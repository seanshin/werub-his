{
  "name": "vital-signs",
  "version": "1.0",
  "locale": "ko",
  "pages": [{
    "label": "바이탈 사인",
    "sections": [{
      "label": "기본 측정",
      "questions": [
        {
          "id": "systolicBP",
          "label": "수축기 혈압",
          "type": "number",
          "unit": "mmHg",
          "validation": { "min": 50, "max": 300, "required": true }
        },
        {
          "id": "diastolicBP",
          "label": "이완기 혈압",
          "type": "number",
          "unit": "mmHg",
          "validation": { "min": 30, "max": 200, "required": true }
        },
        {
          "id": "heartRate",
          "label": "심박수",
          "type": "number",
          "unit": "bpm",
          "validation": { "min": 30, "max": 250, "required": true }
        },
        {
          "id": "temperature",
          "label": "체온",
          "type": "number",
          "unit": "°C",
          "validation": { "min": 30.0, "max": 45.0, "required": true }
        },
        {
          "id": "respiratoryRate",
          "label": "호흡수",
          "type": "number",
          "unit": "회/분",
          "validation": { "min": 5, "max": 60, "required": false }
        },
        {
          "id": "spO2",
          "label": "산소포화도",
          "type": "number",
          "unit": "%",
          "validation": { "min": 50, "max": 100, "required": false }
        },
        {
          "id": "height",
          "label": "신장",
          "type": "number",
          "unit": "cm",
          "validation": { "min": 30, "max": 250, "required": false }
        },
        {
          "id": "weight",
          "label": "체중",
          "type": "number",
          "unit": "kg",
          "validation": { "min": 1, "max": 500, "required": false }
        }
      ]
    }]
  }]
}
