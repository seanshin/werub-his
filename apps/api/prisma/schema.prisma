  /// EHR launch 진입점(앱의 SMART launch 엔드포인트) — 등록된 앱만 차트 런처에 노출
  launchUrl    String?   @map("launch_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("smart_clients")
}

// 디지털 트윈 FHIR write-back (A4-3) — AI 생성 RiskAssessment. 온디맨드·AI-flag·동의·감사
model TwinRiskAssessment {
  id                 String    @id @default(uuid()) @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  status             String    @db.VarChar(20) // final 등
  method             String?   @db.VarChar(50) // ASCVD-PCE | UKPDS56 | CKD-EPI-2021
  occurrenceDateTime DateTime? @map("occurrence_datetime") @db.Timestamptz()
  basis              Json? // [Reference(Observation)]
  prediction         Json? // [{ outcome, probabilityDecimal, whenRange }]
  note               String?   @db.Text // disclaimer
  aiGenerated        Boolean   @default(true) @map("ai_generated") // twin-ai-generated
  authorFhirUser     String?   @map("author_fhir_user") @db.VarChar(200) // Practitioner/{id}
  clientId           String?   @map("client_id") @db.VarChar(100) // SMART client(twin-weve-smart)
  resourceJson       Json      @map("resource_json") // 원본 FHIR RiskAssessment
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([patientId])
  @@index([createdAt])
  @@map("twin_risk_assessments")
}

// 디지털 트윈 FHIR write-back 2단계 — AI 생성 DocumentReference(SBAR). 동일 정책(AI-flag·동의·감사)
model TwinDocumentReference {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  status         String   @db.VarChar(20) // current 등
  docType        String?  @map("doc_type") @db.VarChar(100) // SBAR 등
  description    String?  @db.Text
  contentText    String?  @map("content_text") @db.Text // SBAR 본문(평문/base64 디코드)
  aiGenerated    Boolean  @default(true) @map("ai_generated")
  authorFhirUser String?  @map("author_fhir_user") @db.VarChar(200)
  clientId       String?  @map("client_id") @db.VarChar(100)
  resourceJson   Json     @map("resource_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([patientId])
  @@index([createdAt])
  @@map("twin_document_references")
}

// 발급 문서 (문서충실도 P3) — 발급 시점 스냅샷 동결 + 발급번호 + 해시(진위). 트윈 모델과 분리(설계 §12.3)
model IssuedDocument {
  issueNo            String   @id @map("issue_no") @db.VarChar(60) // WRB-{TYPE}-{YYYYMMDD}-{seq}
  documentType       String   @map("document_type") @db.VarChar(40)
  sourceId           String   @map("source_id") @db.VarChar(64)
  patientId          String?  @map("patient_id") @db.Uuid
  snapshotJson       Json     @map("snapshot_json") // 발급 시점 데이터 동결
  formVersion        String   @default("v1") @map("form_version") @db.VarChar(20)
  hash               String   @db.VarChar(64) // sha256(snapshot)
  status             String   @default("ORIGINAL") @db.VarChar(20) // ORIGINAL|COPY|REISSUE|VOID
  reissueOf          String?  @map("reissue_of") @db.VarChar(60)
  dateKey            String   @map("date_key") @db.VarChar(8) // YYYYMMDD
  seq                Int
  issuedBy           String?  @map("issued_by") @db.Uuid
  issuedAt           DateTime @default(now()) @map("issued_at") @db.Timestamptz()
  // e-sign #6 — 서명요청 바인딩(ConsentForm 외 ERP 계약 등 비동의 문서도 webhook 완료 매칭 가능하게).
  signatureRequestId String?  @map("signature_request_id") @db.VarChar(64)

  @@unique([documentType, dateKey, seq]) // 발급번호 동시성 보장
  @@index([patientId])
  @@index([documentType, sourceId])
  @@index([signatureRequestId])
  @@map("issued_documents")
}

