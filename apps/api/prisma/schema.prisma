// ── 의료 용어 표준 매핑 ──

/// 올린 **기초 데이터의 출처 원장** — 무엇을·어느 고시 기준으로·언제·누가 올렸는가.
///
/// 🔴 사람 지시(2026-08-26): *"현재 올리는 데이터들이 **해당 날짜와 고시에 맞춰서** 저장되면 됨."*
///
/// 🔴 **기준일이 없으면 다음 사람이 그것을 현재로 읽는다.** 약가·분류·매핑은 전부 고시 시점이 있고,
/// 그 시점을 잃어버리면 "왜 이 값이지"를 아무도 되짚을 수 없다.
/// 반영된 값은 이 원장을 가리켜 **어느 고시에서 왔는지** 말할 수 있어야 한다.
/// DRG(질병군) **기타진단 중증도 점수** — 고시 별표4.
///
/// 🔴 이것은 **참조 자료**다. 이 표만으로는 DRG 를 산정할 수 없다
/// (질병군 배정·수가는 별도 자료가 필요하다). 계산할 수 있는 것은 **중증도 점수 합계**까지다.
/// DRG(질병군) **행위 별도보상 코드** — 포괄수가에 묶이지 않고 따로 산정하는 행위.
///
/// 근거: 「7개 질병군 행위 별도보상 코드 목록」(사람 제공). 실측 **73,419코드**.
/// 우리 수가 마스터 166,744 중 **10,878건**이 이 목록에 있다.
///
/// 🔴 **적용기간이 있다.** 기간이 지난 코드를 "별도보상 가능"이라 말하면 그대로 청구된다.
/// 약제 급여상한금액 — **고시 시점별**로 보관한다.
///
/// 🔴 현재가 한 벌만 두면 과거 진료를 오늘 값으로 재계산한다. 실측(2026-08-26):
///    2026.6.1 → 7.1 한 달 사이에 **가격변동 13건**(줄토피플렉스터치주 38,482 → 103,406 = 2.7배 ·
///    렉라자 63,363 → 41,000) · 신규 99 · 삭제 38.
///    6월 진료를 7월 값으로 청구하면 그 13건이 틀린다 — 그래서 `validFrom`/`validTo` 로 시점을 판정한다.
/// 행위 수가 고시 — **종별 단가를 전부, 시점별로** 보관한다.
///
/// 🔴 왜 종별을 전부 두는가(2026-08-26 실측): 고시는 한 코드에 **8개 종별 단가**를 준다.
///    의원단가 ≠ 병원급이상단가인 코드가 **408,196건(97.4%)** 이다.
///    운영 `procedure_codes.unit_price` 166,643건은 그중 **의원단가와 164,704건(98.8%) 일치** —
///    즉 병원인데 의원 단가를 들고 있었다. 한 칸에 하나만 저장하면 그 사실이 드러나지 않는다.
///
/// 🔴 `0` 은 **"그 종별에서는 산정하지 않는다"**이지 "무료"가 아니다.
///    운영에 `unit_price = 0` 인 코드 5,004건 중 2,898건은 병원급에 실제 금액이 있었다.
///    그래서 고시의 0 은 `null` 로 바꾸지 않고 **원문 그대로 0 을 보관**하되,
///    조회(`feeOn`)가 "미산정"과 "모름"을 갈라서 답한다.
model ProcedureFee {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @db.VarChar(20)
  /// 고시 분류번호 원문(`카1`·`가-2-0`) — 접두가 무슨 분류인지는 여기 적지 않는다
  gazetteClass String? @map("gazette_class") @db.VarChar(40)
  nameKo       String? @map("name_ko") @db.VarChar(500)
  nameEn       String? @map("name_en") @db.VarChar(500)
  /// 급여 구분 — 고시 시트 그대로(`급여`·`비급여`·`100대100`)와 영역(`의치과`·`한방`·`약국`)
  benefitType  String? @map("benefit_type") @db.VarChar(20)
  domain       String? @db.VarChar(20)

  /// 🔴 종별 단가(원). 고시 원문 그대로 — `0` 은 그 종별 미산정이다
  priceClinic    Int? @map("price_clinic") // 의원
  priceHospital  Int? @map("price_hospital") // 병원급 이상
  priceDental    Int? @map("price_dental") // 치과 병·의원
  priceHealthCtr Int? @map("price_health_ctr") // 보건기관
  priceMidwife   Int? @map("price_midwife") // 조산원
  priceOriental  Int? @map("price_oriental") // 한방병원
  priceNursing   Int? @map("price_nursing") // 요양·정신병원

  /// 상대가치점수 — 환산지수를 곱하는 원본. 우리가 계산하지 않고 보관만 한다
  rvu         Decimal? @db.Decimal(12, 2)
  /// 본인부담률 특례(고시 Y/N 원문) — 🔴 여기 없다고 30% 인 것이 아니다
  copay50     Boolean  @default(false) @map("copay_50")
  copay80     Boolean  @default(false) @map("copay_80")
  copay90     Boolean  @default(false) @map("copay_90")
  duplicateOk String?  @map("duplicate_ok") @db.VarChar(5)
  calcName    String?  @map("calc_name") @db.VarChar(300)
  isSurgery   String?  @map("is_surgery") @db.VarChar(5)

  /// 고시가 정한 적용일자(원문) — 코드마다 다르다
  appliedOn DateTime? @map("applied_on") @db.Date
  /// 이 반영본이 적용되는 기간(고시 시행일 기준)
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  datasetId String           @map("dataset_id") @db.Uuid
  dataset   ReferenceDataset @relation("ProcedureFees", fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, code])
  @@index([code, validFrom])
  // 시점 유효 고시 찾기(`valid_from <= 시점 ORDER BY valid_from DESC LIMIT 1`) — 종전엔 전 행 순차 스캔+정렬(수가 41.9만 행 · 1회 ~60ms · 2026-10-01 실측)
  @@index([validFrom])
  @@map("procedure_fees")
}

model DrugPrice {
  id             String  @id @default(uuid()) @db.Uuid
  /// 제품코드(EDI 9자리) — `MedicationCode.insuranceCode` 와 맞춘다
  code           String  @db.VarChar(20)
  nameKo         String? @map("name_ko") @db.VarChar(300)
  /// 급여상한금액(원). 🔴 고시에 금액이 없으면 `null` — **0 은 다른 사실이다**(무료가 아니다)
  price          Int?
  /// 주성분코드 · 투여경로 · 규격/단위 — 고시 원문 그대로(해석하지 않는다)
  ingredientCode String? @map("ingredient_code") @db.VarChar(30)
  route          String? @db.VarChar(20)
  spec           String? @db.VarChar(60)
  unit           String? @db.VarChar(40)
  manufacturer   String? @db.VarChar(200)
  /// 분류번호(식약처) — 원문 그대로
  classNo        String? @map("class_no") @db.VarChar(20)
  /// 비고(전문/일반 등) 원문
  note           String? @db.VarChar(60)

  /// 🔴 이 고시가 적용되는 기간. `validTo=null` = 아직 후속 고시가 등재되지 않았다(=무기한이 아니다)
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  datasetId String           @map("dataset_id") @db.Uuid
  dataset   ReferenceDataset @relation("DrugPrices", fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, code])
  @@index([code, validFrom])
  // 시점 유효 고시 찾기(`valid_from <= 시점 ORDER BY valid_from DESC LIMIT 1`) — 종전엔 전 행 순차 스캔+정렬(수가 41.9만 행 · 1회 ~60ms · 2026-10-01 실측)
  @@index([validFrom])
  @@map("drug_prices")
}

model DrgSeparateBilling {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @db.VarChar(20)
  /// 고시 분류번호 원문(`자654-2`)
  gazetteClass String?   @map("gazette_class") @db.VarChar(40)
  name         String?   @db.VarChar(300)
  /// 산정명칭 — 같은 코드의 산정 조건 표기
  calcName     String?   @map("calc_name") @db.VarChar(300)
  /// 보상률(고시 원문 그대로 — 해석하지 않는다)
  rate         String?   @db.VarChar(20)
  benefitType  String?   @map("benefit_type") @db.VarChar(20)
  /// 🔴 질병군 적용 시작·종료일 — 기간 밖이면 별도보상이 아니다
  validFrom    DateTime? @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date

  datasetId String           @map("dataset_id") @db.Uuid
  dataset   ReferenceDataset @relation("DrgSeparate", fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, code])
  @@index([code])
  @@map("drg_separate_billings")
}

model DrgSeverityScore {
  id            String           @id @default(uuid()) @db.Uuid
  /// KCD 진단코드(점 없는 표기 — 고시 원문 그대로)
  diagnosisCode String           @map("diagnosis_code") @db.VarChar(10)
  score         Int
  datasetId     String           @map("dataset_id") @db.Uuid
  dataset       ReferenceDataset @relation("DrgSeverity", fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, diagnosisCode])
  @@index([diagnosisCode])
  @@map("drg_severity_scores")
}

/// DRG **기타진단 점수를 0으로 만드는 주진단** — 고시 별표5.
///
/// 🔴 주진단과 기타진단이 같은 병태를 가리키면 중증도를 이중으로 세지 않는다는 규칙이다.
/// 실측(2026-08-26): 기타진단 4,853종 × 주진단 조합 **729,446쌍**.
/// 쌍마다 한 행으로 두면 73만 행이 되므로 **기타진단당 한 행 + 주진단 배열**로 담는다.
model DrgZeroScoreRule {
  id             String           @id @default(uuid()) @db.Uuid
  /// 이 기타진단이
  otherDiagnosis String           @map("other_diagnosis") @db.VarChar(10)
  /// 이 주진단들과 함께 오면 점수가 0 이 된다
  mainDiagnoses  String[]         @map("main_diagnoses")
  datasetId      String           @map("dataset_id") @db.Uuid
  dataset        ReferenceDataset @relation("DrgZeroRule", fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, otherDiagnosis])
  @@index([otherDiagnosis])
  @@map("drg_zero_score_rules")
}

model ReferenceDataset {
  id            String   @id @default(uuid()) @db.Uuid
  /// 무엇을 올렸나 — DRUG_PRICE_LIST | ATC_MAPPING | DRUG_STANDARD_CODE | PROCEDURE_GAZETTE | OTHER
  kind          String   @db.VarChar(30)
  /// 🔴 **고시 기준일** — 파일이 말하는 시점(올린 날이 아니다)
  effectiveDate DateTime @map("effective_date") @db.Date
  /// 고시 명칭·발행처(사람이 읽는 출처)
  sourceName    String   @map("source_name") @db.VarChar(300)
  /// 원본 파일명 — 같은 고시를 다른 파일로 올렸는지 구분한다
  fileName      String?  @map("file_name") @db.VarChar(300)
  /// 내용 해시 — 같은 파일을 두 번 올렸는지 기계로 안다
  contentHash   String?  @map("content_hash") @db.VarChar(64)

  rowCount     Int     @default(0) @map("row_count")
  appliedCount Int     @default(0) @map("applied_count")
  skippedCount Int     @default(0) @map("skipped_count")
  /// 🔴 반영하지 못한 것·건너뛴 이유 — 숫자만 남기면 왜 그랬는지 잃는다
  notes        String? @db.Text

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz()
  importedBy String   @map("imported_by") @db.Uuid

  importer            User                 @relation("ReferenceDatasetImporter", fields: [importedBy], references: [id])
  drugBarcodes        DrugBarcode[]
  drgSeverityScores   DrgSeverityScore[]   @relation("DrgSeverity")
  drgZeroScoreRules   DrgZeroScoreRule[]   @relation("DrgZeroRule")
  drgSeparateBillings DrgSeparateBilling[] @relation("DrgSeparate")
  drugPrices          DrugPrice[]          @relation("DrugPrices")
  procedureFees       ProcedureFee[]       @relation("ProcedureFees")

  @@index([kind, effectiveDate])
  @@map("reference_datasets")
}

/// 의약품 **포장단위 표준코드**(GS1 GTIN-13) ↔ 약품 마스터.
///
/// 🔴 발단(2026-08-26 실측): `medication_codes.barcode` 22,306건은 전부 **대표코드**였다
/// (심평원 파일의 대표코드와 22,305/22,306 일치). 그런데 **실제 약 상자에 찍혀 나오는 것은
/// 포장단위 표준코드**다 — 한 약에 최대 112개까지 있다. 즉 **스캔하면 못 찾는다.**
///
/// 🔴 체크디지트는 심평원 파일 305,522건 중 **불일치 1건**(공식 파일의 오타)이었다 —
/// 그래서 저장은 하되 `checkDigitValid` 로 사실을 남긴다. 막으면 그 약을 아예 못 찾는다.
model DrugBarcode {
  id                 String  @id @default(uuid()) @db.Uuid
  /// GS1 GTIN-13(표준코드) 원문
  standardCode       String  @unique @map("standard_code") @db.VarChar(14)
  /// 대표코드 — 같은 품목의 포장들을 묶는다
  representativeCode String? @map("representative_code") @db.VarChar(14)
  /// 보험 청구용 제품코드(EDI) — 약품 마스터와 잇는 축
  ediCode            String? @map("edi_code") @db.VarChar(20)
  medicationCodeId   String? @map("medication_code_id") @db.Uuid

  productName     String? @map("product_name") @db.VarChar(300)
  maker           String? @db.VarChar(200)
  packageSpec     String? @map("package_spec") @db.VarChar(200)
  /// 🔴 체크디지트 검증 결과 — `false` 여도 저장한다(막으면 그 약을 못 찾는다)
  checkDigitValid Boolean @default(true) @map("check_digit_valid")

  datasetId String   @map("dataset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  dataset        ReferenceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  medicationCode MedicationCode?  @relation(fields: [medicationCodeId], references: [id])

  @@index([ediCode])
  @@index([representativeCode])
  @@index([medicationCodeId])
  @@map("drug_barcodes")
}

model TerminologyMapping {
