// ── 내과 통합 검사 ──

model InternalMedicineExam {
  id             String  @id @default(uuid()) @db.Uuid
  patientId      String  @map("patient_id") @db.Uuid
  encounterId    String? @map("encounter_id") @db.Uuid
  subspecialty   String  @db.VarChar(30) // CARDIOLOGY, PULMONOLOGY, GASTRO, ENDOCRINE, NEPHROLOGY, HEMATO_ONCOLOGY, INFECTIOUS, RHEUMATOLOGY
  // 공통 필드
  chiefComplaint String? @map("chief_complaint") @db.Text
  diagnosis      String? @db.Text
  plan           String? @db.Text

  // ── 순환기 ──
  nyhaClass     Int?     @map("nyha_class") // I-IV
  ccsGrade      Int?     @map("ccs_grade") // I-IV
  lvef          Decimal? @db.Decimal(4, 1) // %
  heartRhythm   String?  @map("heart_rhythm") @db.VarChar(30) // SINUS, AF, VT, VF, FLUTTER
  ecgFindings   Json?    @map("ecg_findings") @db.JsonB
  echoSummary   Json?    @map("echo_summary") @db.JsonB // {lvef, chamberSize, valveStatus}
  pacemakerInfo Json?    @map("pacemaker_info") @db.JsonB
  inrTarget     Decimal? @map("inr_target") @db.Decimal(3, 1)
  inrActual     Decimal? @map("inr_actual") @db.Decimal(3, 1)
  cha2ds2vasc   Int?     @map("cha2ds2vasc") // 0-9
  hasbled       Int? // 0-9
  heartScore    Int?     @map("heart_score") // 0-10
  graceScore    Int?     @map("grace_score")
  timiScore     Int?     @map("timi_score")

  // ── 호흡기 ──
  fev1          Decimal? @db.Decimal(5, 1) // L
  fvc           Decimal? @db.Decimal(5, 1)
  fev1Fvc       Decimal? @map("fev1_fvc") @db.Decimal(5, 1) // %
  dlco          Decimal? @db.Decimal(5, 1) // %predicted
  goldStage     Int?     @map("gold_stage") // I-IV
  oxygenTherapy Json?    @map("oxygen_therapy") @db.JsonB // {flowRate, method, spo2Target}
  sputum        Json?    @db.JsonB // {amount, color, character}
  curb65        Int? // 0-5
  catScore      Int?     @map("cat_score") // 0-40
  mmrcGrade     Int?     @map("mmrc_grade") // 0-4
  qsofa         Int? // 0-3

  // ── 소화기 ──
  endoscopyType     String? @map("endoscopy_type") @db.VarChar(30) // EGD, COLONOSCOPY, ERCP, EUS
  endoscopyFindings Json?   @map("endoscopy_findings") @db.JsonB
  childPughScore    Int?    @map("child_pugh_score") // 5-15
  childPughClass    String? @map("child_pugh_class") @db.VarChar(1) // A, B, C
  meldScore         Int?    @map("meld_score") // 6-40
  ascites           String? @db.VarChar(20) // NONE, MILD, MODERATE, TENSE
  varicesGrade      String? @map("varices_grade") @db.VarChar(5) // F1, F2, F3
  blatchfordScore   Int?    @map("blatchford_score") // 0-23

  // ── 내분비 ──
  hba1c           Decimal? @db.Decimal(4, 1) // %
  fastingGlucose  Int?     @map("fasting_glucose") // mg/dL
  insulinRegimen  Json?    @map("insulin_regimen") @db.JsonB // {type, dose, schedule}
  thyroidFunction Json?    @map("thyroid_function") @db.JsonB // {tsh, ft4, ft3, antibodies}
  bmdTScore       Decimal? @map("bmd_t_score") @db.Decimal(4, 1)
  bmdSite         String?  @map("bmd_site") @db.VarChar(30) // SPINE, HIP, FOREARM
  fraxScore       Decimal? @map("frax_score") @db.Decimal(4, 1) // %

  // ── 신장 ──
  ckdStage     String?  @map("ckd_stage") @db.VarChar(5) // G1-G5, D
  egfr         Decimal? @db.Decimal(5, 1) // mL/min/1.73m²
  dialysisType String?  @map("dialysis_type") @db.VarChar(10) // HD, PD, CRRT
  ktv          Decimal? @db.Decimal(4, 2) // 투석 적절성
  electrolytes Json?    @db.JsonB // {Na, K, Ca, P, Mg}
  fluidBalance Json?    @map("fluid_balance") @db.JsonB // {intake, output}

  // ── 혈액종양 ──
  cancerType     String?  @map("cancer_type") @db.VarChar(100)
  tnmStage       String?  @map("tnm_stage") @db.VarChar(20) // T1N0M0
  ecogPs         Int?     @map("ecog_ps") // 0-4
  regimenName    String?  @map("regimen_name") @db.VarChar(100) // FOLFOX, CHOP
  cycleDay       String?  @map("cycle_day") @db.VarChar(20) // C3D1
  bsa            Decimal? @db.Decimal(4, 2) // m²
  recistResponse String?  @map("recist_response") @db.VarChar(10) // CR, PR, SD, PD
  ctcaeGrade     Int?     @map("ctcae_grade") // 1-5
  ctcaeEvent     String?  @map("ctcae_event") @db.VarChar(100)

  // ── 감염 ──
  infectionSite  String?  @map("infection_site") @db.VarChar(100)
  organism       String?  @db.VarChar(200)
  susceptibility Json?    @db.JsonB // {drug: 'S'|'I'|'R'}
  antibiotics    Json?    @db.JsonB // [{name, start, end, route}]
  isolationType  String?  @map("isolation_type") @db.VarChar(20) // CONTACT, DROPLET, AIRBORNE
  sofaScore      Int?     @map("sofa_score") // 0-24
  procalcitonin  Decimal? @db.Decimal(6, 2) // ng/mL

  // ── 류마티스 ──
  tenderJointCount  Int?     @map("tender_joint_count") // 0-28 or 0-68
  swollenJointCount Int?     @map("swollen_joint_count") // 0-28 or 0-66
  das28             Decimal? @db.Decimal(4, 2)
  haqDi             Decimal? @map("haq_di") @db.Decimal(4, 2) // 0-3
  autoantibodies    Json?    @db.JsonB // {ANA, dsDNA, RF, CCP, ANCA}
  sledai            Int? // 0-105
  basdai            Decimal? @db.Decimal(4, 1) // 0-10
  biologics         Json?    @db.JsonB // [{name, dose, interval}]

  // 공통 메타
  scores     Json?    @db.JsonB // 추가 스코어링 결과
  examinedBy String   @map("examined_by") @db.Uuid
  examinedAt DateTime @default(now()) @map("examined_at") @db.Timestamptz()

  patient  Patient @relation(fields: [patientId], references: [id])
  examiner User    @relation("InternalMedicineExamExaminer", fields: [examinedBy], references: [id])

  @@index([patientId, subspecialty, examinedAt])
  @@map("internal_medicine_exams")
}

// ── 전문과 진료기록 (구조화 저장) — 관계 없이 patientId/examinedBy String 저장(마이그레이션 표면 최소화·append-only) ──

