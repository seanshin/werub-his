  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient             @relation(fields: [patientId], references: [id])
  prescriber User                @relation("RadiationPlanPrescriber", fields: [prescribedBy], references: [id])
  approver   User?               @relation("RadiationPlanApprover", fields: [planApprovedBy], references: [id])
  fractions  RadiationFraction[]
  toxicities RadiationToxicity[]

  @@map("radiation_plans")
}

model RadiationFraction {
  id             String    @id @default(uuid()) @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  fractionNumber Int       @map("fraction_number")
  scheduledDate  DateTime  @map("scheduled_date") @db.Date
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz()
  deliveredDose  Decimal?  @map("delivered_dose") @db.Decimal(5, 2)
  cumulativeDose Decimal?  @map("cumulative_dose") @db.Decimal(6, 2)
