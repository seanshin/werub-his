/// 여정 지연 **확인·조치 기록** — 관제자가 이 지연을 보고 무엇을 했는가.
///
/// 🔴 발단(2026-08-26): 관제 보드는 지연을 보여주지만 **무엇을 했는지 남는 자리가 없었다.**
///    같은 카드가 교대 내내 빨갛게 떠 있고, 다음 근무자는 앞 사람이 이미 연락했는지 알 수 없다
///    ("워크리스트가 없으면 직원은 기억으로 일한다").
///
/// 🔴 **확인은 지연을 숨기지 않는다.** 카드는 그대로 지연으로 남고 확인 사실이 덧붙을 뿐이다
///    — 숨기는 방향으로는 자동이 없다.
/// 🔴 **확인은 만료된다.** 임계 시간이 한 번 더 지나면 다시 미확인이다
///    (그렇지 않으면 한 번 확인하고 잊는다).
/// 🔴 **다른 지연이 새로 생기면 그것은 미확인이다** — `flagKey` 가 달라져 이 기록이 덮지 못한다.
model JourneyDelayAck {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  track     String   @db.VarChar(4) // OPD | IPD | ER
  stage     String   @db.VarChar(24)
  /// 확인 당시의 지연 플래그(정렬·콤마 결합) — 이 조합에 대해서만 확인이 유효하다
  flagKey   String   @map("flag_key") @db.VarChar(200)
  /// 무엇을 했는가. 🔴 어휘를 지어내 강제하지 않는다 — 입력 보조만 주고 **비어 있으면 안 된다**만 강제
  note      String   @db.VarChar(300)
  ackedBy   String   @map("acked_by") @db.Uuid
  ackedAt   DateTime @default(now()) @map("acked_at") @db.Timestamptz()
  /// 이 확인이 유효한 시각까지 — 지나면 다시 미확인으로 돌아온다
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [ackedBy], references: [id])

  @@index([patientId, expiresAt])
  @@index([expiresAt])
  @@map("journey_delay_acks")
}

model ClinicalHandoff {
  id                 String    @id @default(uuid()) @db.Uuid
  type               String    @db.VarChar(30)
  patientId          String    @map("patient_id") @db.Uuid
  fromDoctorId       String    @map("from_doctor_id") @db.Uuid
  toDoctorId         String    @map("to_doctor_id") @db.Uuid
  emergencyVisitId   String?   @map("emergency_visit_id") @db.Uuid
  admissionId        String?   @map("admission_id") @db.Uuid
  summary            String    @db.Text
  // I-PASS 구조화 인수인계
  illness            String?   @db.VarChar(20) // STABLE, UNSTABLE, CRITICAL
  patientSummary     String?   @map("patient_summary") @db.Text
  actionList         Json?     @map("action_list") @db.JsonB // [{action, status, deadline}]
  situationAwareness String?   @map("situation_awareness") @db.Text
  synthesis          String?   @db.Text // 인수자 확인 사항
  //
  vitalSigns         Json?     @map("vital_signs") @db.JsonB
  pendingItems       Json?     @map("pending_items") @db.JsonB
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.Timestamptz()
  /// 인수 확인한 사람(2026-10-26) — 지정 인수자 본인 또는 관리자 대리. 종전엔 시각만 남아 관리자 대리 확인을 본인 확인과 구별할 수 없었다 · 그 전 확인분은 null(모른다)
  acknowledgedBy     String?   @map("acknowledged_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient    @relation(fields: [patientId], references: [id])
  fromDoctor User       @relation("HandoffFrom", fields: [fromDoctorId], references: [id])
  toDoctor   User       @relation("HandoffTo", fields: [toDoctorId], references: [id])
  admission  Admission? @relation(fields: [admissionId], references: [id])

  @@index([patientId])
  @@index([admissionId])
  @@map("clinical_handoffs")
}

model BedAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  admissionId String    @map("admission_id") @db.Uuid
  bedId       String    @map("bed_id") @db.Uuid
  assignedAt  DateTime  @map("assigned_at") @db.Timestamptz()
  releasedAt  DateTime? @map("released_at") @db.Timestamptz()
  reason      String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  bed       Bed       @relation(fields: [bedId], references: [id])

  @@index([admissionId])
  @@index([bedId, releasedAt])
  @@map("bed_assignments")
}

/// 병동 간 전동 요청 → 수락(2026-09-30) — 보내는 쪽이 요청하고 받는 쪽이 병상을 골라 수락한다(그 순간 전실 정본으로 이동).
/// 입원 하나에 열린 요청은 하나(부분 유니크 `uniq_bed_transfer_open` — 마이그레이션 SQL). 요청 때 병상을 잡지 않는다(사람 결정 `bedTransfer.reserveOnRequest`).
model BedTransferRequest {
  id            String    @id @default(uuid()) @db.Uuid
  admissionId   String    @map("admission_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  fromBedId     String    @map("from_bed_id") @db.Uuid
  targetWardId  String    @map("target_ward_id") @db.Uuid
  targetBedId   String?   @map("target_bed_id") @db.Uuid // 요청자가 원한 병상(선택) — 받는 쪽이 바꿀 수 있다
  reason        String    @db.Text
  status        String    @default("REQUESTED") @db.VarChar(12) // REQUESTED|ACCEPTED|REJECTED|CANCELLED
  requestedById String    @map("requested_by_id") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  decidedById   String?   @map("decided_by_id") @db.Uuid // 입원 종료로 닫히면 null(사람이 판정한 것이 아니다)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz()
  decisionNote  String?   @map("decision_note") @db.Text
  acceptedBedId String?   @map("accepted_bed_id") @db.Uuid

  @@index([status, targetWardId])
  @@index([admissionId])
  @@map("bed_transfer_requests")
}

model Round {
  id          String   @id @default(uuid()) @db.Uuid
  admissionId String   @map("admission_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  roundType   String   @map("round_type") @db.VarChar(20)
  roundedAt   DateTime @map("rounded_at") @db.Timestamptz()
  notes       String?  @db.Text
  assessment  String?  @db.Text
  plan        String?  @db.Text
  vitalSigns  Json?    @map("vital_signs") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  doctor    User      @relation("RoundDoctor", fields: [doctorId], references: [id])

  @@index([admissionId, roundedAt])
  @@map("rounds")
}

model PatientJourneyEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  eventType           String    @map("event_type") @db.VarChar(50)
  eventAt             DateTime  @map("event_at") @db.Timestamptz()
  title               String    @db.VarChar(200)
  description         String?   @db.Text
  department          String?   @db.VarChar(100)
  doctorId            String?   @map("doctor_id") @db.Uuid
  doctorName          String?   @map("doctor_name") @db.VarChar(100)
  refType             String?   @map("ref_type") @db.VarChar(30)
  refId               String?   @map("ref_id") @db.Uuid
  navUrl              String?   @map("nav_url") @db.VarChar(300)
  severity            String?   @db.VarChar(20)
  metadata            Json?     @db.JsonB
  /// 기록 시각(시스템이 알게 된 순간) — 정본은 이 컬럼이다. `eventAt` 은 종전 표시 시각(시드 롤포워드가 다시 쓴 행이 있다)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // ── 여정 P1(2026-10-01 · patient-journey-model.plan.md §5.4) — 전부 추가 전용, 과거 행은 기본값(UNKNOWN·null)
  /// 발생 시각 — 그 일이 실제로 일어난 시각. **모르면 null**(기록 시각으로 채우지 않는다)
  occurredAt          DateTime? @map("occurred_at") @db.Timestamptz()
  /// 발생 시각의 출처: DOMAIN_FIELD(원 기록 시각 필드) · USER_CLAIMED(사용자가 입력한 과거 시각) · SAME_AS_RECORDED(즉시 행위) · UNKNOWN(과거 행)
  occurredAtSource    String    @default("UNKNOWN") @map("occurred_at_source") @db.VarChar(20)
  /// 정밀도: INSTANT · MINUTE · DAY(날짜만 아는 사건)
  occurredAtPrecision String?   @map("occurred_at_precision") @db.VarChar(10)
  /// 예정 시각(SCHEDULED 사건 — 예약·검진 예정) — 발생 시각과 섞지 않는다
  plannedAt           DateTime? @map("planned_at") @db.Timestamptz()
  /// 발행 지점(파일:함수) — 완결성 진단용
  emitter             String?   @db.VarChar(80)
  /// 데이터 출처: LIVE · SEED · DEMO · IMPORTED · UNKNOWN(과거 행 판정 불가)
  dataOrigin          String    @default("UNKNOWN") @map("data_origin") @db.VarChar(10)
  /// (여정 P2) 활동 — shared `JOURNEY_ACTIVITY_MAP` 에서 파생. 과거 행은 null(소급 없음)
  activity            String?   @db.VarChar(40)
  /// (여정 P2) 생명주기 전이 — shared `JOURNEY_TRANSITIONS`
  transition          String?   @db.VarChar(20)
  /// (여정 P2) 결과 속성 — 퇴원·전원·처분 등(전이만으로 못 담는 것)
  outcome             String?   @db.VarChar(40)
  /// (여정 P2) 정정 대상 사건 — REVISED 가 가리키는 앞 사건(모르면 null)
  supersedesId        String?   @map("supersedes_id") @db.Uuid
  /// (여정 P2) 멱등 키 `<activity>:<transition>:<refId>` — 한 번만 일어나는 전이의 이중 발행 방지(NULL 은 여러 개 허용 = 부분 유니크)
  idempotencyKey      String?   @unique @map("idempotency_key") @db.VarChar(160)

  patient Patient                     @relation(fields: [patientId], references: [id])
  objects PatientJourneyEventObject[]

  @@index([patientId, eventAt])
  @@index([eventType])
  @@index([refType, refId])
  @@index([patientId, occurredAt])
  @@index([activity, transition])
  @@map("patient_journey_events")
}

/// 여정 사건–객체 관계(OCEL E2O · 여정 P1) — 사건 하나가 방문·원 기록·장소에 동시에 걸린다.
/// qualifier: episode(방문 단위 — 응급 방문·입원·수술·검진 방문·외래 접수) · focus(직접 대상 기록) · location · performer
model PatientJourneyEventObject {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  objectType String @map("object_type") @db.VarChar(40)
  objectId   String @map("object_id") @db.Uuid
  qualifier  String @db.VarChar(20)

  event PatientJourneyEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, objectType, objectId, qualifier])
  @@index([objectType, objectId])
  @@map("patient_journey_event_objects")
}

// ── 메타버스: 병원 공간 노드 ──

model SpaceNode {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  depth       Int      @default(0)
  path        String   @db.VarChar(500)
  nodeType    String   @map("node_type") @db.VarChar(30)
  name        String   @db.VarChar(100)
  code        String?  @unique @db.VarChar(30)
  floor       Int?
  roomNumber  String?  @map("room_number") @db.VarChar(20)
  spaceType   String   @map("space_type") @db.VarChar(30)
  department  String?  @db.VarChar(50)
  capacity    Int?
  color       String?  @db.VarChar(7)
  icon        String?  @db.VarChar(30)
  wardId      String?  @map("ward_id") @db.Uuid
  bedId       String?  @map("bed_id") @db.Uuid
  connectedTo Json?    @map("connected_to") @db.JsonB
  walkTime    Int?     @map("walk_time")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  equipment   Json?    @db.JsonB
  tags        Json?    @db.JsonB
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  parent          SpaceNode?       @relation("SpaceTree", fields: [parentId], references: [id])
  children        SpaceNode[]      @relation("SpaceTree")
  assetPlacements AssetPlacement[]
  checkupStations CheckupStation[]
  clinicRooms     ClinicRoom[]
  beds            Bed[]

  @@index([parentId])
  @@index([floor])
  @@index([spaceType])
  @@map("space_nodes")
}

// ── 공간 자산 배치 원장 (spatial-flow-vision-3d §5-A) ──
// 워크스테이션·PC·의료기기·장비·보관 장소가 어느 공간에 있는가. 자산은 (assetKind, assetId) 로 가리킨다(복사 없음 · 어휘 shared ASSET_KINDS).
// 🔴 자산당 활성(endedAt null) 배치 하나 — 부분 유니크 인덱스는 db push 가 지우므로 서비스가 advisory lock 으로 보장한다.
// 🔴 x·y 는 도면이 확정된 구역에서만(미확정이면 null) — 지어낸 좌표를 남기지 않는다.
model AssetPlacement {
  id                    String    @id @default(uuid()) @db.Uuid
  assetKind             String    @map("asset_kind") @db.VarChar(30)
  assetId               String    @map("asset_id") @db.Uuid
  spaceNodeId           String    @map("space_node_id") @db.Uuid
  x                     Decimal?  @db.Decimal(8, 2) // 층 좌표계(m) — space-import.v1 과 같다
  y                     Decimal?  @db.Decimal(8, 2)
  source                String    @db.VarChar(16) // MANUAL|SURVEY|IMPORT
  note                  String?   @db.VarChar(300)
  legacyTextAtPlacement String?   @map("legacy_text_at_placement") @db.VarChar(200) // 배치 시점 자산 테이블의 자유 텍스트(대조용 보존)
  placedById            String?   @map("placed_by_id") @db.Uuid
  placedAt              DateTime  @default(now()) @map("placed_at") @db.Timestamptz()
  endedAt               DateTime? @map("ended_at") @db.Timestamptz()
  endedById             String?   @map("ended_by_id") @db.Uuid
  endReason             String?   @map("end_reason") @db.VarChar(300)

  spaceNode SpaceNode @relation(fields: [spaceNodeId], references: [id])

  @@index([assetKind, assetId])
  @@index([spaceNodeId])
  @@index([endedAt])
  @@map("asset_placements")
}

// ── 경영성과 벤치마크 (의료기관 회계정보공시 손익 · 2026-09-28) ──
// 공시 원자료(한국보건산업진흥원 HASPA)를 관리자가 가져온다. 기관·연도당 한 행 · 계정은 원 단위 JSON(shared FINANCE_ACCOUNTS).
// 🔴 항등식(의료수익−의료비용=의료이익 등)이 깨진 행은 들이지 않는다(가져오기 결과에 사유) · 우리 병원 손익은 HIS 에 없다(설정으로 지정).
model FinanceDisclosure {
  id              String   @id @default(uuid()) @db.Uuid
  fiscalYear      Int      @map("fiscal_year")
  institutionName String   @map("institution_name") @db.VarChar(200)
  // 공시 기관 코드(HASPA hosCode) — 연도마다 이름 표기가 달라도(156/1,143곳 · 2026-09-29 실측) 같은 기관으로 잇는 식별자.
  // 원 저장소에서 온 행처럼 코드가 없으면 null(이름으로만 찾는다)
  institutionCode String?  @map("institution_code") @db.VarChar(20)
  beds            Int?
  hospitalType    String?  @map("hospital_type") @db.VarChar(30)
  foundingType    String?  @map("founding_type") @db.VarChar(30)
  address         String?  @db.VarChar(300)
  sido            String?  @db.VarChar(30)
  sigungu         String?  @db.VarChar(50)
  lat             Decimal? @db.Decimal(10, 7)
  lng             Decimal? @db.Decimal(10, 7)
  accounts        Json     @db.JsonB
  // 세목(HASPA 계정 코드 → 금액) — 드릴다운용 · shared DISCLOSURE_ACCOUNT_TREE 의 코드만 · 없으면 null(세목 자료 없음) · 2026-09-29
  detail          Json?    @db.JsonB
  importId        String   @map("import_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // 🔴 식별은 (연도, 기관 코드) — 같은 해 같은 법인명의 다른 기관(명지병원 고양·제천)이 있어 이름은 유일하지 않다(2026-09-29)
  @@unique([fiscalYear, institutionCode])
  @@index([fiscalYear, institutionName])
  @@index([institutionCode])
  @@index([fiscalYear, hospitalType])
  @@map("finance_disclosures")
}

model FinanceDisclosureImport {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(200)
  sourceNote   String?  @map("source_note") @db.VarChar(300)
  totalRows    Int      @map("total_rows")
  created      Int
  updated      Int
  rejected     Int
  rejects      Json     @db.JsonB // [{ line, name, year, reason }] — 앞 200건
  importedById String?  @map("imported_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("finance_disclosure_imports")
}

// ── 공간 도면 가져오기 (spatial-flow-vision-3d P1) ──
// space-import.v1(방·문·동선 그래프·출입구) 한 벌 = 한 행. 사람이 확정하면 SpaceNode 에 좌표(rect)·기하 출처를 새기고,
// 뷰어(P2)·길안내(P3)는 **확정된 최신 한 벌**만 쓴다. 이전 확정본은 SUPERSEDED(지우지 않음).
// 🔴 source=SYNTHETIC(합성 도면)은 운영 모드 REAL 에서 받지 않는다 — 지어낸 건물 위에 실환자 길안내를 그리지 않는다.
model SpaceImport {
  id             String    @id @default(uuid()) @db.Uuid
  schema         String    @db.VarChar(30) // space-import.v1
  source         String    @db.VarChar(20) // SYNTHETIC | DRAWING
  status         String    @db.VarChar(12) // DRAFT | CONFIRMED | REJECTED | SUPERSEDED
  title          String    @db.VarChar(200)
  payload        Json      @db.JsonB
  summary        Json      @db.JsonB // 검증 결과(층·공간·매핑·경고) — 목록에서 payload 를 읽지 않게
  createdById    String?   @map("created_by_id") @db.Uuid
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz()
  rejectedReason String?   @map("rejected_reason") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status])
  @@map("space_imports")
}

// ── 외래 진료실 ↔ 공간 연결 (spatial-flow-vision-3d P0-5) ──
// 진료실은 방 모델 없이 `ClinicSchedule.roomName` 텍스트로만 있다(대기열·대기표·전광판·음성 호출이 복사해 쓴다).
// 이 표는 그 **이름 원문**을 공간 구역에 잇는다 — 연결은 사람이 한다(이름이 같아도 자동으로 잇지 않는다 · 제안만).
model ClinicRoom {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100) // = ClinicSchedule.roomName 원문
  spaceNodeId String?  @map("space_node_id") @db.Uuid // null = 연결 해제(위치 모름)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  spaceNode SpaceNode? @relation(fields: [spaceNodeId], references: [id])

  @@map("clinic_rooms")
}

model PatientLocation {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  zoneId      String    @map("zone_id") @db.Uuid
  status      String    @db.VarChar(30)
  enteredAt   DateTime  @default(now()) @map("entered_at") @db.Timestamptz()
  leftAt      DateTime? @map("left_at") @db.Timestamptz()
  duration    Int?
  eventType   String?   @map("event_type") @db.VarChar(50)
  eventId     String?   @map("event_id") @db.Uuid
  metadata    Json?     @db.JsonB
  // 🔴 출처(shared LOCATION_SOURCES) — 기본값 없음: 쓰는 쪽이 관측인지 추정인지 밝혀야 컴파일된다
  source      String    @db.VarChar(20)
  // 해상도 ZONE|FLOOR — FLOOR 이면 zoneId 는 층 노드(추정 후보가 여럿일 때 아무 구역이나 고르지 않는다)
  granularity String    @default("ZONE") @db.VarChar(10)

  @@index([patientId, enteredAt], map: "idx_patient_locations_patient_time")
  @@index([patientId, leftAt])
  @@index([zoneId])
  @@index([enteredAt])
  @@map("patient_locations")
}

// ── 환자 QR 동선 체크인 (Patient Flow QR Check-in) ──
model LocationStation {
  id         String    @id @default(uuid()) @db.Uuid
  zoneId     String    @map("zone_id") @db.Uuid // SpaceNode
  label      String    @db.VarChar(100)
  deviceType String    @map("device_type") @db.VarChar(20) // PHONE|TABLET|READER
  keyHash    String    @map("key_hash") @db.VarChar(128) // X-Station-Key 의 sha256
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([keyHash])
  @@index([zoneId])
  @@map("location_stations")
}

model PatientLocToken {
  token     String    @id @db.VarChar(64)
  patientId String    @map("patient_id") @db.Uuid
  mode      String    @db.VarChar(10) // DAILY|ADMISSION
  issuedVia String?   @map("issued_via") @db.VarChar(10) // MOBILE|PAPER|CARD
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([patientId])
  @@map("patient_loc_tokens")
}

// ── 무선 AP 기반 원내 위치 (wifi-location.v1 · `docs/01-plan/features/wifi-ap-location.plan.md`) ──
// AP 등록부 — 층 도면 좌표계(m)에 놓인 무선 AP. 교정값이 null 이면 기본 전파 모델로 계산한다(화면이 "교정 안 됨"이라고 말한다)
model WifiAccessPoint {
  id               String    @id @default(uuid()) @db.Uuid
  bssid            String    @unique @db.VarChar(17) // 소문자 aa:bb:cc:dd:ee:ff
  label            String    @db.VarChar(100)
  floorKey         String    @map("floor_key") @db.VarChar(10) // 확정 도면의 층 키(B1·1F…)
  floorLevel       Int       @map("floor_level")
  x                Float
  y                Float
  zoneId           String?   @map("zone_id") @db.Uuid // 놓인 방(SpaceNode) — 표시용
  rssiAt1m         Float?    @map("rssi_at_1m")
  pathLossExponent Float?    @map("path_loss_exponent")
  calibratedAt     DateTime? @map("calibrated_at") @db.Timestamptz()
  vendor           String?   @db.VarChar(40)
  isActive         Boolean   @default(true) @map("is_active")
  // 데이터 출처 — REGISTERED(관리자가 등록) · SEED(데모 배치 · 실제 설치 아님)
  dataOrigin       String    @map("data_origin") @db.VarChar(12)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([floorKey])
  @@map("wifi_access_points")
}

// 수집기 — 무선 컨트롤러·태그 게이트웨이·환자 앱 중계. 키 원문은 발급 때 한 번만 보이고 sha256 만 남긴다
model WifiCollector {
  id          String    @id @default(uuid()) @db.Uuid
  label       String    @db.VarChar(100)
  mode        String    @db.VarChar(10) // NETWORK | DEVICE
  vendor      String?   @db.VarChar(40)
  keyHash     String    @map("key_hash") @db.VarChar(128)
  // 키 교체 시각(2026-10-10) — 교체하면 이전 키는 즉시 무효(해시만 남으므로 이전 키를 되살릴 길이 없다)
  keyRotatedAt DateTime? @map("key_rotated_at") @db.Timestamptz()
  isActive    Boolean   @default(true) @map("is_active")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz()
  // 마지막 배치 결과 {accepted, stored, unbound, rejected} — 수집기가 보내는데 아무것도 안 쌓이는 상태를 화면이 말하게
  lastBatch   Json?     @map("last_batch") @db.JsonB
  dataOrigin  String    @map("data_origin") @db.VarChar(12)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([keyHash])
  @@map("wifi_collectors")
}

// 단말 ↔ 환자 연결 — 동의 근거 필수 · 해제는 지우지 않고 시각·사유 · 단말 원문 없음(sha256)
model WifiDeviceBinding {
  id            String    @id @default(uuid()) @db.Uuid
  deviceHash    String    @map("device_hash") @db.VarChar(64)
  deviceKind    String    @map("device_kind") @db.VarChar(20) // TAG | PATIENT_APP | NETWORK_CLIENT
  // 사람이 알아보는 표식(태그 번호 끝 4자리 등) — 원문 전체를 넣지 않는다
  displayHint   String?   @map("display_hint") @db.VarChar(20)
  patientId     String    @map("patient_id") @db.Uuid
  consentBasis  String    @map("consent_basis") @db.VarChar(20) // WRITTEN | VERBAL_RECORDED | DEMO
  consentNote   String?   @map("consent_note") @db.VarChar(200)
  boundById     String?   @map("bound_by_id") @db.Uuid
  boundAt       DateTime  @default(now()) @map("bound_at") @db.Timestamptz()
  unboundAt     DateTime? @map("unbound_at") @db.Timestamptz()
  unboundById   String?   @map("unbound_by_id") @db.Uuid
  unboundReason String?   @map("unbound_reason") @db.VarChar(200)
  dataOrigin    String    @map("data_origin") @db.VarChar(12)

  @@index([deviceHash, unboundAt])
  @@index([patientId, unboundAt])
  @@map("wifi_device_bindings")
}

// 측위 원장 — 한 번의 관측을 푼 결과(좌표·오차 반경·쓴 AP). 위치 원장(PatientLocation)은 방이 확인될 때만 옮긴다
/// 무선 현장 측정 표본(2026-10-10) — 위치를 아는 지점에서 잰 신호. 신호 지도 측위·AP 교정 제안의 원천. 지우지 않고 무효(사유)
model WifiSurveySample {
  id            String    @id @default(uuid()) @db.Uuid
  floorKey      String    @map("floor_key") @db.VarChar(10)
  floorLevel    Int       @map("floor_level")
  x             Float
  y             Float
  zoneId        String?   @map("zone_id") @db.Uuid // 측정 지점이 든 방(표시용)
  readings      Json      @db.JsonB // [{bssid, rssi}]
  measuredAt    DateTime  @map("measured_at") @db.Timestamptz()
  collectedById String    @map("collected_by_id") @db.Uuid
  note          String?   @db.VarChar(200)
  voidedAt      DateTime? @map("voided_at") @db.Timestamptz()
  voidedById    String?   @map("voided_by_id") @db.Uuid
  voidReason    String?   @map("void_reason") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([floorKey, voidedAt])
  @@map("wifi_survey_samples")
}

model WifiPositionFix {
  id           String   @id @default(uuid()) @db.Uuid
  deviceHash   String   @map("device_hash") @db.VarChar(64)
  patientId    String?  @map("patient_id") @db.Uuid
  bindingId    String?  @map("binding_id") @db.Uuid
  collectorId  String?  @map("collector_id") @db.Uuid
  observedAt   DateTime @map("observed_at") @db.Timestamptz()
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz()
  floorKey     String   @map("floor_key") @db.VarChar(10)
  floorLevel   Int      @map("floor_level")
  x            Float
  y            Float
  accuracyM    Float    @map("accuracy_m")
  apCount      Int      @map("ap_count")
  quality      String   @db.VarChar(8) // POINT | CELL
  floorShare   Float    @map("floor_share")
  uncalibrated Boolean
  zoneId       String?  @map("zone_id") @db.Uuid // null = 층까지만(FLOOR)
  granularity  String   @db.VarChar(10)
  method       String   @db.VarChar(20)
  // 출처 — OBSERVED_WIFI(수집기) · SIMULATED(데모 신호 생성 · 실제 위치 아님)
  source       String   @db.VarChar(20)
  readings     Json     @db.JsonB // 쓴 AP {bssid, rssi, distanceM}
  // 시뮬레이션만 — 신호를 만든 실제 방(엔진 적중률 측정용)
  truthZoneId  String?  @map("truth_zone_id") @db.Uuid
  // 위치 원장으로 옮겼으면 그 행
  locationId   String?  @map("location_id") @db.Uuid

  @@index([patientId, observedAt])
  @@index([deviceHash, observedAt])
  @@index([observedAt])
  @@index([source, observedAt])
  @@map("wifi_position_fixes")
}

// ── CDSS 규칙 ──

model CdssRule {
  id             String   @id @default(uuid()) @db.Uuid
  category       String   @db.VarChar(30)
  level          String   @db.VarChar(10)
  name           String   @db.VarChar(200)
  description    String   @db.Text
  drugA          String?  @map("drug_a") @db.VarChar(100)
  drugB          String?  @map("drug_b") @db.VarChar(100)
  ageMin         Int?     @map("age_min")
  ageMax         Int?     @map("age_max")
  maxDose        String?  @map("max_dose") @db.VarChar(50)
  diagnosisCode  String?  @map("diagnosis_code") @db.VarChar(20)
  recommendation String?  @db.Text
  reference      String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  hitCount       Int      @default(0) @map("hit_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category])
  @@index([drugA])
  @@map("cdss_rules")
}

/// DUR 룰 정본(2026-08-04 거버넌스 P0-a) — 종전 dur.service.ts 하드코딩 5종의 테이블화.
/// 🔴 dur.enforce=BLOCK 으로 실차단 중인 룰이 코드에 있어 약사위가 개정할 수 없던 결함.
/// 판정 로직은 dur.service 유지 — 이 테이블은 룰 데이터만. 타입별 0건이면 하드코딩 폴백(fail-safe).
model DurRule {
  id           String   @id @default(uuid()) @db.Uuid
  ruleType     String   @map("rule_type") @db.VarChar(20) // INTERACTION | AGE | MAX_DOSE | BEERS | PEDIATRIC_DOSE
  severity     String   @default("WARNING") @db.VarChar(10) // ERROR | WARNING
  drugA        String?  @map("drug_a") @db.VarChar(100) // INTERACTION=성분A · 그 외=대상 성분
  drugB        String?  @map("drug_b") @db.VarChar(100) // INTERACTION 전용
  keywords     Json? // BEERS 다중 키워드(영문·한글)
  minAge       Int?     @map("min_age")
  maxAge       Int?     @map("max_age")
  maxDailyDose Float?   @map("max_daily_dose")
  maxPerKgDay  Float?   @map("max_per_kg_day")
  maxAbsolute  Float?   @map("max_absolute")
  unit         String?  @db.VarChar(10)
  message      String   @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  source       String?  @db.VarChar(40) // SEED | 향후 위원회 의결번호(GOV-YYYY-NNN)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([ruleType, isActive])
  @@map("dur_rules")
}

model CdssLog {
  id             String   @id @default(uuid()) @db.Uuid
  encounterId    String   @map("encounter_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  medicationCode String?  @map("medication_code") @db.VarChar(50)
  overallLevel   String   @map("overall_level") @db.VarChar(10)
  totalChecks    Int      @map("total_checks")
  passedChecks   Int      @map("passed_checks")
  alerts         Json     @db.JsonB
  overridden     Boolean  @default(false)
  overrideReason String?  @map("override_reason") @db.Text
  acknowledgerId String?  @map("acknowledger_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([encounterId])
  @@index([patientId])
  @@index([overallLevel])
  @@map("cdss_logs")
}

// 안전 게이트 위반 로그(범용) — 자체 영속이 없는 게이트(재고 만료LOT·장비 사용중지 등)의
// 위반을 기록해 관제 대시보드(WARN→BLOCK 승격 판단)에 공급. best-effort 기록(실패 무해)
model GateViolationLog {
  id        String   @id @default(uuid()) @db.Uuid
  gateKey   String   @map("gate_key") @db.VarChar(60) // config 키(예: inventory.expiryIssueEnforce)
  severity  String   @db.VarChar(10) // WARN | BLOCK(차단 발생) | OFF(게이트 꺼짐 상태에서 통과)
  message   String   @db.Text
  refType   String?  @map("ref_type") @db.VarChar(40) // ITEM/LOT/EQUIPMENT 등
  refId     String?  @map("ref_id") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([gateKey, createdAt])
  @@map("gate_violation_logs")
}

// ── 환자-담당의 메시지 ──
model PatientMessage {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  doctorId  String?  @map("doctor_id") @db.Uuid
  sender    String   @db.VarChar(10) // PATIENT | DOCTOR
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User?   @relation("DoctorMessages", fields: [doctorId], references: [id])

  @@index([patientId, createdAt])
  @@index([doctorId, isRead])
  @@map("patient_messages")
}

// ── 개인 건강 메모 ──
model HealthMemo {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  category  String   @default("GENERAL") @db.VarChar(30) // GENERAL, SYMPTOM, MEDICATION, DIET, EXERCISE
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("health_memos")
}

// ── 만족도 평가 ──
model SatisfactionSurvey {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  encounterId    String?  @map("encounter_id") @db.Uuid
  overallRating  Int // 1-5
  waitRating     Int?     @map("wait_rating") // 1-5
  staffRating    Int?     @map("staff_rating") // 1-5
  facilityRating Int?     @map("facility_rating") // 1-5
  comment        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("satisfaction_surveys")
}

// 만족도 설문 발송(토큰 기반) — 포털/태블릿/SMS 작성
model SurveyDispatch {
  id           String    @id @default(uuid()) @db.Uuid
  token        String    @unique @db.VarChar(40)
  templateId   String    @map("template_id") @db.VarChar(40)
  templateName String    @map("template_name") @db.VarChar(200)
  questions    Json
  patientId    String?   @map("patient_id") @db.Uuid
  patientName  String?   @map("patient_name") @db.VarChar(100)
  department   String?   @db.VarChar(60)
  channel      String    @default("PORTAL") @db.VarChar(12)
  trigger      String    @default("MANUAL") @db.VarChar(16)
  deviceId     String?   @map("device_id") @db.Uuid
  status       String    @default("PENDING") @db.VarChar(12)
  answers      Json?
  npsScore     Int?      @map("nps_score")
  avgScore     Float?    @map("avg_score")
  submittedAt  DateTime? @map("submitted_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([patientId])
  @@index([deviceId])
  @@map("survey_dispatches")
}

