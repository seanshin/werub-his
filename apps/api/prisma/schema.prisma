  status         String    @default("ORDERED") @db.VarChar(20)
  // ORDERED, SAMPLE_RECEIVED, EXTRACTION, LIBRARY_PREP, SEQUENCING, ANALYSIS, INTERPRETATION, REPORTED, COUNSELED
  orderedBy      String    @map("ordered_by") @db.Uuid
