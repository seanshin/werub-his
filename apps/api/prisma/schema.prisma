  tempOk          Boolean  @default(false) @map("temp_ok") // ④ 배식 온도
  deliveredBy     String   @map("delivered_by") @db.Uuid
  deliveredAt     DateTime @default(now()) @map("delivered_at") @db.Timestamptz()

  @@index([mealOrderId])
  @@map("meal_delivery_checks")
}

