  @@index([fhirId], map: "idx_patients_fhir_id")
  @@index([validFrom, validTo], map: "idx_patients_valid_range")
  // 🔴 (2026-10-01 SQL 튜닝) 이름 검색 트라이그램 GIN — 종전엔 수동 SQL 로만 만들어 `db push` 가 스키마 밖이라며 지웠다
  //    (서버 이전 뒤 운영에 10종 중 0종). 스키마에 두어야 배포가 지우지 않는다.
  @@index([familyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_patients_family_trgm")
  @@index([givenName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_patients_given_trgm")
  @@index([mrn(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_patient_mrn_gin")
  @@map("patients")
}

// ============================================================
// Patient History (bi-temporal versioning)
// ============================================================

model PatientHistory {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  data      Json     @db.JsonB
  validFrom DateTime @map("valid_from") @db.Timestamptz()
  validTo   DateTime @map("valid_to") @db.Timestamptz()
  txTime    DateTime @default(now()) @map("tx_time") @db.Timestamptz()
  changedBy String   @map("changed_by") @db.Uuid

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])
  changer User    @relation("HistoryChangedBy", fields: [changedBy], references: [id])

  @@index([patientId], map: "idx_patient_history_patient")
  @@index([validFrom, validTo], map: "idx_patient_history_temporal")
  @@map("patient_history")
}

// ============================================================
// Patient Contact (보호자/비상연락처)
// ============================================================

model PatientContact {
  id                 String   @id @default(uuid()) @db.Uuid
  patientId          String   @map("patient_id") @db.Uuid
  relationship       String   @db.VarChar(30) // PARENT, SPOUSE, CHILD, SIBLING, GUARDIAN, OTHER
  relationshipDetail String?  @map("relationship_detail") @db.VarChar(50) // '어머니', '배우자'
  name               String   @db.VarChar(100)
  phone              String   @db.VarChar(20)
  phone2             String?  @db.VarChar(20)
  isEmergencyContact Boolean  @default(false) @map("is_emergency_contact")
  isLegalGuardian    Boolean  @default(false) @map("is_legal_guardian")
  isPrimaryContact   Boolean  @default(false) @map("is_primary_contact")
  priority           Int      @default(1)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_contacts")
}

// ============================================================
// Patient Relation (가족 관계)
// ============================================================

/// 구조화 가족력 (G4-2) — 관계·질환(KCD 연결)·발병연령·생존. 자유텍스트 familyHistory 병행.
model FamilyHistory {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  relation        String   @db.VarChar(20) // FATHER|MOTHER|SIBLING|GRANDFATHER|GRANDMOTHER|CHILD|OTHER
  diagnosisCodeId String?  @map("diagnosis_code_id") @db.Uuid // KCD 연결(선택)
  conditionName   String   @map("condition_name") @db.VarChar(200) // 질환명(자유입력 병행)
  onsetAge        Int?     @map("onset_age") // 발병 연령
  isDeceased      Boolean  @default(false) @map("is_deceased")
  note            String?  @db.Text
  recordedBy      String?  @map("recorded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient       Patient        @relation("PatientFamilyHistory", fields: [patientId], references: [id], onDelete: Cascade)
  diagnosisCode DiagnosisCode? @relation(fields: [diagnosisCodeId], references: [id])

  @@index([patientId])
  @@map("family_histories")
}

model PatientRelation {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  relatedId    String   @map("related_id") @db.Uuid
  relationship String   @db.VarChar(30) // PARENT, CHILD, SPOUSE, SIBLING
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation("PatientRelations", fields: [patientId], references: [id])
  related Patient @relation("RelatedPatients", fields: [relatedId], references: [id])

  @@unique([patientId, relatedId])
  @@index([patientId])
  @@index([relatedId])
  @@map("patient_relations")
}

// ============================================================
// Appointments (예약)
// ============================================================

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  doctorId    String            @map("doctor_id") @db.Uuid
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz()
  duration    Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  type        AppointmentType   @default(INITIAL)
  reason      String?           @db.Text
  notes       String?           @db.Text

  // 예약 보완(P0+) — 과/슬롯/확정/자동화 메타
  departmentName    String?   @map("department_name") @db.VarChar(100)
  roomName          String?   @map("room_name") @db.VarChar(100)
  slotPeriod        String?   @map("slot_period") @db.VarChar(10)
  bookedVia         String?   @map("booked_via") @db.VarChar(20) // STAFF/PORTAL/AI
  priority          Int?      @default(0)
  noShowAt          DateTime? @map("no_show_at") @db.Timestamptz()
  rescheduledFromId String?   @map("rescheduled_from_id") @db.Uuid
  recurringGroupId  String?   @map("recurring_group_id") @db.Uuid
  reminderSentAt    DateTime? @map("reminder_sent_at") @db.Timestamptz()
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz()
  confirmedBy       String?   @map("confirmed_by") @db.Uuid

  // Audit
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy    String?   @map("created_by") @db.Uuid // 포털 셀프예약은 스태프 생성자 없음(null)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason") @db.Text

  // Relations
  patient   Patient    @relation(fields: [patientId], references: [id])
  doctor    User       @relation("DoctorAppointments", fields: [doctorId], references: [id])
  preOrders PreOrder[] // 이 예약에서 시행 예정인 사전처방
  creator   User?      @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])
  canceller User?      @relation("AppointmentCancelledBy", fields: [cancelledBy], references: [id])
  encounter Encounter?

  @@index([patientId], map: "idx_appointments_patient")
  @@index([doctorId], map: "idx_appointments_doctor")
  @@index([scheduledAt], map: "idx_appointments_scheduled")
  @@index([status], map: "idx_appointments_status")
  @@index([doctorId, scheduledAt], map: "idx_appointments_doctor_schedule")
  @@index([recurringGroupId], map: "idx_appointments_recurring")
  @@map("appointments")
}

/// 예약 대기자명단(§G6) — 만석 시 등록, 취소 발생 시 안내
model AppointmentWaitlist {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  doctorId       String?   @map("doctor_id") @db.Uuid
  departmentName String    @map("department_name") @db.VarChar(100)
  preferredFrom  DateTime? @map("preferred_from") @db.Timestamptz()
  preferredTo    DateTime? @map("preferred_to") @db.Timestamptz()
  status         String    @default("WAITING") @db.VarChar(20) // WAITING/OFFERED/BOOKED/EXPIRED/CANCELLED
  notifiedAt     DateTime? @map("notified_at") @db.Timestamptz()
  note           String?   @db.Text
  createdBy      String?   @map("created_by") @db.Uuid // 스태프 등록 시(포털은 null)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([doctorId, status])
  @@index([departmentName, status])
  @@index([patientId])
  @@map("appointment_waitlists")
}

// ============================================================
// Audit Logs (감사 로그 — append-only)
