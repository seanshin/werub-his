}

model PacuRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  surgeryId           String    @map("surgery_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  arrivalTime         DateTime  @map("arrival_time") @db.Timestamptz()
  dischargeTime       DateTime? @map("discharge_time") @db.Timestamptz()
  aldretScore         Int?      @map("aldrete_score")
  aldreteDetail       Json?     @map("aldrete_detail") @db.JsonB // 6항목 세부점수(활동·호흡·순환·의식·SpO2·통증)
  painScore           Int?      @map("pain_score")
  ponvScore           Int?      @map("ponv_score") // 수술후 오심·구토 0 없음·1 오심·2 구역질·3 구토
  ponvManagement      String?   @map("ponv_management") @db.VarChar(200) // PONV 중재(약물·조치)
  padssScore          Int?      @map("padss_score") // 귀가 척도 0~10(HOME 퇴실 기준 ≥9)
  padssDetail         Json?     @map("padss_detail") @db.JsonB // 5항목 각 0~2(활력·보행·오심구토·통증·수술부위출혈)
  /// 평가 시각·평가자(2026-09-30) — 종전엔 점수만 덮어써 누가 언제 잰 점수인지 알 수 없었다(게이트가 2시간 전 점수로도 통과). 이전 기록은 null
  aldreteAssessedAt   DateTime? @map("aldrete_assessed_at") @db.Timestamptz()
  aldreteAssessedById String?   @map("aldrete_assessed_by_id") @db.Uuid
  padssAssessedAt     DateTime? @map("padss_assessed_at") @db.Timestamptz()
  padssAssessedById   String?   @map("padss_assessed_by_id") @db.Uuid
  ponvAssessedAt      DateTime? @map("ponv_assessed_at") @db.Timestamptz()
  ponvAssessedById    String?   @map("ponv_assessed_by_id") @db.Uuid
  /// 퇴실 목적지(2026-09-30) — 퇴실과 같은 트랜잭션에서 실제로 한 일: 원 병상 복귀·병상 이동·ICU 입실(기존/신규)·귀가.
  /// { kind, action, admissionId?, bedId?, wardName?, icuAdmissionId?, icuBedId? } · 종전 퇴실은 null(무엇이 일어났는지 기록 없음)
  destination         Json?     @db.JsonB
  arrivalHandoff      Json?     @map("arrival_handoff") @db.JsonB // 수술실→PACU 인수인계(SBAR)
  dischargeHandoff    Json?     @map("discharge_handoff") @db.JsonB // PACU→병동/ICU/귀가 인수인계(SBAR)
  complications       Json?     @db.JsonB // 구조화 합병증 이벤트 배열 [{type,severity,intervention,note,time}]
  painAssessments     Json?     @map("pain_assessments") @db.JsonB // 통증 재평가 추이 배열 [{score,scale,intervention,time}]
  oxygenTherapy       String?   @map("oxygen_therapy") @db.VarChar(50)
  vitalSigns          Json?     @map("vital_signs") @db.JsonB
  interventions       Json?     @db.JsonB
  nurseId             String    @map("nurse_id") @db.Uuid
  disposition         String?   @db.VarChar(30)
  dischargedById      String?   @map("discharged_by_id") @db.Uuid // 퇴실 처리자(마취과/간호)
  dischargeOverride   String?   @map("discharge_override") @db.Text // Aldrete<9 강제 퇴실 사유
  notes               String?   @db.Text
  /// 회복실 상세화(2026-10-07) — 점수는 덮어쓰기만 해 입실·중간·퇴실 추이가 남지 않았다. 덧붙이기 원장 [{kind: ALDRETE|PADSS|PONV, score, detail?, phase: ADMIT|INTERVAL|DISCHARGE, at, by}]
  scoreHistory        Json?     @map("score_history") @db.JsonB
  /// 회복실 섭취·배설(덧붙이기) [{kind: IN|OUT, route, ml, note?, at, by}] — 종전엔 중재 FLUID 자유 글뿐
  ioEntries           Json?     @map("io_entries") @db.JsonB
  /// 회복실 간호기록(덧붙이기) [{text, at, by}] — 종전엔 입실 때 notes 한 번뿐
  nursingNotes        Json?     @map("nursing_notes") @db.JsonB
  /// 마취과 퇴실 확인(서명) — 의사만 · 한 번(덮어쓰지 않음) · 필수 여부는 결정 등록부(사람 결정)
  anesthesiaSignOffAt   DateTime? @map("anesthesia_sign_off_at") @db.Timestamptz()
  anesthesiaSignOffById String?   @map("anesthesia_sign_off_by_id") @db.Uuid
  /// 퇴실 지연 사유(shared PACU_DELAY_REASONS 어휘) · 메모 — 종전엔 강제 퇴실 사유만 있었다
  delayReason         String?   @map("delay_reason") @db.VarChar(30)
  delayNote           String?   @map("delay_note") @db.VarChar(300)
  /// 회복실 자리(베이) — 자유 표기(원내 배치) · 미지정 null
  bayCode             String?   @map("bay_code") @db.VarChar(10)
  patient             Patient   @relation(fields: [patientId], references: [id])
  nurse               User      @relation("PacuNurse", fields: [nurseId], references: [id])

  @@index([surgeryId])
  @@index([patientId])
  @@index([dischargeTime])
  @@index([arrivalTime])
  @@map("pacu_records")
}

model SurgicalChecklist {
  id                       String    @id @default(uuid()) @db.Uuid
  surgeryId                String    @unique @map("surgery_id") @db.Uuid
  signInPatientId          Boolean?  @map("sign_in_patient_id")
