// ── 혈액은행 ──

model BloodProduct {
  id              String             @id @default(uuid()) @db.Uuid
  unitNumber      String             @unique @map("unit_number") @db.VarChar(30)
  productType     String             @map("product_type") @db.VarChar(30)
  bloodType       String             @map("blood_type") @db.VarChar(5)
  rhFactor        String             @map("rh_factor") @db.VarChar(3)
  volume          Int
  collectedAt     DateTime           @map("collected_at") @db.Timestamptz()
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz()
  donorId         String?            @map("donor_id") @db.VarChar(30)
  supplierName    String?            @map("supplier_name") @db.VarChar(100)
  receivedAt      DateTime           @map("received_at") @db.Timestamptz()
  status          String             @default("AVAILABLE") @db.VarChar(20)
  storageLocation String?            @map("storage_location") @db.VarChar(50)
  notes           String?            @db.Text
  irradiated      Boolean            @default(false) // 방사선조사(GVHD 예방)
  leukoreduced    Boolean            @default(false) // 백혈구제거
  cmvNegative     Boolean            @default(false) @map("cmv_negative") // CMV 음성
  washed          Boolean            @default(false) // 세척(IgA결핍 등)
  discardReason   String?            @map("discard_reason") @db.VarChar(200) // 폐기/반납 사유
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  crossmatches    BloodCrossmatch[]
  transfusions    BloodTransfusion[]

  @@index([productType, bloodType, status])
  @@index([expiresAt])
  @@map("blood_products")
}

model BloodCrossmatch {
  id             String       @id @default(uuid()) @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  bloodProductId String       @map("blood_product_id") @db.Uuid
  requestedBy    String       @map("requested_by") @db.Uuid
  requestedAt    DateTime     @default(now()) @map("requested_at") @db.Timestamptz()
  testedBy       String?      @map("tested_by") @db.Uuid
  testedAt       DateTime?    @map("tested_at") @db.Timestamptz()
  method         String?      @db.VarChar(30)
  result         String?      @db.VarChar(20)
  antibodyScreen String?      @map("antibody_screen") @db.VarChar(20)
  validUntil     DateTime?    @map("valid_until") @db.Timestamptz()
  notes          String?      @db.Text
  patient        Patient      @relation(fields: [patientId], references: [id])
  bloodProduct   BloodProduct @relation(fields: [bloodProductId], references: [id])
  requester      User         @relation("CrossmatchRequester", fields: [requestedBy], references: [id])

  @@map("blood_crossmatches")
}

model TransfusionOrder {
  id               String             @id @default(uuid()) @db.Uuid
  patientId        String             @map("patient_id") @db.Uuid
  orderedBy        String             @map("ordered_by") @db.Uuid
  productType      String             @map("product_type") @db.VarChar(30)
  units            Int
  urgency          String             @default("ROUTINE") @db.VarChar(20)
  indication       String?            @db.Text
  specialReqs      Json?              @map("special_reqs") @db.JsonB
  preTransfusionHb Decimal?           @map("pre_transfusion_hb") @db.Decimal(4, 1)
  consentId        String?            @map("consent_id") @db.Uuid // 수혈 동의서 연계(선택)
  status           String             @default("ORDERED") @db.VarChar(20)
  orderedAt        DateTime           @default(now()) @map("ordered_at") @db.Timestamptz()
  patient          Patient            @relation(fields: [patientId], references: [id])
  orderer          User               @relation("TransfusionOrderer", fields: [orderedBy], references: [id])
  transfusions     BloodTransfusion[]

  @@index([patientId])
  @@map("transfusion_orders")
}

model BloodTransfusion {
  id               String           @id @default(uuid()) @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  bloodProductId   String           @map("blood_product_id") @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  verifiedByNurse1 String?          @map("verified_by_nurse1") @db.Uuid
  verifiedByNurse2 String?          @map("verified_by_nurse2") @db.Uuid
  verificationTime DateTime?        @map("verification_time") @db.Timestamptz()
  // bedside 바코드 대조(2026-07 R2) — 환자 손목밴드(MRN)·혈액백(unitNumber) 스캔 원본값 보존
  patientBandScan  String?          @map("patient_band_scan") @db.VarChar(40)
  bloodUnitScan    String?          @map("blood_unit_scan") @db.VarChar(40)
  bedsideScanAt    DateTime?        @map("bedside_scan_at") @db.Timestamptz()
  startTime        DateTime?        @map("start_time") @db.Timestamptz()
  endTime          DateTime?        @map("end_time") @db.Timestamptz()
  rate             Int?
  volumeTransfused Int?             @map("volume_transfused")
  vitalSigns       Json?            @map("vital_signs") @db.JsonB
  reactionOccurred Boolean          @default(false) @map("reaction_occurred")
  reactionType     String?          @map("reaction_type") @db.VarChar(50)
  reactionSeverity String?          @map("reaction_severity") @db.VarChar(20)
  reactionAction   String?          @map("reaction_action") @db.Text
  emergencyRelease Boolean          @default(false) @map("emergency_release") // 긴급 비교차 출고
  emergencyReason  String?          @map("emergency_reason") @db.VarChar(300)
  status           String           @default("PENDING") @db.VarChar(20)
  notes            String?          @db.Text
  order            TransfusionOrder @relation(fields: [orderId], references: [id])
  bloodProduct     BloodProduct     @relation(fields: [bloodProductId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([orderId])
  @@map("blood_transfusions")
}

