  patientId      String    @map("patient_id") @db.Uuid
  diagnosis      String    @db.VarChar(200)
  diagnosisCode  String?   @map("diagnosis_code") @db.VarChar(20)
  intent         String    @db.VarChar(20)
  technique      String    @db.VarChar(30)
  site           String    @db.VarChar(100)
  totalDose      Decimal   @map("total_dose") @db.Decimal(6, 2)
  fractionDose   Decimal   @map("fraction_dose") @db.Decimal(5, 2)
  totalFractions Int       @map("total_fractions")
