  altAllele      String?  @map("alt_allele") @db.VarChar(500)
  variantType    String   @map("variant_type") @db.VarChar(30) // SNV, INDEL, CNV, FUSION
  zygosity       String?  @db.VarChar(20)
  classification String   @db.VarChar(30) // PATHOGENIC, LIKELY_PATHOGENIC, VUS, LIKELY_BENIGN, BENIGN
  alleleFreq     Decimal? @map("allele_freq") @db.Decimal(6, 4)
  clinicalSig    String?  @map("clinical_sig") @db.Text
  actionability  String?  @db.VarChar(20) // TIER_1, TIER_2, TIER_3, TIER_4
