  passwordHash      String    @map("password_hash") @db.VarChar(255)
  previousPasswords Json?     @map("previous_passwords") @db.JsonB
  pinHash           String?   @map("pin_hash") @db.VarChar(255)
  biometricEnabled  Boolean   @default(false) @map("biometric_enabled")
  email             String?   @db.VarChar(255)
  emailVerified     Boolean   @default(false) @map("email_verified")
  status            String    @default("ACTIVE") @db.VarChar(20)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz()
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz()
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz()
  lastLoginIp       String?   @map("last_login_ip") @db.VarChar(50)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  /// 포털 첫 안내(온보딩)를 마친 시각 — 계정 단위(2026-10-20 · 종전엔 기기 localStorage 라 기기·브라우저마다 다시 떴다). null = 아직
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz()

  patient       Patient               @relation(fields: [patientId], references: [id])
  devices       PatientDevice[]
  appKeys       AppInstallationKey[]  @relation("PatientAccountAppKeys")
  consents      PatientConsent[]
  guardianOf    PatientGuardian[]     @relation("GuardianOf")
  dependentOf   PatientGuardian[]     @relation("DependentOf")
  notifications PatientNotification[]
  notifSettings NotificationSetting[]

  @@map("patient_accounts")
}

