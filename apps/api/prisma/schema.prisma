model QualityIndicator {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique @db.VarChar(200)
  category     String          @db.VarChar(100)
  formula      String          @db.Text
  targetValue  Decimal         @map("target_value") @db.Decimal(5, 2)
  // 🔴 지표 방향·단위·스케일이 컬럼에 없어 코드 등재표(indicator-policy)에만 있었다 —
  //    관리자가 화면에서 새 지표를 만들면 방향 미등재로 **측정 입력이 422 로 막혔다**(2026-08-18).
  //    정본 리터럴은 `HIGHER_IS_BETTER` | `LOWER_IS_BETTER`(indicator-policy 가 쓰기 시 정규화한다).
  //    null = 미등재 — 판정 불가로 다루고 지어내지 않는다
  direction    String?         @db.VarChar(20)
  unit         String?         @db.VarChar(20) // 표시 단위(%·건·/1000재원일)
  valueScale   Int?            @map("value_scale") // 비율에 곱할 배수(백분율 100·천분율 1000·건수 1)
  isActive     Boolean         @default(true) @map("is_active")
  // ── QI 흐름(2026-10-08) — 담당·위원회·자동 산출 공급원(indicator-suppliers.ts 키 · 없으면 수기 지표)
  ownerId       String?         @map("owner_id") @db.Uuid
  committeeCode String?         @map("committee_code") @db.VarChar(20)
  supplierKey   String?         @map("supplier_key") @db.VarChar(60)
  measurements QiMeasurement[]

  @@map("quality_indicators")
}

model QiMeasurement {
  id          String   @id @default(uuid()) @db.Uuid
  indicatorId String   @map("indicator_id") @db.Uuid
  period      String   @db.VarChar(20)
  numerator   Int
  denominator Int
  value       Decimal  @db.Decimal(5, 2)
  // 🔴 nullable — 방향을 모르면 '판정 불가'다. 종전엔 저장 자체가 불가능해 억지 판정을 강요했다
  meetTarget  Boolean? @map("meet_target")
  notes       String?  @db.Text
  measuredAt  DateTime @map("measured_at") @db.Timestamptz()

  // 🔴 잘못 넣은 측정을 **지우지 않고 무효화**한다 — QI 는 인증·대외 보고의 근거가 되므로
  //    "무엇이 있었는지"가 남아야 한다(하드 삭제는 그 사실을 없앤다).
  //    무효 처리된 행은 조회·집계에서 빠지되 이력으로는 남는다.
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason") @db.Text

  // ── QI 흐름(2026-10-08) — 이 행이 **어떻게 만들어졌는가**(사실 기록). 기존 행은 미상(null) — 소급해 채우지 않는다
  source     String? @db.VarChar(12) // MANUAL · AUTO · CPOE · SEED · EXTERNAL
  computedBy String? @map("computed_by") @db.VarChar(80) // 자동 산출 공급원 키·버전
  evidence   Json?   @db.JsonB // 자동 산출 근거(분자·분모 원장·기간·층)
  createdBy  String? @map("created_by") @db.Uuid
  // 층(병원 전체 = '') — 병동·진료과별 측정
  stratumKey String  @default("") @map("stratum_key") @db.VarChar(80)
  // 유일성 칸 — 수기(MANUAL·출처 미상·SEED·EXTERNAL)는 'MANUAL', 자동(AUTO·CPOE)은 'AUTO'. 같은 달 수기·자동이 **나란히** 있을 수 있다
  // (어느 쪽이 맞는지 시스템이 정하지 않는다 · 결정 qi.autoManual.precedence)
  sourceKey  String  @default("MANUAL") @map("source_key") @db.VarChar(12)
  indicator QualityIndicator @relation(fields: [indicatorId], references: [id])

  // 🔴 지표×기간은 하나다 — 종전엔 같은 기간을 다시 넣으면 **별도 행**으로 쌓여
  //    어느 것이 맞는지 화면·집계가 알 수 없었다(운영 실측 300건 중 중복 0 — 제약 추가 안전).
  @@unique([indicatorId, period, stratumKey, sourceKey])
  @@index([indicatorId])
  @@map("qi_measurements")
}

enum ConsentType {
  SURGERY
  PROCEDURE
  ANESTHESIA
  RESEARCH
  TRANSFUSION
  DNR
  TREATMENT
  GENERAL
  RECORDING // 진료 녹음·AI 문서화(앰비언트 스크라이브) 전용 별도 동의
}

enum ConsentStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

model ConsentForm {
  // 기존 필드 유지
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  type         String    @db.VarChar(50)
  templateName String    @map("template_name") @db.VarChar(200)
  content      Json      @db.JsonB
  signedBy     String?   @map("signed_by") @db.VarChar(100)
  signedAt     DateTime? @map("signed_at") @db.Timestamptz()
  witnessId    String?   @map("witness_id") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz()
  isValid      Boolean   @default(true) @map("is_valid")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // EMR-03 확장 필드 (모두 nullable)
  templateId       String?        @map("template_id") @db.Uuid
  consentType      ConsentType?   @map("consent_type")
  encounterId      String?        @map("encounter_id") @db.Uuid
  surgeryId        String?        @map("surgery_id") @db.Uuid
  risks            String?        @db.Text
  alternatives     String?        @db.Text
  patientSignature String?        @map("patient_signature") @db.Text
  attachments      Json?          @db.JsonB // 첨부파일 [{url,fileName,mimeType,size,uploadedBy,uploadedAt}] — 인쇄 시 별첨 표시
  patientSignedAt  DateTime?      @map("patient_signed_at") @db.Timestamptz()
  patientSignedBy  String?        @map("patient_signed_by") @db.VarChar(100)
  witnessSignedAt  DateTime?      @map("witness_signed_at") @db.Timestamptz()
  doctorId         String?        @map("doctor_id") @db.Uuid
  doctorSignedAt   DateTime?      @map("doctor_signed_at") @db.Timestamptz()
  status           ConsentStatus? @default(PENDING)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz()
  revokedReason    String?        @map("revoked_reason") @db.Text
  // C-2 동의서 개정(재동의) — sign request.superseded 수신 시 현행 아님 표시(원본 서명/감사 보존)
  supersededBy     String?        @map("superseded_by") @db.VarChar(80) // 새 버전 signatureRequestId
  supersededAt     DateTime?      @map("superseded_at") @db.Timestamptz()

  // 동의서 워크스테이션 확장 (모두 nullable, additive)
  requestedBy           String?   @map("requested_by") @db.Uuid // 요청 직원
  nurseId               String?   @map("nurse_id") @db.Uuid // 담당 간호사
  nurseCheckedAt        DateTime? @map("nurse_checked_at") @db.Timestamptz() // 간호사 사전 확인
  nurseCheckedBy        String?   @map("nurse_checked_by") @db.Uuid
  doctorSignatureImage  String?   @map("doctor_signature_image") @db.Text // 의사 서명 이미지
  nurseSignatureImage   String?   @map("nurse_signature_image") @db.Text // 간호사 서명 이미지
  witnessSignatureImage String?   @map("witness_signature_image") @db.Text // 증인 서명 이미지
  explanation           String?   @db.Text // 구두 설명 요지
  signMode              String?   @map("sign_mode") @db.VarChar(20) // TABLET, PC, PORTAL, PAPER
  signerType            String?   @map("signer_type") @db.VarChar(20) // PATIENT, GUARDIAN
  guardianName          String?   @map("guardian_name") @db.VarChar(100)
  guardianRelation      String?   @map("guardian_relation") @db.VarChar(30)
  guardianLegalBasis    String?   @map("guardian_legal_basis") @db.VarChar(50)

  // 외부 서명서비스(sign) 연동 P0 — additive·비파괴. signProvider 토글(SIMULATION=현행 내부서명/EXTERNAL=sign).
  // ※ sign팀 명세의 "signMode"는 위 기존 signMode(서명기기)와 충돌해 signProvider로 명명.
  signProvider       String? @default("EXTERNAL") @map("sign_provider") @db.VarChar(20) // SIMULATION|EXTERNAL — sign 단독 전환(2026-06-15·기록용·소비 분기 없음)
  signatureRequestId String? @map("signature_request_id") @db.VarChar(64) // sign 서비스 서명요청 ID
  signStatus         String? @map("sign_status") @db.VarChar(24) // sign 서비스 서명상태(PENDING/SIGNED/...)
  signParticipantId  String? @map("sign_participant_id") @db.VarChar(64)
  signCertSerial     String? @map("sign_cert_serial") @db.VarChar(64) // 서명 인증서 일련번호
  auditCertUri       String? @map("audit_cert_uri") @db.Text // 감사 인증서(PAdES/TSA) URI
  // HSM 기획 Phase 4 — sign 서명 키 수탁 attestation(webhook additive 수신·기록). 미수신 시 null(폴백).
  signKeyCustody     String? @map("sign_key_custody") @db.VarChar(20) // SOFTWARE|HSM (sign 회신·서명키 수탁출처)
  signAssuranceLevel String? @map("sign_assurance_level") @db.VarChar(20) // 봉인 보증수준(HSM_ANCHORED 등) — 봉인 판정 권위 필드(keyCustody 아님)
  signAttestationRef String? @map("sign_attestation_ref") @db.VarChar(500) // sign 서명 키 attestation 참조
  signTsaToken       String? @map("sign_tsa_token") @db.Text // RFC3161 타임스탬프 토큰(LTV 증거)

  patient      Patient              @relation(fields: [patientId], references: [id])
  template     ConsentTemplate?     @relation(fields: [templateId], references: [id])
  encounter    Encounter?           @relation(fields: [encounterId], references: [id])
  surgery      Surgery?             @relation(fields: [surgeryId], references: [id])
  doctor       User?                @relation("ConsentDoctor", fields: [doctorId], references: [id])
  signSessions ConsentSignSession[]

  @@index([patientId])
  @@index([status, createdAt])
  @@map("consent_forms")
}

// 동의서 대면 서명 세션 (태블릿/PC 핸드오프) — 1회용 토큰
model ConsentSignSession {
  id         String    @id @default(uuid()) @db.Uuid
  consentId  String    @map("consent_id") @db.Uuid
  token      String    @unique @db.VarChar(64)
  signMode   String    @db.VarChar(20) // TABLET, PC
  signerType String    @db.VarChar(20) // PATIENT, GUARDIAN
  status     String    @default("OPEN") @db.VarChar(20) // OPEN, SIGNED, EXPIRED, CANCELLED
  createdBy  String    @map("created_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  signedAt   DateTime? @map("signed_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  consent ConsentForm @relation(fields: [consentId], references: [id])

  @@index([token])
  @@index([consentId, status])
  @@map("consent_sign_sessions")
}

// 동의서 서명 기기 (태블릿 상주·페어링) — consent-signing-device 기획
model ConsentSigningDevice {
  id               String    @id @default(uuid()) @db.Uuid
  deviceUid        String    @unique @map("device_uid") @db.VarChar(64) // 태블릿 자가 생성(localStorage)
  deviceSecret     String?   @map("device_secret") @db.VarChar(64) // enroll 시 발급, 공개 호출 인증
  name             String    @db.VarChar(100)
  location         String?   @db.VarChar(100)
  approvalStatus   String    @default("PENDING") @map("approval_status") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz()
  status           String    @default("IDLE") @db.VarChar(20) // IDLE, DISPATCHED, SIGNING
  currentConsentId String?   @map("current_consent_id") @db.Uuid
  currentToken     String?   @map("current_token") @db.VarChar(64)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz()
  userAgent        String?   @map("user_agent") @db.VarChar(300)
