  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([deviceUid])
  @@index([approvalStatus])
  @@index([status])
  @@map("consent_signing_devices")
}

// 기기 등록용 페어링 인증코드 (관리자 발급, QR 포함, 1회용 단기)
