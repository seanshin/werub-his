}

model DialysisMachine {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(50)
  model            String?   @db.VarChar(100)
  serialNumber     String?   @map("serial_number") @db.VarChar(50)
  machineType      String    @map("machine_type") @db.VarChar(20)
  location         String?   @db.VarChar(50)
  status           String    @default("AVAILABLE") @db.VarChar(20)
  lastDisinfection DateTime? @map("last_disinfection") @db.Timestamptz()
  isActive         Boolean   @default(true) @map("is_active")

  sessions DialysisSession[]

  @@map("dialysis_machines")
}

// ── 호스피스/완화의료 ──

model HospiceRegistration {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  admissionId      String?   @map("admission_id") @db.Uuid
  registeredBy     String    @map("registered_by") @db.Uuid
  registeredAt     DateTime  @map("registered_at") @db.Timestamptz()
  ppsScore         Int       @map("pps_score") // Palliative Performance Scale (0-100)
  primaryDiagnosis String    @map("primary_diagnosis") @db.VarChar(200)
  prognosis        String?   @db.VarChar(50) // DAYS, WEEKS, MONTHS
  hospiceType      String    @map("hospice_type") @db.VarChar(20) // INPATIENT, HOME, CONSULTATION
  goals            String?   @db.Text // 돌봄 목표
  dnrStatus        Boolean   @default(false) @map("dnr_status")
  status           String    @default("ACTIVE") @db.VarChar(15) // ACTIVE, DISCHARGED, DECEASED
  dischargedAt     DateTime? @map("discharged_at") @db.Timestamptz()
  deceasedAt       DateTime? @map("deceased_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient     Patient                    @relation(fields: [patientId], references: [id])
  registrar   User                       @relation("HospiceRegistrar", fields: [registeredBy], references: [id])
  assessments HospiceSymptomAssessment[]
  conferences HospiceCareConference[]

  @@index([patientId])
  @@index([status])
  @@map("hospice_registrations")
}

model HospiceSymptomAssessment {
  id                String   @id @default(uuid()) @db.Uuid
  registrationId    String   @map("registration_id") @db.Uuid
  assessorId        String   @map("assessor_id") @db.Uuid
  // ESAS (Edmonton Symptom Assessment Scale) — 0~10
  pain              Int      @default(0)
  tiredness         Int      @default(0)
  nausea            Int      @default(0)
  depression        Int      @default(0)
  anxiety           Int      @default(0)
  drowsiness        Int      @default(0)
  appetite          Int      @default(0) // 0=좋음, 10=최악
  wellbeing         Int      @default(0)
  shortnessOfBreath Int      @default(0) @map("shortness_of_breath")
  // 추가
  otherSymptom      String?  @map("other_symptom") @db.VarChar(100)
  otherScore        Int?     @map("other_score")
  totalScore        Int      @map("total_score") // 자동 합산
  // 통증 관리
  painType          String?  @map("pain_type") @db.VarChar(30) // NOCICEPTIVE, NEUROPATHIC, MIXED
  whoStep           Int?     @map("who_step") // WHO 3단계 (1/2/3)
  painMedication    String?  @map("pain_medication") @db.VarChar(200)
  //
  notes             String?  @db.Text
  assessedAt        DateTime @map("assessed_at") @db.Timestamptz()
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  registration HospiceRegistration @relation(fields: [registrationId], references: [id])
  assessor     User                @relation("HospiceAssessor", fields: [assessorId], references: [id])

  @@index([registrationId, assessedAt])
  @@map("hospice_symptom_assessments")
}

model AdvanceDirective {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  documentType         String    @map("document_type") @db.VarChar(20) // AD (사전의향서), POLST (연명의료계획서)
  // 연명의료 결정
  cprDecision          String?   @map("cpr_decision") @db.VarChar(10) // DO, DNR
  ventilatorDecision   String?   @map("ventilator_decision") @db.VarChar(10)
  dialysisDecision     String?   @map("dialysis_decision") @db.VarChar(10)
  transfusionDecision  String?   @map("transfusion_decision") @db.VarChar(10)
  chemotherapyDecision String?   @map("chemotherapy_decision") @db.VarChar(10)
  // 호스피스
  hospiceConsent       Boolean?  @map("hospice_consent")
  organDonation        Boolean?  @map("organ_donation")
  // 서명
  patientSignedAt      DateTime? @map("patient_signed_at") @db.Timestamptz()
  familySignedAt       DateTime? @map("family_signed_at") @db.Timestamptz()
  doctorSignedAt       DateTime? @map("doctor_signed_at") @db.Timestamptz()
  doctorId             String?   @map("doctor_id") @db.Uuid
  // 등록
  registeredAt         DateTime  @map("registered_at") @db.Timestamptz()
  status               String    @default("ACTIVE") @db.VarChar(15) // ACTIVE, REVOKED
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz()
  // 철회 — 누가 기록했고 왜(2026-10-10 신설 · 그 전에 철회된 행은 null = 모름)
  revokedById          String?   @map("revoked_by") @db.Uuid
  revokeReason         String?   @map("revoke_reason") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient   Patient @relation(fields: [patientId], references: [id])
  revokedBy User?   @relation("AdvanceDirectiveRevoker", fields: [revokedById], references: [id])

  @@index([patientId])
  @@map("advance_directives")
}

model HospiceCareConference {
  id                 String    @id @default(uuid()) @db.Uuid
  registrationId     String    @map("registration_id") @db.Uuid
  facilitatorId      String    @map("facilitator_id") @db.Uuid
  conferenceDate     DateTime  @map("conference_date") @db.Timestamptz()
  conferenceType     String    @map("conference_type") @db.VarChar(20) // INITIAL, REGULAR, FAMILY, EMERGENCY
  attendees          Json      @db.JsonB // [{role, name}]
  // 회의 내용
  currentStatus      String?   @map("current_status") @db.Text
  careGoals          String?   @map("care_goals") @db.Text
  painManagement     String?   @map("pain_management") @db.Text
  psychosocial       String?   @db.Text
  spiritual          String?   @db.Text
  familyConcerns     String?   @map("family_concerns") @db.Text
  actionItems        Json?     @map("action_items") @db.JsonB // [{action, responsible, deadline}]
  nextConferenceDate DateTime? @map("next_conference_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  registration HospiceRegistration @relation(fields: [registrationId], references: [id])
  facilitator  User                @relation("HospiceConferenceFacilitator", fields: [facilitatorId], references: [id])

  @@index([registrationId])
  @@map("hospice_care_conferences")
}

// ── 장기이식 ──

model TransplantWaitlist {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  organType    String    @map("organ_type") @db.VarChar(30) // KIDNEY, LIVER, HEART, LUNG, PANCREAS, CORNEA
  bloodType    String    @map("blood_type") @db.VarChar(5) // A, B, O, AB
  urgency      String    @default("ROUTINE") @db.VarChar(15) // EMERGENCY, URGENT, ROUTINE
  hlaTyping    Json?     @map("hla_typing") @db.JsonB // {A, B, DR, DQ 등}
  pra          Int? // Panel Reactive Antibody (%)
  registeredAt DateTime  @map("registered_at") @db.Timestamptz()
  konosId      String?   @map("konos_id") @db.VarChar(30) // 장기이식관리센터 등록번호
  status       String    @default("WAITING") @db.VarChar(15) // WAITING, MATCHED, TRANSPLANTED, REMOVED
  matchedAt    DateTime? @map("matched_at") @db.Timestamptz()
  removedAt    DateTime? @map("removed_at") @db.Timestamptz()
  removeReason String?   @map("remove_reason") @db.VarChar(100)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient           @relation(fields: [patientId], references: [id])
  transplant TransplantRecord? @relation("WaitlistTransplant")

  @@index([patientId])
  @@index([organType, status])
  @@map("transplant_waitlists")
}

model TransplantDonor {
  id               String    @id @default(uuid()) @db.Uuid
  donorType        String    @map("donor_type") @db.VarChar(15) // LIVING, DECEASED, CADAVERIC
  // 생체 기증자
  donorPatientId   String?   @map("donor_patient_id") @db.Uuid
  donorName        String?   @map("donor_name") @db.VarChar(100)
  relationship     String?   @db.VarChar(30) // PARENT, SIBLING, SPOUSE, UNRELATED
  // 공통 정보
  bloodType        String    @map("blood_type") @db.VarChar(5)
  hlaTyping        Json?     @map("hla_typing") @db.JsonB
  organType        String    @map("organ_type") @db.VarChar(30)
  // 적합성
  crossmatchResult String?   @map("crossmatch_result") @db.VarChar(15) // NEGATIVE, POSITIVE
  crossmatchDate   DateTime? @map("crossmatch_date") @db.Date
  // 상태
  status           String    @default("REGISTERED") @db.VarChar(15) // REGISTERED, EVALUATED, APPROVED, DONATED
  evaluationNotes  String?   @map("evaluation_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  donorPatient Patient?               @relation("TransplantDonorPatient", fields: [donorPatientId], references: [id])
  transplants  TransplantRecord[]
  crossmatches TransplantCrossmatch[]

  @@index([organType])
  @@map("transplant_donors")
}

// 이식 교차시험 — 기증자↔특정 수혈자 결속(교차시험은 수혈자별 검사이므로 donor 전역 필드로 판정하면 위험).
model TransplantCrossmatch {
  id          String    @id @default(uuid()) @db.Uuid
  donorId     String    @map("donor_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid // 수혈자(환자)
  result      String    @db.VarChar(15) // NEGATIVE, POSITIVE
  details     Json?     @db.JsonB // CDC/Flow/Virtual 세부
  testedAt    DateTime  @default(now()) @map("tested_at") @db.Timestamptz()
  validUntil  DateTime? @map("valid_until") @db.Timestamptz() // 유효기간(경과 시 재검 필요)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  donor TransplantDonor @relation(fields: [donorId], references: [id])

  @@index([donorId, recipientId, testedAt])
  @@map("transplant_crossmatches")
}

model TransplantRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  recipientId        String   @map("recipient_id") @db.Uuid
  donorId            String   @map("donor_id") @db.Uuid
  waitlistId         String?  @unique @map("waitlist_id") @db.Uuid
  surgeryId          String?  @map("surgery_id") @db.Uuid
  organType          String   @map("organ_type") @db.VarChar(30)
  // 수술
  transplantDate     DateTime @map("transplant_date") @db.Timestamptz()
  surgeonId          String   @map("surgeon_id") @db.Uuid
  coldIschemiaTime   Int?     @map("cold_ischemia_time") // 분
  warmIschemiaTime   Int?     @map("warm_ischemia_time") // 분
  // 결과
  outcome            String   @default("SUCCESS") @db.VarChar(15) // SUCCESS, FAILURE, PRIMARY_NON_FUNCTION
  graftFunction      String?  @map("graft_function") @db.VarChar(15) // IMMEDIATE, DELAYED, NON_FUNCTION
  // 면역억제
  inductionRegimen   String?  @map("induction_regimen") @db.Text
  maintenanceRegimen String?  @map("maintenance_regimen") @db.Text
  //
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  recipient       Patient               @relation("TransplantRecipient", fields: [recipientId], references: [id])
  donor           TransplantDonor       @relation(fields: [donorId], references: [id])
  waitlist        TransplantWaitlist?   @relation("WaitlistTransplant", fields: [waitlistId], references: [id])
  surgeon         User                  @relation("TransplantSurgeon", fields: [surgeonId], references: [id])
  rejectionEvents TransplantRejection[]

  @@index([recipientId])
  @@map("transplant_records")
}

// 이식 TDM/HLA/추적관찰 영속화(P2-E) — 기존 서비스는 create 없이 계산객체만 반환(휘발)이던 결함.
//  FK는 relation 미사용 컬럼(수동 조인). HLA=대기자(waitlist)·TDM/FollowUp=이식기록(record) 귀속.
model TransplantHla {
  id         String   @id @default(uuid()) @db.Uuid
  waitlistId String   @map("waitlist_id") @db.Uuid // TransplantWaitlist(이식 전). 기존 waitlist.hlaTyping=최신 스냅샷 / 본 모델=검사 이력
  classI     Json?    @map("class_i") // {hlaA,hlaB,hlaC}
  classII    Json?    @map("class_ii") // {hlaDR,hlaDQ,hlaDP}
  method     String?  @db.VarChar(50)
  pra        Int?
  antibodies Json?
  lab        String?  @db.VarChar(100)
  testedAt   DateTime @map("tested_at") @db.Timestamptz()
  recordedBy String?  @map("recorded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([waitlistId])
  @@map("transplant_hla")
}

model TransplantTdm {
  id             String   @id @default(uuid()) @db.Uuid
  transplantId   String   @map("transplant_id") @db.Uuid // TransplantRecord(이식 후)
  drug           String   @db.VarChar(60)
  troughLevel    Float?   @map("trough_level")
  peakLevel      Float?   @map("peak_level")
  targetLow      Float?   @map("target_low")
  targetHigh     Float?   @map("target_high")
  inRange        Boolean? @map("in_range")
  doseAdjustment String?  @map("dose_adjustment") @db.VarChar(200)
  sideEffects    Json?    @map("side_effects")
  sampledAt      DateTime @map("sampled_at") @db.Timestamptz()
  recordedBy     String?  @map("recorded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([transplantId])
  @@map("transplant_tdm")
}

model TransplantFollowUp {
  id                       String    @id @default(uuid()) @db.Uuid
  transplantId             String    @map("transplant_id") @db.Uuid
  visitDate                DateTime  @map("visit_date") @db.Timestamptz()
  postOpDay                Int?      @map("post_op_day")
  graftFunction            String?   @map("graft_function") @db.VarChar(30)
  labResults               Json?     @map("lab_results")
  immunosuppressionRegimen Json?     @map("immunosuppression_regimen")
  complications            Json?
