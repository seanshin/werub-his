// ── 직원 패스워드리스 SSO 포털 (staff-sso-passwordless) ──
// P1: WebAuthn(FIDO2) 패스키 + 관리자 검증 디바이스. 서버는 공개키만 저장(생체 원본 비전송).
model WebAuthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id") @db.Text // base64url
  publicKey    Bytes     @map("public_key") // 공개키만 저장
  counter      BigInt    @default(0) // signCount, 복제감지(FR-21)
  transports   String[]  @default([]) // platform/internal/hybrid 등
  aaguid       String?   @db.VarChar(64)
  backedUp     Boolean   @default(false) @map("backed_up") // synced passkey 식별(FR-26)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  deviceId     String?   @map("device_id") @db.Uuid
  status       String    @default("ACTIVE") @db.VarChar(20) // ACTIVE/REVOKED/REPLACED/LOCKED(FR-21)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz()

  user   User         @relation("UserWebAuthnCredentials", fields: [userId], references: [id])
  device StaffDevice? @relation("DeviceCredentials", fields: [deviceId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("webauthn_credentials")
}

// ── 네이티브 앱 무결성·본인확인 (iOS 앱 요청서 APPKEY-01 · EXT-ID-01) ──

/**
 * 앱 설치별 개별키 — Apple App Attest 로 등록한 공개키.
 * 🔴 이 키는 **"등록된 정식 앱 설치가 보낸 요청인지"** 만 증명한다.
 * 사용자 인증(Passkey·비밀번호)도, 업무 권한(RBAC)도 대신하지 않는다.
 * 반대로 올바른 Passkey 가 있어도 요구된 키가 폐기 상태면 세션을 발급하지 않는다.
 * 개인키는 기기의 App Attest 안에만 있다 — 서버는 공개키와 keyId 만 안다.
 */
model AppInstallationKey {
  id                     String    @id @default(uuid()) @db.Uuid
  app                    String    @db.VarChar(20) // PATIENT_IOS | STAFF_IOS
  installationId         String    @map("installation_id") @db.VarChar(64) // 앱이 만든 상관 식별자(단독 인증 근거 아님)
  appleKeyId             String    @unique @map("apple_key_id") @db.VarChar(128)
  publicKey              Bytes     @map("public_key") // COSE→PKCS 변환 전 원본(EC P-256)
  publicKeyFingerprint   String    @unique @map("public_key_fingerprint") @db.VarChar(64) // sha256 hex — 설치 간 공유 거부
  receiptEncrypted       String?   @map("receipt_encrypted") @db.Text // Apple fraud assessment 용. 일반 API·로그에 반환 금지
  attestationEnvironment String    @map("attestation_environment") @db.VarChar(12) // DEVELOPMENT | PRODUCTION
  attestationLevel       String    @default("APP_ATTEST") @map("attestation_level") @db.VarChar(24) // APP_ATTEST | KEY_POSSESSION_ONLY
  bundleId               String    @map("bundle_id") @db.VarChar(100)
  bundleVersion          String?   @map("bundle_version") @db.VarChar(30)
  status                 String    @default("PENDING") @db.VarChar(20) // PENDING | ACTIVE | ROTATE_REQUIRED | REVOKED
  patientAccountId       String?   @map("patient_account_id") @db.Uuid
  staffUserId            String?   @map("staff_user_id") @db.Uuid
  staffDeviceId          String?   @map("staff_device_id") @db.Uuid
  patientDeviceId        String?   @map("patient_device_id") @db.Uuid
  assertionCounter       BigInt    @default(0) @map("assertion_counter")
  attestedAt             DateTime  @default(now()) @map("attested_at") @db.Timestamptz()
  boundAt                DateTime? @map("bound_at") @db.Timestamptz()
  lastAssertedAt         DateTime? @map("last_asserted_at") @db.Timestamptz()
  rotatedAt              DateTime? @map("rotated_at") @db.Timestamptz()
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz()
  revokeReason           String?   @map("revoke_reason") @db.VarChar(255)
  replacedByKeyId        String?   @map("replaced_by_key_id") @db.Uuid

  staffUser      User?           @relation("UserAppKeys", fields: [staffUserId], references: [id])
  staffDevice    StaffDevice?    @relation("StaffDeviceAppKeys", fields: [staffDeviceId], references: [id])
  patientAccount PatientAccount? @relation("PatientAccountAppKeys", fields: [patientAccountId], references: [id])

  @@index([app, status])
  @@index([staffUserId])
  @@index([patientAccountId])
  @@index([installationId])
  @@map("app_installation_keys")
}

/**
 * 외부 휴대폰 본인확인 거래 — 앱은 **CI 원문을 보지 못하고** 일회용 verificationId 만 받는다.
 * 🔴 가입 API 는 클라이언트가 보낸 CI 를 믿지 않는다. 서버가 검증한 이 행만 믿는다.
 * `ciLookupHash` 는 HMAC(pepper, CI) 로, 중복 매칭에 원문 복호화 없이 쓴다.
 */
model IdentityVerification {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String    @db.VarChar(40) // LOCAL_FAKE | NICE_MOBILE_IDENTITY | ...
  purpose          String    @db.VarChar(40) // PATIENT_SIGNUP | PATIENT_RECOVERY | ...
  status           String    @default("STARTED") @db.VarChar(20) // STARTED|VERIFIED|CONSUMED|CANCELLED|EXPIRED|FAILED
  installationId   String?   @map("installation_id") @db.VarChar(64)
  appKeyId         String?   @map("app_key_id") @db.Uuid
  providerTxRef    String?   @map("provider_tx_ref") @db.VarChar(200)
  stateNonce       String    @map("state_nonce") @db.VarChar(128) // callback 위조·재사용 방지
  ciEncrypted      String?   @map("ci_encrypted") @db.Text
  ciLookupHash     String?   @map("ci_lookup_hash") @db.VarChar(64) // HMAC(pepper, CI) — 원문 없이 중복 판정
  verifiedName     String?   @map("verified_name") @db.VarChar(100)
  verifiedBirth    String?   @map("verified_birth") @db.VarChar(10)
  verifiedGender   String?   @map("verified_gender") @db.VarChar(10)
  verifiedPhone    String?   @map("verified_phone") @db.VarChar(20)
  matchedPatientId String?   @map("matched_patient_id") @db.Uuid
  failureCode      String?   @map("failure_code") @db.VarChar(40)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz()
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status, expiresAt])
  @@index([ciLookupHash])
  @@map("identity_verifications")
}

model StaffDevice {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  deviceName     String    @map("device_name") @db.VarChar(100)
  status         String    @default("ACTIVE") @db.VarChar(20) // ACTIVE/REENROLL_DUE/EXPIRED/REVOKED/REPLACED (FR-01/02)
  enrollChannel  String    @default("ADMIN_QR") @map("enroll_channel") @db.VarChar(20) // SELF/ADMIN_QR
  enrollMode     String    @default("REMOTE") @map("enroll_mode") @db.VarChar(20) // IN_PERSON/REMOTE(FR-43)
  enrolledBy     String?   @map("enrolled_by") @db.Uuid // 검증 관리자
  fcmToken       String?   @map("fcm_token") @db.Text // 스태프 푸시(FR-42/49)
  fcmTokenAt     DateTime? @map("fcm_token_at") @db.Timestamptz()
  verifiedAt     DateTime  @default(now()) @map("verified_at") @db.Timestamptz()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz() // 미사용 만료 판정 (FR-02)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz() // 만료 예정 (FR-01)
  reEnrollDueAt  DateTime? @map("re_enroll_due_at") @db.Timestamptz() // 재등록 도래 (FR-01)
  lostReportedAt DateTime? @map("lost_reported_at") @db.Timestamptz() // 분실 신고 (FR-04)
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()
  revokeReason   String?   @map("revoke_reason") @db.VarChar(255)

  user        User                 @relation("UserStaffDevices", fields: [userId], references: [id])
  credentials WebAuthnCredential[] @relation("DeviceCredentials")
  appKeys     AppInstallationKey[] @relation("StaffDeviceAppKeys")

  @@index([userId])
  @@index([status])
  @@map("staff_devices")
}

// 제로 트러스트 단말 보안 — 단말 자산 레지스트리 (terminal-zero-trust 설계 §2.1)
// 단말 mode(공용/전용) × 직군으로 보안 프로파일 결정. PIN/draft는 Redis 휘발(키 최소화).
model TerminalRegistry {
  id              String   @id @default(uuid()) @db.Uuid
  deviceUuid      String   @unique @map("device_uuid") @db.VarChar(128) // X-Device-UUID
  ipAddress       String?  @map("ip_address") @db.VarChar(45) // 고정 IP(보조키)
  macAddress      String?  @map("mac_address") @db.VarChar(32)
  mode            String   @default("PUBLIC") @db.VarChar(8) // PUBLIC | PRIVATE
  dedicatedUserId String?  @map("dedicated_user_id") @db.Uuid // PRIVATE 전담(기본세션, 물리차단X)
  location        String?  @db.VarChar(120) // 간호스테이션/진료실
  label           String?  @db.VarChar(120)
  beaconId        String?  @map("beacon_id") @db.VarChar(64) // BLE 비콘(게이트 D5)
  status          String   @default("ACTIVE") @db.VarChar(16) // ACTIVE | QUARANTINED | RETIRED
  lockTimeoutSec  Int?     @map("lock_timeout_sec") // null=프로파일 기본(§6.7.1)
  registeredById  String?  @map("registered_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dedicatedUser User? @relation("TerminalDedicated", fields: [dedicatedUserId], references: [id])

  @@index([deviceUuid])
  @@index([ipAddress])
  @@map("terminal_registry")
}

// 직원 단말 보안 동의(위치정보·생체안면·패스키) — 온보딩 FR-F7 게이트 (설계 §2.2)
model StaffConsent {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  locationConsent  Boolean   @default(false) @map("location_consent") // 위치정보법
  biometricConsent Boolean   @default(false) @map("biometric_consent") // 개보법§23 안면
  passkeyConsent   Boolean   @default(false) @map("passkey_consent")
  consentDocId     String?   @map("consent_doc_id") @db.Uuid // IssuedDocument 봉인 참조
  consentedAt      DateTime? @map("consented_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation("StaffConsentUser", fields: [userId], references: [id])

  @@map("staff_consent")
}

// 데이터 보유/파기 정책 (security-governance G1 / FR-S1·S2)
// ⚠️ 3중 안전장치: 전역 retention.purgeEnabled + 정책별 legalConfirmed + 법정 클램프(legalMinDays).
// 기본 REPORT_ONLY·legalConfirmed=false → 법무 확정 전까지 절대 파기 안 함(DRY-RUN 리포트만).
model RetentionPolicy {
  id             String    @id @default(uuid()) @db.Uuid
  resourceType   String    @unique @map("resource_type") @db.VarChar(40) // AUDIT_LOG|PRE_BOARD_ACCOUNT|MEDICAL_RECORD|PRESCRIPTION|CONSENT_FORM ...
  retentionDays  Int       @map("retention_days") // 보존 후 파기 대상 기준일
  legalMinDays   Int       @default(0) @map("legal_min_days") // 법정 최소 보존(클램프 — 이 안에선 절대 파기 금지)
  action         String    @default("REPORT_ONLY") @db.VarChar(16) // REPORT_ONLY|SOFT_DELETE|ANONYMIZE|HARD_PURGE
  legalConfirmed Boolean   @default(false) @map("legal_confirmed") // 법무 보존기간 확정(false면 파기 거부)
  enabled        Boolean   @default(true)
  description    String?   @db.VarChar(200)
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz()
  lastCandidates Int?      @map("last_candidates") // 최근 DRY-RUN 후보 수
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("retention_policy")
}

/// 법적 보존명령(legal hold) — 상용 릴리즈 T10-7(2026-09-13).
/// 소송·분쟁·수사로 보존해야 하는 환자 기록의 **파기·익명화·(향후) 아카이브 이동을 막는 표시**다.
/// 🔴 append-only — 행을 고치지 않는다(DB 트리거가 UPDATE/DELETE 를 거부한다).
/// 🔴 활성 여부는 상태 컬럼이 아니라 **해제 기록(LegalHoldRelease) 유무로 파생**한다 — 컬럼 하나를 뒤집어 조용히 풀 수 없다.
/// 환자 FK 는 두지 않는다(기존 Patient 모델을 바꾸지 않기 위해) — 서비스가 설정 시 환자 존재를 확인한다.
model LegalHold {
  id        String            @id @default(uuid()) @db.Uuid
  patientId String            @map("patient_id") @db.Uuid
  scope     String            @default("ALL") @db.VarChar(40) // ALL | 기록 종류(법정 분류 키 확정 후 — T10-3)
  reason    String            @db.Text
  basis     String?           @db.VarChar(200) // 사건번호·요청 기관 등(자유 기재 — 검증하지 않는다)
  setBy     String            @map("set_by") @db.Uuid
  setAt     DateTime          @default(now()) @map("set_at") @db.Timestamptz()
  release   LegalHoldRelease?

  @@index([patientId])
  @@map("legal_holds")
}

/// 법적 보존명령 해제 기록 — 4-eyes(요청자≠승인자 · 설정자≠승인자) 승인을 소비한 뒤에만 생긴다. append-only.
model LegalHoldRelease {
  id          String    @id @default(uuid()) @db.Uuid
  holdId      String    @unique @map("hold_id") @db.Uuid
  hold        LegalHold @relation(fields: [holdId], references: [id])
  reason      String    @db.Text
  requestedBy String    @map("requested_by") @db.Uuid
  approvedBy  String    @map("approved_by") @db.Uuid
  approvalId  String    @map("approval_id") @db.Uuid
  releasedBy  String    @map("released_by") @db.Uuid
  releasedAt  DateTime  @default(now()) @map("released_at") @db.Timestamptz()

  @@map("legal_hold_releases")
}

// 직원 호출·긴급알림·Code (FR-38~40, 48, 50)
model StaffCall {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(20) // STAFF_CALL / BROADCAST / CODE
  severity    String    @default("NORMAL") @db.VarChar(20) // NORMAL / URGENT / CRITICAL
  senderId    String    @map("sender_id") @db.Uuid
  targetKind  String    @map("target_kind") @db.VarChar(20) // USER / ROLE / DEPARTMENT / ALL
  targetRef   String?   @map("target_ref") @db.VarChar(100) // userId/role/dept
  message     String?   @db.Text
  patientRef  String?   @map("patient_ref") @db.Uuid // 환자 ID만(평문정보 금지, FR-50)
  status      String    @default("OPEN") @db.VarChar(20) // OPEN/ACKED/ESCALATED/CANCELLED/CLOSED
  location    String?   @db.VarChar(100) // Code 위치
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  escalatedAt DateTime? @map("escalated_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  sender User           @relation("StaffCallSender", fields: [senderId], references: [id])
  acks   StaffCallAck[]

  @@index([senderId])
  @@index([targetKind, targetRef])
  @@index([status])
  @@map("staff_calls")
}

// 원내 심정지·신속대응팀(P2-C) — 코드블루 알림(StaffCall type=CODE)과 별개로 임상 소생 경과를 기록.
//  FK는 relation 미사용 컬럼(서비스에서 수동 조인) — 부모 역관계 가산 회피.
enum CodeBlueOutcome {
  ONGOING
  ROSC // 자발순환 회복
  DEATH
  TRANSFER
}

enum RrtTrigger {
  NEWS2 // 조기경보 기반
  DIRECT_CALL // 직접 콜
  FAMILY // 보호자 요청
  OTHER
}

enum RrtOutcome {
  ONGOING
  WARD_STAY // 병동 유지
  ICU_TRANSFER
  CODE_BLUE // 코드블루 격상
  DECEASED
}

model CodeBlueEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  patientId           String          @map("patient_id") @db.Uuid
  admissionId         String?         @map("admission_id") @db.Uuid // 범용 Admission 참조(병동·ICU 무관)
  staffCallId         String?         @map("staff_call_id") @db.Uuid // 발령 알림(StaffCall type=CODE) 결속
  location            String          @db.VarChar(100)
  recognizedAt        DateTime        @map("recognized_at") @db.Timestamptz() // 인지 시각
  teamArrivedAt       DateTime?       @map("team_arrived_at") @db.Timestamptz() // 팀 도착
  cprStartedAt        DateTime?       @map("cpr_started_at") @db.Timestamptz()
  roscAt              DateTime?       @map("rosc_at") @db.Timestamptz() // 자발순환 회복
  endedAt             DateTime?       @map("ended_at") @db.Timestamptz()
  defibrillationCount Int             @default(0) @map("defibrillation_count")
  medications         Json? // [{drug, dose, at}]
  outcome             CodeBlueOutcome @default(ONGOING)
  notes               String?         @db.Text
  recordedBy          String          @map("recorded_by") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([patientId])
  @@index([recognizedAt])
  @@map("code_blue_events")
}

model RrtActivation {
  id            String     @id @default(uuid()) @db.Uuid
  patientId     String     @map("patient_id") @db.Uuid
  ewsId         String?    @map("ews_id") @db.Uuid // 트리거 EarlyWarningScore
  trigger       RrtTrigger @default(DIRECT_CALL)
  activatedAt   DateTime   @map("activated_at") @db.Timestamptz()
  respondedAt   DateTime?  @map("responded_at") @db.Timestamptz() // 도착(SLA 산출)
  responderTeam String?    @map("responder_team") @db.VarChar(100)
  reason        String?    @db.Text
  outcome       RrtOutcome @default(ONGOING)
  recordedBy    String     @map("recorded_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([patientId])
  @@index([activatedAt])
  @@map("rrt_activations")
}

model StaffCallAck {
  id       String   @id @default(uuid()) @db.Uuid
  callId   String   @map("call_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  response String   @db.VarChar(20) // ACCEPT / CONFIRM / CALLBACK / ACK
  ackedAt  DateTime @default(now()) @map("acked_at") @db.Timestamptz()

  call StaffCall @relation(fields: [callId], references: [id])
  user User      @relation("StaffCallAcker", fields: [userId], references: [id])

  @@unique([callId, userId])
  @@map("staff_call_acks")
}

// 인증 연속성 Break-glass (FR-51) — 환자기록 BTG(BreakTheGlassAccess)와 별개.
// 인증 불가(패스키 분실/장애) 직원에게 책임자 승인 하에 시간제한 임시 접근.
model AuthEmergencyAccess {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid // 접근 대상(잠긴 직원)
  reason       String    @db.Text
  approvers    String[]  @default([]) // 승인자 userId(들) — 2인 승인 지원
  approvalKind String    @map("approval_kind") @db.VarChar(20) // SUPERVISOR / TWO_PERSON
  scope        String    @default("FULL") @db.VarChar(100)
  grantedAt    DateTime  @default(now()) @map("granted_at") @db.Timestamptz()
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz() // 짧은 만료
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()

  user User @relation("EmergencyAccessUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([grantedAt])
  @@map("auth_emergency_access")
}

// 계정 복구 (FR-16/24) — 패스키 전부 분실 시 관리자 다중통제 승인 → 재등록
model AccountRecovery {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  reason      String?   @db.Text
  status      String    @default("PENDING") @db.VarChar(20) // PENDING/APPROVED/COMPLETED/REJECTED
  approvers   String[]  @default([])
  tokenHash   String?   @map("token_hash") @db.VarChar(128) // 복구 토큰 sha256
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  user User @relation("AccountRecoveryUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("account_recoveries")
}

// 직원 인증 관리 콘솔(credential-admin) — 권한 grant (FR-40/54) / 4-eyes 승인 (FR-41)
model AdminPermissionGrant {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  permission String    @db.VarChar(40) // CRED_*
  grantedBy  String    @map("granted_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz() // 위임(FR-54)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_permission_grants")
}

model AdminApproval {
  id          String    @id @default(uuid()) @db.Uuid
  action      String    @db.VarChar(40) // CERT_REVOKE/ACCOUNT_DEPROVISION/RECOVERY_APPROVE/BULK_REENROLL
  targetType  String    @map("target_type") @db.VarChar(30)
  targetId    String    @map("target_id") @db.VarChar(64)
  payload     Json?
  requestedBy String    @map("requested_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  status      String    @default("PENDING") @db.VarChar(20) // PENDING/APPROVED/REJECTED/EXECUTED/EXPIRED
  reason      String?   @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz()
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()

  @@index([status])
  @@index([targetType, targetId])
  @@map("admin_approvals")
}

// 인증 정책 (GLOBAL←ROLE←DEPARTMENT 오버라이드, FR-25/D-1)
model AuthPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  scope            String   @db.VarChar(20) // GLOBAL/ROLE/DEPARTMENT
  scopeRef         String   @default("*") @map("scope_ref") @db.VarChar(50) // GLOBAL='*'
  reEnrollDays     Int      @default(180) @map("re_enroll_days")
  idleExpireDays   Int      @default(60) @map("idle_expire_days")
  certValidityDays Int      @default(365) @map("cert_validity_days")
  expiryWarnDays   Int      @default(14) @map("expiry_warn_days")
  maxDevices       Int      @default(3) @map("max_devices")
  inPersonRoles    String[] @default(["DOCTOR"]) @map("in_person_roles")
  syncedPasskey    String   @default("ROLE_BASED") @map("synced_passkey") @db.VarChar(20)
  updatedBy        String   @map("updated_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([scope, scopeRef])
  @@map("auth_policies")
}

model VipPatient {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @unique @map("patient_id") @db.Uuid
  designatedBy String   @map("designated_by") @db.Uuid
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient @relation(fields: [patientId], references: [id])
  designator User    @relation("VipDesignator", fields: [designatedBy], references: [id])

  @@map("vip_patients")
}

// ── EMR-09: 문진표 토큰 ──

model QuestionnaireToken {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  formSchemaId   String    @map("form_schema_id") @db.Uuid
  appointmentId  String?   @map("appointment_id") @db.Uuid
  token          String    @unique @db.VarChar(100)
  status         String    @default("SENT") @db.VarChar(20) // SENT | OPENED | IN_PROGRESS | COMPLETED | EXPIRED
  sentVia        String?   @map("sent_via") @db.VarChar(20) // CHAT | SMS | KAKAO | QR | MANUAL
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  openedAt       DateTime? @map("opened_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz()
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz()
  submissionId   String?   @unique @map("submission_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient         @relation(fields: [patientId], references: [id])
  formSchema FormSchema      @relation(fields: [formSchemaId], references: [id])
  submission FormSubmission? @relation(fields: [submissionId], references: [id])
  reviewer   User?           @relation("QuestionnaireReviewer", fields: [reviewedBy], references: [id])

  @@index([token])
  @@index([status])
  @@index([patientId, status])
  @@map("questionnaire_tokens")
}

// ============================================================
// Webhook Subscriptions (Clinic ↔ HIS 연동)
// ============================================================

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @db.VarChar(500)
  events    String[] @db.VarChar(50)
  secret    String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("webhook_subscriptions")
}

// ── Clinic 동기화 이력 ──

model ClinicSyncLog {
  id           String   @id @default(uuid()) @db.Uuid
  syncType     String   @map("sync_type") @db.VarChar(50) // PUSH_STAFF, PULL_STAFF, ROLE_MAPPING
  status       String   @db.VarChar(20) // SUCCESS, FAILED, PARTIAL
  totalSent    Int      @map("total_sent")
  registered   Int      @default(0)
  skipped      Int      @default(0)
  failed       Int      @default(0)
  details      Json?    @db.JsonB // 상세 결과 (details 배열)
  errorMessage String?  @map("error_message") @db.Text
  executedBy   String   @map("executed_by") @db.Uuid
  executedAt   DateTime @default(now()) @map("executed_at") @db.Timestamptz()

  executor User @relation("SyncLogExecutor", fields: [executedBy], references: [id])

  @@index([executedAt])
  @@map("clinic_sync_logs")
}

// ── 약속처방(CP) + Pre-Order ──

model OrderSet {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique @db.VarChar(200)
  code              String?   @db.VarChar(30)
  department        String?   @db.VarChar(50)
  category          String    @db.VarChar(30)
  diagnosisCode     String?   @map("diagnosis_code") @db.VarChar(20)
  description       String?   @db.Text
  items             Json      @db.JsonB
  isShared          Boolean   @default(true) @map("is_shared")
  version           Int       @default(1)
  status            String    @default("ACTIVE") @db.VarChar(20)
  applicableTo      String?   @map("applicable_to") @db.VarChar(30)
  ageGroup          String?   @map("age_group") @db.VarChar(20) // ALL|ADULT|PEDIATRIC|GERIATRIC — 대상 연령군
  contraindications Json?     @map("contraindications") @db.JsonB // 금기 조건 배열 [{type, value, note}]
  evidenceLevel     String?   @map("evidence_level") @db.VarChar(10)
  guidelineRef      String?   @map("guideline_ref") @db.VarChar(200)
  createdBy         String?   @map("created_by") @db.Uuid
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz()
  useCount          Int       @default(0) @map("use_count")
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz()
  parentId          String?   @map("parent_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  creator   User?               @relation("OrderSetCreator", fields: [createdBy], references: [id])
  diagnoses OrderSetDiagnosis[]

  @@index([category])
  @@index([department])
  @@index([diagnosisCode])
  @@index([code])
  @@index([status])
  @@map("order_sets")
}

/// 치료일정 템플릿 — 진단 확정 시 환자별 스케줄로 전개(P2)될 D-day 오프셋 기반 일정 정의.
/// 승인 상태머신·ACTIVE 코드해석 게이트는 약속처방(OrderSet) 패턴과 동일.
model TreatmentScheduleTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(200)
  department  String?   @db.VarChar(50)
  description String?   @db.Text
  status      String    @default("DRAFT") @db.VarChar(20) // DRAFT|PENDING_APPROVAL|APPROVED|ACTIVE|DEPRECATED
  version     Int       @default(1)
  parentId    String?   @map("parent_id") @db.Uuid
  totalDays   Int       @default(28) @map("total_days") // 전체 기간(일)
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  items     TreatmentTemplateItem[]
  diagnoses TreatmentTemplateDiagnosis[]

  @@index([status])
  @@index([department])
  @@map("treatment_schedule_templates")
}

model TreatmentTemplateItem {
  id          String  @id @default(uuid()) @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  dayOffset   Int     @map("day_offset") // D+N (anchor 기준)
  timeOfDay   String? @map("time_of_day") @db.VarChar(5) // "09:00"
  itemType    String  @map("item_type") @db.VarChar(20) // VISIT|LAB|IMAGING|PROCEDURE|MEDICATION_CYCLE|EDUCATION|NURSING|ASSESSMENT
  title       String  @db.VarChar(200)
  refCodeId   String? @map("ref_code_id") @db.Uuid // 코드 필수 유형(LAB/IMAGING/PROCEDURE/MEDICATION_CYCLE)의 해석 강제 — 유령 방지
  repeatEvery Int?    @map("repeat_every") // 반복 간격(일) — 주1회=7
  repeatCount Int?    @map("repeat_count") // 반복 횟수
  isDefault   Boolean @default(true) @map("is_default") // 전개 모달(P2) 기본 체크
  sortOrder   Int     @default(0) @map("sort_order")
  notes       String? @db.VarChar(300)

  template TreatmentScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, dayOffset])
  @@map("treatment_template_items")
}

/// 환자별 치료일정 인스턴스 — 템플릿 전개(P2) 결과. 계획 레이어(실행은 각 도메인 객체가 SoT·ref 연결만)
model PatientTreatmentSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  encounterId String?  @map("encounter_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  name        String   @db.VarChar(200) // 전개 시점 템플릿명 스냅샷
  anchorDate  DateTime @map("anchor_date") @db.Date // D0
  status      String   @default("ACTIVE") @db.VarChar(15) // ACTIVE|COMPLETED|CANCELLED
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  items PatientScheduleItem[]

  @@index([patientId, status])
  @@map("patient_treatment_schedules")
}

model PatientScheduleItem {
  id         String    @id @default(uuid()) @db.Uuid
  scheduleId String    @map("schedule_id") @db.Uuid
  plannedAt  DateTime  @map("planned_at") @db.Timestamptz() // anchor + dayOffset(+반복 회차)
  itemType   String    @map("item_type") @db.VarChar(20)
  title      String    @db.VarChar(200)
  status     String    @default("PLANNED") @db.VarChar(15) // PLANNED(계획만)|LINKED(실 객체 연결)|CANCELLED
  refType    String?   @map("ref_type") @db.VarChar(20) // 'PreOrder' 등 — 실행 객체(SoT) 참조
  refId      String?   @map("ref_id") @db.Uuid
  notes      String?   @db.VarChar(300)
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz() // D-1 환자 리마인더 발송 멱등키

  schedule PatientTreatmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, plannedAt])
  @@map("patient_schedule_items")
}

/// 치료일정 템플릿 ↔ 진단 매핑 — OrderSetDiagnosis와 동형(추천 엔진 공유 규칙)
model TreatmentTemplateDiagnosis {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  diagnosisCode String   @map("diagnosis_code") @db.VarChar(20)
  matchType     String   @default("EXACT") @map("match_type") @db.VarChar(10) // EXACT | PREFIX
  role          String   @default("ANY") @db.VarChar(15) // ANY | PRIMARY_ONLY
  weight        Int      @default(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  template TreatmentScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, diagnosisCode])
  @@index([diagnosisCode])
  @@map("treatment_template_diagnoses")
}

/// 약속처방 ↔ 진단코드 다대다 매핑 — 추천 엔진 v2.
/// 기존 OrderSet.diagnosisCode(단일 VarChar)는 하위호환 유지(추천 시 양쪽 소스 병합).
model OrderSetDiagnosis {
  id            String   @id @default(uuid()) @db.Uuid
  orderSetId    String   @map("order_set_id") @db.Uuid
  diagnosisCode String   @map("diagnosis_code") @db.VarChar(20) // KCD-8 코드 또는 prefix(E11 → E11.*)
  matchType     String   @default("EXACT") @map("match_type") @db.VarChar(10) // EXACT | PREFIX
  role          String   @default("ANY") @db.VarChar(15) // ANY | PRIMARY_ONLY (주상병일 때만 추천)
  weight        Int      @default(100) // 추천 정렬 가중치
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  orderSet OrderSet @relation(fields: [orderSetId], references: [id], onDelete: Cascade)

  @@unique([orderSetId, diagnosisCode])
  @@index([diagnosisCode])
  @@map("order_set_diagnoses")
}

model OrderSetUsage {
  id            String   @id @default(uuid()) @db.Uuid
  orderSetId    String   @map("order_set_id") @db.Uuid
  encounterId   String   @map("encounter_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  usedBy        String   @map("used_by") @db.Uuid
  usedAt        DateTime @default(now()) @map("used_at") @db.Timestamptz()
  itemsApplied  Int      @map("items_applied")
  itemsModified Int      @map("items_modified")

  @@index([orderSetId])
  @@map("order_set_usages")
}

model FavoriteOrder {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(200)
  items     Json     @db.JsonB
  useCount  Int      @default(0) @map("use_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation("UserFavoriteOrders", fields: [userId], references: [id])

  @@index([userId, useCount])
  @@map("favorite_orders")
}

// ============================================================
// Phase ICU + 기초검사
// ============================================================

// ── ICU 병상 ──

model IcuBed {
  id         String         @id @default(uuid()) @db.Uuid
  unitName   String         @map("unit_name") @db.VarChar(100)
  bedNumber  String         @map("bed_number") @db.VarChar(20)
  status     String         @default("AVAILABLE") @db.VarChar(20)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  admissions IcuAdmission[]

  @@unique([unitName, bedNumber])
  @@map("icu_beds")
}

// ── ICU 입실 ──

model IcuAdmission {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  icuBedId      String      @map("icu_bed_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  admitDate     DateTime    @map("admit_date") @db.Timestamptz()
  dischargeDate DateTime?   @map("discharge_date") @db.Timestamptz()
  admitReason   String      @map("admit_reason") @db.Text
  severity      String?     @db.VarChar(20)
  ventilator    Boolean     @default(false)
  isolation     Boolean     @default(false)
  status        String      @default("ADMITTED") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  patient       Patient     @relation(fields: [patientId], references: [id])
  icuBed        IcuBed      @relation(fields: [icuBedId], references: [id])
  records       IcuRecord[]

  @@index([status])
  @@map("icu_admissions")
}

// ── ICU 기록 ──

model IcuRecord {
  id              String       @id @default(uuid()) @db.Uuid
  admissionId     String       @map("admission_id") @db.Uuid
  recordTime      DateTime     @map("record_time") @db.Timestamptz()
  // 바이탈
  heartRate       Int?         @map("heart_rate")
  systolicBp      Int?         @map("systolic_bp")
  diastolicBp     Int?         @map("diastolic_bp")
  spo2            Int?
  respiratoryRate Int?         @map("respiratory_rate")
  temperature     Decimal?     @db.Decimal(4, 1)
  // 의식 수준
  gcScore         Int?         @map("gc_score") // GCS 3~15
  consciousness   String?      @db.VarChar(20) // ALERT, VERBAL, PAIN, UNRESPONSIVE
  pupilReaction   String?      @map("pupil_reaction") @db.VarChar(50)
  // I/O (섭취/배출)
  intakeOral      Int?         @map("intake_oral") // ml
  intakeIv        Int?         @map("intake_iv") // ml
  intakeOther     Int?         @map("intake_other") // ml (수혈, 영양 등)
  outputUrine     Int?         @map("output_urine") // ml
  outputDrain     Int?         @map("output_drain") // ml
  outputOther     Int?         @map("output_other") // ml (구토, 기타)
  // 인공호흡기
  ventMode        String?      @map("vent_mode") @db.VarChar(30) // AC, SIMV, PS, CPAP, T-piece
  fio2            Int? // %
  peep            Int? // cmH2O
  tidalVolume     Int?         @map("tidal_volume") // ml
  pip             Int? // cmH2O (최고흡기압)
  // 중증도 점수
  apacheScore     Int?         @map("apache_score") // APACHE II (0~71)
  sofaScore       Int?         @map("sofa_score") // SOFA (0~24)
  // 기타
  painScore       Int?         @map("pain_score") // NRS 0~10
  sedationScore   Int?         @map("sedation_score") // RASS -5~+4
  notes           String?      @db.Text
  recordedBy      String       @map("recorded_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  admission       IcuAdmission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([recordTime])
  @@map("icu_records")
}

// ── 기초검사 (Diagnostic Tests) ──

model DiagnosticTest {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  testType         String    @map("test_type") @db.VarChar(50)
  testName         String    @map("test_name") @db.VarChar(200)
  requestedBy      String    @map("requested_by") @db.Uuid
  performedBy      String?   @map("performed_by") @db.Uuid
  interpretedBy    String?   @map("interpreted_by") @db.Uuid
  status           String    @default("ORDERED") @db.VarChar(20)
  scheduledAt      DateTime? @map("scheduled_at") @db.Timestamptz()
  performedAt      DateTime? @map("performed_at") @db.Timestamptz()
  reportedAt       DateTime? @map("reported_at") @db.Timestamptz()
  findings         String?   @db.Text
  impression       String?   @db.Text
  conclusion       String?   @db.VarChar(50)
  measurements     Json?     @db.JsonB
  attachmentUrl    String?   @map("attachment_url") @db.VarChar(500)
  // ── 보강(P1~P3·전부 가산적) ──
  priority         String    @default("ROUTINE") @db.VarChar(20) // STAT/URGENT/ROUTINE (P1)
  targetTatMinutes Int?      @map("target_tat_minutes") // 목표 소요시간(P1 TAT)
  criticalFlag     Boolean   @default(false) @map("critical_flag") // 위험소견(P1)
  criticalNote     String?   @map("critical_note") @db.VarChar(300)
  // 의뢰 메모(금식 여부·알레르기·특이사항). 🔴 2026-08-26 실측: 의뢰 화면이 이 값을 입력받고
  //    있었는데 담을 컬럼도 DTO 필드도 없어 **전송조차 되지 않고 사라지고 있었다.**
  requestNote      String?   @map("request_note") @db.VarChar(500)
  roomName         String?   @map("room_name") @db.VarChar(50) // 검사실(P2)
  equipmentName    String?   @map("equipment_name") @db.VarChar(100) // 장비(P2)
  orderId          String?   @map("order_id") @db.Uuid // Order 브릿지(P2·plain)
  reviewedBy       String?   @map("reviewed_by") @db.Uuid // 판독 검토자(P2)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewStatus     String?   @map("review_status") @db.VarChar(20) // PENDING_REVIEW/APPROVED/REJECTED
  deltaFlag        Boolean   @default(false) @map("delta_flag") // 이전 대비 급변(P3)
  deltaNote        String?   @map("delta_note") @db.VarChar(300)
  // ── 상태 전이 기록(P2 취소·보류 — 2026-09-14) ──
  // 🔴 종전 전이 EP 는 사유를 `criticalNote`(위험소견 메모)에 덮어써 판독자의 위험소견을 지웠다. 사유는 자기 칸에 둔다.
  //    이력 전체는 감사 로그(변이 기본 감사)와 환자 여정 이벤트가 갖는다 — 이 칸은 "지금 왜 이 상태인가"만.
  statusReason     String?   @map("status_reason") @db.VarChar(300)
  statusChangedBy  String?   @map("status_changed_by") @db.Uuid
  statusChangedAt  DateTime? @map("status_changed_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  patient          Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([testType])
  @@index([status])
  @@index([reviewStatus])
  @@map("diagnostic_tests")
}

// ============================================================
// 시스템 설정 (System Configuration)
// ============================================================

/// 연동 개통 게이트 — 조직 결재(A-1 정책·A-2 프로토콜 승인·A-3 자격증명 등)를 시스템으로 추적.
/// 트랙의 전 게이트 CONFIRMED일 때만 개통(config ON) 가능 — 결재 근거·확인자·시각 감사 보존.
model IntegrationGate {
  id           String    @id @default(uuid()) @db.Uuid
  track        String    @db.VarChar(30) // LIS_REFLEX 등
  key          String    @db.VarChar(10) // A-1 | A-2 | A-3
  title        String    @db.VarChar(200)
  owner        String    @db.VarChar(80) // 주관(진료부·원무 / 진단검사의학과 / 보안팀)
  status       String    @default("PENDING") @db.VarChar(15) // PENDING | CONFIRMED
  confirmedBy  String?   @map("confirmed_by") @db.Uuid
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz() // 시스템 기록 시각
  // 구조화 결재 근거 — 추적성(결재문서·결재일·결재자·원문 링크)
  evidenceType String?   @map("evidence_type") @db.VarChar(20) // APPROVAL_DOC(전자결재)|MEETING(회의록)|OFFICIAL_LETTER(공문)|OTHER
  evidenceRef  String?   @map("evidence_ref") @db.VarChar(120) // 문서번호·회의명 등 식별자
  approvedOn   DateTime? @map("approved_on") @db.Date // 실제 결재일
  approverName String?   @map("approver_name") @db.VarChar(50) // 주관 부서 결재자(성명·직책)
  evidenceUrl  String?   @map("evidence_url") @db.VarChar(300) // 그룹웨어/문서 링크
  note         String?   @db.VarChar(500) // 비고(레거시 근거 포함)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  events IntegrationGateEvent[]

  @@unique([track, key])
  @@map("integration_gates")
}

/// 게이트 이력 — 확인/회수/개통/중지의 도메인 이벤트(스냅샷 보존). AuditLog와 별개로 보드에 표시
model IntegrationGateEvent {
  id        String   @id @default(uuid()) @db.Uuid
  gateId    String?  @map("gate_id") @db.Uuid // 트랙 이벤트(ACTIVATE 등)는 null
  track     String   @db.VarChar(30)
  key       String?  @db.VarChar(10)
  action    String   @db.VarChar(15) // CONFIRM | REVOKE | ACTIVATE | DEACTIVATE
  actorId   String?  @map("actor_id") @db.Uuid
  snapshot  Json?    @db.JsonB // 당시 근거 스냅샷
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  gate IntegrationGate? @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([track, createdAt])
  @@map("integration_gate_events")
}

/// 결정 이력 원장 — **덧붙이기만**(2026-10-11 사용자 "이미 의사결정된 의사결정과정도 로그 형태로").
///
/// 🔴 발단(실측): 결정 기록은 `system_configs` 의 `decision.<key>` **한 행을 덮어썼다**. 다시 기록하면 이전 선택은
///    감사 로그의 `choice=…;applied=…` 문자열에만 남았고(운영 2건), 위원회 의결로 바뀐 것·선행 결정이 바뀌어
///    하위 결정이 흔들린 것·결정에 묶인 설정을 관리자가 직접 바꾼 것은 **어디에도 남지 않았다**.
///    이 표는 그 사건들을 시간순으로 쌓는다 — 고치지도 지우지도 않는다(코드에 update/delete 경로가 없다).
/// 어휘(kind)는 shared `decision-log.ts` 정본.
model DecisionLogEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  decisionKey         String   @map("decision_key") @db.VarChar(120)
  kind                String   @db.VarChar(30)
  choice              String?  @db.VarChar(80)
  prevChoice          String?  @map("prev_choice") @db.VarChar(80)
  basisRef            String?  @map("basis_ref") @db.Text
  authorityClaim      String?  @map("authority_claim") @db.Text
  /// 행위자 계정 — 시스템이 남긴 사건(선행 변경 전파)은 null
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  /// 이 사건을 일으킨 다른 결정 키(선행 결정 변경 전파) · 설정 키(설정 직접 변경)
  sourceKey           String?  @map("source_key") @db.VarChar(160)
  committeeDecisionId String?  @map("committee_decision_id") @db.Uuid
  detail              Json?
  /// 사건이 일어난 시각 — 원장 시작 전 기록을 옮긴 행은 원 기록의 결정 시각
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz()
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([decisionKey, occurredAt])
  @@index([occurredAt])
  @@index([kind])
  @@map("decision_log_entries")
}

