}

model SterilePackage {
  id              String    @id @default(uuid()) @db.Uuid
  lotNo           String    @unique @map("lot_no") @db.VarChar(40)
  templateId      String    @map("template_id") @db.Uuid
  templateName    String    @map("template_name") @db.VarChar(200)
  status          String    @default("PACKAGED") @db.VarChar(16) // ASSEMBLING/PACKAGED/IN_LOAD/STERILE/IN_USE/RETURNED/EXPIRED/RECALLED
  packagingType   String    @default("POUCH") @map("packaging_type") @db.VarChar(20)
  countVerified   Boolean   @default(false) @map("count_verified")
  countNote       String?   @map("count_note") @db.VarChar(300)
  assembledBy     String?   @map("assembled_by") @db.Uuid
  packagedAt      DateTime? @map("packaged_at") @db.Timestamptz()
  loadId          String?   @map("load_id") @db.Uuid
  sterilizedAt    DateTime? @map("sterilized_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  location        String?   @db.VarChar(100)
  usedEncounterId String?   @map("used_encounter_id") @db.Uuid
  usedAt          DateTime? @map("used_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  template InstrumentSetTemplate @relation(fields: [templateId], references: [id])
  load     SterilizationLoad?    @relation(fields: [loadId], references: [id])
  events   PackageEvent[]
  units    SterilePackageUnit[]

  @@index([status])
  @@index([loadId])
  @@index([expiresAt])
  @@map("sterile_packages")
}

model SterilizationLoad {
  id          String    @id @default(uuid()) @db.Uuid
  loadNo      String    @unique @map("load_no") @db.VarChar(40)
  sterilizer  String    @db.VarChar(60)
  program     String    @default("STEAM") @db.VarChar(20) // STEAM/EO/H2O2
  tempC       Int?      @map("temp_c")
  durationMin Int?      @map("duration_min")
  operatorId  String?   @map("operator_id") @db.Uuid
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz()
  biResult    String    @default("PENDING") @map("bi_result") @db.VarChar(10) // PASS/FAIL/PENDING
  ciResult    String    @default("PENDING") @map("ci_result") @db.VarChar(10)
  releasedBy  String?   @map("released_by") @db.Uuid
  releasedAt  DateTime? @map("released_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

