  admission Admission @relation(fields: [admissionId], references: [id])
  doctor    User      @relation("ChargeOfCareDoctor", fields: [doctorId], references: [id])

  @@index([admissionId, releasedAt])
  @@index([doctorId])
  @@map("charge_of_care")
