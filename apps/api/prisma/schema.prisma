}

// ── 정신건강의학과 (Psychiatry) ──

// 정신과 비자의입원(정신건강복지법) — 입원유형 분류 + 법정 안전장치(2인전문의·보호의무자·적합성/계속입원심사·기간한도) 추적·경고.
enum AdmissionLegalType {
  VOLUNTARY // 자의입원 §41
  CONSENT // 동의입원 §42 (환자+보호의무자1)
  GUARDIAN // 보호입원 §43 (보호의무자2+전문의)
  ADMINISTRATIVE // 행정입원 §44 (시장·군수·구청장)
  EMERGENCY // 응급입원 §50 (72시간 한도)
}

enum PsychAdmissionStatus {
  ACTIVE
  DISCHARGED
  CONVERTED // 유형 전환(예: 응급→보호)
}

model PsychiatricAdmission {
  id                    String               @id @default(uuid()) @db.Uuid
  patientId             String               @map("patient_id") @db.Uuid
  admissionId           String?              @map("admission_id") @db.Uuid
  legalType             AdmissionLegalType   @map("legal_type")
  status                PsychAdmissionStatus @default(ACTIVE)
  admittedAt            DateTime             @default(now()) @map("admitted_at") @db.Timestamptz()
  diagnosis             String?              @db.VarChar(500)
  psychiatrist1Id       String?              @map("psychiatrist1_id") @db.Uuid // 진단 전문의
  psychiatrist2Id       String?              @map("psychiatrist2_id") @db.Uuid // 계속입원 시 다른기관 전문의
  guardian1Name         String?              @map("guardian1_name") @db.VarChar(100)
  guardian1Relation     String?              @map("guardian1_relation") @db.VarChar(50)
  guardian2Name         String?              @map("guardian2_name") @db.VarChar(100)
  guardian2Relation     String?              @map("guardian2_relation") @db.VarChar(50)
  suitabilityReviewDue  DateTime?            @map("suitability_review_due") @db.Date // 입원적합성심사 기한(1개월)
  suitabilityReviewedAt DateTime?            @map("suitability_reviewed_at") @db.Date
  suitabilityResult     String?              @map("suitability_result") @db.VarChar(30) // 적합/부적합/퇴원명령
  continuationReviewDue DateTime?            @map("continuation_review_due") @db.Date // 계속입원심사 기한
  legalExpiryAt         DateTime?            @map("legal_expiry_at") @db.Timestamptz() // 응급72h·보호3개월 만료
  dischargedAt          DateTime?            @map("discharged_at") @db.Timestamptz()
  recordedBy            String               @map("recorded_by") @db.Uuid
  notes                 String?              @db.Text
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  patient  Patient @relation("PatientPsychAdmissions", fields: [patientId], references: [id])
  recorder User    @relation("PsychAdmissionRecorder", fields: [recordedBy], references: [id])

  @@index([patientId, status])
  @@index([status, legalExpiryAt])
  @@map("psychiatric_admissions")
}

// ── 정신건강복지법 §75 격리·강박 — 정신과 전용(감염 IsolationPrecaution·범용 RestraintOrder와 별개) ──
model PsychSeclusionOrder {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  admissionId          String?   @map("admission_id") @db.Uuid // PsychiatricAdmission 참조(plain)
  type                 String    @db.VarChar(20) // SECLUSION(격리) | RESTRAINT(강박)
  reason               String    @db.Text // 법정 사유 — 자·타해 위험이 뚜렷하고 다른 방법으로 위험 회피가 어려운 경우에 한함
  riskType             String    @db.VarChar(20) // SELF_HARM | HARM_OTHERS | BOTH
  orderedById          String    @map("ordered_by_id") @db.Uuid // 지시자(정신건강의학과 전문의)
  psychiatristVerified Boolean   @default(false) @map("psychiatrist_verified") // 지시자 전문의 검증 통과 여부(WARN 모드 감사)
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  legalMaxUntil        DateTime  @map("legal_max_until") @db.Timestamptz() // 법정 최대시간(격리 12h·강박 4h, 연장 시 갱신)
  extensionCount       Int       @default(0) @map("extension_count")
  status               String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | RELEASED
  releasedAt           DateTime? @map("released_at") @db.Timestamptz()
  releasedById         String?   @map("released_by_id") @db.Uuid
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  monitorings PsychSeclusionMonitoring[]
  extensions  PsychSeclusionExtension[]

  @@index([patientId, status])
  @@index([status, legalMaxUntil])
  @@map("psych_seclusion_orders")
}

model PsychSeclusionMonitoring {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  checkedById String   @map("checked_by_id") @db.Uuid
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz()
  observation String?  @db.Text
  vitalSigns  Json?    @map("vital_signs") @db.JsonB
  continued   Boolean  @default(true) // false=지속 불필요 → 자동 해제

  order PsychSeclusionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("psych_seclusion_monitorings")
}

model PsychSeclusionExtension {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  extendedById String   @map("extended_by_id") @db.Uuid // 연장 지시 전문의(대면진찰)
