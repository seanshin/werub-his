// ── 중앙공급실 CSSD (FR-29) ──

enum SterilizationStatus {
  DIRTY
  WASHING
  STERILIZING
  STERILE
  EXPIRED
  IN_USE
}

model InstrumentSet {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @unique @db.VarChar(200) // "일반 수술 세트", "정형외과 세트"
  contents         Json                @db.JsonB // 기구 목록
  status           SterilizationStatus @default(DIRTY)
  lastSterilizedAt DateTime?           @map("last_sterilized_at") @db.Timestamptz()
  expiresAt        DateTime?           @map("expires_at") @db.Timestamptz()
  location         String?             @db.VarChar(100)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  sterilizationLogs SterilizationLog[]

  @@index([status])
  @@map("instrument_sets")
}

model SterilizationLog {
  id              String   @id @default(uuid()) @db.Uuid
  instrumentSetId String   @map("instrument_set_id") @db.Uuid
  action          String   @db.VarChar(50) // "세척", "멸균", "출고", "반납"
  performedBy     String   @map("performed_by") @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  instrumentSet InstrumentSet @relation(fields: [instrumentSetId], references: [id])

  @@index([instrumentSetId])
  @@map("sterilization_logs")
}

// ── CSSD 재포장·패키지 관리 (트레이 마스터 / 멸균 패키지 LOT / 멸균 로드) ──
