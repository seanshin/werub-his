  purpose            String?   @db.VarChar(200)
  periodFrom         DateTime? @map("period_from") @db.Date
  periodTo           DateTime? @map("period_to") @db.Date
  deliveryMethod     String    @default("VISIT") @map("delivery_method") @db.VarChar(20) // VISIT, FAX, MAIL
  copies             Int       @default(1)
  status             String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, PROCESSING, READY, DELIVERED, REJECTED
  fee                Int? // 발급 수수료 (원)
  note               String?   @db.VarChar(500) // 환자 요청 메모
  rejectReason       String?   @map("reject_reason") @db.VarChar(300)
  processedBy        String?   @map("processed_by") @db.Uuid
  processedAt        DateTime? @map("processed_at") @db.Timestamptz()
  draftedBy          String?   @map("drafted_by") @db.Uuid // 임상 기록지 기안자(간호·행정) — 전자결재 확약 결과 알림 대상
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  // P0 의무기록 사본 발급 워크플로우 확장
  requestorAccountId String?   @map("requestor_account_id") @db.Uuid // 신청 계정(본인=환자 계정). 대리(P1) 대비
  // P1 대리인 자격 검증(의료법 §21) — env MEDICAL_RECORD_PROXY_ENABLED OFF 기본, 법무 확정 후 활성
  requesterType      String    @default("SELF") @map("requester_type") @db.VarChar(10) // SELF | PROXY
  requesterRelation  String?   @map("requester_relation") @db.VarChar(30) // 배우자·자녀·법정대리인 등
  legalBasis         String?   @map("legal_basis") @db.VarChar(20) // SELF | LEGAL_GUARDIAN | DELEGATED | BEREAVED
  proxyDocuments     Json?     @map("proxy_documents") @db.JsonB // 구비서류 메타(위임장·신분증·관계증명 첨부 참조)
  proxyVerifyStatus  String    @default("NONE") @map("proxy_verify_status") @db.VarChar(10) // NONE | PENDING | VERIFIED | REJECTED
  proxyVerifiedBy    String?   @map("proxy_verified_by") @db.Uuid
  proxyVerifiedAt    DateTime? @map("proxy_verified_at") @db.Timestamptz()
  recordTypes        Json?     @map("record_types") @db.JsonB // A그룹 요청 기록유형 배열
  encounterId        String?   @map("encounter_id") @db.Uuid // B그룹(진단서) 관련 진료 — 환자가 포털에서 선택
  issuedDocumentId   String?   @map("issued_document_id") @db.VarChar(60) // 발급 결과 IssuedDocument.issueNo
  slaDueAt           DateTime? @map("sla_due_at") @db.Timestamptz() // 처리 기한(P0=표시)
  // P3 수령(delivery) 처리 — 방문/우편(송장)/팩스 수령 완료 추적
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz()
  deliveredBy        String?   @map("delivered_by") @db.Uuid
  deliveryRef        String?   @map("delivery_ref") @db.VarChar(120) // 우편 송장번호 / 팩스 수신번호 / 방문 수령 메모
  // 2026-10-10 창구 접수 — 보낼 곳(우편 주소·팩스 번호). 방문·포털은 null
  deliveryDestination String?  @map("delivery_destination") @db.VarChar(300)
  feeBreakdown       Json?     @map("fee_breakdown") @db.JsonB // 수수료 산정 근거(규칙엔진)
  bundleId           String?   @map("bundle_id") @db.Uuid // F-4 실손보험 서류 세트 묶음(같은 신청 트랜잭션의 요청들을 그룹핑)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient   Patient            @relation(fields: [patientId], references: [id])
  artifacts IssuanceArtifact[]

  @@index([patientId])
  @@index([status])
  @@index([bundleId])
  @@map("document_requests")
}

// F-7 처방약 AI 쉬운 설명 — 약품 코드 단위 캐시(환자 무관 부분만: 효능/주의/부작용/연락 기준)
// source_version = e약은요 개정일(update_de) — 불일치 시 재생성. item_code = 해석된 품목기준코드(2회째부터 1-hop)
model DrugExplainCache {
  medicationCodeId String    @id @map("medication_code_id") @db.Uuid
  itemCode         String?   @map("item_code") @db.VarChar(20)
  content          Json      @db.JsonB // {purpose, cautions[], sideEffects[], whenToCall[]}
  sourceVersion    String?   @map("source_version") @db.VarChar(40)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // 약사 승인제 — 승인분만 환자 노출. 재생성(e약은요 개정) 시 승인 리셋(안전 측)
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz()

  @@map("drug_explain_cache")
}

/// 의무기록 사본 발급 산출물 — 발급 시점 SIGNED 원천을 동결(원본 정정돼도 불변)
model IssuanceArtifact {
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String    @map("request_id") @db.Uuid
  recordType       String    @map("record_type") @db.VarChar(30) // A: ENCOUNTER|PROGRESS|NURSING|DISCHARGE|PRESCRIPTION / B: CERTIFICATE|OPINION|ADMISSION_CERT
  sourceIds        Json      @map("source_ids") @db.JsonB // 동결 원천 PK 목록
  snapshotJson     Json      @map("snapshot_json") @db.JsonB // 발급 시점 데이터 동결(A=기록, B=진단 동결)
  issuedDocumentId String?   @map("issued_document_id") @db.VarChar(60)
  pageCount        Int?      @map("page_count")
  // B그룹(진단서·소견서·입퇴원확인서) 작성·전자서명
  authoredJson     Json?     @map("authored_json") @db.JsonB // 의사 작성 내용(진단명·발병일·향후소견 등)
  signedBy         String?   @map("signed_by") @db.Uuid // 전자서명 의사(=작성자)
  signedAt         DateTime? @map("signed_at") @db.Timestamptz()
  signatureRef     String?   @map("signature_ref") @db.VarChar(120)
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  request DocumentRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("issuance_artifacts")
}

