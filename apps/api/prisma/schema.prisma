model ConsentTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  type           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  language       String   @default("ko") @db.VarChar(10) // 언어별 동의서 템플릿 — 외국인 환자 선호언어 매칭(patient.supportedLanguages)
  version        String   @db.VarChar(20)
  content        Json     @db.JsonB
  requiredFields Json     @map("required_fields") @db.JsonB
  description    String?  @db.VarChar(500)
  components     Json?    @db.JsonB
  variables      Json?    @db.JsonB
  legalChecks    Json?    @map("legal_checks") @db.JsonB
  lastEditedBy   String?  @map("last_edited_by") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  isLatest       Boolean  @default(true) @map("is_latest")
