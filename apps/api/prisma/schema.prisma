// ============================================================
// 트리아지 관리 시스템
// ============================================================

model TriageSymptom {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  category     String?  @db.VarChar(50)
  description  String?  @db.VarChar(200)
  isEmergency  Boolean  @default(false) @map("is_emergency")
  emergencyMsg String?  @map("emergency_msg") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  rules   TriageRule[]
  aliases TriageAlias[]

  @@index([category])
  @@map("triage_symptoms")
}

model TriageRule {
  id             String   @id @default(uuid()) @db.Uuid
  symptomId      String   @map("symptom_id") @db.Uuid
  departmentName String   @map("department_name") @db.VarChar(100)
  priority       Int      @default(1)
  confidence     Int      @default(70)
  reason         String?  @db.VarChar(200)
  condition      String?  @db.VarChar(200)
  isActive       Boolean  @default(true) @map("is_active")
  hitCount       Int      @default(0) @map("hit_count")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  symptom TriageSymptom @relation(fields: [symptomId], references: [id])

  @@unique([symptomId, departmentName])
  @@index([departmentName])
  @@map("triage_rules")
}

model TriageAlias {
  id        String   @id @default(uuid()) @db.Uuid
  symptomId String   @map("symptom_id") @db.Uuid
  alias     String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  hitCount  Int      @default(0) @map("hit_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  symptom TriageSymptom @relation(fields: [symptomId], references: [id])

  @@index([alias])
  @@map("triage_aliases")
