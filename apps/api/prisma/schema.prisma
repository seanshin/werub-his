  countItems               Json?     @map("count_items") @db.JsonB // [{item:'GAUZE', initial, final, status:'MATCH|MISMATCH|NA'}]
  countStatus              String?   @map("count_status") @db.VarChar(20) // MATCH | MISMATCH | UNRESOLVED
  countDiscrepancyNote     String?   @map("count_discrepancy_note") @db.Text // 불일치 해소(재계수·X-ray) 기록
  signOutSpecimenLabeled   Boolean?  @map("sign_out_specimen_labeled")
  signOutRecoveryPlan      Boolean?  @map("sign_out_recovery_plan")
  signOutEquipmentIssues   Boolean?  @map("sign_out_equipment_issues") // WHO: 장비 문제
  signOutCompletedBy       String?   @map("sign_out_completed_by") @db.Uuid
  signOutCompletedAt       DateTime? @map("sign_out_completed_at") @db.Timestamptz()

  @@map("surgical_checklists")
