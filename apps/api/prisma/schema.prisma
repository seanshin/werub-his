  eligibilityStatus  String?   @map("eligibility_status") @db.VarChar(16) // VERIFIED|EXPIRED|NOT_FOUND|ERROR|NOT_CHECKED
  eligibilityCheckId String?   @map("eligibility_check_id") @db.Uuid
