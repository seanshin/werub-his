model ImagingResult {
  id              String              @id @default(uuid()) @db.Uuid
  orderId         String              @unique @map("order_id") @db.Uuid
  patientId       String              @map("patient_id") @db.Uuid
  radiologistId   String?             @map("radiologist_id") @db.Uuid
  // PACS 웹훅이 주는 판독의 표시명 — §6 회수(2026-08-25). 종전엔 DTO 로 받고 버렸다.
  // 🔴 이름으로 User 를 추측 매핑하지 않는다 — 표시명 그대로 보존만(radiologistId 는 원내 경로 전용)
  radiologistName String?             @map("radiologist_name") @db.VarChar(100)
  modality        String              @db.VarChar(50)
  bodyPart        String?             @map("body_part") @db.VarChar(100)
  finding         String?             @db.Text
  impression      String?             @db.Text
  status          ImagingResultStatus @default(ORDERED)
  safetyChecks    Json?               @map("safety_checks") @db.JsonB // 시행 전 안전게이트 평가 결과(조영제·임신·피폭 — override 감사 포함)
  acquiredAt      DateTime?           @map("acquired_at") @db.Timestamptz()
  reportedAt      DateTime?           @map("reported_at") @db.Timestamptz()
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  order    Order              @relation(fields: [orderId], references: [id])
  patient  Patient            @relation(fields: [patientId], references: [id])
  exposure RadiationExposure?

  @@index([patientId, status], map: "idx_imaging_results_patient_status")
  @@index([status, createdAt], map: "idx_imaging_results_status_date")
  @@map("imaging_results")
}

// 진단 피폭선량 기록 — PACS 분리로 DICOM RDSR 자동추출 불가 → 장비 콘솔 판독값 수기 입력
model RadiationExposure {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  imagingResultId  String?  @unique @map("imaging_result_id") @db.Uuid
  modality         String   @db.VarChar(10)
  bodyPart         String?  @map("body_part") @db.VarChar(100)
  dlp              Decimal? @db.Decimal(10, 2) // CT Dose-Length Product (mGy·cm)
  ctdiVol          Decimal? @map("ctdi_vol") @db.Decimal(10, 2) // CTDIvol (mGy)
  doseAreaProduct  Decimal? @map("dose_area_product") @db.Decimal(10, 3) // 투시/일반촬영 DAP (Gy·cm²)
  effectiveDoseMsv Decimal? @map("effective_dose_msv") @db.Decimal(8, 3) // 유효선량 (mSv)
  estimated        Boolean  @default(false) // 유효선량이 DLP×k 변환 추정치인지
  enteredBy        String   @map("entered_by") @db.Uuid
  performedAt      DateTime @default(now()) @map("performed_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient       Patient        @relation(fields: [patientId], references: [id])
  imagingResult ImagingResult? @relation(fields: [imagingResultId], references: [id])

  @@index([patientId, performedAt])
  @@map("radiation_exposures")
}

// ── 건강보험 청구 (FR-15) ──

model Claim {
  id             String      @id @default(uuid()) @db.Uuid
  billingId      String      @map("billing_id") @db.Uuid
  patientId      String      @map("patient_id") @db.Uuid
  claimNumber    String?     @unique @map("claim_number") @db.VarChar(50)
  claimDate      DateTime    @map("claim_date") @db.Date
  claimedAmount  Int         @map("claimed_amount")
  approvedAmount Int?        @map("approved_amount")
  paidAmount     Int?        @map("paid_amount")
  reducedAmount  Int?        @map("reduced_amount")
  status         ClaimStatus @default(DRAFT)
  submittedAt    DateTime?   @map("submitted_at") @db.Timestamptz()
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamptz()
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz()
  rejectReason   String?     @map("reject_reason") @db.Text
  claimData      Json?       @map("claim_data") @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  billing       Billing             @relation(fields: [billingId], references: [id])
  patient       Patient             @relation(fields: [patientId], references: [id])
  hiraDocuments HiraClaimDocument[]
  adjustments   ClaimAdjustment[]

  @@index([billingId])
  @@index([status])
  @@index([claimDate])
  @@index([status, claimDate], map: "idx_claims_status_date")
  @@index([patientId, status], map: "idx_claims_patient_status")
  @@map("claims")
}

/// 심사조정(삭감) 라인 — 청구 단위 총액(reducedAmount)만 있던 삭감을 항목·사유코드 단위로 (2026-07 R3-3).
/// EDI 반송파일 자동 파싱은 포맷 확보 후 — 1차는 심사결과 통지 기반 기록.
model ClaimAdjustment {
  id           String   @id @default(uuid()) @db.Uuid
  claimId      String   @map("claim_id") @db.Uuid
  lineRef      String?  @map("line_ref") @db.VarChar(120) // 청구 라인 식별(처방ID·수가코드 등)
  itemName     String?  @map("item_name") @db.VarChar(200)
  adjustCode   String   @map("adjust_code") @db.VarChar(20) // HIRA 심사조정 사유코드
  adjustReason String?  @map("adjust_reason") @db.VarChar(300)
  amount       Int // 삭감액(원)
  status       String   @default("ACCEPTED") @db.VarChar(12) // ACCEPTED(수용)|APPEALING(이의)|REWORK(재작업)|RESOLVED
  recordedBy   String?  @map("recorded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([adjustCode])
  @@index([status])
  @@map("claim_adjustments")
}

// ============================================================
// Phase 4: 원무 + 입원 + 병상
// ============================================================

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEANING // 퇴원 후 청소·소독 대기(가용 아님)
  ISOLATION // 격리 병상(감염관리)
}

// ── 병상 관리 (FR-27) ──

model Ward {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(100) // "5층 내과병동"
  floor    Int
  type     String  @default("GENERAL") @db.VarChar(20) // GENERAL|EMERGENCY — 입원 가용 조회에서 EMERGENCY 제외(ER 베드 보드 D1)
  isActive Boolean @default(true) @map("is_active")
  beds     Bed[]

  @@map("wards")
}

model Bed {
  id         String    @id @default(uuid()) @db.Uuid
  wardId     String    @map("ward_id") @db.Uuid
  roomNumber String    @map("room_number") @db.VarChar(20) // "501"
  bedNumber  String    @map("bed_number") @db.VarChar(10) // "A", "B"
  status     BedStatus @default(AVAILABLE)
  bedClass   String    @default("GENERAL") @map("bed_class") @db.VarChar(20) // 병상 등급(GENERAL|SEMI_PRIVATE|PRIVATE…) — 입원료 일당 차등(config inpatient.bedRates)

  ward           Ward            @relation(fields: [wardId], references: [id])
  admissions     Admission[]
  bedAssignments BedAssignment[]
  /// 🔴 (2026-10-02) 도면의 방(또는 응급실 한 공간) — null = 미연결(위치를 모른다). **사람이 잇는다**(층·호실이 같아도 제안만).
  ///    방 하나에 병상 여럿이라 병상 쪽에 둔다(`SpaceNode.bedId` 는 1:1 이라 쓰지 않는다 — 비어 있는 옛 열).
  spaceNodeId    String?         @map("space_node_id") @db.Uuid
  spaceNode      SpaceNode?      @relation(fields: [spaceNodeId], references: [id])

  @@unique([wardId, roomNumber, bedNumber])
  @@index([spaceNodeId])
  @@index([status])
  @@map("beds")
}

// ── 입원 관리 (FR-24) ──

model Admission {
  id                String @id @default(uuid()) @db.Uuid
  patientId         String @map("patient_id") @db.Uuid
  bedId             String @map("bed_id") @db.Uuid
  admittingDoctorId String @map("admitting_doctor_id") @db.Uuid

  admitDate             DateTime        @map("admit_date") @db.Timestamptz()
  dischargeDate         DateTime?       @map("discharge_date") @db.Timestamptz()
  expectedDischargeDate DateTime?       @map("expected_discharge_date") @db.Timestamptz() // 퇴원 예정일(재원 중 계획·DC_PLAN 판정·병상회전 예측)
  status                AdmissionStatus @default(ADMITTED)

  admitReason       String? @map("admit_reason") @db.Text
  dischargeSummary  String? @map("discharge_summary") @db.Text
  dietType          String? @map("diet_type") @db.VarChar(100)
  attendingDoctorId String? @map("attending_doctor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient             Patient                  @relation(fields: [patientId], references: [id])
  bed                 Bed                      @relation(fields: [bedId], references: [id])
  admittingDoctor     User                     @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  attendingDoctor     User?                    @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])
  progressNotes       ProgressNote[]
  mealOrders          MealOrder[]
  specialNutrition    SpecialNutritionOrder[]
  dischargeSummaryDoc DischargeSummary?
  nursingAssessments  NursingAssessment[]
  nursingNotes        NursingNote[]
  intakeOutputs       IntakeOutput[]
  chargeOfCare        ChargeOfCare[]
  bedAssignments      BedAssignment[]
  rounds              Round[]
  encounters          Encounter[]              @relation("AdmissionEncounters")
  handoffs            ClinicalHandoff[]
  nurseAssignments    NursePatientAssignment[]
  flowSheetEntries    FlowSheetEntry[]
  nursingChecklists   NursingChecklist[]
  interimBillings     InterimBilling[]

  @@index([patientId])
  @@index([status])
  @@index([bedId])
  @@index([attendingDoctorId])
  @@index([status, admitDate], map: "idx_admissions_status_date")
  @@map("admissions")
}

// ── 입원 중간 정산 ──

model InterimBilling {
  id              String    @id @default(uuid()) @db.Uuid
  admissionId     String    @map("admission_id") @db.Uuid
  periodStart     DateTime  @map("period_start") @db.Date
  periodEnd       DateTime  @map("period_end") @db.Date
  sequenceNo      Int       @map("sequence_no")
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(12, 0)
  insuranceAmount Decimal   @default(0) @map("insurance_amount") @db.Decimal(12, 0)
  copayAmount     Decimal   @default(0) @map("copay_amount") @db.Decimal(12, 0)
  status          String    @default("GENERATED") @db.VarChar(20) // GENERATED, NOTIFIED, PAID, OVERDUE, VOID(2026-10-22 무효 · 수납 전만)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz()
  paidAmount      Decimal?  @map("paid_amount") @db.Decimal(12, 0)
  billingId       String?   @map("billing_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// 2026-10-22 중간정산 산정 근거 — 퇴원 입원료 청구와 같은 정본(BillingService.quoteInpatientStay) · null = 이 칸 전 생성분(근거 모름)
  days            Int?
  dailyRate       Decimal?  @map("daily_rate") @db.Decimal(12, 0)
  stayCode        String?   @map("stay_code") @db.VarChar(20)
  /// 단가 출처 — CODE(수가 마스터) · CONFIG_BED_CLASS · CONFIG_DAILY · DEFAULT_CONSTANT(설정 없음 → 상수 · 근거 없는 단가)
  priceBasis      String?   @map("price_basis") @db.VarChar(30)
  copayRate       Decimal?  @map("copay_rate") @db.Decimal(5, 4)
  createdBy       String?   @map("created_by") @db.Uuid
  paidBy          String?   @map("paid_by") @db.Uuid
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy        String?   @map("voided_by") @db.Uuid
  voidReason      String?   @map("void_reason") @db.Text

  admission Admission @relation(fields: [admissionId], references: [id])
  payments  InterimBillingPayment[]
  refunds   InterimBillingRefund[]

  @@unique([admissionId, sequenceNo])
  @@index([admissionId])
  @@index([status])
  @@map("interim_billings")
}

/// 중간정산 수납 원장(2026-10-22) — 외래 수납 원장(billing_payments)과 같은 칸. 덧붙이기만.
/// 🔴 종전엔 중간정산 수납에 수단·처리자·원장 줄이 없어 일마감 시재·카드 대사에서 그 돈이 보이지 않았고 ERP 는 어느 계정으로 받을지 몰랐다.
model InterimBillingPayment {
  id               String   @id @default(uuid()) @db.Uuid
  interimBillingId String   @map("interim_billing_id") @db.Uuid
  method           String   @db.VarChar(20) // CARD|CASH|TRANSFER (shared INTERIM_PAYMENT_METHODS)
  amount           Int
  cardApprovalNo   String?  @map("card_approval_no") @db.VarChar(30)
  cardCompany      String?  @map("card_company") @db.VarChar(30)
  installment      Int?
  cashReceiptNo    String?  @map("cash_receipt_no") @db.VarChar(30)
  processedBy      String?  @map("processed_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  interimBilling InterimBilling @relation(fields: [interimBillingId], references: [id])

  @@index([interimBillingId])
  @@index([createdAt])
  @@map("interim_billing_payments")
}

/// 중간정산 환불 원장(2026-10-22 · ERP 회신 R5 계약) — 덧붙이기만 · id = ERP 멱등 키(refundId) · 부분 환불 · 누적 ≤ 그 회차 수납액.
/// 이벤트 `billing.interim_refunded`(수납 이벤트 뒤) · 회차 상태는 PAID 그대로(무효 아님) · 퇴원 정산 기납부에서 뺀다.
model InterimBillingRefund {
  id               String   @id @default(uuid()) @db.Uuid
  interimBillingId String   @map("interim_billing_id") @db.Uuid
  amount           Int
  method           String   @db.VarChar(20) // CARD|CASH|TRANSFER (shared INTERIM_PAYMENT_METHODS)
  reason           String   @db.Text
  refundedBy       String?  @map("refunded_by") @db.Uuid
  refundedAt       DateTime @default(now()) @map("refunded_at") @db.Timestamptz()
  // 2026-10-22 v4.118.0 ERP 2차 회신 — 요청 중복 방지 키(Idempotency-Key). 같은 키 재요청 = 첫 결과(새 환불 없음) · v4.117.0 기간 행은 null
  requestKey       String?  @unique @map("request_key") @db.VarChar(100)

  interimBilling InterimBilling @relation(fields: [interimBillingId], references: [id])

  @@index([interimBillingId])
  @@index([refundedAt])
  @@map("interim_billing_refunds")
}

// ── 입원 경과기록 ──

model ProgressNote {
  id          String   @id @default(uuid()) @db.Uuid
  admissionId String   @map("admission_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  noteDate    DateTime @map("note_date") @db.Date
  content     String   @db.Text
  vitalSigns  Json?    @map("vital_signs") @db.JsonB
  /// PROGRESS(일일 경과기록) | ADMISSION(입원 초진기록·H&P) — 2026-09-30 H&P 를 둘 자리가 없어 신설(기존 행=PROGRESS)
  noteType    String   @default("PROGRESS") @map("note_type") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  doctor    User      @relation("ProgressNoteDoctor", fields: [doctorId], references: [id])

  @@index([admissionId])
  // 경과기록 본문 검색 — 운영에 수동으로만 있어 `db push` 미리보기가 DROP 하려 들었다(2026-09-13 실측 · CLAUDE.md 배포 규칙). 스키마로 고정(2026-10-01)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_progress_notes_content_trgm")
  @@map("progress_notes")
}

// ── 증명서 발급 (FR-23 원무) ──

model Certificate {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  issuedBy  String   @map("issued_by") @db.Uuid
  type      String   @db.VarChar(50) // "진단서", "소견서", "입퇴원확인서"
  content   Json     @db.JsonB
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])
  issuer  User    @relation("CertificateIssuer", fields: [issuedBy], references: [id])

  @@index([patientId])
  @@map("certificates")
}

// ============================================================
// Phase 5: 수술 + 응급실
// ============================================================

enum SurgeryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// 수술 부위 좌우(P2-A) — 오부위수술(wrong-site) 방지. 좌우구분 술식에서 필수 검증.
enum Laterality {
  LEFT
  RIGHT
  BILATERAL
  MIDLINE
  NA
}

enum KtasLevel {
  LEVEL_1 // 소생 (즉시)
  LEVEL_2 // 긴급 (10분)
  LEVEL_3 // 응급 (30분)
  LEVEL_4 // 준응급 (60분)
  LEVEL_5 // 비응급 (120분)
}

enum EmergencyDisposition {
  DISCHARGE // 귀가
  ADMISSION // 입원
  TRANSFER // 전원
  DEATH // 사망
  LEAVE_AMA // 자의퇴원
  OBSERVATION // 관찰실
  SURGERY // 수술
}

// ── 수술 관리 (FR-25) ──

model Surgery {
  id            String  @id @default(uuid()) @db.Uuid
  patientId     String  @map("patient_id") @db.Uuid
  surgeonId     String  @map("surgeon_id") @db.Uuid
  anesthetistId String? @map("anesthetist_id") @db.Uuid
  admissionId   String? @map("admission_id") @db.Uuid

  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  endedAt     DateTime? @map("ended_at") @db.Timestamptz()

  procedureName String        @map("procedure_name") @db.VarChar(500)
  procedureCode String?       @map("procedure_code") @db.VarChar(20)
  // 오부위수술 방지(P2-A) — 부위·좌우. Time-out 3자대조(예약=표시=동의서) 원천. CancerRegistry.laterality(String)와는 별개 표현.
  bodySite      String?       @map("body_site") @db.VarChar(200)
  laterality    Laterality?
  status        SurgeryStatus @default(SCHEDULED)

  // Op Note (구조화 15필드)
  preOpDiagnosis  String?   @map("pre_op_diagnosis") @db.Text
  postOpDiagnosis String?   @map("post_op_diagnosis") @db.Text
  opNote          String?   @map("op_note") @db.Text // 수술 상세 기술
  findings        String?   @db.Text
  complications   String?   @db.Text
  specimens       String?   @db.Text // 검체
  ebl             Int? // 추정 실혈량 (mL)
  fluidsGiven     String?   @map("fluids_given") @db.VarChar(500) // 수액/수혈
  implants        String?   @db.Text // 삽입물/기기
  drains          String?   @db.VarChar(500) // 배액관
  incisionTime    DateTime? @map("incision_time") @db.Timestamptz()
  closureTime     DateTime? @map("closure_time") @db.Timestamptz()
  assistantId     String?   @map("assistant_id") @db.Uuid
  scrubNurseId    String?   @map("scrub_nurse_id") @db.Uuid
  /// 순회 간호(2026-10-05 수술방 차트) — 종전엔 자리가 없어 수술팀에서 빠졌다 · 간호사가 "내가 맡기"로 지정(감사)
  circulatingNurseId String? @map("circulating_nurse_id") @db.Uuid

  // Anesthesia
  anesthesiaType String? @map("anesthesia_type") @db.VarChar(50)
  anesthesiaNote String? @map("anesthesia_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient                 Patient                  @relation(fields: [patientId], references: [id])
  surgeon                 User                     @relation("SurgeonSurgeries", fields: [surgeonId], references: [id])
  consentForms            ConsentForm[]
  opNoteDetail            SurgeryOpNote?
  preAnesthesiaEvaluation PreAnesthesiaEvaluation?

  @@index([patientId])
  @@index([scheduledAt])
  @@index([status])
  @@map("surgeries")
}

/// 마취전평가(Pre-anesthesia Evaluation) — 술전 독립 게이트(2026-07 R2-2).
/// config surgery.preAnesthesiaGate ON 시 WHO 체크리스트 sign-in 진입 전 COMPLETED 필수.
model PreAnesthesiaEvaluation {
  id                String    @id @default(uuid()) @db.Uuid
  surgeryId         String    @unique @map("surgery_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  evaluatorId       String    @map("evaluator_id") @db.Uuid // 마취과 의사
  asaClass          String?   @map("asa_class") @db.VarChar(4) // 1~6, E 접미(응급)
  airwayMallampati  String?   @map("airway_mallampati") @db.VarChar(4) // I~IV
  npoConfirmed      Boolean   @default(false) @map("npo_confirmed") // 금식 확인
  npoSince          DateTime? @map("npo_since") @db.Timestamptz()
  cardiacRiskRcri   Int?      @map("cardiac_risk_rcri") // RCRI 0~6
  pulmonaryRisk     String?   @map("pulmonary_risk") @db.VarChar(200)
  labsReviewed      Boolean   @default(false) @map("labs_reviewed") // 술전검사 리뷰
  anesthesiaConsent Boolean   @default(false) @map("anesthesia_consent") // 마취 동의 확인
  plan              String?   @db.VarChar(20) // GENERAL|SPINAL|EPIDURAL|SEDATION|LOCAL
  status            String    @default("DRAFT") @db.VarChar(12) // DRAFT|COMPLETED
  completedAt       DateTime? @map("completed_at") @db.Timestamptz()
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  surgery   Surgery @relation(fields: [surgeryId], references: [id])
  evaluator User    @relation("PreAnesthesiaEvaluator", fields: [evaluatorId], references: [id])

  @@index([patientId])
  @@map("pre_anesthesia_evaluations")
}

// ── 응급실 (FR-26) ──

// ── 응급 도착 상황 기록(2026-09-29 · 기획 er-arrival-record) ──
// 🔴 종전 응급 미확인 등록의 "도착 상황 메모"·"손상 유형"은 API 가 검증 후 **버렸다**(저장 0 · 개통 이래).
// 첫 기록(INITIAL) + 추가 기록(ADDENDUM) — **고치지 않고 덧붙인다**(나중에 들은 사실이 원래 기록을 덮지 않게).
// 어휘 정본 shared `er-arrival.ts` · 모르는 칸은 null(도착 시각을 '지금'으로 박지 않는다).
/// 환자 교육 기록(2026-09-30) — 누가·누구에게·무엇을·어떻게·이해했는가. 어휘 정본 shared `patient-education.ts`.
/// 지우지 않는다 — 잘못 쓴 것은 사유와 함께 무효 처리(voided*). 이해도는 평가한 경우에만(null = 미기록).
model PatientEducationRecord {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  admissionId    String?   @map("admission_id") @db.Uuid // 기록 시점에 재원 중이던 입원(서버가 채운다)
  encounterId    String?   @map("encounter_id") @db.Uuid
  topic          String    @db.VarChar(30)
  content        String    @db.Text
  learner        String    @db.VarChar(24)
  learnerNote    String?   @map("learner_note") @db.VarChar(200) // 보호자 관계 등
  methods        Json? // EducationMethod[] — String[] 대신 Json(DB 이식성 기준)
  understanding  String?   @db.VarChar(16)
  barriers       String?   @db.VarChar(200) // 언어·청력·인지 등 교육 장애
  followUpNeeded Boolean?  @map("follow_up_needed")
  educatedAt     DateTime  @map("educated_at") @db.Timestamptz()
  educatorId     String    @map("educator_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz()
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.Text
  patient        Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, educatedAt])
  @@index([admissionId])
  @@map("patient_education_records")
}

model EmergencyArrivalNote {
  id                  String    @id @default(uuid()) @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  kind                String    @db.VarChar(12) // INITIAL | ADDENDUM
  arrivalAt           DateTime? @map("arrival_at") @db.Timestamptz()
  arrivalMode         String?   @map("arrival_mode") @db.VarChar(20)
  emsUnit             String?   @map("ems_unit") @db.VarChar(100)
  foundLocation       String?   @map("found_location") @db.VarChar(300)
  foundAt             DateTime? @map("found_at") @db.Timestamptz()
  circumstance        String?   @db.Text
  consciousness       String?   @db.VarChar(16)
  injuryTypes         Json?     @map("injury_types") // InjuryType[] — String[] 대신 Json(DB 이식성 기준)
  companionType       String?   @map("companion_type") @db.VarChar(20)
  companionName       String?   @map("companion_name") @db.VarChar(100)
  companionContact    String?   @map("companion_contact") @db.VarChar(100)
  companionRelation   String?   @map("companion_relation") @db.VarChar(100)
  belongings          Json? // [{ item, custody }]
  identifyingFeatures String?   @map("identifying_features") @db.Text
  policeInvolved      Boolean?  @map("police_involved")
  policeAgency        String?   @map("police_agency") @db.VarChar(100)
  policeOfficer       String?   @map("police_officer") @db.VarChar(100)
  policeCaseNo        String?   @map("police_case_no") @db.VarChar(100)
  infoSource          String?   @map("info_source") @db.VarChar(20)
  note                String?   @db.Text
  // 119·전원 사전통보에서 불러와 쓴 기록이면 그 통보(초안 출처 — 사람이 확인하고 저장한 것) · 2026-09-29
  prenotificationId   String?   @map("prenotification_id") @db.Uuid
  recordedById        String?   @map("recorded_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  patient             Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("emergency_arrival_notes")
}

model EmergencyVisit {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  doctorId  String? @map("doctor_id") @db.Uuid

  arrivalAt      DateTime  @map("arrival_at") @db.Timestamptz()
  triageLevel    KtasLevel @map("triage_level")
  chiefComplaint String    @map("chief_complaint") @db.Text
  // 세분화 상태
  status         String    @default("PENDING_TRIAGE") @db.VarChar(25) // PENDING_TRIAGE, TRIAGED, PENDING_DOCTOR, IN_TREATMENT, PENDING_RESULT, UNDER_OBSERVATION, PENDING_DISPOSITION, COMPLETED
  isNonEmergency Boolean   @default(false) @map("is_non_emergency") // KTAS 5 비응급 판정

  // Triage
  triageNurseId String?   @map("triage_nurse_id") @db.Uuid
  triagedAt     DateTime? @map("triaged_at") @db.Timestamptz()
  triageNote    String?   @map("triage_note") @db.Text
  vitalSigns    Json?     @map("vital_signs") @db.JsonB

  // Treatment
  treatmentNote      String?   @map("treatment_note") @db.Text
  treatmentStartedAt DateTime? @map("treatment_started_at") @db.Timestamptz()

  // Disposition
  disposition     EmergencyDisposition?
  dispositionAt   DateTime?             @map("disposition_at") @db.Timestamptz()
  dispositionNote String?               @map("disposition_note") @db.Text
  admissionId     String?               @map("admission_id") @db.Uuid // 입원 연계
  /// 응급실 퇴실 시각(2026-10-03 결정 D9 `emergency.departureTimeSource` = DEPARTED_AT_FIELD) — 퇴실·입원 전환·사망 시 남긴다.
  /// 자동 종결 등 떠난 시각을 모르면 null(지어내지 않는다). 응급 체류(ED LOS)·방문 끝·위치 닫기의 정본.
  departedAt       DateTime? @map("departed_at") @db.Timestamptz()
  /// RECORDED = 처리 버튼을 누른 시각 · USER_CLAIMED = 직원이 입력한 과거 시각(입력값으로 표식)
  departedAtSource String?   @map("departed_at_source") @db.VarChar(20)

  // ER 잔여 3종(2026-07-23) — NEDOCS 인공호흡기 카운트·MCI 사상자 태깅(둘 다 additive nullable)
  onVentilator Boolean @default(false) @map("on_ventilator") // 인공호흡기 적용 중(NEDOCS 입력·간호평가/상태변경에서 갱신)
  mciEventId   String? @map("mci_event_id") @db.Uuid // 다수사상자(MCI) 이벤트 연계

  // ER 베드 보드(2026-08-05) — 현재 배정 캐시. 정본은 EmergencyBedAssignment(불일치 시 assignment 가 이긴다)
  bedId String? @map("bed_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient           Patient                     @relation(fields: [patientId], references: [id])
  reassessments     EmergencyReassessment[]
  dispositionRecord EmergencyDispositionRecord?
  nursingAssessment EmergencyNursingAssessment?

  @@index([patientId])
  @@index([triageLevel])
  @@index([arrivalAt])
  @@map("emergency_visits")
}

// ER 베드 배정 이력 정본(2026-08-05·베드 보드 D2) — 동시 배정 방지는 부분 유니크 인덱스(수동 DDL):
//   uq_er_bed_active   ON (bed_id)   WHERE released_at IS NULL
//   uq_er_visit_active ON (visit_id) WHERE released_at IS NULL
model EmergencyBedAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  visitId       String    @map("visit_id") @db.Uuid
  bedId         String    @map("bed_id") @db.Uuid
  assignedBy    String    @map("assigned_by") @db.Uuid
  assignedAt    DateTime  @default(now()) @map("assigned_at") @db.Timestamptz()
  releasedAt    DateTime? @map("released_at") @db.Timestamptz()
  releaseReason String?   @map("release_reason") @db.VarChar(30) // MOVE|DISPOSITION|MANUAL|AUTO_CLOSE

  @@index([visitId])
  @@index([bedId, releasedAt])
  @@map("emergency_bed_assignments")
}

// 응급실 골든타임 크리티컬 패스웨이(STEMI/뇌졸중/패혈증) — plain visitId/patientId(비파괴)
model EmergencyGoldenPathway {
  id                   String    @id @default(uuid()) @db.Uuid
  visitId              String?   @map("visit_id") @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  pathwayType          String    @map("pathway_type") @db.VarChar(20) // STEMI/STROKE/SEPSIS
  primaryMetric        String    @map("primary_metric") @db.VarChar(40) // Door-to-Balloon 등
  targetMinutes        Int       @map("target_minutes")
  milestones           Json      @db.JsonB // [{key,label,targetMin,doneAt,doneBy}]
  status               String    @default("ACTIVE") @db.VarChar(20) // ACTIVE/COMPLETED/CANCELLED
  activatedBy          String    @map("activated_by") @db.Uuid
  activatedAt          DateTime  @default(now()) @map("activated_at") @db.Timestamptz()
  completedAt          DateTime? @map("completed_at") @db.Timestamptz()
  primaryMetricMinutes Int?      @map("primary_metric_minutes") // 핵심지표 실측 소요분
  notes                String?   @db.Text

  @@index([status])
  @@index([patientId])
  @@map("emergency_golden_pathways")
}

/// 119/전원 사전통보(pre-arrival notification) — 구급대·이송기관이 도착 전 환자 정보를 통보(ER 잔여 2026-07-23).
/// 수신=서버-서버(X-Integration-Key emergency.emsKey·fail-closed) 또는 직원 수기. 도착 시 트리아지(visit)와 연결.
model EmergencyPrenotification {
  id             String    @id @default(uuid()) @db.Uuid
  source         String    @default("EMS_119") @db.VarChar(20) // EMS_119 | TRANSFER(전원) | OTHER
  unitId         String?   @map("unit_id") @db.VarChar(40) // 구급대/이송기관 식별
  etaMinutes     Int?      @map("eta_minutes")
  etaAt          DateTime? @map("eta_at") @db.Timestamptz()
  patientAge     Int?      @map("patient_age")
  patientGender  String?   @map("patient_gender") @db.VarChar(10)
  chiefComplaint String    @map("chief_complaint") @db.Text
  severityHint   String?   @map("severity_hint") @db.VarChar(20) // 구급대 추정 중증도(참고용 — KTAS는 도착 후 병원 판정)
  vitals         Json?     @db.JsonB
  note           String?   @db.Text
  status         String    @default("EN_ROUTE") @db.VarChar(20) // EN_ROUTE | ARRIVED | CANCELLED
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz()
  linkedVisitId  String?   @map("linked_visit_id") @db.Uuid // 도착 후 트리아지 visit 연결

  @@index([status, receivedAt])
  @@map("emergency_prenotifications")
}

/// 다수사상자/재난(MCI) 이벤트 — 활성 중 ER 보드 배너·사상자 visit 태깅(mciEventId)(ER 잔여 2026-07-23).
model MciEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String    @db.VarChar(200)
  type               String    @default("MCI") @db.VarChar(20) // MCI | DISASTER | DRILL(훈련)
  status             String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | CLOSED
  expectedCasualties Int?      @map("expected_casualties")
  note               String?   @db.Text
  activatedBy        String    @map("activated_by") @db.Uuid
  activatedAt        DateTime  @default(now()) @map("activated_at") @db.Timestamptz()
  closedBy           String?   @map("closed_by") @db.Uuid
  closedAt           DateTime? @map("closed_at") @db.Timestamptz()

  @@index([status, activatedAt])
  @@map("mci_events")
}

model EmergencyReassessment {
  id            String   @id @default(uuid()) @db.Uuid
  visitId       String   @map("visit_id") @db.Uuid
  previousLevel String   @map("previous_level") @db.VarChar(10)
  newLevel      String   @map("new_level") @db.VarChar(10)
  reason        String   @db.Text
  vitals        Json?    @db.JsonB
  assessedBy    String   @map("assessed_by") @db.Uuid
  assessedAt    DateTime @default(now()) @map("assessed_at") @db.Timestamptz()

  visit EmergencyVisit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("emergency_reassessments")
}

model EmergencyDispositionRecord {
  id                    String    @id @default(uuid()) @db.Uuid
  visitId               String    @unique @map("visit_id") @db.Uuid
  disposition           String    @db.VarChar(20)
  decidedBy             String    @map("decided_by") @db.Uuid
  decidedAt             DateTime  @default(now()) @map("decided_at") @db.Timestamptz()
  dischargeInstructions String?   @map("discharge_instructions") @db.Text
  followUpDate          DateTime? @map("followup_date") @db.Timestamptz()
  admissionId           String?   @map("admission_id") @db.Uuid
  transferTo            String?   @map("transfer_to") @db.VarChar(200)
  transferReason        String?   @map("transfer_reason") @db.Text

  visit EmergencyVisit @relation(fields: [visitId], references: [id])

  @@map("emergency_dispositions")
}

model EmergencyNursingAssessment {
  id           String   @id @default(uuid()) @db.Uuid
  visitId      String   @unique @map("visit_id") @db.Uuid
  airway       String   @db.VarChar(20)
  breathing    String   @db.VarChar(20)
  circulation  String   @db.VarChar(20)
  gcsEye       Int?     @map("gcs_eye")
  gcsVerbal    Int?     @map("gcs_verbal")
  gcsMotor     Int?     @map("gcs_motor")
  painScale    Int?     @map("pain_scale")
  painLocation String?  @map("pain_location") @db.VarChar(100)
  assessedBy   String   @map("assessed_by") @db.Uuid
  assessedAt   DateTime @default(now()) @map("assessed_at") @db.Timestamptz()

  visit EmergencyVisit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("emergency_nursing_assessments")
}

// ============================================================
// Phase 5+: 자재/CSSD/영양/장비
// ============================================================

enum InventoryTxType {
  IN // 입고
  OUT // 출고
  ADJUST // 조정
  RETURN // 반품
  TRANSFER // 이동
  ISSUE // 불출
  RECEIVE // 입고검수
  DISPOSAL // 폐기
  EXPIRED // 유효기간만료
}

// ── 자재/재고 관리 (FR-28) ──

model InventoryItem {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique @db.VarChar(50)
  erpItemCode       String?   @map("erp_item_code") @db.VarChar(60) // ERP 품목코드 매핑
  name              String    @db.VarChar(300)
  category          String    @db.VarChar(100) // 소모품, 수술소모품, 검사소모품, 의약품, 의료기기
  unit              String    @db.VarChar(30) // 개, 박스, 병, 팩
  specification     String?   @db.VarChar(500) // 규격 (3mL, 4x4인치)
  barcode           String?   @db.VarChar(100) // GS1-128 바코드
  /// GS1 GTIN-14 — 바코드에서 파싱해 채운다(`parseGs1`). 🔴 바코드 원문은 그대로 보존한다
  gtin              String?   @db.VarChar(14)
  manufacturer      String?   @db.VarChar(200) // 제조사
  countryOfOrigin   String?   @map("country_of_origin") @db.VarChar(50) // 원산지
  storageCondition  String?   @map("storage_condition") @db.VarChar(100) // 실온, 냉장2~8℃
  currentStock      Int       @default(0) @map("current_stock")
  safetyStock       Int       @default(10) @map("safety_stock")
  maxStock          Int?      @map("max_stock") // 최대재고
  reorderPoint      Int?      @map("reorder_point") // 발주점
  reorderQty        Int?      @map("reorder_qty") // 발주 단위 수량
  leadTimeDays      Int?      @map("lead_time_days") // 납품 리드타임(일)
  supplierName      String?   @map("supplier_name") @db.VarChar(200)
  unitPrice         Int?      @map("unit_price")
  lastPurchaseDate  DateTime? @map("last_purchase_date") @db.Date
  lastPurchasePrice Int?      @map("last_purchase_price")
  defaultStorageId  String?   @map("default_storage_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  transactions   InventoryTransaction[]
  lots           InventoryLot[]
  itemSuppliers  InventoryItemSupplier[]
  defaultStorage InventoryStorage?       @relation("DefaultStorage", fields: [defaultStorageId], references: [id])
  countItems     InventoryCountItem[]

  @@index([category])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  itemId          String          @map("item_id") @db.Uuid
  type            InventoryTxType
  quantity        Int
  reason          String?         @db.VarChar(500)
  performedBy     String          @map("performed_by") @db.Uuid
  lotId           String?         @map("lot_id") @db.Uuid
  storageId       String?         @map("storage_id") @db.Uuid
  unitCost        Int?            @map("unit_cost")
  totalCost       Int?            @map("total_cost")
  referenceNumber String?         @map("reference_number") @db.VarChar(100)
  department      String?         @db.VarChar(100)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  item    InventoryItem     @relation(fields: [itemId], references: [id])
  lot     InventoryLot?     @relation(fields: [lotId], references: [id])
  storage InventoryStorage? @relation(fields: [storageId], references: [id])

  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ── 보관장소 ──

model InventoryStorage {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(200)
  type        String   @db.VarChar(50) // WAREHOUSE, PHARMACY, WARD, DEPARTMENT, COLD_STORAGE
  location    String?  @db.VarChar(200)
  parentId    String?  @map("parent_id") @db.Uuid
  temperature String?  @db.VarChar(50)
  capacity    Int?
  managerName String?  @map("manager_name") @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  parent       InventoryStorage?      @relation("StorageTree", fields: [parentId], references: [id])
  children     InventoryStorage[]     @relation("StorageTree")
  lots         InventoryLot[]
  transactions InventoryTransaction[]
  defaultItems InventoryItem[]        @relation("DefaultStorage")
  counts       InventoryCount[]

  @@map("inventory_storages")
}

// ── 거래처 마스터 ──

model InventorySupplier {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(30)
  erpVendorCode  String?   @map("erp_vendor_code") @db.VarChar(60) // ERP 거래처코드 매핑
  name           String    @db.VarChar(200)
  businessNumber String?   @map("business_number") @db.VarChar(20)
  representative String?   @db.VarChar(100)
  contactName    String?   @map("contact_name") @db.VarChar(100)
  contactPhone   String?   @map("contact_phone") @db.VarChar(50)
  contactEmail   String?   @map("contact_email") @db.VarChar(255)
  address        String?   @db.Text
  paymentTerms   String?   @map("payment_terms") @db.VarChar(100)
  contractExpiry DateTime? @map("contract_expiry") @db.Date
  rating         String?   @db.VarChar(20)
  isActive       Boolean   @default(true) @map("is_active")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  itemSuppliers  InventoryItemSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("inventory_suppliers")
}

// ── 품목-거래처 매핑 ──

model InventoryItemSupplier {
  id               String  @id @default(uuid()) @db.Uuid
  itemId           String  @map("item_id") @db.Uuid
  supplierId       String  @map("supplier_id") @db.Uuid
  supplierItemCode String? @map("supplier_item_code") @db.VarChar(100)
  unitPrice        Int?    @map("unit_price")
  leadTimeDays     Int?    @map("lead_time_days")
  isPrimary        Boolean @default(false) @map("is_primary")
  minOrderQty      Int?    @map("min_order_qty")

  item     InventoryItem     @relation(fields: [itemId], references: [id])
  supplier InventorySupplier @relation(fields: [supplierId], references: [id])

  @@unique([itemId, supplierId])
  @@map("inventory_item_suppliers")
}

// ── LOT/유효기간 ──

model InventoryLot {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  lotNumber       String    @map("lot_number") @db.VarChar(100)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  quantity        Int       @default(0)
  storageId       String?   @map("storage_id") @db.Uuid
  unitCost        Int?      @map("unit_cost")
  status          String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, EXPIRED, CONSUMED, RECALLED
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

