}

// ============================================================
// 한국 의료 코드 마스터 (FR-20)
// ============================================================

// 질병분류코드 (KCD-8, ICD-10, ICD-11 다중 코드체계)
model DiagnosisCode {
  id             String    @id @default(uuid()) @db.Uuid
  codeSystem     String    @default("KCD-8") @map("code_system") @db.VarChar(20) // KCD-8, ICD-10, ICD-11
  code           String    @db.VarChar(20)
  nameKo         String    @map("name_ko") @db.VarChar(500)
  nameEn         String?   @map("name_en") @db.VarChar(500)
  category       String?   @db.VarChar(100)
  /// 주상병 사용 불가(HIRA 상병마스터 '주상병사용구분 N') — 주상병 지정 시 경고
  notPrimary     Boolean   @default(false) @map("not_primary")
  /// 성별 제한(M/F, HIRA 상병마스터) — 불일치 경고
  sexRestriction String?   @map("sex_restriction") @db.VarChar(1)
  /// 연령 하한/상한(세, HIRA 상병마스터) — 범위 밖 경고
  ageMin         Int?      @map("age_min")
  ageMax         Int?      @map("age_max")
  chapter        String?   @db.VarChar(10)
  parentCode     String?   @map("parent_code") @db.VarChar(20) // 계층 구조 (상위 코드)
  icd10Code      String?   @map("icd10_code") @db.VarChar(20) // KCD→ICD-10 매핑
  icd11Code      String?   @map("icd11_code") @db.VarChar(20) // KCD→ICD-11 매핑
  isActive       Boolean   @default(true) @map("is_active")
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  // 🔴 폐지는 삭제가 아니다(2026-08-26 · C3). `validTo` 로 종료하고 **후속 코드**를 잇는다 —
  //    연결이 없으면 과거 기록의 코드가 무엇으로 바뀌었는지 해석할 방법이 사라진다.
  //    문자열로 둔다(FK 아님): 후속 코드가 아직 등재되지 않았을 수 있고, 그때 폐지를 막으면 안 된다.
  /// 이 코드가 어디서 왔는가 — `HIRA`(고시 반영) · `LOCAL`(원내 등록) · `null`(표기 없음).
  /// 🔴 기존 행을 일괄로 `HIRA` 로 찍지 않는다 — **모르는 것을 아는 척하지 않는다.**
  /// 고시 반영이 건드린 행에 `HIRA`, 사람이 화면에서 만든 행에 `LOCAL` 이 찍힌다.
  origin         String?   @db.VarChar(10)
  successorCode  String?   @map("successor_code") @db.VarChar(20)
  retiredReason  String?   @map("retired_reason") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  encounterDiagnoses EncounterDiagnosis[]
  problemLists       ProblemList[]
  familyHistories    FamilyHistory[]
  prescriptions      Prescription[]       @relation("PrescriptionDiagnosis")

  @@unique([codeSystem, code])
  @@index([code])
  @@index([codeSystem])
  @@index([icd10Code])
  @@index([icd11Code])
  // 🔴 (2026-10-01 SQL 튜닝) 이름 검색 트라이그램 GIN — 종전엔 수동 SQL 로만 만들어 `db push` 가 스키마 밖이라며 지웠다
  //    (서버 이전 뒤 운영에 10종 중 0종). 스키마에 두어야 배포가 지우지 않는다.
  @@index([nameKo(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_diagnosis_codes_nameko_trgm")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_diagnosis_code_code_gin")
  @@map("diagnosis_codes")
}

// EDI 수가코드 (건강보험 행위/치료재료)
model ProcedureCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @db.VarChar(20)
  nameKo           String    @map("name_ko") @db.VarChar(500)
  loincCode        String?   @map("loinc_code") @db.VarChar(20) // 검사 오더용 표준 LOINC(FHIR ServiceRequest.code). 랩만 해당·사람 검증 후 세팅(패널은 패널 LOINC)
  category         String?   @db.VarChar(100)
  modality         String?   @db.VarChar(10) // 영상 modality(CT/MR/CR/US/MG/NM…) — 미설정 시 코드/명칭 휴리스틱 판정
  usesContrast     Boolean   @default(false) @map("uses_contrast") // 조영제 사용 검사 — 미설정 시 명칭 '조영' 휴리스틱 병행
  unitPrice        Int?      @map("unit_price")
  insuranceCovered Boolean   @default(true) @map("insurance_covered")
  copayRate        Decimal?  @map("copay_rate") @db.Decimal(5, 4)
  isActive         Boolean   @default(true) @map("is_active")
  validFrom        DateTime  @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  // 🔴 폐지는 삭제가 아니다(2026-08-26 · C3). `validTo` 로 종료하고 **후속 코드**를 잇는다 —
  //    연결이 없으면 과거 기록의 코드가 무엇으로 바뀌었는지 해석할 방법이 사라진다.
  //    문자열로 둔다(FK 아님): 후속 코드가 아직 등재되지 않았을 수 있고, 그때 폐지를 막으면 안 된다.
  /// 이 코드가 어디서 왔는가 — `HIRA`(고시 반영) · `LOCAL`(원내 등록) · `null`(표기 없음).
  /// 🔴 기존 행을 일괄로 `HIRA` 로 찍지 않는다 — **모르는 것을 아는 척하지 않는다.**
  /// 고시 반영이 건드린 행에 `HIRA`, 사람이 화면에서 만든 행에 `LOCAL` 이 찍힌다.
  origin           String?   @db.VarChar(10)
  /// 이 분류가 **어디서 왔는가** — `HIRA`(고시 반영) · `PREFIX_DERIVED`(코드 접두에서 유도) · `null`(미상).
  /// 🔴 접두에서 유도한 분류가 고시 분류인 척하면, 다음 사람이 그것을 근거로 청구를 판단한다.
  /// 실측(2026-08-26): 미분류 166,689건 중 **접두 증거가 덮는 것은 5,084건(3.0%)** 뿐이다.
  categorySource   String?   @map("category_source") @db.VarChar(20)
  /// 고시 **분류번호 원문**(`자654-2`·`나580다(2)`). 🔴 접두(가·나·다…)가 무슨 분류인지는
  /// 여기에 적지 않는다 — 그 대응표는 고시가 정하고, 기억으로 적으면 그 추정이 정책인 척한다.
  gazetteClass     String?   @map("gazette_class") @db.VarChar(40)
  successorCode    String?   @map("successor_code") @db.VarChar(20)
  retiredReason    String?   @map("retired_reason") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  prescriptions Prescription[]
  preOrders     PreOrder[]

  @@unique([code, validFrom]) // 수가 이력(temporal) — code+적용일 단위 버전
  @@index([code])
  // 🔴 (2026-10-01 SQL 튜닝) 이름 검색 트라이그램 GIN — 종전엔 수동 SQL 로만 만들어 `db push` 가 스키마 밖이라며 지웠다
  //    (서버 이전 뒤 운영에 10종 중 0종). 스키마에 두어야 배포가 지우지 않는다.
  @@index([nameKo(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_procedure_codes_nameko_trgm")
  @@map("procedure_codes")
}

// 약품코드 (약학정보원 KPIS 기반)
model MedicationCode {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique @db.VarChar(20)
  nameKo             String    @map("name_ko") @db.VarChar(500)
  nameEn             String?   @map("name_en") @db.VarChar(500)
  /// 약효분류(식약처 분류번호 기반 한글명, HIRA 급여표 유래) — 검색 카테고리 그룹핑
  category           String?   @db.VarChar(100)
  ingredient         String?   @db.VarChar(500)
  ingredientCode     String?   @map("ingredient_code") @db.VarChar(20) // 식약처 주성분코드/ATC (DUR 동일성분·병용금기 매칭, ERP 동봉)
  manufacturer       String?   @db.VarChar(200)
  dosageForm         String?   @map("dosage_form") @db.VarChar(100)
  unit               String?   @db.VarChar(50)
  insuranceCode      String?   @map("insurance_code") @db.VarChar(20)
  unitPrice          Int?      @map("unit_price")
  barcode            String?   @db.VarChar(50) // GS1-128 또는 KD코드
  controlSchedule    String?   @map("control_schedule") @db.VarChar(5) // I, II, III, IV, V (마약류 등급, null=일반)
  narcoticType       String?   @map("narcotic_type") @db.VarChar(20) // 한국 마약류 분류: NARCOTIC(마약)|PSYCHOTROPIC(향정)|CANNABIS — NIMS 보고 키(관리자 큐레이션)
  psychotropicGroup  String?   @map("psychotropic_group") @db.VarChar(10) // 향정 가·나·다·라 — NIMS 보고 키
  storageCondition   String?   @map("storage_condition") @db.VarChar(10) // ROOM, COLD, FROZEN
  // 고위험 약물 (ISMP)
  highAlertFlag      Boolean   @default(false) @map("high_alert_flag")
  highAlertCategory  String?   @map("high_alert_category") @db.VarChar(50) // ANTICOAGULANT, INSULIN, OPIOID 등
  pregnancyCategory  String?   @map("pregnancy_category") @db.VarChar(4) // 임부투여 안전성(FDA A/B/C/D/X) — DUR 임부금기. X=금기·D=위험. 식약처 공고 데이터 필요
  lasaGroup          String?   @map("lasa_group") @db.VarChar(30) // 유사명칭 그룹
  aspRestrictedLevel String?   @map("asp_restricted_level") @db.VarChar(20) // 항생제 스튜어드십 제한등급(RESTRICTED/CONTROLLED, null=비제한) — P2-F
  maxSingleDose      Decimal?  @map("max_single_dose") @db.Decimal(10, 2)
  maxDailyDose       Decimal?  @map("max_daily_dose") @db.Decimal(10, 2)
  isActive           Boolean   @default(true) @map("is_active")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  // 🔴 폐지는 삭제가 아니다(2026-08-26 · C3). `validTo` 로 종료하고 **후속 코드**를 잇는다 —
  //    연결이 없으면 과거 기록의 코드가 무엇으로 바뀌었는지 해석할 방법이 사라진다.
  //    문자열로 둔다(FK 아님): 후속 코드가 아직 등재되지 않았을 수 있고, 그때 폐지를 막으면 안 된다.
  /// 이 코드가 어디서 왔는가 — `HIRA`(고시 반영) · `LOCAL`(원내 등록) · `null`(표기 없음).
  /// 🔴 기존 행을 일괄로 `HIRA` 로 찍지 않는다 — **모르는 것을 아는 척하지 않는다.**
  /// 고시 반영이 건드린 행에 `HIRA`, 사람이 화면에서 만든 행에 `LOCAL` 이 찍힌다.
  origin             String?   @db.VarChar(10)
  successorCode      String?   @map("successor_code") @db.VarChar(20)
  retiredReason      String?   @map("retired_reason") @db.VarChar(300)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  prescriptions   Prescription[]
  dispensingItems DispensingItem[]
  preOrders       PreOrder[]
  batches         MedicationBatch[]
  substitutions   GenericSubstitution[] @relation("SubstituteMed")

  drugBarcodes DrugBarcode[]

  @@index([code])
  @@index([ingredient])
  // 🔴 (2026-10-01 SQL 튜닝) 이름 검색 트라이그램 GIN — 종전엔 수동 SQL 로만 만들어 `db push` 가 스키마 밖이라며 지웠다
  //    (서버 이전 뒤 운영에 10종 중 0종). 스키마에 두어야 배포가 지우지 않는다.
  @@index([nameKo(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_medication_codes_name_ko_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_medication_codes_name_en_trgm")
  @@index([ingredient(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_medication_codes_ingredient_trgm")
  @@map("medication_codes")
}

// 항생제 스튜어드십(ASP) 사전승인(P2-F) — 종전 인메모리 mock(재시작 소실) → 영속화.
//  prescriptionId 1:1로 승인-투약 연동(조제 게이트). FK relation 미사용(수동 조인).
model AspRequest {
  id                String    @id @default(uuid()) @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  prescriptionId    String?   @unique @map("prescription_id") @db.Uuid // 승인-투약 1:1(조제 게이트 연동)
  encounterId       String?   @map("encounter_id") @db.Uuid
  antimicrobialName String    @map("antimicrobial_name") @db.VarChar(200)
  restrictedLevel   String?   @map("restricted_level") @db.VarChar(20)
  indication        String    @db.Text
  duration          Int?
  durationUnit      String?   @map("duration_unit") @db.VarChar(20)
  requestedBy       String    @map("requested_by") @db.Uuid
  status            String    @default("PENDING") @db.VarChar(20) // PENDING/APPROVED/REJECTED/CONDITIONAL
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewComment     String?   @map("review_comment") @db.Text
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz()

  @@index([patientId])
  @@index([status])
  @@map("asp_requests")
}

// ── 내부 코드 마스터 (확장) ──

/// 코드 동의어·약어 — 검색어를 넓히는 사전.
///
/// 🔴 **두 형태가 있고 의미가 다르다.**
///  - `code = null`  : **질의 확장만** 한다("AMI" 를 치면 "심근경색"으로도 찾는다).
///                     어느 코드인지는 **지목하지 않는다** — 고르는 것은 사람이다.
///  - `code` 있음    : 그 코드를 결과 위로 올린다. 🔴 **어느 코드인지를 시스템이 정하는 것**이라
///                     원내에서 사람이 등록·승인한 것만 있어야 한다.
///
/// 🔴 `status = APPROVED` 인 것만 검색에 쓴다. 동의어가 틀리면 **다른 병을 고르게 된다**.
/// 초기 배포분은 전부 `PROPOSED` 다 — **초기 견본은 원내 표준이 아니다**(검토 전).
model CodeSynonym {
  id          String    @id @default(uuid()) @db.Uuid
  sourceTable String    @map("source_table") @db.VarChar(40) // DiagnosisCode | ProcedureCode | MedicationCode | LabTestCode
  code        String?   @db.VarChar(20) // null = 질의 확장 전용(코드 미지목)
  /// 🔴 유니크 키 전용 사본(`code ?? ''`). Postgres 는 **NULL 을 서로 다른 값으로 보아**
  /// `@@unique([...code])` 가 확장 전용 행의 중복을 막지 못한다. 그래서 빈 문자열로 접어 둔다.
  codeKey     String    @default("") @map("code_key") @db.VarChar(20)
  codeSystem  String?   @map("code_system") @db.VarChar(20)
  term        String    @db.VarChar(120) // 사람이 입력하는 표기 그대로
  termNorm    String    @map("term_norm") @db.VarChar(120) // 정규화(소문자·공백/기호 제거) — 매칭 키
  expandsTo   String?   @map("expands_to") @db.VarChar(200) // 확장 질의어(코드 미지목형에서 사용)
  kind        String    @db.VarChar(20) // ABBREVIATION | COLLOQUIAL | ENGLISH | LEGACY | TYPO
  status      String    @default("PROPOSED") @db.VarChar(12) // PROPOSED | APPROVED | REJECTED
  note        String?   @db.VarChar(300)
  proposedBy  String?   @map("proposed_by") @db.Uuid
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote  String?   @map("review_note") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([sourceTable, termNorm, codeKey])
  @@index([sourceTable, termNorm, status])
  @@index([status])
  @@map("code_synonyms")
}

model LabTestCode {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(20)
  loincCode      String?  @map("loinc_code") @db.VarChar(20)
  nameKo         String   @map("name_ko") @db.VarChar(200)
  nameEn         String?  @map("name_en") @db.VarChar(200)
  category       String   @db.VarChar(50) // 혈액, 생화학, 미생물, 소변, 혈청, 응고
  specimen       String?  @db.VarChar(50) // Blood, Urine, CSF, Stool
  unit           String?  @db.VarChar(30)
  refRangeMale   String?  @map("ref_range_male") @db.VarChar(50)
  refRangeFemale String?  @map("ref_range_female") @db.VarChar(50)
  turnaroundMin  Int?     @map("turnaround_min") // 소요시간(분)
  ediCode        String?  @map("edi_code") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// 🔴 (2026-10-01) LIS 검사코드 카탈로그 증분(`?since=`)이 패널 항목의 추가·변경·비활성을 실을 근거 — 종전엔 이 열이 없어
  ///    증분은 수가 코드(ProcedureCode.updatedAt)만 보았고 패널 변경은 LIS 에 영영 가지 않았다.
  ///    기존 행은 마이그레이션 시각으로 시작한다(언제 바뀌었는지 모른다 — 다음 증분 한 번은 전 패널을 다시 싣는다 · 안전측).
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category])
  @@map("lab_test_codes")
