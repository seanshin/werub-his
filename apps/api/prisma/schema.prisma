/// 외부 SMART 앱의 FHIR 접근 기록 — AuditLog(userId 필수·User FK)로는 담을 수 없는
/// **클라이언트 주체** 접근을 남긴다(client_credentials 는 사용자가 아예 없음).
/// per-user launch 는 여기에 userId 도 함께 남고, AuditLog 에도 환자 열람으로 이중 기록된다.
/// 무인증(공개) 채널 접근 원장.
///
/// 🔴 2026-08-19 실측: `AuditLog.userId` 는 User FK(NOT NULL)라 **주체가 사람이 아닌 접근을 담을 수 없다.**
///    그래서 감사 인터셉터가 `if (!user?.id) return;` 로 탈락하고,
///    공개 예약 챗(`/api/v1/booking/*`)·무인 키오스크(`/api/v1/kiosk/*`)의 조회는
///    **개통 이래 한 건도 기록되지 않았다.** 그 채널이 환자 본인확인·PHI 열람·금전 변이를 다루는데도 그랬다.
///    (외부 앱 접근을 `SmartAccessLog` 로 따로 남긴 것과 같은 이유·같은 형태다.)
///
/// 🔴 여기에 원문 식별자를 그대로 적지 않는다 — 원장 자체가 열거 소스가 되면 안 된다.
///    등록번호는 해시(`subjectHash`)로만 남기고, 본인확인을 통과한 뒤에만 `patientId` 를 적는다.
model PublicAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// BOOKING | KIOSK | STATION | DISPLAY
  channel     String   @db.VarChar(20)
  /// verify | lookup | pay | checkin | message
  action      String   @db.VarChar(20)
  path        String   @db.VarChar(300)
  /// 본인확인 결과 — OK | FAIL | LOCKED | BLOCKED
  result      String   @db.VarChar(20)
  /// 🔴 시도한 식별자의 해시(원문 금지). 같은 대상에 대한 반복 시도를 세기 위한 것
  subjectHash String?  @map("subject_hash") @db.VarChar(64)
  /// 본인확인을 통과한 경우에만 채운다
  patientId   String?  @map("patient_id") @db.Uuid
  /// 대화형 채널의 세션(AgentSession.id 등)
  sessionRef  String?  @map("session_ref") @db.Uuid
  detail      Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  at          DateTime @default(now()) @db.Timestamptz()

  @@index([channel, at])
  @@index([result, at])
  @@index([subjectHash, at])
  @@index([patientId, at])
  @@map("public_access_logs")
}

model SmartAccessLog {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.VarChar(100)
  clientName   String?  @map("client_name") @db.VarChar(200)
  /// fhirUser(Practitioner/<id>)에서 해석된 의료진 — 없으면 시스템 단위 접근
  userId       String?  @map("user_id") @db.Uuid
  patientId    String?  @map("patient_id") @db.Uuid
  resourceType String   @map("resource_type") @db.VarChar(50)
  action       String   @db.VarChar(20) // read | search | write
  path         String   @db.VarChar(300)
  scope        String?  @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  at           DateTime @default(now()) @db.Timestamptz()

  @@index([clientId, at])
  @@index([userId, at])
  @@index([patientId, at])
  @@map("smart_access_logs")
}

model SmartClient {
  id           String    @id @default(uuid()) @db.Uuid
