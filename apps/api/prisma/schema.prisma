// ============================================================
// 병리과 (Pathology)
// ============================================================

model PathologySpecimen {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  encounterId  String?   @map("encounter_id") @db.Uuid
  accessionNo  String    @unique @map("accession_no") @db.VarChar(30) // 접수번호
  specimenType String    @map("specimen_type") @db.VarChar(50) // BIOPSY, EXCISION, CYTOLOGY, FNA, FROZEN
  site         String    @db.VarChar(200) // 채취 부위
  collectedAt  DateTime  @map("collected_at") @db.Timestamptz()
  collectedBy  String    @map("collected_by") @db.Uuid // 의뢰 의사
  receivedAt   DateTime? @map("received_at") @db.Timestamptz()
  fixative     String?   @db.VarChar(50) // 10% formalin, alcohol 등
  clinicalInfo String?   @map("clinical_info") @db.Text // 임상 정보
  status       String    @default("RECEIVED") @db.VarChar(20) // RECEIVED, PROCESSING, REPORTED, SIGNED, AMENDED
  priority     String    @default("ROUTINE") @db.VarChar(20) // ROUTINE, URGENT, FROZEN
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient         Patient                   @relation(fields: [patientId], references: [id])
  collector       User                      @relation("SpecimenCollector", fields: [collectedBy], references: [id])
  report          PathologyReport?
  processingSteps PathologyProcessingStep[]

  @@index([patientId])
  @@index([status])
  @@index([accessionNo])
  @@map("pathology_specimens")
}

// 병리 검체 처리단계(고정·포매·박절·염색·봉입) 실 기록
model PathologyProcessingStep {
  id          String   @id @default(uuid()) @db.Uuid
  specimenId  String   @map("specimen_id") @db.Uuid
  step        String   @db.VarChar(20) // FIXATION|EMBEDDING|SECTIONING|STAINING|MOUNTING
  notes       String?  @db.Text
  performedBy String?  @map("performed_by") @db.Uuid
  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz()

  specimen PathologySpecimen @relation(fields: [specimenId], references: [id])

  @@index([specimenId, performedAt])
  @@map("pathology_processing_steps")
}

model PathologyReport {
  id               String    @id @default(uuid()) @db.Uuid
  specimenId       String    @unique @map("specimen_id") @db.Uuid
  // 육안 소견
  grossDescription String?   @map("gross_description") @db.Text
  // 현미경 소견
  microDescription String?   @map("micro_description") @db.Text
  // 최종 진단
  diagnosis        String?   @db.Text
  diagnosisCode    String?   @map("diagnosis_code") @db.VarChar(20) // KCD
  // 추가 검사
  ihc              Json?     @db.JsonB // 면역화학염색 [{marker, result}]
  molecularTest    Json?     @map("molecular_test") @db.JsonB // 분자검사
  // TNM (종양)
  tnmT             String?   @map("tnm_t") @db.VarChar(10) // pT 분류
  tnmN             String?   @map("tnm_n") @db.VarChar(10) // pN 분류
  tnmM             String?   @map("tnm_m") @db.VarChar(10) // pM 분류
  tnmStage         String?   @map("tnm_stage") @db.VarChar(20) // AJCC 병기군
  tumorGrade       String?   @map("tumor_grade") @db.VarChar(20)
  marginStatus     String?   @map("margin_status") @db.VarChar(20) // CLEAR, INVOLVED, CLOSE
  // 보고
  reportedBy       String?   @map("reported_by") @db.Uuid // 판독 병리의
  reportedAt       DateTime? @map("reported_at") @db.Timestamptz()
  signedBy         String?   @map("signed_by") @db.Uuid // 최종 서명
  signedAt         DateTime? @map("signed_at") @db.Timestamptz()
  // 추가 소견/수정
  addendum         String?   @db.Text
  amendedAt        DateTime? @map("amended_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  specimen PathologySpecimen @relation(fields: [specimenId], references: [id])
  reporter User?             @relation("PathologyReporter", fields: [reportedBy], references: [id])
  signer   User?             @relation("PathologySigner", fields: [signedBy], references: [id])

  @@map("pathology_reports")
}

// ============================================================
// HIRA EDI 청구
// ============================================================

model HiraClaimDocument {
  id               String    @id @default(uuid()) @db.Uuid
  claimId          String    @map("claim_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  // 명세서 유형
  documentType     String    @map("document_type") @db.VarChar(20) // OUTPATIENT, INPATIENT, PHARMACY
  // EDI 데이터
  ediVersion       String    @map("edi_version") @db.VarChar(10) // 1.0, 2.0
  ediData          Json      @map("edi_data") @db.JsonB // 구조화된 EDI 전문
  // 명세서 내용
  treatmentFrom    DateTime  @map("treatment_from") @db.Date
  treatmentTo      DateTime  @map("treatment_to") @db.Date
  totalAmount      Int       @map("total_amount")
  insuranceAmount  Int       @map("insurance_amount")
  patientAmount    Int       @map("patient_amount")
  // 진료 내역
  diagnosisCodes   Json      @map("diagnosis_codes") @db.JsonB // [{code, name, type}]
  procedures       Json      @db.JsonB // [{code, name, qty, amount, days}]
  medications      Json      @db.JsonB // [{code, name, qty, days, amount}]
  materials        Json?     @db.JsonB // [{code, name, qty, amount}]
  // 전송 상태
  status           String    @default("DRAFT") @db.VarChar(20) // DRAFT, VALIDATED, SUBMITTED, ACCEPTED, REJECTED, ADJUSTED
  validationErrors Json?     @map("validation_errors") @db.JsonB
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz()
  responseAt       DateTime? @map("response_at") @db.Timestamptz()
  responseData     Json?     @map("response_data") @db.JsonB // 심사 결과
  // 메타
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  claim   Claim   @relation(fields: [claimId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  creator User    @relation("HiraClaimCreator", fields: [createdBy], references: [id])

  @@index([claimId])
  @@index([patientId])
  @@index([status])
  @@map("hira_claim_documents")
}

// ============================================================
// 마약류 처방 관리
// ============================================================

model ControlledSubstanceLog {
  id                String    @id @default(uuid()) @db.Uuid
  prescriptionId    String?   @map("prescription_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  // 약물 정보
  drugName          String    @map("drug_name") @db.VarChar(200)
  drugCode          String?   @map("drug_code") @db.VarChar(30) // EDI 코드
  deaSchedule       String    @map("dea_schedule") @db.VarChar(10) // I, II, III, IV, V
  // 한국 마약류 분류(마약류관리법·NIMS) — deaSchedule(US)와 별도
  narcoticType      String?   @map("narcotic_type") @db.VarChar(20) // NARCOTIC(마약)·PSYCHOTROPIC(향정)·CANNABIS(대마)
  psychotropicGroup String?   @map("psychotropic_group") @db.VarChar(4) // 향정 가·나·다·라
  // 수량
  quantity          Decimal   @db.Decimal(10, 2) // 불출/처방 수량
  administeredQty   Decimal?  @map("administered_qty") @db.Decimal(10, 2) // 실제 투여량(잔량 추적)
  wastedQty         Decimal?  @map("wasted_qty") @db.Decimal(10, 2) // 폐기 잔량(앰플 부분사용 다이버전 차단)
  unit              String    @db.VarChar(20)
  // 처방/투약
  prescribedBy      String    @map("prescribed_by") @db.Uuid
  prescribedAt      DateTime  @map("prescribed_at") @db.Timestamptz()
  // 이중 확인
  verifiedBy        String?   @map("verified_by") @db.Uuid // 2차 확인자
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz()
  // 불출
  dispensedBy       String?   @map("dispensed_by") @db.Uuid
  dispensedAt       DateTime? @map("dispensed_at") @db.Timestamptz()
  dispenseScanCode  String?   @map("dispense_scan_code") @db.VarChar(100) // 바코드 스캔
  // 투약
  administeredBy    String?   @map("administered_by") @db.Uuid
  administeredAt    DateTime? @map("administered_at") @db.Timestamptz()
  // 상태
  status            String    @default("PRESCRIBED") @db.VarChar(20) // PRESCRIBED, VERIFIED, DISPENSED, ADMINISTERED, WASTED, RETURNED
  wasteReason       String?   @map("waste_reason") @db.VarChar(200)
  wasteWitness      String?   @map("waste_witness") @db.Uuid // 폐기 증인
  // 감사
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient    Patient @relation(fields: [patientId], references: [id])
  prescriber User    @relation("ControlledPrescriber", fields: [prescribedBy], references: [id])

  @@index([patientId])
  @@index([deaSchedule])
  @@index([status])
  @@index([prescribedAt])
  @@map("controlled_substance_logs")
}

// 마약류 영속재고(수불부) — 마약 금고/캐비닛 장부재고. 실사 대사로 유용(diversion) 탐지.
model ControlledSubstanceStock {
  id            String    @id @default(uuid()) @db.Uuid
  drugCode      String    @map("drug_code") @db.VarChar(30)
  drugName      String    @map("drug_name") @db.VarChar(200)
  deaSchedule   String    @map("dea_schedule") @db.VarChar(10) // I~V
  location      String    @default("PHARMACY") @db.VarChar(60) // 보관 장소(약국/병동 마약금고)
  unit          String    @db.VarChar(20)
  balance       Decimal   @default(0) @db.Decimal(12, 2) // 장부 잔량
  lastCountedAt DateTime? @map("last_counted_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  txns ControlledSubstanceStockTxn[]

  @@unique([drugCode, location])
  @@index([deaSchedule])
  @@map("controlled_substance_stocks")
}

// 마약류 수불 거래 — 모든 이동(입고/불출/반납/폐기/조정/실사)·전후 잔량 감사.
model ControlledSubstanceStockTxn {
  id            String   @id @default(uuid()) @db.Uuid
  stockId       String   @map("stock_id") @db.Uuid
  type          String   @db.VarChar(15) // RECEIPT/ISSUE/RETURN/WASTE/ADJUST/COUNT
  quantity      Decimal  @db.Decimal(12, 2) // 부호 있는 변동량(+입고/-불출)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  refType       String?  @map("ref_type") @db.VarChar(30) // CS_LOG 등
  refId         String?  @map("ref_id") @db.Uuid
  reason        String?  @db.VarChar(300)
  performedBy   String   @map("performed_by") @db.Uuid
  witnessedBy   String?  @map("witnessed_by") @db.Uuid // 폐기·실사불일치 증인
  discrepancy   Decimal? @db.Decimal(12, 2) // COUNT 시 실사-장부 차이
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  stock ControlledSubstanceStock @relation(fields: [stockId], references: [id])

  @@index([stockId, occurredAt])
  @@index([type])
  @@map("controlled_substance_stock_txns")
}

// 사고마약류(마약류관리법 §12 도난·분실·파손·재해) — 지체없이 관할청/식약처 보고 의무
model ControlledSubstanceIncident {
  id           String    @id @default(uuid()) @db.Uuid
  logId        String?   @map("log_id") @db.Uuid // 관련 마약류 로그(선택)
  incidentType String    @map("incident_type") @db.VarChar(20) // THEFT(도난)·LOSS(분실)·DAMAGE(파손)·DISASTER(재해)
  drugName     String    @map("drug_name") @db.VarChar(200)
  drugCode     String?   @map("drug_code") @db.VarChar(30)
  quantity     Decimal   @db.Decimal(10, 2)
  unit         String    @db.VarChar(20)
  occurredAt   DateTime  @map("occurred_at") @db.Timestamptz()
  description  String    @db.Text
  reportedBy   String    @map("reported_by") @db.Uuid
  status       String    @default("REPORTED") @db.VarChar(20) // REPORTED·FILED(관할신고)·CLOSED
  filedAt      DateTime? @map("filed_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  reporter User @relation("CsIncidentReporter", fields: [reportedBy], references: [id])

  @@index([status])
  @@index([incidentType])
  @@map("controlled_substance_incidents")
}

// 무균조제(주사·TPN·항암 무균조제) — 종전 부재. 조제지시→계산→무균조제→2인검증→불출. USP 797/800·CSSD 패턴 이식.
enum CompoundingStatus {
  ORDERED
  CALCULATED
  IN_PREP
  COMPOUNDED
  VERIFIED
  RELEASED
  CANCELLED
}

model CompoundingOrder {
  id                      String            @id @default(uuid()) @db.Uuid
  sourceType              String            @map("source_type") @db.VarChar(20) // IV_RX·TPN·CHEMO
  prescriptionId          String?           @map("prescription_id") @db.Uuid
  specialNutritionOrderId String?           @map("special_nutrition_order_id") @db.Uuid
  patientId               String            @map("patient_id") @db.Uuid
  status                  CompoundingStatus @default(ORDERED)
  priority                String            @default("ROUTINE") @db.VarChar(10) // STAT·URGENT·ROUTINE
  isHazardous             Boolean           @default(false) @map("is_hazardous") // 항암/세포독성 — 차폐·강제 이중확인
  dueAt                   DateTime?         @map("due_at") @db.Timestamptz()
  // 조제 수행
  assignedPharmacistId    String?           @map("assigned_pharmacist_id") @db.Uuid
  compoundedBy            String?           @map("compounded_by") @db.Uuid
  hoodType                String?           @map("hood_type") @db.VarChar(20) // LAFW·BSC_II·ISOLATOR
  startedAt               DateTime?         @map("started_at") @db.Timestamptz()
  finishedAt              DateTime?         @map("finished_at") @db.Timestamptz()
  // 독립 2차 검증·불출
  verifiedBy              String?           @map("verified_by") @db.Uuid
  verifiedAt              DateTime?         @map("verified_at") @db.Timestamptz()
  budAt                   DateTime?         @map("bud_at") @db.Timestamptz() // beyond-use date
  labelBarcode            String?           @map("label_barcode") @db.VarChar(100)
  releasedAt              DateTime?         @map("released_at") @db.Timestamptz()
  cancelReason            String?           @map("cancel_reason") @db.VarChar(200)
  notes                   String?           @db.Text
  createdBy               String            @map("created_by") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  patient    Patient                    @relation("PatientCompoundings", fields: [patientId], references: [id])
  components CompoundingComponent[]
  mars       MedicationAdministration[] // 불출 시 MAR 실물 연결(무균조제 추적)

  @@index([status])
  @@index([patientId, status])
  @@map("compounding_orders")
}

model CompoundingComponent {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  role             String    @db.VarChar(20) // BASE_FLUID·ADDITIVE·ELECTROLYTE·LIPID·AMINO_ACID·DRUG
  medicationCodeId String?   @map("medication_code_id") @db.Uuid
  name             String    @db.VarChar(200)
  orderedAmount    Decimal?  @map("ordered_amount") @db.Decimal(12, 3)
  amountUnit       String?   @map("amount_unit") @db.VarChar(20)
  computedVolumeMl Decimal?  @map("computed_volume_ml") @db.Decimal(10, 2)
  lotNumber        String?   @map("lot_number") @db.VarChar(50)
  expiryDate       DateTime? @map("expiry_date") @db.Date
  sortOrder        Int       @default(0) @map("sort_order")

  order CompoundingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("compounding_components")
}

// NIMS(마약류통합관리시스템) 취급보고 아웃박스 — 이벤트→식약처 보고 큐. 실제 전송은 외부 인증서/계약(스텁).
model NimsReport {
  id           String    @id @default(uuid()) @db.Uuid
  reportType   String    @map("report_type") @db.VarChar(20) // DISPENSE·ADMINISTER·WASTE·INVENTORY·INCIDENT
  refId        String?   @map("ref_id") @db.Uuid // 원천(log/incident/stock) id
  drugCode     String?   @map("drug_code") @db.VarChar(30)
  drugName     String    @map("drug_name") @db.VarChar(200)
  narcoticType String?   @map("narcotic_type") @db.VarChar(20)
  quantity     Decimal   @db.Decimal(12, 3)
  unit         String    @db.VarChar(20)
  eventAt      DateTime  @map("event_at") @db.Timestamptz()
  payload      Json // NIMS 취급내역 레코드(서식 매핑)
  status       String    @default("PENDING") @db.VarChar(20) // PENDING·SUBMITTED·ACK·FAILED
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz()
  nimsRefNo    String?   @map("nims_ref_no") @db.VarChar(50) // NIMS 접수번호
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status])
  @@index([reportType])
  @@index([eventAt])
  @@map("nims_reports")
}

// ============================================================
// 낙상/욕창 재평가 스케줄
// ============================================================

model RiskReassessmentSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  admissionId    String?   @map("admission_id") @db.Uuid
  // 평가 유형
  assessmentType String    @map("assessment_type") @db.VarChar(20) // FALL_RISK, PRESSURE_ULCER
  toolName       String    @map("tool_name") @db.VarChar(30) // MORSE, BRADEN, HUMPTY_DUMPTY
  // 스케줄
  intervalHours  Int       @map("interval_hours") // 재평가 주기 (시간)
  nextDueAt      DateTime  @map("next_due_at") @db.Timestamptz()
  // 최근 평가
  lastScore      Int?      @map("last_score")
  lastRiskLevel  String?   @map("last_risk_level") @db.VarChar(20) // LOW, MODERATE, HIGH
  lastAssessedAt DateTime? @map("last_assessed_at") @db.Timestamptz()
  lastAssessedBy String?   @map("last_assessed_by") @db.Uuid
  // 상태
  isActive       Boolean   @default(true) @map("is_active")
  // 중재 계획
  interventions  Json?     @db.JsonB // [{type, description, applied}]
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, assessmentType])
  @@index([nextDueAt, isActive])
  @@map("risk_reassessment_schedules")
}

// ============================================================
// Universal Nursing Note (범용 간호기록)
// ============================================================

model UniversalNursingNote {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  nurseId        String   @map("nurse_id") @db.Uuid
  contextType    String   @map("context_type") @db.VarChar(30)
  contextId      String   @map("context_id") @db.Uuid
  noteType       String   @map("note_type") @db.VarChar(30)
  situation      String?  @db.Text
  background     String?  @db.Text
  assessment     String?  @db.Text
  recommendation String?  @db.Text
  content        String?  @db.Text
  vitalSigns     Json?    @map("vital_signs") @db.JsonB
  severity       String?  @db.VarChar(20)
  shiftType      String?  @map("shift_type") @db.VarChar(10)
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])
  nurse   User    @relation("UniversalNursingNoteNurse", fields: [nurseId], references: [id])

  @@index([patientId, contextType])
  @@index([contextType, contextId])
  @@index([nurseId, recordedAt])
  @@map("universal_nursing_notes")
}

// ── 알림 (Notification) ──

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  severity  String    @default("INFO") @db.VarChar(20)
  refType   String?   @map("ref_type") @db.VarChar(30)
  refId     String?   @map("ref_id") @db.Uuid
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// 위급검사값 통보 (Critical Value Alert) — IPSG.2 read-back
model CriticalValueAlert {
  id                String    @id @default(uuid()) @db.Uuid
  labResultId       String    @map("lab_result_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  doctorId          String?   @map("doctor_id") @db.Uuid
  testName          String    @map("test_name") @db.VarChar(200)
  value             String    @db.VarChar(100)
  unit              String    @db.VarChar(50)
  reason            String    @db.VarChar(200)
  notifiedAt        DateTime  @default(now()) @map("notified_at") @db.Timestamptz()
  // PENDING → (ESCALATED) → ACKNOWLEDGED → ACTED → CLOSED — 정본 modules/lab/critical-value-alert-states.ts
  status            String    @default("PENDING") @db.VarChar(20)
  acknowledgedBy    String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz()
  readBackConfirmed Boolean   @default(false) @map("read_back_confirmed") // 구두 read-back 확인
  responseAction    String?   @map("response_action") @db.Text // 조치 내용
  /// 허용시간 초과로 크론이 ESCALATED 로 전이한 시각 — 전이가 없었으면 null(추정해 채우지 않는다)
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz()
  /// 확인 이후 조치 기록자·시각(ACTED)
  actedBy           String?   @map("acted_by") @db.Uuid
  actedAt           DateTime? @map("acted_at") @db.Timestamptz()
  /// 종결자·시각(CLOSED)
  closedBy          String?   @map("closed_by") @db.Uuid
  closedAt          DateTime? @map("closed_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([doctorId, status])
  @@index([patientId])
  @@index([status, notifiedAt])
  @@map("critical_value_alerts")
}

// 손위생 관찰 (Hand Hygiene Observation) — JCI IPSG.5 / WHO 5 Moments
model HandHygieneObservation {
  id           String   @id @default(uuid()) @db.Uuid
  observerId   String   @map("observer_id") @db.Uuid // 관찰자
  department   String?  @db.VarChar(50) // 관찰 부서/병동
  observedRole String   @map("observed_role") @db.VarChar(20) // 피관찰 직군 DOCTOR/NURSE/...
  moment       Int // WHO 5 Moments (1~5)
  action       String   @db.VarChar(20) // PERFORMED, MISSED
  method       String?  @db.VarChar(20) // SOAP(물비누), SANITIZER(손소독제), GLOVE_ONLY
  observedAt   DateTime @default(now()) @map("observed_at") @db.Timestamptz()
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([department, observedAt])
  @@index([observedRole])
  @@index([observedAt])
  @@map("hand_hygiene_observations")
}

// 신체보호대 처방 (Physical/Chemical Restraint) — 환자 권리·안전
model RestraintOrder {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  type            String    @db.VarChar(20) // PHYSICAL(신체), CHEMICAL(약물)
  reason          String    @db.Text // 사유 (자해/타해 위험, 치료유지 등)
  bodyParts       Json?     @map("body_parts") @db.JsonB // ['좌측손목','우측손목','체간']
  orderedBy       String    @map("ordered_by") @db.Uuid // 처방의
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  plannedUntil    DateTime? @map("planned_until") @db.Timestamptz() // 재평가 기한(권장 24h)
  consentObtained Boolean   @default(false) @map("consent_obtained") // 보호자 동의
  status          String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, DISCONTINUED
  discontinuedAt  DateTime? @map("discontinued_at") @db.Timestamptz()
  discontinuedBy  String?   @map("discontinued_by") @db.Uuid
  encounterId     String?   @map("encounter_id") @db.Uuid
  admissionId     String?   @map("admission_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  monitorings RestraintMonitoring[]

  @@index([patientId, status])
  @@index([status])
  @@map("restraint_orders")
}

// 신체보호대 모니터링 (주기적 점검, 권장 2시간마다)
model RestraintMonitoring {
  id            String   @id @default(uuid()) @db.Uuid
  restraintId   String   @map("restraint_id") @db.Uuid
  checkedBy     String   @map("checked_by") @db.Uuid
  checkedAt     DateTime @default(now()) @map("checked_at") @db.Timestamptz()
  circulation   String?  @db.VarChar(20) // NORMAL, IMPAIRED (말초순환)
  skinIntegrity String?  @map("skin_integrity") @db.VarChar(20) // INTACT, INJURY (피부손상)
  rangeOfMotion Boolean  @default(false) @map("range_of_motion") // 관절가동운동 제공
  repositioned  Boolean  @default(false) // 체위변경 제공
  behavior      String?  @db.VarChar(50) // 환자 상태(진정/초조 등)
  continued     Boolean  @default(true) // 지속 필요 여부
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  restraint RestraintOrder @relation(fields: [restraintId], references: [id])

  @@index([restraintId, checkedAt])
  @@map("restraint_monitorings")
}

// 직원 자격/면허 (Staff Credential) — JCI SQE
model StaffCredential {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(30) // LICENSE(면허), CERTIFICATION(자격증), BLS, ACLS, ...
  name       String    @db.VarChar(200)
  number     String?   @db.VarChar(100)
  issuer     String?   @db.VarChar(200)
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz()
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  status     String    @default("VALID") @db.VarChar(20) // VALID, EXPIRED, SUSPENDED
  verifiedBy String?   @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz()
  fileUrl    String?   @map("file_url") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([type, status])
  @@index([expiresAt])
  @@map("staff_credentials")
}

// 직원 교육 이수 (Staff Education) — JCI SQE 필수교육 추적
model StaffEducation {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  courseName     String    @map("course_name") @db.VarChar(200)
  category       String    @db.VarChar(30) // MANDATORY(법정필수), INFECTION, SAFETY, CPR, FIRE, ...
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz() // 재이수 기한
  dueDate        DateTime? @map("due_date") @db.Timestamptz()
  hours          Decimal?  @db.Decimal(5, 1)
  status         String    @default("COMPLETED") @db.VarChar(20) // COMPLETED, DUE, OVERDUE
  certificateUrl String?   @map("certificate_url") @db.VarChar(500)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(120) // edu 연동 멱등키(재전송 안전)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([category, status])
  @@index([expiresAt])
  @@map("staff_educations")
}

// JCI GLD — 위원회 (Committee)
model Committee {
  id           String   @id @default(uuid()) @db.Uuid
  code         String?  @unique @db.VarChar(20) // 거버넌스 시드 키(DTC·IC·MRC·QPS·TRF·ETH·NUT·SAFE·OPS) — 2026-08-04 P0-b
  quorum       Int      @default(0) // 의결 정족수(0=과반 규칙)
  name         String   @db.VarChar(150)
  type         String   @db.VarChar(40) // QUALITY, SAFETY, INFECTION, PHARMACY, ETHICS, MEDICAL, MORTALITY, ...
  purpose      String?  @db.Text
  charter      String?  @db.Text // 위원회 헌장/규정
  meetingCycle String?  @map("meeting_cycle") @db.VarChar(30) // 월간/분기/반기
  chairId      String?  @map("chair_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  members      CommitteeMember[]
  meetings     CommitteeMeeting[]
  policies     InstitutionalPolicy[]
  agendas      CommitteeAgenda[]
  govDecisions CommitteeDecision[]

  @@index([type])
  @@map("committees")
}

// 위원 (Committee Member)
/**
 * 개원 단계 항목의 **사람 기록** — 2026-08-28.
 * 🔴 연결 키(`goLiveKey`/`decisionKey`/`committeeCode`)가 있는 항목에는 **쓰지 않는다.**
 * 상태를 두 곳에서 말하게 되는 순간 정본이 둘이 된다(서비스가 거부한다).
 */
model OpeningTaskRecord {
  id           String    @id @default(uuid()) @db.Uuid
  /**
   * `opening.registry.ts` 의 key
   */
  taskKey      String    @unique @map("task_key") @db.VarChar(80)
  /**
   * RECORDED = 완료했다 · NOT_APPLICABLE = 이 기관에 해당 없다(사유 필수)
   */
  state        String    @db.VarChar(20)
  /**
   * 증빙 참조 — 신고증 번호·문서번호 등. 🔴 **강제하지 않는다.**
   * 필수로 만들면 아무 값이나 채워진다(§규약 4). 비면 "증빙 미기재"로 보인다.
   */
  evidenceRef  String?   @map("evidence_ref") @db.VarChar(200)
  /**
   * 🔴 date-only — `dateOnlyValue` 로만 쓴다(로컬 자정을 넣으면 KST 에서 하루 밀린다)
   */
  evidenceDate DateTime? @map("evidence_date") @db.Date
  /**
   * NOT_APPLICABLE 이면 필수 — 사유 없이 지우면 빠뜨린 것과 구분되지 않는다
   */
  note         String?   @db.Text
  /**
   * 증빙 파일 — `[{ id, fileName, url, mimeType, sizeBytes, uploadedBy, uploadedAt }]`.
   * 🔴 URL 은 저장 경로다. **응답 시점에 서명**해서 내보낸다(`/uploads` 는 인증이 없다).
   */
  attachments  Json?     @db.JsonB
  recordedBy   String    @map("recorded_by") @db.Uuid
  recordedAt   DateTime  @default(now()) @map("recorded_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([state])
  @@map("opening_task_records")
}

/**
 * 🔴 **기관이 추가한 개원 항목** (P3) — `opening.registry.ts` 의 코드 항목과 **다른 표에 둔다.**
 * 레지스트리는 "기본 목록이며 전수가 아니다"라고 말하고, `O9_POST`(개원 직후)는
 * 아예 **비어 있다**("기관이 정한다"). 그런데 정하는 통로가 없었다 — 화면이 약속만 하고
 * 방법을 주지 않는 상태였다. 이 표가 그 통로다.
 * 🔴 이 표가 **하지 않는 것** 셋:
 * ① **연결 키(goLiveKey·decisionKey·committeeCode)를 갖지 않는다.** 파생은 코드 정본만 한다.
 * 기관이 임의 키를 넣으면 없는 것을 가리키거나 **남의 상태를 자기 상태인 척**한다.
 * 그래서 기관 항목의 상태는 언제나 사람 기록(`OpeningTaskRecord`)이다.
 * ② **레지스트리 항목을 덮어쓰지 않는다.** 코드 항목을 "해당 없음"으로 내리는 길은
 * 이미 있다(`OpeningTaskRecord.state = NOT_APPLICABLE` · 사유 필수). 여기서 또 내리면
 * 같은 사실에 정본이 둘이 된다.
 * ③ **키를 사람이 짓지 않는다** — `inst.<hex>` 로 발급한다. 사람이 지으면 레지스트리 키와
 * 부딪히거나 의미를 담아버린다(의미가 담기면 그것이 정책이 된다).
 */
model OpeningCustomTask {
  id             String   @id @default(uuid()) @db.Uuid
  /**
   * `inst.` 로 시작한다 — 🔴 레지스트리가 이 접두어를 쓰지 못하도록 가드가 막는다.
   * `OpeningTaskRecord.taskKey` 가 이 값을 그대로 쓴다(기록 표는 하나다).
   */
  key            String   @unique @db.VarChar(80)
  /**
   * 🔴 **비워두지 않는다.** 비면 "모든 나라"인지 "아직 안 정했는지" 구분되지 않는다
   * (레지스트리와 같은 규약 · 국가가 다르면 절차가 다르다).
   */
  countries      String[]
  phase          String   @db.VarChar(30)
  /**
   * 🔴 실무 명칭 그대로 — 전산 용어로 바꾸지 않는다
   */
  title          String   @db.VarChar(200)
  /**
   * 역할·부서(사람 이름 아님)
   */
  owner          String   @db.VarChar(100)
  /**
   * 어디에 내는가 — 🔴 모르면 `null`. 빈 문자열로 아는 척하지 않는다
   */
  authority      String?  @db.VarChar(200)
  dueBy          String   @db.VarChar(20)
  cycle          String?  @db.VarChar(20)
  note           String?  @db.Text
  /**
   * 선행 — 🔴 **막지 않는다**(순서를 보여줄 뿐). 🔴 **국가를 공유하는 항목만** 걸 수 있다.
   * 국가 간에 선행을 걸면 UAE 항목이 한국 항목을 기다리는 거짓 순서가 생긴다.
   */
  dependsOn      String[] @map("depends_on")
  /**
   * 🔴 **비활성은 삭제가 아니다.** 기록·증빙이 붙어 있을 수 있으므로 지우지 않고 내린다
   * (기록이 하나도 없는 항목만 삭제할 수 있다 — 오타 입력 회수용).
   */
  isActive       Boolean  @default(true) @map("is_active")
  /**
   * 🔴 내린 사유는 필수다 — 사유 없이 내리면 "빠뜨린 것"과 구분되지 않는다
   */
  inactiveReason String?  @map("inactive_reason") @db.Text
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([isActive])
  @@map("opening_custom_tasks")
}

model CommitteeMember {
  id          String   @id @default(uuid()) @db.Uuid
  committeeId String   @map("committee_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("MEMBER") @db.VarChar(20) // CHAIR, VICE_CHAIR, SECRETARY, MEMBER
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  isActive    Boolean  @default(true) @map("is_active")
  /**
   * 🔴 **시드 구성과 실제 임명은 다른 사실이다.** 리허설을 돌리려면 명부가 있어야 하지만,
   * 시드로 채운 위원을 "임명됐다"고 세면 화면이 거짓 안심을 준다 — Go-Live 준비율이
   * 시드 결재 3건을 실결재로 세어 65%(실제 45%)를 표시한 전례가 있다.
   * MANUAL = 사람이 화면에서 임명 · SEED = 리허설용 구성
   */
  source      String   @default("MANUAL") @db.VarChar(10)
  /**
   * 누가 임명 기록을 남겼는가 — 시드는 `null`(아무도 임명하지 않았다)
   */
  appointedBy String?  @map("appointed_by") @db.Uuid

  committee Committee @relation(fields: [committeeId], references: [id])
  /**
   * 🔴 종전에는 **맨 uuid** 였다 — 아무 값이나 넣어도 위원이 됐고, 화면은
   * 이름을 못 찾으면 조용히 `null` 로 그렸다(이름 없는 위원). FK 로 못박는다.
   * 실측(2026-08-28): 기존 30건 전부 유효한 사용자였다 — 소실 없이 추가 가능.
   */
  user      User      @relation("CommitteeMemberUser", fields: [userId], references: [id])

  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
  @@map("committee_members")
}

// 회의 (Committee Meeting) — 안건·회의록·의결
model CommitteeMeeting {
  id              String    @id @default(uuid()) @db.Uuid
  committeeId     String    @map("committee_id") @db.Uuid
  title           String    @db.VarChar(200)
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz()
  location        String?   @db.VarChar(100)
  agenda          String?   @db.Text
  minutes         String?   @db.Text // 회의록
  decisions       Json?     @db.JsonB // ⚠️ deprecated(P0-b) — 정형 의결은 CommitteeDecision. 과거 데이터 보존용
  minutesSignedAt DateTime? @map("minutes_signed_at") @db.Timestamptz() // 의사록 봉인(sign·P3)
  minutesSignRef  String?   @map("minutes_sign_ref") @db.VarChar(200)
  attendees       Json?     @db.JsonB // 참석자 userId[]
  status          String    @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, COMPLETED, CANCELLED
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  committee Committee @relation(fields: [committeeId], references: [id])

  @@index([committeeId, scheduledAt])
  @@index([status])
  @@map("committee_meetings")
}

// 기관 정책/규정 (Institutional Policy) — JCI GLD 정책 관리
model InstitutionalPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  code          String?   @db.VarChar(40)
  title         String    @db.VarChar(200)
  category      String    @db.VarChar(40) // CLINICAL, ADMIN, SAFETY, INFECTION, HR, ...
  version       String    @default("1.0") @db.VarChar(20)
  content       String?   @db.Text
  committeeId   String?   @map("committee_id") @db.Uuid
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz()
  effectiveDate DateTime? @map("effective_date") @db.Timestamptz()
  reviewDate    DateTime? @map("review_date") @db.Timestamptz() // 재검토 예정일
  status        String    @default("DRAFT") @db.VarChar(20) // DRAFT, ACTIVE, UNDER_REVIEW, ARCHIVED
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  committee Committee? @relation(fields: [committeeId], references: [id])

  @@index([category, status])
  @@index([reviewDate])
  @@map("institutional_policies")
}

// ── 위원회 거버넌스 엔진 P0-b(2026-08-04) — 안건·의결·집행항목·표면 매핑 ──
// 기획 정본: docs/01-plan/features/committee-governance-engine.plan.md (D1~D15)

/// 안건 — 접수(SUBMITTED)→회의 배정(SCHEDULED)→의결(RESOLVED)|부결|보류|철회
model CommitteeAgenda {
  id           String    @id @default(uuid()) @db.Uuid
  committeeId  String    @map("committee_id") @db.Uuid
  meetingId    String?   @map("meeting_id") @db.Uuid // null=회의 배정 전
  seq          Int? // 회의 내 순번
  title        String    @db.VarChar(300)
  proposerId   String    @map("proposer_id") @db.Uuid
  sourceRef    Json?     @map("source_ref") // 유입 출처 {type:'SAFETY_GATE'|'GO_LIVE'|'FORMULARY_REQUEST'|'DATA_QUALITY', key}
  body         String?   @db.Text
  status       String    @default("SUBMITTED") @db.VarChar(20) // SUBMITTED, SCHEDULED, RESOLVED, REJECTED, DEFERRED, WITHDRAWN
  /// 🔴 의결 선택지 — `[{ value, label, effect, enact }]`. 어휘 정본은 shared `decision-option.ts`.
  /// 등록부에서 올라온 안건은 그 `options` 를 **`enact` 까지 그대로** 싣는다(종전에는 `enact` 가
  /// 빠지고 AI 프롬프트 안에서만 인용돼, 의결해도 어느 안을 골랐는지가 구조로 남지 않았다).
  /// null/빈 배열 = 선택지 없는 안건 → 종전대로 자유서술 의결.
  options      Json?     @map("options")
  aiAssessment Json?     @map("ai_assessment") // AI 영향 평가 스냅샷(워크벤치 P2 — 재생성=교체·RESOLVED 후 동결)
  aiAssessedAt DateTime? @map("ai_assessed_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  committee Committee          @relation(fields: [committeeId], references: [id])
  decision  CommitteeDecision?

  @@index([committeeId, status])
  @@index([meetingId])
  @@map("committee_agendas")
}

/// 의결 — GOV-YYYY-NNN. 시계열 정본=supersede 체인(D4)
model CommitteeDecision {
  id             String    @id @default(uuid()) @db.Uuid
  committeeId    String    @map("committee_id") @db.Uuid
  agendaId       String    @unique @map("agenda_id") @db.Uuid
  decisionNo     String    @unique @map("decision_no") @db.VarChar(30)
  resolution     String    @db.Text // 의결 주문
  /// 🔴 **무엇을 골랐는가** — 값 하나가 아니라 `{ value, snapshot[], note? }`.
  /// 안건 선택지는 나중에 바뀔 수 있으므로 **그때 본 선택지 전문을 스냅샷**으로 남긴다.
  /// `value` 가 `MODIFIED`/`NONE_OF_ABOVE` 면 원안 수정·선택지 밖 의결이며 **자동 집행하지 않는다**.
  chosenOption   Json?     @map("chosen_option")
  voteFor        Int?      @map("vote_for")
  voteAgainst    Int?      @map("vote_against")
  voteAbstain    Int?      @map("vote_abstain")
  resolvedAt     DateTime  @map("resolved_at") @db.Timestamptz()
  effectiveFrom  DateTime? @map("effective_from") @db.Timestamptz()
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz()
  reviewDue      DateTime? @map("review_due") @db.Date
  status         String    @default("RESOLVED") @db.VarChar(20) // RESOLVED, ENACTED, PARTIALLY_ENACTED, SUPERSEDED, REVOKED, EXPIRED
  supersedesId   String?   @map("supersedes_id") @db.Uuid
  policyId       String?   @map("policy_id") @db.Uuid // InstitutionalPolicy 제·개정 연결
  signRef        String?   @map("sign_ref") @db.VarChar(200) // 봉인 영수증(P3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  committee Committee        @relation(fields: [committeeId], references: [id])
  agenda    CommitteeAgenda  @relation(fields: [agendaId], references: [id])
  actions   DecisionAction[]

  @@index([committeeId, status])
  @@index([supersedesId])
  @@map("committee_decisions")
}

/// 집행 항목 — P0-b 는 MANUAL 기록만, 자동 집행(CONFIG/GATE …)은 P1 엔진
/// 집행 액션 원장 — **출처가 둘이다**(2026-08-27).
///
/// 🔴 종전에는 `decisionId` 가 NOT NULL 이라 액션이 반드시 위원회 의결에 매달렸다.
///    그런데 사람 결정 등록부(`decision.registry.ts`)의 **허가권자 결정**은 위원회가 의결한 것이
///    아니다. 그것을 이 원장에 담으려면 위원회와 안건을 지어내야 했고, 그러면
///    `committee_decisions` 에 **위원회가 의결하지 않은 것이 의결로 박힌다.**
///    (이 저장소 고정 원칙: 결정의 세 층은 고정 · 하위가 상위를 대체하지 못한다)
///
///    그래서 집행기는 그대로 두고 **출처 한 칸만 일반화**했다.
///    🔴 불변식: `decisionId` 와 `registryKey` 중 **정확히 하나**만 채워진다.
///       (Prisma 가 CHECK 를 표현하지 못해 애플리케이션 가드가 강제한다 — `assertSingleSource`)
model DecisionAction {
  id             String    @id @default(uuid()) @db.Uuid
  /// 위원회 의결에서 온 액션 — `registryKey` 와 배타
  decisionId     String?   @map("decision_id") @db.Uuid
  /// 결정 등록부(허가권자·코드변경)에서 온 액션 — `decisionId` 와 배타. 값은 `DECISION_REGISTRY` 의 key
  registryKey    String?   @map("registry_key") @db.VarChar(80)
  kind           String    @db.VarChar(30) // MANUAL | (P1~) CONFIG_CHANGE·GATE_MODE·FORMULARY·MASTER_DATA·TEMPLATE·ACCESS·PUBLISH·RETENTION
  target         Json
  status         String    @default("PENDING") @db.VarChar(20) // PENDING, ENACTED, FAILED, SKIPPED, CANCELLED
  snapshotBefore Json?     @map("snapshot_before")
  enactedAt      DateTime? @map("enacted_at") @db.Timestamptz()
  enactedBy      String?   @map("enacted_by") @db.Uuid
  error          String?   @db.VarChar(500)
  manualNote     String?   @map("manual_note") @db.Text
  /// 🔴 이 집행이 선 **근거** — `{ legal?, accreditation?, evidence? }`(shared `decision-basis.ts`).
  /// 세 갈래를 섞지 않는다(법령=지켜야 할 것 · 인증=받으려는 것 · 실측=우리 데이터).
  /// 🔴 키 없음 = **미기재**, 빈 배열 = **검토했고 해당 없음** — 다른 사실이다.
  basis          Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  decision CommitteeDecision? @relation(fields: [decisionId], references: [id])

  @@index([decisionId])
  @@index([registryKey])
  @@index([status])
  @@map("decision_actions")
}

/// 정책 표면 담당 매핑(D14) — go-live.registry owner 이관 시드
model CommitteeSurfaceMap {
  id          String   @id @default(uuid()) @db.Uuid
  /// 'config:dur.enforce' · 'master:…' · 'pathway:CP-AMI-001' · 'protocol:ER_V1'
  /// 🔴 2026-08-27: `@unique` 를 풀었다 — **합동 의결**(진료위+QPS)을 표현할 수 없었다.
  ///    담당 정본은 여전히 이 표 **하나**다(요건은 `StandardGovernanceRule` 이 갖는다 — 다른 축).
  surfaceKey  String   @map("surface_key") @db.VarChar(120)
  committeeId String   @map("committee_id") @db.Uuid
  note        String?  @db.VarChar(300) // 근거(법정·인증 조항·registry 원 owner 표기)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([surfaceKey, committeeId])
  @@index([surfaceKey])
  @@index([committeeId])
  @@map("committee_surface_maps")
}

/// 결정 **경로** — CP 엔진(`ProtocolTemplate`)의 결정 축 대응물 (2026-08-28 · P2).
///
/// 🔴 발단: CP 엔진과 1:1로 놓으니 결정 축에 **10가지가 전부 없었다** —
///    템플릿·버전 / 발행이력 / 단계 / 단계별 담당역할 / 게이트 / SLA / 전이조건 /
///    인스턴스 버전 스냅샷 / 현재단계 / **막힌 이유**.
///    결정은 "상태 문자열 6값 + 자유서술"이었고, 병원에서 더 오래 멈춰 있는 쪽은 결정인데
///    계측이 없는 쪽도 결정이었다.
///
/// 🔴 CP 의 `protocol_*` 표를 재사용하지 않는다 — 그쪽은 **환자 인스턴스** 축이다.
///    한 표에 섞으면 둘 다 오염된다(모양만 차용한다).
model DecisionPathway {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @db.VarChar(40)
  name        String    @db.VarChar(200)
  version     Int       @default(1)
  /// DRAFT | ACTIVE | RETIRED
  status      String    @default("DRAFT") @db.VarChar(12)
  /// 어느 층의 결정에 쓰는 경로인가 — LICENSE_HOLDER | INTERNAL_COMMITTEE | STAFF
  layer       String    @db.VarChar(20)
  description String?   @db.Text
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  publishedBy String?   @map("published_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  steps     DecisionPathwayStep[]
  instances DecisionPathwayInstance[]

  @@unique([code, version])
  @@index([code, status])
  @@map("decision_pathways")
}

model DecisionPathwayStep {
  id          String   @id @default(uuid()) @db.Uuid
  pathwayId   String   @map("pathway_id") @db.Uuid
  key         String   @db.VarChar(40)
  title       String   @db.VarChar(120)
  sortOrder   Int      @map("sort_order")
  /// 🔴 이 단계는 **누구 손에 있는가** — 지금까지 어디에도 없던 값이다
  ownerRoles  String[] @map("owner_roles")
  /// 게이트 단계 — 통과하지 못하면 다음으로 못 간다("법적 검토 없이 의결"을 막을 자리)
  gate        Boolean  @default(false)
  /// 명명 술어 — legal_review_recorded | quorum_met | basis_present …
  gateRule    String?  @map("gate_rule") @db.VarChar(40)
  /// 🔴 기한(일). **null = 기준 없음.**
  ///    2026-08-28 실측: 의결된 안건 20건이 **전부 당일 처리**(평균 0.2일·최대 0.6일)였다.
  ///    실제 위원회 소요가 아니라 시드가 같은 날 만든 흔적이라 **표본이 아니다.**
  ///    감으로 기준을 넣지 않는다 — 미설정임을 화면이 밝힌다.
  slaDays     Int?     @map("sla_days")
  /// [{ toKey, condition? }] — 반려·보류·재심의 같은 분기
  transitions Json?

  pathway DecisionPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, key])
  @@index([pathwayId])
  @@map("decision_pathway_steps")
}

/// 안건/등록부 항목 하나 = 인스턴스.
/// 🔴 출처는 **배타**다 — `DecisionAction` 과 같은 불변식(위원회 의결 ≠ 허가권자 결정).
model DecisionPathwayInstance {
  id             String    @id @default(uuid()) @db.Uuid
  pathwayId      String    @map("pathway_id") @db.Uuid
  /// 🔴 **버전 스냅샷** — 경로가 개정돼도 과거 인스턴스가 소급 해석되지 않는다
  pathwayVersion Int       @map("pathway_version")
  /// 위원회 안건에서 온 것 — `registryKey` 와 배타
  agendaId       String?   @unique @map("agenda_id") @db.Uuid
  /// 결정 등록부에서 온 것 — `agendaId` 와 배타
  registryKey    String?   @unique @map("registry_key") @db.VarChar(80)
  currentStepKey String?   @map("current_step_key") @db.VarChar(40)
  /// ACTIVE | BLOCKED | DONE | CANCELLED
  status         String    @default("ACTIVE") @db.VarChar(12)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()

  pathway DecisionPathway            @relation(fields: [pathwayId], references: [id])
  states  DecisionPathwayStepState[]

  @@index([status])
  @@map("decision_pathway_instances")
}

model DecisionPathwayStepState {
  id            String    @id @default(uuid()) @db.Uuid
  instanceId    String    @map("instance_id") @db.Uuid
  stepKey       String    @map("step_key") @db.VarChar(40)
  /// PENDING | IN_PROGRESS | DONE | BLOCKED | SKIPPED
  status        String    @default("PENDING") @db.VarChar(12)
  actorId       String?   @map("actor_id") @db.Uuid
  actedAt       DateTime? @map("acted_at") @db.Timestamptz()
  /// 🔴 **왜 멈춰 있는가** — 지금 어디에도 없는 값이다.
  ///    "막혔다"만 알고 이유를 모르면 아무도 그 결정을 다시 밀 수 없다.
  blockedReason String?   @map("blocked_reason") @db.Text
  note          String?   @db.Text

  instance DecisionPathwayInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, stepKey])
  @@index([instanceId])
  @@map("decision_pathway_step_states")
}

/// 표준(프로세스·프로토콜·CP)이 **발효되기 위한 요건** — 2026-08-27.
///
/// 🔴 발단(운영 실측): 발효 중인 진료 표준 9건(임상경로 5·프로토콜 4)에 **의결 근거가 하나도 없었다.**
///    임상경로는 `@Roles(ADMIN)` 클릭 한 번으로 `status:'ACTIVE'` 가 되고 발행자 컬럼조차 없었다.
///    실제 의료기관에서 CP·프로토콜은 위원회가 제정·개정·폐지를 의결하고 그 의결번호로 발효된다.
///
/// 🔴 **담당(누구 것인가)은 여기 없다** — `CommitteeSurfaceMap` 이 정본이다.
///    여기에 위원회를 또 두면 같은 질문에 답이 둘이 된다.
model StandardGovernanceRule {
  id            String   @id @default(uuid()) @db.Uuid
  /// PATHWAY | PROTOCOL | PROCESS
  standardKind  String   @map("standard_kind") @db.VarChar(20)
  /// 🔴 `'*'` = 그 유형 전체의 **기본 규칙** · 그 외 = 이 표준만의 예외.
  ///    처음엔 `null` 로 뒀는데, Postgres 는 유니크 인덱스에서 NULL 을 **서로 다르게** 취급해
  ///    `(PATHWAY, null)` 기본 규칙이 **둘 이상 생길 수 있었다** — 그러면 조회가 아무거나 집는다.
  ///    어휘를 지어낸 것이 아니라 **범위 표식**이며, 표준 코드로 쓸 수 없는 값을 골랐다.
  standardCode  String   @default("*") @map("standard_code") @db.VarChar(60)
  /// 복수 담당일 때 전원 의결(AND)인가 한 곳이면 되는가(OR). 담당 목록은 surfaceMap 이 갖는다
  requireAll    Boolean  @default(true) @map("require_all")
  /// 행위별 요건 `{ ENACT, AMEND, RETIRE }` — 제정은 위원회, 오타 수정까지 위원회는 과하다
  /// 값: 'COMMITTEE' | 'DELEGATED'(위원회가 위임한 경미개정 — 위임 근거 의결번호 필수)
  actions       Json
  /// ['legal','accreditation','evidence'] 중 필수인 것. 빈 배열 = 근거를 요구하지 않는다
  requireBasis  String[] @map("require_basis")
  /// 재심의 주기(월). 🔴 null = 주기 없음 — 주기를 지어내지 않는다
  reviewCycleM  Int?     @map("review_cycle_m")
  /// 🔴 OFF | WARN | BLOCK — **기본 WARN**. BLOCK 으로 켜면 이미 발효된 표준이 즉시 멈춘다
  ///    (환자에게 적용 중인 임상경로 5건 — 그것은 안전측이 아니라 진료 중단이다)
  gateMode      String   @default("WARN") @map("gate_mode") @db.VarChar(10)
  /// 위임을 허용한 근거 의결번호(`actions` 에 DELEGATED 가 있을 때 필수)
  delegationRef String?  @map("delegation_ref") @db.VarChar(30)
  note          String?  @db.Text
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([standardKind, standardCode])
  @@map("standard_governance_rules")
}

// 환자 마킹/플래그 (비표준) — 악성('루비')·VIP·직원지인
model PatientFlag {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  flagType      String   @db.VarChar(20) // MALICIOUS(루비), VIP, ACQUAINTANCE
  reason        String?  @db.Text
  flaggedBy     String   @map("flagged_by") @db.Uuid // 마킹한 직원
  relatedUserId String?  @map("related_user_id") @db.Uuid // ACQUAINTANCE/VIP: 누구의 지인인지(직원)
  relation      String?  @db.VarChar(30) // FAMILY, FRIEND, ACQUAINTANCE
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, flaggedBy, flagType]) // 1인 1유형 1회 → 악성 마킹 카운트 = 표시한 직원 수
  @@index([patientId, flagType])
  @@map("patient_flags")
}

// ============================================================
// ============================================================
// 임상 워크스테이션 (Workstation)
// ============================================================

model WorkstationConfig {
  id         String   @id @default(uuid()) @db.Uuid
  stationId  String   @unique @map("station_id") @db.VarChar(30)
  label      String   @db.VarChar(100)
  category   String   @db.VarChar(20) // LAB, IMAGING, DIAGNOSTIC
  department String   @db.VarChar(50) // 진단검사의학과, 영상의학과 등
  orderCodes Json     @map("order_codes") @db.JsonB // 이 스테이션에서 처리하는 코드 목록
  location   String?  @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("workstation_configs")
}

// ── 워크스테이션-디바이스 연동(P0+P1) — 물리 워크스테이션 + 주변기기 ──

// 물리 워크스테이션 프로파일(하이브리드 정체성: terminalId 바인딩 or code 선택)
model WorkstationProfile {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(30) // 로그인/선택 키 (예: WS-LAB-01)
  label             String             @db.VarChar(100)
  department        String?            @db.VarChar(50)
  location          String?            @db.VarChar(100)
  defaultStationIds Json               @default("[]") @map("default_station_ids") @db.JsonB // 논리 WorkstationConfig.stationId 매핑
  terminalId        String?            @map("terminal_id") @db.Uuid // TerminalRegistry 바인딩(자동 해석·선택)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  peripherals       PeripheralDevice[]

  @@index([terminalId])
  @@map("workstation_profiles")
}

// 주변기기(프린터·스캐너·서명패드·모달리티 등) — 연결정보 조정 가능
model PeripheralDevice {
  id                   String             @id @default(uuid()) @db.Uuid
  workstationProfileId String             @map("workstation_profile_id") @db.Uuid
  type                 String             @db.VarChar(20) // LABEL_PRINTER/DOC_PRINTER/BARCODE_SCANNER/SIGNATURE_PAD/DICOM_MODALITY/VITALS_MONITOR/CARD_READER/OTHER
  name                 String             @db.VarChar(100)
  connection           String             @default("NETWORK") @db.VarChar(15) // NETWORK/LOCAL_AGENT/WEBUSB/WEBSERIAL
  host                 String?            @db.VarChar(120) // 네트워크 IP/호스트
  port                 Int? // 네트워크 포트(프린터 9100 등)
  config               Json?              @db.JsonB // 드라이버별 설정(용지·DPI·에이전트ID·프로토콜 등)
  isDefault            Boolean            @default(false) @map("is_default") // 유형별 기본기
  status               String             @default("UNKNOWN") @db.VarChar(10) // ONLINE/OFFLINE/UNKNOWN
  lastSeenAt           DateTime?          @map("last_seen_at") @db.Timestamptz()
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  workstation          WorkstationProfile @relation(fields: [workstationProfileId], references: [id])

  @@index([workstationProfileId, type])
  @@map("peripheral_devices")
}

// ── 당직/근무표(duty-schedule) 영속화 ──
model DutyEntry {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime @db.Date
  shift      String   @db.VarChar(10) // DAY|EVENING|NIGHT
  staffId    String   @map("staff_id") @db.VarChar(50) // User.id (2026-07-22 운영 전수검증: 외부 직원키 없음)
  staffName  String   @map("staff_name") @db.VarChar(100)
  role       String   @db.VarChar(20) // doctor|nurse
  department String   @db.VarChar(50)
  startTime  String?  @map("start_time") @db.VarChar(5) // "09:00" — HR 수동입력·ERP 근태 산정용(StaffSchedule 통합 이관)
  endTime    String?  @map("end_time") @db.VarChar(5)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([date])
  @@index([staffId, date])
  @@index([department, date])
  @@map("duty_entries")
}

model DutySwapRequest {
  id            String   @id @default(uuid()) @db.Uuid
  requesterId   String   @map("requester_id") @db.VarChar(50)
  requesterName String   @map("requester_name") @db.VarChar(100)
  targetId      String   @map("target_id") @db.VarChar(50)
  targetName    String   @map("target_name") @db.VarChar(100)
  originalDate  String   @map("original_date") @db.VarChar(10)
  originalShift String   @map("original_shift") @db.VarChar(10)
  swapDate      String   @map("swap_date") @db.VarChar(10)
  swapShift     String   @map("swap_shift") @db.VarChar(10)
  reason        String   @db.Text
  status        String   @default("PENDING") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status])
  @@map("duty_swap_requests")
}

model DutyLeaveRequest {
  id         String   @id @default(uuid()) @db.Uuid
  staffId    String   @map("staff_id") @db.VarChar(50)
  staffName  String   @map("staff_name") @db.VarChar(100)
  department String   @db.VarChar(50)
  startDate  String   @map("start_date") @db.VarChar(10)
  endDate    String   @map("end_date") @db.VarChar(10)
  type       String   @db.VarChar(15) // ANNUAL|SICK|PERSONAL|MATERNITY
  reason     String   @db.Text
  status     String   @default("PENDING") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status])
  @@map("duty_leave_requests")
}

// 당직 인력기준(P1b) — 부서·근무·요일유형별 최소 인원. 편성/조회 시 미달 경고 근거.
model DutyStaffingRule {
  id         String   @id @default(uuid()) @db.Uuid
  department String   @db.VarChar(50)
  shift      String   @db.VarChar(10) // DAY|EVENING|NIGHT
  dayType    String   @default("ALL") @map("day_type") @db.VarChar(10) // ALL|WEEKDAY|WEEKEND|HOLIDAY
  minCount   Int      @default(1) @map("min_count")
  nurseGrade String?  @map("nurse_grade") @db.VarChar(10) // 간호등급(선택)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([department, shift, dayType])
  @@map("duty_staffing_rules")
}

// 당직 on-call(P2) — 3교대와 별개. 과별 당직·1st/2nd call 로테이션.
model OnCallSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime @db.Date
  department String   @db.VarChar(50)
  callLevel  String   @map("call_level") @db.VarChar(10) // FIRST|SECOND|BACKUP
  staffId    String   @map("staff_id") @db.Uuid // User.id
  staffName  String   @map("staff_name") @db.VarChar(100)
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([date, department, callLevel])
  @@index([date])
  @@map("on_call_schedules")
}

// 개인 근무 선호/기피(P3) — 편성 전 희망 수집.
model DutyPreference {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid // User.id
  month     String   @db.VarChar(7) // YYYY-MM
  date      String   @db.VarChar(10) // 특정일 희망/기피
  kind      String   @db.VarChar(10) // WISH_OFF|WISH_DAY|WISH_NIGHT|AVOID
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([staffId, month])
  @@map("duty_preferences")
}

// ── 수련교육(education) 영속화: 로그북·EPA·로테이션·증례발표 ──
model TrainingLogbook {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.VarChar(50)
  date          DateTime @db.Date
  category      String   @db.VarChar(20) // PROCEDURE|CASE|LECTURE|CONFERENCE
  procedureName String?  @map("procedure_name") @db.VarChar(200)
  icdCode       String?  @map("icd_code") @db.VarChar(20)
  role          String   @default("ASSISTANT") @db.VarChar(20)
  supervisor    String?  @db.VarChar(100)
  department    String?  @db.VarChar(50)
  patientAge    Int?     @map("patient_age")
  complexity    String   @default("MODERATE") @db.VarChar(20)
  outcome       String   @default("SUCCESSFUL") @db.VarChar(20)
  reflection    String?  @db.Text
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, date])
  @@map("training_logbooks")
}

model EpaAssessment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.VarChar(50)
  epaNumber        String   @map("epa_number") @db.VarChar(20)
  epaTitle         String?  @map("epa_title") @db.VarChar(200)
  entrustmentLevel Int      @default(1) @map("entrustment_level") // 1~5
  assessor         String?  @db.VarChar(100)
  assessorRole     String?  @map("assessor_role") @db.VarChar(50)
  clinicalContext  String?  @map("clinical_context") @db.Text
  strengths        String?  @db.Text
  improvements     String?  @db.Text
  feedback         String?  @db.Text
  assessedAt       DateTime @default(now()) @map("assessed_at") @db.Timestamptz()

  @@index([userId, epaNumber])
  @@map("epa_assessments")
}

model TrainingRotation {
  id           String   @id @default(uuid()) @db.Uuid
  residentId   String   @map("resident_id") @db.VarChar(50)
  residentName String   @map("resident_name") @db.VarChar(100)
  department   String   @db.VarChar(50)
  startDate    String   @map("start_date") @db.VarChar(10)
  endDate      String   @map("end_date") @db.VarChar(10)
  supervisor   String?  @db.VarChar(100)
  objectives   Json?    @db.JsonB
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  @@index([department])
  @@map("training_rotations")
}

model CasePresentation {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(300)
  presenter        String?  @db.VarChar(100)
  department       String?  @db.VarChar(50)
  presentationDate DateTime @map("presentation_date") @db.Date
  caseType         String   @default("CLINICAL") @map("case_type") @db.VarChar(20)
  diagnosis        String?  @db.VarChar(300)
  summary          String?  @db.Text
  learningPoints   Json?    @map("learning_points") @db.JsonB
  attendees        Json?    @db.JsonB
  feedback         String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([department])
  @@map("case_presentations")
}

model LabTestTemplate {
  id            String  @id @default(uuid()) @db.Uuid
  procedureCode String  @unique @map("procedure_code") @db.VarChar(20)
  testName      String  @map("test_name") @db.VarChar(200)
  stationId     String  @map("station_id") @db.VarChar(30)
  items         Json    @db.JsonB // [{ name, unit, refRange, decimalPlaces }]
  isActive      Boolean @default(true) @map("is_active")

  @@map("lab_test_templates")
}

// ── 치료 오더 ──

model TherapyOrder {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @unique @map("order_id") @db.Uuid
  therapyType   String    @map("therapy_type") @db.VarChar(30)
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  scheduledTime String?   @map("scheduled_time") @db.VarChar(10)
  duration      Int?
  therapistId   String?   @map("therapist_id") @db.Uuid
  stationId     String?   @map("station_id") @db.VarChar(30)
  isRecurring   Boolean   @default(false) @map("is_recurring")
  recurPattern  String?   @map("recur_pattern") @db.VarChar(50)
  recurEndDate  DateTime? @map("recur_end_date") @db.Date
  totalSessions Int?      @map("total_sessions")
  sessionNo     Int?      @map("session_no")
  resultData    Json?     @map("result_data") @db.JsonB
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  order     Order @relation(fields: [orderId], references: [id])
  therapist User? @relation("TherapyTherapist", fields: [therapistId], references: [id])

  @@index([scheduledDate, stationId])
  @@index([therapistId, scheduledDate])
  @@map("therapy_orders")
}

// 건강검진 센터 (Checkup Center) — 클리닉 센터 확장 패턴
// 테이블 prefix: ck_ / checkup_
// ============================================================

// ── 검진 검사항목 마스터 ──

model CheckupTestMaster {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(30) // ex: CBC_18, CHEST_PA, EKG
  name           String   @db.VarChar(200) // ex: 일반혈액검사 (18항목)
  category       String   @db.VarChar(20) // PHYSICAL, LAB, IMAGING, DIAGNOSTIC, CONSULT, AI
  subCategory    String?  @map("sub_category") @db.VarChar(50) // ex: 혈액, 소변, 초음파, X-ray, CT, MRI
  interpretDept  String?  @map("interpret_dept") @db.VarChar(50) // 판독 담당과
  unit           String?  @db.VarChar(30) // 결과 단위 (mg/dL, mm 등)
  referenceRange String?  @map("reference_range") @db.VarChar(100) // 참고치 (ex: 70~110)
  defaultPrice   Int      @default(0) @map("default_price") // 단독 시행 시 기본 단가
  duration       Int      @default(5) // 예상 소요(분)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category])
  @@index([isActive])
  @@map("checkup_test_masters")
}

// ── 검진 프로그램 (패키지) ──

model CheckupProgram {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(200)
  category      String   @db.VarChar(20) // BASIC, PLUS, PRECISION, PREMIUM, PET_PRECISION, SPECIAL
  description   String?  @db.Text
  gender        String   @default("ALL") @db.VarChar(10) // ALL, MALE, FEMALE
  ageMin        Int?     @map("age_min")
  ageMax        Int?     @map("age_max")
  price         Int // 정가 (원)
  discountRate  Int      @default(0) @map("discount_rate")
  duration      Int      @default(120) // 예상 소요(분)
  dailyCapacity Int?     @map("daily_capacity") // 일일 최대 수검자 수 (null=무제한)
  items         Json     @db.JsonB // CheckupProgramItem[]
  options       Json?    @db.JsonB // 선택 추가 항목
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  visits         CheckupVisit[]
  contracts      CheckupContract[]
  questionnaires CheckupQuestionnaire[]

  @@map("checkup_programs")
}

// ── 검진 문진표 ──

model CheckupQuestionnaire {
  id        String   @id @default(uuid()) @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  title     String   @db.VarChar(200)
  sections  Json     @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  program   CheckupProgram?                @relation(fields: [programId], references: [id])
  responses CheckupQuestionnaireResponse[]

  @@map("ck_questionnaires")
}

model CheckupQuestionnaireResponse {
  id              String    @id @default(uuid()) @db.Uuid
  questionnaireId String    @map("questionnaire_id") @db.Uuid
  visitId         String    @unique @map("visit_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  answers         Json      @db.JsonB
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  questionnaire CheckupQuestionnaire @relation(fields: [questionnaireId], references: [id])
  visit         CheckupVisit         @relation(fields: [visitId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("ck_questionnaire_responses")
}

// ── 검진 워크스테이션 ──

model CheckupStation {
  id          String   @id @default(uuid()) @db.Uuid
  stationId   String   @unique @map("station_id") @db.VarChar(30)
  name        String   @db.VarChar(100)
  category    String   @db.VarChar(20) // LAB, IMAGING, DIAGNOSTIC, PHYSICAL, CONSULT
  location    String?  @db.VarChar(100)
  icon        String?  @db.VarChar(10)
  sortOrder   Int      @default(0) @map("sort_order")
  avgMinutes  Int      @default(5) @map("avg_minutes")
  capacity    Int      @default(1)
  template    Json?    @db.JsonB
  hisMapping  Json?    @map("his_mapping") @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  // 공간 정본 연결(P0-5) — null = 미연결(위치를 모른다고 말한다 · `location` 자유 텍스트는 폐기 예정)
  spaceNodeId String?  @map("space_node_id") @db.Uuid

  logs      CheckupStationLog[]
  spaceNode SpaceNode?          @relation(fields: [spaceNodeId], references: [id])

  @@map("ck_stations")
}

model CheckupStationLog {
  id          String    @id @default(uuid()) @db.Uuid
  visitId     String    @map("visit_id") @db.Uuid
  stationId   String    @map("station_id") @db.VarChar(30)
  arrivedAt   DateTime  @map("arrived_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  operatorId  String?   @map("operator_id") @db.Uuid
  resultData  Json?     @map("result_data") @db.JsonB
  finding     String    @default("PENDING") @db.VarChar(20)
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  visit    CheckupVisit   @relation(fields: [visitId], references: [id])
  station  CheckupStation @relation(fields: [stationId], references: [stationId])
  operator User?          @relation("CheckupStationOperator", fields: [operatorId], references: [id])

  @@unique([visitId, stationId])
  @@index([stationId, arrivedAt])
  @@map("ck_station_logs")
}

// ── 검진 방문 ──

model CheckupVisit {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  programId        String    @map("program_id") @db.Uuid
  encounterId      String?   @map("encounter_id") @db.Uuid
  scheduledDate    DateTime  @map("scheduled_date") @db.Date
  status           String    @default("RESERVED") @db.VarChar(20)
  // RESERVED → CHECKED_IN → IN_PROGRESS → EXAM_COMPLETE(→PARTIAL_COMPLETE) → REVIEW → COMPLETED → DELIVERED
  // 종료 상태: CANCELLED · NO_SHOW (정본 STATUS_FLOW — 주석 어휘 누락으로 G축 오판 여지 있던 것 정정 2026-08-24)
  selectedOptions  Json?     @map("selected_options") @db.JsonB
  totalPrice       Int       @map("total_price")
  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz()
  completedAt      DateTime? @map("completed_at") @db.Timestamptz()
  barcodeNumber    String?   @map("barcode_number") @db.VarChar(20)
  questionnaireId  String?   @map("questionnaire_id") @db.Uuid
  isNhiScreening   Boolean   @default(false) @map("is_nhi_screening")
  nhiScreeningCode String?   @map("nhi_screening_code") @db.VarChar(10)
  contractId       String?   @map("contract_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient               Patient                       @relation(fields: [patientId], references: [id])
  program               CheckupProgram                @relation(fields: [programId], references: [id])
  encounter             Encounter?                    @relation(fields: [encounterId], references: [id])
  contract              CheckupContract?              @relation("ContractVisits", fields: [contractId], references: [id])
  items                 CheckupResultItem[]
  summary               CheckupSummary?
  interpretations       CheckupInterpretation[]
  referrals             CheckupReferral[]
  followUps             CheckupFollowUp[]
  questionnaireResponse CheckupQuestionnaireResponse?
  stationLogs           CheckupStationLog[]

  @@index([patientId])
  @@index([scheduledDate])
  @@index([status])
  @@index([contractId])
  @@index([encounterId])
  @@map("checkup_visits")
}

// ── 개별 검사 결과 ──

model CheckupResultItem {
  id             String    @id @default(uuid()) @db.Uuid
  visitId        String    @map("visit_id") @db.Uuid
  category       String    @db.VarChar(20) // LAB, IMAGING, DIAGNOSTIC, PHYSICAL
  testCode       String?   @map("test_code") @db.VarChar(30) // CheckupTestMaster.code — 프로토콜 판정룰 매칭
  testName       String    @map("test_name") @db.VarChar(200)
  value          String?   @db.VarChar(200)
  unit           String?   @db.VarChar(50)
  referenceRange String?   @map("reference_range") @db.VarChar(100)
  finding        String    @default("PENDING") @db.VarChar(20) // NORMAL, ABNORMAL, CRITICAL, PENDING, NOT_APPLICABLE
  grade          String?   @db.VarChar(5) // 프로토콜 판정 등급 A~D2
  sourceType     String?   @map("source_type") @db.VarChar(30) // LAB_RESULT, IMAGING_RESULT, DIAGNOSTIC_TEST
  sourceId       String?   @map("source_id") @db.Uuid
  note           String?   @db.Text
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  visit          CheckupVisit           @relation(fields: [visitId], references: [id])
  interpretation CheckupInterpretation?

  @@index([visitId])
  @@map("checkup_result_items")
}

// ── 종합 소견 ──

model CheckupSummary {
  id              String    @id @default(uuid()) @db.Uuid
  visitId         String    @unique @map("visit_id") @db.Uuid
  overallGrade    String    @map("overall_grade") @db.VarChar(5) // A, B, C1, C2, D1, D2
  sections        Json      @db.JsonB // { area, grade, findings }[]
  doctorOpinion   String?   @map("doctor_opinion") @db.Text
  recommendations Json?     @db.JsonB // string[]
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  authoredBy      String?   @map("authored_by") @db.Uuid // 작성자(검진의) — 4-eyes: 서명자와 분리
  signedBy        String?   @map("signed_by") @db.Uuid // 서명자(자격 검증)
  signedAt        DateTime? @map("signed_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  visit  CheckupVisit @relation(fields: [visitId], references: [id])
  doctor User?        @relation("CheckupReviewer", fields: [reviewedBy], references: [id])

  @@map("checkup_summaries")
}

// ── 과별 판독 요청 ──

model CheckupInterpretation {
  id             String    @id @default(uuid()) @db.Uuid
  visitId        String    @map("visit_id") @db.Uuid
  resultItemId   String    @unique @map("result_item_id") @db.Uuid
  department     String    @db.VarChar(50)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  interpretedBy  String?   @map("interpreted_by") @db.Uuid
  interpretedAt  DateTime? @map("interpreted_at") @db.Timestamptz()
  finding        String?   @db.Text
  grade          String?   @db.VarChar(5)
  recommendation String?   @db.Text
  status         String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, IN_REVIEW, COMPLETED

  visit      CheckupVisit      @relation(fields: [visitId], references: [id])
  resultItem CheckupResultItem @relation(fields: [resultItemId], references: [id])
  doctor     User?             @relation("CheckupInterpreter", fields: [interpretedBy], references: [id])

  @@index([department, status])
  @@map("ck_interpretations")
}

// ── 검진결과 해석(쉽게보기) 감수 콘텐츠 (웰니스 · 소비자 노출은 규제 게이트 후) ──
// testCode 단위 쉬운말 해석. status APPROVED 만 소비자 노출 대상(현재는 저작/감수 인프라만).
model CheckupExplainerContent {
  id              String    @id @default(uuid()) @db.Uuid
  testCode        String    @unique @map("test_code") @db.VarChar(30) // CheckupTestMaster.code
  testName        String    @map("test_name") @db.VarChar(200)
  plainWhat       String?   @map("plain_what") @db.Text // 이 검사는 무엇을 보나요(한 문장)
  plainMeaning    String?   @map("plain_meaning") @db.Text // 일반적 의미(정보제공·단정 금지)
  lifestyleInfo   String?   @map("lifestyle_info") @db.Text // 참고 생활정보(맞춤 처방 아님)
  whenToSeeDoctor String?   @map("when_to_see_doctor") @db.Text // 이럴 땐 진료를 권해요
  sourceRef       String?   @map("source_ref") @db.VarChar(300) // 근거(가이드라인·기관)
  status          String    @default("DRAFT") @db.VarChar(20) // DRAFT | IN_REVIEW | APPROVED | REJECTED
  version         Int       @default(1)
  contentHash     String?   @map("content_hash") @db.VarChar(64) // 감수 시점 본문 해시 — 변경 감지(4-eyes 집계·재감수)
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedByName  String?   @map("reviewed_by_name") @db.VarChar(100)
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote      String?   @map("review_note") @db.Text
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@map("checkup_explainer_contents")
}

// 검진해석 콘텐츠 감수 로그 (append-only) — 4-eyes(2인 승인) 집계·감사
model CheckupExplainerReview {
  id             String   @id @default(uuid()) @db.Uuid
  contentId      String   @map("content_id") @db.Uuid
  testCode       String   @map("test_code") @db.VarChar(30)
  decision       String   @db.VarChar(20) // APPROVED | REJECTED
  contentHash    String?  @map("content_hash") @db.VarChar(64) // 승인 대상 본문 해시
  note           String?  @db.Text
  reviewedBy     String   @map("reviewed_by") @db.Uuid
  reviewedByName String   @map("reviewed_by_name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([contentId, createdAt])
  @@map("checkup_explainer_reviews")
}

// ── 검진 프로토콜(정의·관리): 판정룰·판독라우팅·검토/서명 단계 ──

model CheckupProtocol {
  id                        String    @id @default(uuid()) @db.Uuid
  code                      String    @db.VarChar(40)
  name                      String    @db.VarChar(160)
  programId                 String?   @map("program_id") @db.Uuid // 특정 프로그램 바인딩(없으면 공통)
  gender                    String    @default("ALL") @db.VarChar(10)
  ageMin                    Int?      @map("age_min")
  ageMax                    Int?      @map("age_max")
  version                   Int       @default(1)
  status                    String    @default("DRAFT") @db.VarChar(12) // DRAFT|ACTIVE|RETIRED
  requireAllInterpretations Boolean   @default(true) @map("require_all_interpretations")
  requireFourEyes           Boolean   @default(false) @map("require_four_eyes")
  signerRoles               String[]  @default(["DOCTOR"]) @map("signer_roles")
  panelTestCodes            String[]  @default([]) @map("panel_test_codes")
  publishedAt               DateTime? @map("published_at") @db.Timestamptz()
  publishedBy               String?   @map("published_by") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  rules CheckupJudgmentRule[]

  @@index([programId, status])
  @@map("ck_protocols")
}

model CheckupJudgmentRule {
  id                     String  @id @default(uuid()) @db.Uuid
  protocolId             String  @map("protocol_id") @db.Uuid
  testCode               String  @map("test_code") @db.VarChar(30) // CheckupTestMaster.code
  sex                    String  @default("ALL") @db.VarChar(10)
  ageMin                 Int?    @map("age_min")
  ageMax                 Int?    @map("age_max")
  normalLow              Float?  @map("normal_low")
  normalHigh             Float?  @map("normal_high")
  gradeBands             Json?   @map("grade_bands") @db.JsonB // [{op,value|min|max,grade}]
  panicLow               Float?  @map("panic_low")
  panicHigh              Float?  @map("panic_high")
  interpretDept          String? @map("interpret_dept") @db.VarChar(50)
  requiredInterpretation Boolean @default(false) @map("required_interpretation")

  protocol CheckupProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([protocolId, testCode, sex])
  @@map("ck_judgment_rules")
}

// ── 외래 의뢰 ──

model CheckupReferral {
  id            String   @id @default(uuid()) @db.Uuid
  visitId       String   @map("visit_id") @db.Uuid
  resultItemId  String?  @map("result_item_id") @db.Uuid
  toDepartment  String   @map("to_department") @db.VarChar(50)
  reason        String   @db.Text
  urgency       String   @default("ROUTINE") @db.VarChar(20) // ROUTINE, URGENT
  appointmentId String?  @map("appointment_id") @db.Uuid
  referralId    String?  @map("referral_id") @db.Uuid
  status        String   @default("CREATED") @db.VarChar(20) // CREATED, APPOINTMENT_MADE, VISITED, CLOSED
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  visit CheckupVisit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("ck_referrals")
}

// ── 추적 관리 ──

model CheckupFollowUp {
  id            String    @id @default(uuid()) @db.Uuid
  visitId       String    @map("visit_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  followUpType  String    @map("follow_up_type") @db.VarChar(30) // RECHECK, OUTPATIENT, SCREENING
  description   String    @db.VarChar(500)
  dueDate       DateTime  @map("due_date") @db.Date
  reminderSent  Boolean   @default(false) @map("reminder_sent")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()
  linkedVisitId String?   @map("linked_visit_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  visit   CheckupVisit @relation(fields: [visitId], references: [id])
  patient Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId, dueDate])
  @@map("ck_follow_ups")
}

// ── 단체 검진 계약 ──

model CheckupContract {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @map("company_name") @db.VarChar(200)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  contactPhone  String?  @map("contact_phone") @db.VarChar(20)
  programId     String   @map("program_id") @db.Uuid
  headcount     Int
  discountRate  Int      @map("discount_rate")
  contractDate  DateTime @map("contract_date") @db.Date
  expiryDate    DateTime @map("expiry_date") @db.Date
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, EXPIRED, CANCELLED
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  program CheckupProgram @relation(fields: [programId], references: [id])
  visits  CheckupVisit[] @relation("ContractVisits")

  @@map("ck_contracts")
}

// ══════════════════════════════════════════
// 대학병원 Phase A1: 임상경로 (Clinical Pathway)
// ══════════════════════════════════════════

model ClinicalPathway {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(30)
  name          String    @db.VarChar(200)
  department    String    @db.VarChar(50)
  targetDrg     String?   @map("target_drg") @db.VarChar(20)
  version       Int       @default(1)
  status        String    @default("DRAFT") @db.VarChar(20)
  totalDays     Int       @map("total_days")
  description   String?   @db.Text
  createdBy     String    @map("created_by") @db.Uuid
  /// 🔴 2026-08-27: 발행자·발행시각이 **없었다** — 급성심근경색 표준경로가 전 병원에 발효됐는데
  ///    누가 눌렀는지도 남지 않았다. `ProtocolTemplate` 과 **같은 이름**을 쓴다(다르게 지으면 갈라진다).
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  publishedBy   String?   @map("published_by") @db.Uuid
  /// 이 표준이 어느 의결로 발효됐는가(`CommitteeDecision.decisionNo`). null = 의결 근거 없음
  governanceRef String?   @map("governance_ref") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  milestones  PathwayMilestone[]
  assignments PathwayAssignment[]

  @@index([department, status])
  @@map("clinical_pathways")
}

model PathwayMilestone {
  id         String  @id @default(uuid()) @db.Uuid
  pathwayId  String  @map("pathway_id") @db.Uuid
  day        Int
  category   String  @db.VarChar(30)
  title      String  @db.VarChar(200)
  detail     Json?   @db.JsonB
  isRequired Boolean @default(true) @map("is_required")
  sortOrder  Int     @default(0) @map("sort_order")

  pathway  ClinicalPathway    @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  outcomes MilestoneOutcome[]

  @@index([pathwayId, day])
  @@map("pathway_milestones")
}

model PathwayAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  pathwayId   String    @map("pathway_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  encounterId String    @map("encounter_id") @db.Uuid
  startDate   DateTime  @map("start_date") @db.Date
  status      String    @default("ACTIVE") @db.VarChar(20)
  deviations  Int       @default(0)
  actualDays  Int?      @map("actual_days")
  note        String?   @db.Text
  assignedBy  String    @map("assigned_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  pathway  ClinicalPathway    @relation(fields: [pathwayId], references: [id])
  patient  Patient            @relation(fields: [patientId], references: [id])
  outcomes MilestoneOutcome[]

  @@index([patientId])
  @@index([status])
  @@map("pathway_assignments")
}

model MilestoneOutcome {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  milestoneId  String   @map("milestone_id") @db.Uuid
  actualDay    Int      @map("actual_day")
  status       String   @db.VarChar(20)
  variance     String?  @db.Text
  performedBy  String?  @map("performed_by") @db.Uuid
  performedAt  DateTime @default(now()) @map("performed_at") @db.Timestamptz()

  assignment PathwayAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  milestone  PathwayMilestone  @relation(fields: [milestoneId], references: [id])

  @@unique([assignmentId, milestoneId])
  @@index([assignmentId])
  @@map("milestone_outcomes")
}

// ══════════════════════════════════════════
// 대학병원 Phase A2: 다학제 진료 (MDT Conference)
// ══════════════════════════════════════════

model MdtConference {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String    @db.VarChar(200)
  conferenceType     String    @map("conference_type") @db.VarChar(30)
  department         String    @db.VarChar(50)
  scheduledAt        DateTime  @map("scheduled_at") @db.Timestamptz()
  location           String?   @db.VarChar(100)
  status             String    @default("SCHEDULED") @db.VarChar(20)
  chairpersonId      String    @map("chairperson_id") @db.Uuid
  notes              String?   @db.Text
  recordingUrl       String?   @map("recording_url") @db.Text
  minutes            String?   @db.Text // 자동생성 회의록
  minutesGeneratedAt DateTime? @map("minutes_generated_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  cases     MdtCase[]
  attendees MdtAttendee[]

  @@index([department, scheduledAt])
  @@map("mdt_conferences")
}

model MdtCase {
  id               String  @id @default(uuid()) @db.Uuid
  conferenceId     String  @map("conference_id") @db.Uuid
  patientId        String  @map("patient_id") @db.Uuid
  presenterId      String  @map("presenter_id") @db.Uuid
  primaryDiag      String  @map("primary_diag") @db.VarChar(200)
  tnmStage         String? @map("tnm_stage") @db.VarChar(30)
  clinicalSummary  String? @map("clinical_summary") @db.Text
  imagingSummary   String? @map("imaging_summary") @db.Text
  pathologySummary String? @map("pathology_summary") @db.Text
  labSummary       String? @map("lab_summary") @db.Text
  proposedPlan     String? @map("proposed_plan") @db.Text
  decision         String? @db.Text
  decisionCategory String? @map("decision_category") @db.VarChar(30)
  followUp         String? @map("follow_up") @db.Text
  sortOrder        Int     @default(0) @map("sort_order")

  conference MdtConference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  patient    Patient       @relation(fields: [patientId], references: [id])

  @@index([conferenceId])
  @@index([patientId])
  @@map("mdt_cases")
}

model MdtAttendee {
  id           String  @id @default(uuid()) @db.Uuid
  conferenceId String  @map("conference_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  department   String  @db.VarChar(50)
  role         String  @db.VarChar(20)
  attended     Boolean @default(false)

  conference MdtConference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@map("mdt_attendees")
}

// ══════════════════════════════════════════
// 대학병원 Phase A3: 암 등록 (Cancer Registry)
// ══════════════════════════════════════════

model CancerRegistry {
  id                 String    @id @default(uuid()) @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  registrationNo     String    @unique @map("registration_no") @db.VarChar(20)
  diagnosisDate      DateTime  @map("diagnosis_date") @db.Date
  primarySite        String    @map("primary_site") @db.VarChar(10)
  morphology         String    @db.VarChar(10)
  behavior           String    @db.VarChar(5)
  grade              String?   @db.VarChar(5)
  laterality         String?   @db.VarChar(10)
  diagnosisBasis     String    @map("diagnosis_basis") @db.VarChar(20)
  icdCode            String    @map("icd_code") @db.VarChar(10)
  tnmClinical        String?   @map("tnm_clinical") @db.VarChar(20)
  tnmPathological    String?   @map("tnm_pathological") @db.VarChar(20)
  ajccStage          String?   @map("ajcc_stage") @db.VarChar(10)
  ajccEdition        Int?      @map("ajcc_edition")
  firstTreatment     String?   @map("first_treatment") @db.VarChar(30)
  firstTreatmentDate DateTime? @map("first_treatment_date") @db.Date
  recurrenceDate     DateTime? @map("recurrence_date") @db.Date
  recurrenceSite     String?   @map("recurrence_site") @db.VarChar(100)
  vitalStatus        String    @default("ALIVE") @map("vital_status") @db.VarChar(20)
  lastContactDate    DateTime? @map("last_contact_date") @db.Date
  deathDate          DateTime? @map("death_date") @db.Date
  causeOfDeath       String?   @map("cause_of_death") @db.VarChar(10)
  registrarId        String    @map("registrar_id") @db.Uuid
  status             String    @default("REGISTERED") @db.VarChar(20)
  reportedToKccr     Boolean   @default(false) @map("reported_to_kccr")
  // 🔴 전송 근거 컬럼이 없어 화면이 구조적으로 "전송됨"을 표현할 수 없었다(W7 이연).
  //    연동 전에는 **null 로 둔다** — 나가지 않은 전송에 시각을 박지 않는다(external-reporting 규약).
  kccrTransmittedAt  DateTime? @map("kccr_transmitted_at") @db.Timestamptz()
  kccrSubmissionId   String?   @map("kccr_submission_id") @db.VarChar(60) // 미전송 로컬 접수번호는 `LOCAL-` 접두
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz() // 확인 일시
  verifiedBy         String?   @map("verified_by") @db.Uuid // 확인자
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient    Patient           @relation(fields: [patientId], references: [id])
  treatments CancerTreatment[]
  followUps  CancerFollowUp[]

  @@index([patientId])
  @@index([primarySite])
  @@index([status])
  @@map("cancer_registries")
}

model CancerTreatment {
  id            String    @id @default(uuid()) @db.Uuid
  registryId    String    @map("registry_id") @db.Uuid
  treatmentType String    @map("treatment_type") @db.VarChar(30)
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  regimen       String?   @db.VarChar(200)
  cycles        Int?
  response      String?   @db.VarChar(20)
  surgeryType   String?   @map("surgery_type") @db.VarChar(100)
  radiationDose String?   @map("radiation_dose") @db.VarChar(50)
  note          String?   @db.Text

  registry CancerRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  @@index([registryId])
  @@map("cancer_treatments")
}

model CancerFollowUp {
  id                String   @id @default(uuid()) @db.Uuid
  registryId        String   @map("registry_id") @db.Uuid
  followUpDate      DateTime @map("follow_up_date") @db.Date
  status            String   @db.VarChar(20)
  recurrence        Boolean  @default(false)
  metastasisSite    String?  @map("metastasis_site") @db.VarChar(100)
  performanceStatus String?  @map("performance_status") @db.VarChar(10)
  note              String?  @db.Text
  recordedBy        String   @map("recorded_by") @db.Uuid

  registry CancerRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  @@index([registryId])
  @@map("cancer_follow_ups")
}

// ══════════════════════════════════════════
// 대학병원 Phase A4: 임상 연구 (Clinical Research / IRB)
// ══════════════════════════════════════════

model ResearchStudy {
  id              String    @id @default(uuid()) @db.Uuid
  studyNo         String    @unique @map("study_no") @db.VarChar(30)
  title           String    @db.Text
  piUserId        String    @map("pi_user_id") @db.Uuid
  department      String    @db.VarChar(50)
  studyType       String    @map("study_type") @db.VarChar(30)
  phase           String?   @db.VarChar(10)
  sponsor         String?   @db.VarChar(200)
  irbStatus       String    @default("SUBMITTED") @map("irb_status") @db.VarChar(20)
  irbApprovalDate DateTime? @map("irb_approval_date") @db.Date
  irbExpiryDate   DateTime? @map("irb_expiry_date") @db.Date
  targetEnroll    Int?      @map("target_enroll")
  currentEnroll   Int       @default(0) @map("current_enroll")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  description     String?   @db.Text
  protocol        Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  subjects   ResearchSubject[]
  documents  ResearchDocument[]
  amendments IrbAmendment[]

  @@index([department, irbStatus])
  @@map("research_studies")
}

model ResearchSubject {
  id             String    @id @default(uuid()) @db.Uuid
  studyId        String    @map("study_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  subjectNo      String    @map("subject_no") @db.VarChar(20)
  consentDate    DateTime  @map("consent_date") @db.Date
  status         String    @default("ENROLLED") @db.VarChar(20)
  withdrawDate   DateTime? @map("withdraw_date") @db.Date
  withdrawReason String?   @map("withdraw_reason") @db.Text
  armGroup       String?   @map("arm_group") @db.VarChar(50)
  enrolledBy     String    @map("enrolled_by") @db.Uuid

  study   ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id])

  @@unique([studyId, patientId])
  @@index([studyId, status])
  @@map("research_subjects")
}

model ResearchDocument {
  id         String   @id @default(uuid()) @db.Uuid
  studyId    String   @map("study_id") @db.Uuid
  docType    String   @map("doc_type") @db.VarChar(30)
  version    String   @db.VarChar(10)
  fileName   String   @map("file_name") @db.VarChar(200)
  fileUrl    String   @map("file_url") @db.Text
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@map("research_documents")
}

model IrbAmendment {
  id          String    @id @default(uuid()) @db.Uuid
  studyId     String    @map("study_id") @db.Uuid
  amendmentNo Int       @map("amendment_no")
  reason      String    @db.Text
  changes     Json      @db.JsonB
  status      String    @default("SUBMITTED") @db.VarChar(20)
  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz()
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote  String?   @map("review_note") @db.Text

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@map("irb_amendments")
}

// ══════════════════════════════════════════
// 대학병원 Phase A5: 원가 분석 (Activity-Based Costing)
// ══════════════════════════════════════════

model CostCenter {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(20)
  name       String  @db.VarChar(100)
  type       String  @db.VarChar(20)
  parentId   String? @map("parent_id") @db.Uuid
  department String  @db.VarChar(50)
  isActive   Boolean @default(true) @map("is_active")

  allocations CostAllocation[]

  @@map("cost_centers")
}

model CostDriver {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  category String  @db.VarChar(20)
  unit     String  @db.VarChar(20)
  unitCost Decimal @map("unit_cost") @db.Decimal(12, 2)
  period   String  @db.VarChar(10)
  note     String? @db.Text

  @@index([category, period])
  @@map("cost_drivers")
}

model CostAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  costCenterId String   @map("cost_center_id") @db.Uuid
  costDriverId String?  @map("cost_driver_id") @db.Uuid
  period       String   @db.VarChar(10)
  amount       Decimal  @db.Decimal(14, 2)
  quantity     Decimal? @db.Decimal(10, 2)
  allocatedAt  DateTime @default(now()) @map("allocated_at") @db.Timestamptz()
  source       String   @db.VarChar(20)

  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@index([costCenterId, period])
  @@map("cost_allocations")
}

model ProcedureCost {
  id            String  @id @default(uuid()) @db.Uuid
  procedureCode String  @map("procedure_code") @db.VarChar(20)
  procedureName String  @map("procedure_name") @db.VarChar(200)
  period        String  @db.VarChar(10)
  directCost    Decimal @map("direct_cost") @db.Decimal(12, 2)
  indirectCost  Decimal @map("indirect_cost") @db.Decimal(12, 2)
  totalCost     Decimal @map("total_cost") @db.Decimal(12, 2)
  revenueAvg    Decimal @map("revenue_avg") @db.Decimal(12, 2)
  margin        Decimal @db.Decimal(8, 4)
  volumeCount   Int     @map("volume_count")

  @@unique([procedureCode, period])
  @@map("procedure_costs")
}

// ══════════════════════════════════════════
// 간호 차트 고도화: Flow Sheet + Checklist
// ══════════════════════════════════════════

model FlowSheetEntry {
  id              String    @id @default(uuid()) @db.Uuid
  admissionId     String    @map("admission_id") @db.Uuid
  nurseId         String    @map("nurse_id") @db.Uuid
  recordedAt      DateTime  @map("recorded_at") @db.Timestamptz()
  // 바이탈
  systolicBp      Int?      @map("systolic_bp")
  diastolicBp     Int?      @map("diastolic_bp")
  heartRate       Int?      @map("heart_rate")
  temperature     Decimal?  @db.Decimal(4, 1)
  spo2            Int?
  respiratoryRate Int?      @map("respiratory_rate")
  // 의식/통증
  consciousness   String?   @db.VarChar(20) // ALERT, VERBAL, PAIN, UNRESPONSIVE
  painScore       Int?      @map("pain_score") // NRS 0-10
  painLocation    String?   @map("pain_location") @db.VarChar(100)
  // I/O
  intakeOral      Int?      @map("intake_oral")
  intakeIv        Int?      @map("intake_iv")
  intakeOther     Int?      @map("intake_other")
  outputUrine     Int?      @map("output_urine")
  outputDrain     Int?      @map("output_drain")
  outputOther     Int?      @map("output_other")
  // 기타
  pupilLeft       String?   @map("pupil_left") @db.VarChar(20)
  pupilRight      String?   @map("pupil_right") @db.VarChar(20)
  gcsScore        Int?      @map("gcs_score")
  sedationScore   Int?      @map("sedation_score") // RASS -5~+4
  notes           String?   @db.Text
  shiftType       ShiftType @map("shift_type")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  nurse     User      @relation("FlowSheetNurse", fields: [nurseId], references: [id])

  @@index([admissionId, recordedAt])
  @@map("flow_sheet_entries")
}

model NursingChecklist {
  id           String     @id @default(uuid()) @db.Uuid
  admissionId  String     @map("admission_id") @db.Uuid
  nurseId      String     @map("nurse_id") @db.Uuid
  templateType String     @map("template_type") @db.VarChar(30) // SHIFT_HANDOFF, SAFETY_IPSG, PRE_OP, POST_OP, FALL_PREVENTION, PRESSURE_ULCER
  shiftType    ShiftType? @map("shift_type")
  items        Json       @db.JsonB // [{item: string, checked: boolean, checkedAt?: string, note?: string}]
  totalItems   Int        @map("total_items")
