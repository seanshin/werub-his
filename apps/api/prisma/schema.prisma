// ============================================================
// 처방/오더 고도화: Pre-Order, 의료진 코드 목록, 과별 카탈로그
// ============================================================

model PreOrder {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  doctorId         String    @map("doctor_id") @db.Uuid
  type             String    @db.VarChar(20) // MEDICATION, LAB, IMAGING
  medicationCodeId String?   @map("medication_code_id") @db.Uuid
  procedureCodeId  String?   @map("procedure_code_id") @db.Uuid
  dosage           String?   @db.VarChar(100)
  frequency        String?   @db.VarChar(100)
  duration         Int?
  quantity         Int?
  route            String?   @db.VarChar(50)
  priority         String    @default("ROUTINE") @db.VarChar(20)
  instructions     String?   @db.Text
  reason           String?   @db.Text
  scheduledDate    DateTime? @map("scheduled_date") @db.Date
  durSnapshot      Json?     @map("dur_snapshot") @db.JsonB // 작성 시점 DUR 경고 스냅샷 — 승인 시 재검증과 대비
  source           String    @default("MANUAL") @db.VarChar(20) // MANUAL | LIS_REFLEX (외부 발신 오더 표식)
  externalRef      String?   @unique @map("external_ref") @db.VarChar(120) // 외부 시스템 식별자(LIS identifier) — 재발신 멱등키
  appointmentId    String?   @map("appointment_id") @db.Uuid // 연계 예약("이 재진에서 시행") — P2 ON_CHECKIN 자동활성의 기반
  activationMode   String    @default("ON_APPROVAL") @map("activation_mode") @db.VarChar(15) // ON_APPROVAL(의사 승인) | ON_CHECKIN(접수 시 자동 — 비약물 한정·config 게이트)
  recurringGroupId String?   @map("recurring_group_id") @db.Uuid // 반복 사전처방 그룹(매 N일 ×M회) — 그룹 일괄 취소용
  scheduledTime    String?   @map("scheduled_time") @db.VarChar(5)
  status           String    @default("PENDING") @db.VarChar(20)
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz()
  encounterId      String?   @map("encounter_id") @db.Uuid
  prescriptionId   String?   @map("prescription_id") @db.Uuid
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient        Patient            @relation(fields: [patientId], references: [id])
  doctor         User               @relation("PreOrderDoctor", fields: [doctorId], references: [id])
  medicationCode MedicationCode?    @relation(fields: [medicationCodeId], references: [id])
  procedureCode  ProcedureCode?     @relation(fields: [procedureCodeId], references: [id])
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  revisions      PreOrderRevision[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([scheduledDate])
  @@index([appointmentId])
  @@map("pre_orders")
}

/// 사전처방 수정 이력 — modify 시 수정 전 값 스냅샷 (감사·삭감 추적)
model PreOrderRevision {
  id         String   @id @default(uuid()) @db.Uuid
  preOrderId String   @map("pre_order_id") @db.Uuid
  snapshot   Json     @db.JsonB // 수정 전 필드 값
  changedBy  String?  @map("changed_by") @db.Uuid
  reason     String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  preOrder PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade)

  @@index([preOrderId])
  @@map("pre_order_revisions")
}

model DoctorCodeList {
