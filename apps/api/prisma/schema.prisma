  dicomStudies                  DicomStudy[]
  fallRiskAssessments           FallRiskAssessment[]
  infectionSurveillances        InfectionSurveillance[]
  consentForms                  ConsentForm[]
  conciergeSessions             ConciergeSession[]
  problemLists                  ProblemList[]
  allergiesRel                  Allergy[]                      @relation("PatientAllergies")
  allergyAssessments            AllergyAssessment[]            @relation("PatientAllergyAssessments")
  isolationPrecautions          IsolationPrecaution[]          @relation("PatientIsolations")
  psychAdmissions               PsychiatricAdmission[]         @relation("PatientPsychAdmissions")
  compoundingOrders             CompoundingOrder[]             @relation("PatientCompoundings")
  medAdmins                     MedicationAdministration[]
  waitingQueues                 WaitingQueue[]
  medicalRecordCopies           MedicalRecordCopy[]
  btgAccesses                   BreakTheGlassAccess[]
  vipStatus                     VipPatient?
  flags                         PatientFlag[]
  relations                     PatientRelation[]              @relation("PatientRelations")
  relatedBy                     PatientRelation[]              @relation("RelatedPatients")
  questionnaireTokens           QuestionnaireToken[]
  portalSessions                PortalSession[]
  documentRequests              DocumentRequest[]
  account                       PatientAccount?
  familyMembers                 PatientFamily[]                @relation("PatientFamilyMembers")
  familyHistories               FamilyHistory[]                @relation("PatientFamilyHistory")
  linkedByFamily                PatientFamily[]                @relation("LinkedFamilyPatient")
  patientAddresses              PatientAddress[]
  icuAdmissions                 IcuAdmission[]
  diagnosticTests               DiagnosticTest[]
  preOrders                     PreOrder[]
  handoffs                      ClinicalHandoff[]
  journeyEvents                 PatientJourneyEvent[]
  rehabAssessments              RehabAssessment[]
  rehabPlans                    RehabPlan[]
  radiationPlans                RadiationPlan[]
  dialysisOrders                DialysisOrder[]
  dentalCharts                  DentalChart[]
  dentalTreatmentPlans          DentalTreatmentPlan[]
  eyeExams                      EyeExam[]
  eyeSurgeries                  EyeSurgery[]
  skinLesions                   SkinLesion[]
  entExams                      EntExam[]
