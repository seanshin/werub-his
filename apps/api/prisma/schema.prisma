  // 전체 순차 스캔 후 7,978행을 버리고 1행을 썼다(2026-10-01 느린 쿼리·스캔 통계 실측 · 접수 건수에 비례해 커진다)
  @@index([patientId, checkedInAt])
  @@map("waiting_queue")
}

// HIRA 의약품 표준코드 마스터(약가) — 보험 제품코드 매칭 참조(급여 품목)
model DrugStandardCode {
  id             String   @id @default(uuid()) @db.Uuid
  insuranceCode  String   @unique @map("insurance_code") @db.VarChar(16) // 제품코드(개정후) 보험 제품코드 9자리
  productName    String   @map("product_name") @db.VarChar(300) // 한글상품명
  manufacturer   String?  @db.VarChar(200) // 업체명
  spec           String?  @db.VarChar(100) // 약품규격
  standardCode   String?  @map("standard_code") @db.VarChar(20) // 표준코드(13자리 바코드)
  ingredientCode String?  @map("ingredient_code") @db.VarChar(20) // 일반명(성분명)코드
  atcCode        String?  @map("atc_code") @db.VarChar(20) // 국제표준 ATC
  dosageForm     String?  @map("dosage_form") @db.VarChar(40)
  rxOtc          String?  @map("rx_otc") @db.VarChar(20) // 전문/일반
  baseCode       String?  @map("base_code") @db.VarChar(20) // 품목기준코드
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([ingredientCode])
  @@index([atcCode])
  @@index([productName])
  // 🔴 (2026-10-01 SQL 튜닝) 이름 검색 트라이그램 GIN — 종전엔 수동 SQL 로만 만들어 `db push` 가 스키마 밖이라며 지웠다
  //    (서버 이전 뒤 운영에 10종 중 0종). 스키마에 두어야 배포가 지우지 않는다.
  @@index([productName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_drug_std_product_trgm")
  @@map("drug_standard_codes")
}

// 수진자 자격조회 결과 (건강보험공단 연계 — 시뮬레이션/실연동)
