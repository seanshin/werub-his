// ── 산과 분만 보강(P1~P3) — plain patientId(Patient 비수정) ──

// 분만 기록
model DeliveryRecord {
  id               String                @id @default(uuid()) @db.Uuid
  patientId        String                @map("patient_id") @db.Uuid
  encounterId      String?               @map("encounter_id") @db.Uuid
  status           String                @default("IN_LABOR") @db.VarChar(20) // IN_LABOR/DELIVERED/POSTPARTUM/CLOSED
  deliveryType     String?               @map("delivery_type") @db.VarChar(20) // VAGINAL/VACUUM/FORCEPS/CESAREAN
  gestationalWeeks String?               @map("gestational_weeks") @db.VarChar(10) // 예: 39+2
  laborOnsetAt     DateTime?             @map("labor_onset_at") @db.Timestamptz()
  deliveredAt      DateTime?             @map("delivered_at") @db.Timestamptz()
  stage1Minutes    Int?                  @map("stage1_minutes") // 1기(개대)
  stage2Minutes    Int?                  @map("stage2_minutes") // 2기(만출)
  stage3Minutes    Int?                  @map("stage3_minutes") // 3기(태반)
  anesthesia       String?               @db.VarChar(30) // NONE/EPIDURAL/SPINAL/GENERAL
  bloodLossMl      Int?                  @map("blood_loss_ml")
  indication       String?               @db.VarChar(200) // 개입 적응증
  complications    String?               @db.Text
  deliveredBy      String?               @map("delivered_by") @db.Uuid
  // 산욕(Postpartum)
  lochia           String?               @db.VarChar(100)
  fundusStatus     String?               @map("fundus_status") @db.VarChar(100)
  woundStatus      String?               @map("wound_status") @db.VarChar(100)
  breastfeeding    String?               @db.VarChar(50)
  notes            String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz()
  newborns         NewbornRecord[]
  laborProgress    LaborProgressRecord[]

  @@index([status])
  @@index([patientId])
  @@map("delivery_records")
}

// 신생아 기록(분만 연계)
model NewbornRecord {
  id            String         @id @default(uuid()) @db.Uuid
  deliveryId    String         @map("delivery_id") @db.Uuid
  patientId     String?        @map("patient_id") @db.Uuid // 신생아 환자등록 시(선택)
  birthOrder    Int            @default(1) @map("birth_order") // 출생 순번(다태아 식별 — 1=단태/첫째)
  idBandNo      String?        @unique @map("id_band_no") @db.VarChar(40) // 신생아 식별밴드 번호(모아 동시확인). @unique=밴드 중복 부여 차단(NULL 다수는 Postgres distinct라 무해)
  motherBandNo  String?        @map("mother_band_no") @db.VarChar(40) // 산모 식별밴드(모아 페어링·바코드 대조·P2-B)
  birthAt       DateTime       @map("birth_at") @db.Timestamptz()
  sex           String         @db.VarChar(10) // M/F/AMBIGUOUS
  weightG       Int?           @map("weight_g")
  lengthCm      Decimal?       @map("length_cm") @db.Decimal(4, 1)
  headCircCm    Decimal?       @map("head_circ_cm") @db.Decimal(4, 1)
  apgar1        Int?           @map("apgar_1") // 0~10
  apgar5        Int?           @map("apgar_5")
  apgar10       Int?           @map("apgar_10")
  resuscitation String?        @db.VarChar(100) // 소생술 내용
  nicuAdmission Boolean        @default(false) @map("nicu_admission")
  feedingType   String?        @map("feeding_type") @db.VarChar(30)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  delivery      DeliveryRecord @relation(fields: [deliveryId], references: [id])

  @@unique([deliveryId, birthOrder]) // 다태아 순번 중복(모아 오식별) DB 차단
  @@index([deliveryId])
  @@map("newborn_records")
}

// 분만 진행 기록(파토그램 시계열)
model LaborProgressRecord {
  id               String         @id @default(uuid()) @db.Uuid
  deliveryId       String         @map("delivery_id") @db.Uuid
  recordedAt       DateTime       @default(now()) @map("recorded_at") @db.Timestamptz()
  cervicalDilation Int?           @map("cervical_dilation") // cm 0~10
  station          Int? // 하강도 -5~+5
  contractionFreq  Int?           @map("contraction_freq") // 10분당 횟수
  contractionDur   Int?           @map("contraction_dur") // 지속 초
  fetalHeartRate   Int?           @map("fetal_heart_rate")
  note             String?        @db.VarChar(200)
  recordedBy       String?        @map("recorded_by") @db.Uuid
  delivery         DeliveryRecord @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, recordedAt])
  @@map("labor_progress_records")
}

// ── 소아청소년과 (Pediatrics) ──

model PediatricGrowth {
