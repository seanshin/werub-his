  status           String    @default("SCHEDULED") @db.VarChar(20)
  notes            String?   @db.Text
  safetyChecks     Json?     @map("safety_checks") @db.JsonB // 시행 전 안전게이트 평가(낙상위험·hold parameter — override 감사 포함)
  // 청구코드 매핑(세션 완료 시 therapyType→EDI 수가)
  billingCode      String?   @map("billing_code") @db.VarChar(20)
  billingCodeName  String?   @map("billing_code_name") @db.VarChar(200)
  billingUnitPrice Int?      @map("billing_unit_price")

  plan      RehabPlan @relation(fields: [planId], references: [id])
  therapist User      @relation("RehabTherapist", fields: [therapistId], references: [id])

  @@map("rehab_sessions")
}

// ── 방사선종양학 ──

model RadiationPlan {
