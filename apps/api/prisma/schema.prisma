// ============================================================
// 블록체인 전자인증서 시스템
// ============================================================

model BlockchainCertificate {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerType            String    @map("owner_type") @db.VarChar(10) // STAFF, PATIENT
  userId               String?   @map("user_id") @db.Uuid
  patientId            String?   @map("patient_id") @db.Uuid
  serialNumber         String    @unique @map("serial_number") @db.VarChar(64)
  subjectDn            String    @map("subject_dn") @db.VarChar(500)
  publicKey            String    @map("public_key") @db.Text
  algorithm            String    @db.VarChar(30)
  issuedAt             DateTime  @map("issued_at") @db.Timestamptz()
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz()
  status               String    @default("PENDING") @db.VarChar(20) // PENDING, ACTIVE, SUSPENDED, REVOKED, EXPIRED
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz()
  revokeReason         String?   @map("revoke_reason") @db.VarChar(200)
  licenseNumber        String?   @map("license_number") @db.VarChar(50)
  licenseType          String?   @map("license_type") @db.VarChar(30)
  department           String?   @db.VarChar(100)
  specialty            String?   @db.VarChar(100)
  patientMrn           String?   @map("patient_mrn") @db.VarChar(50)
  identityVerified     Boolean?  @map("identity_verified")
  certHash             String    @map("cert_hash") @db.VarChar(64)
  blockchainTxId       String?   @map("blockchain_tx_id") @db.VarChar(128)
  blockchainAnchoredAt DateTime? @map("blockchain_anchored_at") @db.Timestamptz()
  previousCertId       String?   @map("previous_cert_id") @db.Uuid
  fingerprint          String    @db.VarChar(64)
  // HSM 기획 Phase 4 — 키 수탁 출처·attestation(부인방지 증거). 기본 SOFTWARE(정직한 현행).
  keyCustody           String    @default("SOFTWARE") @map("key_custody") @db.VarChar(20) // SOFTWARE|CLIENT_SE|HSM|EXTERNAL_SIGN
  attestationRef       String?   @map("attestation_ref") @db.VarChar(500)
  pinFailCount         Int       @default(0) @map("pin_fail_count")
  pinLockedUntil       DateTime? @map("pin_locked_until") @db.Timestamptz()
  lastBackupAt         DateTime? @map("last_backup_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user         User?                   @relation("UserBlockchainCerts", fields: [userId], references: [id])
  patient      Patient?                @relation("PatientBlockchainCerts", fields: [patientId], references: [id])
  previousCert BlockchainCertificate?  @relation("CertRenewalChain", fields: [previousCertId], references: [id])
  renewedBy    BlockchainCertificate[] @relation("CertRenewalChain")
  signatures   DocumentSignature[]

  @@index([ownerType, userId])
  @@index([ownerType, patientId])
  @@index([serialNumber])
  @@index([fingerprint])
  @@index([status])
  @@map("blockchain_certificates")
}

model SignedDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  documentType         String    @map("document_type") @db.VarChar(50)
  documentId           String    @map("document_id") @db.Uuid
  patientId            String?   @map("patient_id") @db.Uuid
  documentHash         String    @map("document_hash") @db.VarChar(64)
  documentVersion      Int       @default(1) @map("document_version")
  status               String    @default("PENDING") @db.VarChar(20)
  requiredSigners      Int       @default(1) @map("required_signers")
  completedSigners     Int       @default(0) @map("completed_signers")
  timeoutAt            DateTime? @map("timeout_at") @db.Timestamptz()
  merkleRoot           String?   @map("merkle_root") @db.VarChar(64)
  blockchainTxId       String?   @map("blockchain_tx_id") @db.VarChar(128)
  blockchainAnchoredAt DateTime? @map("blockchain_anchored_at") @db.Timestamptz()
  envelopeUrl          String?   @map("envelope_url") @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient    Patient?            @relation("PatientSignedDocuments", fields: [patientId], references: [id])
  signatures DocumentSignature[]

  @@index([documentType, documentId])
  @@index([patientId])
  @@index([status])
  @@map("signed_documents")
}

model DocumentSignature {
  id                 String    @id @default(uuid()) @db.Uuid
  signedDocumentId   String    @map("signed_document_id") @db.Uuid
  certificateId      String    @map("certificate_id") @db.Uuid
  signatureValue     String    @map("signature_value") @db.Text
  signatureAlgorithm String    @map("signature_algorithm") @db.VarChar(30)
  signedAt           DateTime  @map("signed_at") @db.Timestamptz()
  signerRole         String    @map("signer_role") @db.VarChar(30)
  signerType         String    @map("signer_type") @db.VarChar(10)
  signerUserId       String?   @map("signer_user_id") @db.Uuid
  signerPatientId    String?   @map("signer_patient_id") @db.Uuid
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(500)
  isValid            Boolean   @default(true) @map("is_valid")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz()
  // HSM 기획 Phase 4 — 서명 키 수탁 출처·attestation
  keyCustody         String    @default("SOFTWARE") @map("key_custody") @db.VarChar(20) // SOFTWARE|CLIENT_SE|HSM|EXTERNAL_SIGN
  attestationRef     String?   @map("attestation_ref") @db.VarChar(500)

  signedDocument SignedDocument        @relation(fields: [signedDocumentId], references: [id])
  certificate    BlockchainCertificate @relation(fields: [certificateId], references: [id])
  signerUser     User?                 @relation("UserDocSignatures", fields: [signerUserId], references: [id])
  signerPatient  Patient?              @relation("PatientDocSignatures", fields: [signerPatientId], references: [id])

  @@index([signedDocumentId])
  @@index([signerUserId, signedAt])
  @@index([signerPatientId, signedAt])
  @@map("document_signatures")
}

// 봉투 암호화(envelope) DEK 레지스트리 — HSM 기획 Phase 3.
// KEK(마스터, SOFTWARE=ENCRYPTION_KEY 도출·HSM=하드웨어 내부)로 wrap된 DEK 보관.
// KEK 회전 시 DEK 재-wrap만으로 마스터 교체(전 PHI 재암호화 불필요).
// ⚠️ 현재는 키 관리 계층만 — field-encryption 소비(활성화)는 HSM 도입+백필 게이트 후.
model EncryptionKeyRegistry {
  id         String    @id @default(uuid()) @db.Uuid
  keyId      String    @unique @map("key_id") @db.VarChar(32) // DEK 식별자(향후 ciphertext 에 기록)
  wrappedDek String    @map("wrapped_dek") @db.Text // KEK로 wrap된 DEK (iv:tag:cipher hex)
  kekKind    String    @map("kek_kind") @db.VarChar(10) // SOFTWARE|HSM — KEK 수탁 출처
  status     String    @default("ACTIVE") @db.VarChar(10) // ACTIVE|RETIRED
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz()

  @@index([status])
  @@map("encryption_key_registry")
}

// 스마트폰 푸시 생체 승인 — Tier 2(생명직결 처방/데이터변경) 재인증.
// PC가 고위험 액션 시 승인요청 생성→스태프 폰 FCM 푸시(또는 폰 polling)→폰 생체승인→
//   step-up 토큰 발급(PC가 polling 수령→x-step-up-token 으로 재시도). 단말 제로트러스트 ② Tier2.
// 입원별 추가 지정의 — 주치의 외에 특수환자에 배치하는 책임 의사(공동주치/지정의).
// 담당 의료군(care group) 처방 권한 산정에 포함. 배치자(assignedBy)·사유 감사.
model AdmissionDesignatedDoctor {
  id          String   @id @default(uuid()) @db.Uuid
  admissionId String   @map("admission_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  reason      String?  @db.VarChar(200)
  assignedBy  String   @map("assigned_by") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([admissionId, doctorId])
  @@index([admissionId, active])
  @@map("admission_designated_doctors")
}

model StepUpApproval {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid // 승인 주체(지정 처방의) — 폰으로 승인하는 사람
  requesterId String?   @map("requester_id") @db.Uuid // 위임 요청자(입력자) — 토큰 1회 수령 권한. self-stepup이면 null
  action      String    @db.VarChar(50)
  resourceId  String?   @map("resource_id") @db.VarChar(100)
  summary     String?   @db.VarChar(120) // 위임 승인 시 "무엇을 승인하는지"(예: 약품·검사명) — approve-blind 방지
  bodyHash    String?   @map("body_hash") @db.VarChar(64)
  status      String    @default("PENDING") @db.VarChar(12) // PENDING|APPROVED|DENIED|EXPIRED|CONSUMED
  method      String?   @db.VarChar(8) // BIO|PIN — 승인 방식(감사·오버사이트)
  stepUpToken String?   @map("step_up_token") @db.Text // 승인 시 발급 — PC가 polling 으로 1회 수령
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz()
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("step_up_approvals")
}

model BlockchainAnchor {
