  preHr               Int?      @map("pre_hr")
  intradialyticVitals Json?     @map("intradialytic_vitals") @db.JsonB
  postWeight          Decimal?  @map("post_weight") @db.Decimal(5, 1)
  postTemp            Decimal?  @map("post_temp") @db.Decimal(4, 1)
