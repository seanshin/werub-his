model PackageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  action    String   @db.VarChar(40)
  by        String?  @db.Uuid
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  package SterilePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_events")
}

// ── ERP 연동 아웃박스 (전송보장·재시도, 전 도메인 공통) ──
model IntegrationOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  domain        String    @db.VarChar(30) // cssd/inventory/billing/...
  event         String    @db.VarChar(40) // stock.changed 등
  ref           String    @db.VarChar(200) // 멱등키(source_ref) — bline:enc:rx:rxId::wh:whId(123자)가 120 초과로 createMany 전체 실패하던 결함 해소
  payload       Json
  targetUrl     String    @map("target_url") @db.VarChar(400)
  status        String    @default("PENDING") @db.VarChar(10) // PENDING/SENT/FAILED
  attempts      Int       @default(0)
  maxAttempts   Int       @default(6) @map("max_attempts")
  lastError     String?   @map("last_error") @db.VarChar(300)
  secret        String?   @db.VarChar(200) // his_webhooks 팬아웃 행: 본문 HMAC 서명용(없으면 X-Integration-Key)
  format        String?   @db.VarChar(10) // 발신 포맷: RAW(기본 envelope) | SLACK(W.Channel 리치카드)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz()
  sentAt        DateTime? @map("sent_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([domain, ref]) // 멱등키 — 동일 (domain,ref) 이중 enqueue 차단(백필·재emit 동시성 방어)
  @@index([status, nextAttemptAt])
  @@index([domain])
  @@map("integration_outbox")
}

/// HIS 이벤트 웹훅 구독 등록 — 외부(ERP 등)가 받을 이벤트·URL·서명비밀 관리.
/// enqueue 시 활성 구독 중 event 매칭분으로 팬아웃(ref 에 ::wh:<id> 접미 → outbox UNIQUE 유지).
model HisWebhook {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(100)
  targetUrl      String    @map("target_url") @db.VarChar(400)
  events         String[]  @db.VarChar(50) // ['staff.attendance_recorded', ...] 또는 ['*']
  secret         String    @db.VarChar(200) // HMAC-SHA256 서명 비밀
  format         String    @default("RAW") @db.VarChar(10) // RAW(envelope) | SLACK(W.Channel 등 Slack호환 리치카드)
  isActive       Boolean   @default(true) @map("is_active")
  description    String?   @db.VarChar(300)
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz()
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([isActive])
  @@map("his_webhooks")
}

// ── ERP ↔ HIS 전자결재(W.Sign) 릴레이 매핑 ──
model EApprovalRelay {
  id                  String    @id @default(uuid()) @db.Uuid
  approvalId          String?   @unique @map("approval_id") @db.VarChar(80) // W.Sign docId
  docType             String    @map("doc_type") @db.VarChar(30) // HR_LEAVE 등
  title               String?   @db.VarChar(300)
  refModule           String    @map("ref_module") @db.VarChar(80) // hr.leave_requests
  refId               String    @map("ref_id") @db.VarChar(80)
  drafterClinicUserId String?   @map("drafter_clinic_user_id") @db.VarChar(80)
  callbackUrl         String    @map("callback_url") @db.VarChar(400)
  viewUrl             String?   @map("view_url") @db.VarChar(400)
  status              String    @default("PENDING") @db.VarChar(12) // PENDING/APPROVED/REJECTED/WITHDRAWN/ERROR
  result              String?   @db.VarChar(12)
  approvalLine        Json?     @map("approval_line")
  idempotencyKey      String?   @unique @map("idempotency_key") @db.VarChar(160)
  callbackDelivered   Boolean   @default(false) @map("callback_delivered")
  remindedAt          DateTime? @map("reminded_at") @db.Timestamptz() // 미결 리마인더 멱등(P1-5)
  decidedAt           DateTime? @map("decided_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([approvalId])
  @@index([refModule, refId])
  @@map("eapproval_relays")
}

// ── 사전승인(Pre-Authorization) 요청 — 고위험 오더 발행 전 결재 게이트 / 환자 포털 신청 ──
// EApprovalRelay(docType=PRE_AUTH)로 결재. 관계 미설정(refModule/refId 느슨 패턴) — 기존 모델 무변경 additive.
model PreAuthRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  category             String    @db.VarChar(10) // ORDER(의료진발) | PORTAL(환자 신청)
  type                 String    @db.VarChar(40) // NARCOTIC_RX | HIGH_COST_IMAGING | TRANSFUSION | CHEMO_REGIMEN | PORTAL_REFILL | PORTAL_TEST | PORTAL_REFERRAL | PORTAL_CONSULT
  status               String    @default("DRAFT") @db.VarChar(20) // DRAFT|PENDING|APPROVED|REJECTED|FULFILLED|CANCELLED|POST_FACTO_PENDING
  patientId            String    @map("patient_id") @db.Uuid
  encounterId          String?   @map("encounter_id") @db.Uuid
  requestedByUserId    String?   @map("requested_by_user_id") @db.Uuid // 직원 기안(갈래1)
  requestedByPatientId String?   @map("requested_by_patient_id") @db.Uuid // 환자 기안(갈래2)
  payload              Json // 오더 초안 / 신청 상세
  eApprovalRef         String?   @map("eapproval_ref") @db.VarChar(80) // EApprovalRelay.refId
  decision             String?   @db.VarChar(12)
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz()
  fulfilledRef         String?   @map("fulfilled_ref") @db.VarChar(80) // 발행된 prescription/order/appointment id
  fulfilledType        String?   @map("fulfilled_type") @db.VarChar(30)
  bypassReason         String?   @map("bypass_reason") @db.VarChar(300) // 응급/사후승인 사유
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([patientId])
  @@index([status, type])
  @@index([eApprovalRef])
  @@map("pre_auth_requests")
}

// ── CSSD 기구 품목 마스터 · 공급/재고 ──
model InstrumentItem {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(200)
  category    String?  @db.VarChar(40) // 절단/지혈/견인/봉합/세척/기타
  spec        String?  @db.VarChar(100)
  unit        String   @default("개") @db.VarChar(20)
  stock       Int      @default(0)
  safetyStock Int      @default(0) @map("safety_stock")
  location    String?  @db.VarChar(100)
  supplierId  String?  @map("supplier_id") @db.Uuid
  unitPrice   Int?     @map("unit_price")
  erpItemCode String?  @map("erp_item_code") @db.VarChar(60) // ERP 품목코드 매핑
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  /// 개체 수명 한도(멸균 합격 사이클 수) — 제조사·원내 기준 **입력값**. null = 한도 미설정(경보 없음 · 지어내지 않는다). 개체(InstrumentUnit.maxCycles)가 덮어쓴다.
  maxCycles Int? @map("max_cycles")

  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  transactions SupplyTransaction[]
  units        InstrumentUnit[]

  @@index([category])
  @@map("instrument_items")
}

/// CSSD 기구 개체(세트가 아닌 개별 기구 — 각인·UDI·자체 라벨로 식별).
/// 🔴 멸균 횟수·최초 사용일은 **저장하지 않는다** — SterilePackageUnit(개체↔패키지 LOT) 에서 파생한다(카운터 필드를 두면 정본이 둘).
model InstrumentUnit {
  id         String    @id @default(uuid()) @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  serialNo   String    @unique @map("serial_no") @db.VarChar(60)
  /// 개체별 수명 한도 — null 이면 품목(InstrumentItem.maxCycles) 값, 둘 다 null 이면 한도 미설정
  maxCycles  Int?      @map("max_cycles")
  status     String    @default("ACTIVE") @db.VarChar(16) // ACTIVE|RETIRED
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz()
  retiredBy  String?   @map("retired_by") @db.Uuid
  retireNote String?   @map("retire_note") @db.VarChar(300)
  note       String?   @db.VarChar(300)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  item     InstrumentItem       @relation(fields: [itemId], references: [id])
  packages SterilePackageUnit[]

  @@index([itemId])
  @@map("instrument_units")
}

/// 개체 ↔ 멸균 패키지(LOT) 구성 기록 — 패키지 1건 = 멸균 사이클 1회 기회. 합격 여부는 SterilePackage.sterilizedAt 이 말한다.
model SterilePackageUnit {
  packageId String   @map("package_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  addedBy   String?  @map("added_by") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz()

  package SterilePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  unit    InstrumentUnit @relation(fields: [unitId], references: [id])

  @@id([packageId, unitId])
  @@index([unitId])
  @@map("sterile_package_units")
}

// ── CSSD 발주(PO) 워크플로우 ──
model CssdPurchaseOrder {
  id          String       @id @default(uuid()) @db.Uuid
  poNo        String       @unique @map("po_no") @db.VarChar(40)
  supplierId  String?      @map("supplier_id") @db.Uuid
  status      String       @default("REQUESTED") @db.VarChar(12) // REQUESTED/APPROVED/RECEIVED/CANCELLED
  note        String?      @db.VarChar(300)
  requestedBy String?      @map("requested_by") @db.VarChar(80)
  approvedBy  String?      @map("approved_by") @db.VarChar(80)
  approvedAt  DateTime?    @map("approved_at")
  receivedAt  DateTime?    @map("received_at")
  totalAmount Int          @default(0) @map("total_amount")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  lines       CssdPoLine[]

  @@index([status])
  @@map("cssd_purchase_orders")
}

model CssdPoLine {
  id          String            @id @default(uuid()) @db.Uuid
  poId        String            @map("po_id") @db.Uuid
  po          CssdPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String            @map("item_id") @db.Uuid
  itemName    String            @map("item_name") @db.VarChar(200)
  qty         Int
  receivedQty Int               @default(0) @map("received_qty")
  unitPrice   Int?              @map("unit_price")

  @@index([poId])
  @@map("cssd_po_lines")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  erpVendorCode String?  @map("erp_vendor_code") @db.VarChar(60) // ERP 거래처코드 매핑
  name          String   @db.VarChar(200)
  contact       String?  @db.VarChar(100)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(120)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  items InstrumentItem[]

  @@map("suppliers")
}

model SupplyTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  type         String   @db.VarChar(10) // IN/OUT/ADJUST/RETURN
  qty          Int // 부호 포함(+입고/-소모)
  balanceAfter Int      @map("balance_after")
  reason       String?  @db.VarChar(200)
  ref          String?  @db.VarChar(80) // 재포장 LOT·PO 등
  performedBy  String?  @map("performed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  item InstrumentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("supply_transactions")
}

// ============================================================
// 인사관리 (HR)
// ============================================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
}

enum StaffCategory {
  MEDICAL // 의료진 (의사, 간호사)
  TECHNICAL // 의료기사 (방사선사, 임상병리사)
  ADMIN // 행정직
  SUPPORT // 지원직 (청소, 보안 등)
}

model Staff {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String?       @unique @map("user_id") @db.Uuid // 시스템 User 연결 (선택)
  employeeNumber  String        @unique @map("employee_number") @db.VarChar(20) // 사번
  erpEmployeeCode String?       @map("erp_employee_code") @db.VarChar(60) // ERP 인사 코드 매핑
  familyName      String        @map("family_name") @db.VarChar(100)
  givenName       String        @map("given_name") @db.VarChar(100)
  category        StaffCategory
  department      String        @db.VarChar(100) // "내과", "간호부", "원무과"
  position        String        @db.VarChar(100) // "전문의", "수간호사", "과장"
  licenseNumber   String?       @map("license_number") @db.VarChar(50) // 면허번호 (의료진)
  specialty       String?       @db.VarChar(100) // 전공/전문분야

  hireDate   DateTime         @map("hire_date") @db.Date
  resignDate DateTime?        @map("resign_date") @db.Date
  status     EmploymentStatus @default(ACTIVE)

  phone         String? @db.VarChar(20)
  email         String? @db.VarChar(255)
  clinicUserId  String? @unique @map("clinic_user_id") @db.VarChar(100)
  executiveRole String? @map("executive_role") @db.VarChar(20) // "CEO", "CMO" — 경영진 대시보드 접근

  managerStaffId String? @map("manager_staff_id") @db.Uuid // 보고라인(상급자 Staff) — 에스컬레이션 대상 산정

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  schedules    StaffSchedule[]
  manager      Staff?             @relation("StaffManager", fields: [managerStaffId], references: [id])
  reports      Staff[]            @relation("StaffManager")
  dependents   StaffDependent[]
  documents    StaffDocument[]
  payrollRelay StaffPayrollRelay?

  @@index([category])
  @@index([department])
  @@index([status])
  @@index([managerStaffId])
  @@map("staff")
}

// 부양가족(인적공제 기초) — HIS 구조화 저장. 주민번호는 미저장(필요 시 릴레이 전용).
model StaffDependent {
  id            String    @id @default(uuid()) @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  name          String    @db.VarChar(100)
  relation      String    @db.VarChar(20) // 배우자, 자녀, 부, 모, 형제자매, 조부모 등
  birthDate     DateTime? @map("birth_date") @db.Date
  isDependent   Boolean   @default(true) @map("is_dependent") // 인적공제 대상 여부
  deductionType String?   @map("deduction_type") @db.VarChar(30) // 기본공제, 장애인, 경로우대, 자녀세액 등
  note          String?   @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_dependents")
}

// 입사/급여 서류 — 암호화 저장(온보딩 패턴 복제). fileKey=암호화 파일 경로.
model StaffDocument {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  category  String   @db.VarChar(30) // BANKBOOK(통장사본), ID_CARD(신분증), FAMILY_CERT(가족관계증명), RESIDENT_REG(주민등록등본), OTHER
  fileName  String   @map("file_name") @db.VarChar(255)
  fileKey   String   @map("file_key") @db.VarChar(300) // 암호화 저장 경로
  mimeType  String?  @map("mime_type") @db.VarChar(100)
  sizeBytes Int?     @map("size_bytes")
  sensitive Boolean  @default(true)
  status    String   @default("SUBMITTED") @db.VarChar(20) // SUBMITTED, VERIFIED, REJECTED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_documents")
}

// 급여 신원정보(계좌·주민번호) 릴레이 상태 — HIS는 전체값 미보관(B). 마스킹 힌트+ERP 전송시각만.
model StaffPayrollRelay {
  id                String    @id @default(uuid()) @db.Uuid
  staffId           String    @unique @map("staff_id") @db.Uuid
  bankName          String?   @map("bank_name") @db.VarChar(40)
  bankAccountMask   String?   @map("bank_account_mask") @db.VarChar(40) // ***1234 (표시용)
  bankHolder        String?   @map("bank_holder") @db.VarChar(60)
  bankRelayedAt     DateTime? @map("bank_relayed_at") @db.Timestamptz()
  residentIdMask    String?   @map("resident_id_mask") @db.VarChar(20) // 720108-1******
  residentRelayedAt DateTime? @map("resident_relayed_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_payroll_relays")
}

/// @deprecated 당직 모델 이원화 통합(2026-07-22, duty-model-unification.plan.md) — 정본은 DutyEntry.
/// 비OFF 데이터는 duty_entries로 이관 완료(manual/duty-model-unification-20260722.sql). 원본은 감사·롤백용 동결 보존.
/// 신규 읽기/쓰기 금지 — 근무는 DutyEntry, OFF는 승인 LeaveRequest가 정본.
model StaffSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  date      DateTime @db.Date
  shiftType String   @map("shift_type") @db.VarChar(20) // "DAY", "EVENING", "NIGHT", "OFF"
  startTime String?  @map("start_time") @db.VarChar(5) // "09:00"
  endTime   String?  @map("end_time") @db.VarChar(5) // "18:00"
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([date])
  @@map("staff_schedules")
}

// ============================================================
// 영양/급식 (FR-30) + 의료장비 (FR-31) + Bots (FR-12)
// ============================================================

// ── 영양/급식 ──

model MealOrder {
  id                String    @id @default(uuid()) @db.Uuid
  admissionId       String    @map("admission_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  date              DateTime  @db.Date
  mealType          String    @map("meal_type") @db.VarChar(20) // BREAKFAST, LUNCH, DINNER, SNACK
  dietType          String    @map("diet_type") @db.VarChar(100) // 일반식, 저염식, 당뇨식, 유동식
  allergies         String?   @db.Text
  notes             String?   @db.Text
  status            String    @default("ORDERED") @db.VarChar(20) // ORDERED, PREPARED, DELIVERED, COMPLETED, PARTIAL, REFUSED
  wardName          String?   @map("ward_name") @db.VarChar(100) // 병동별 식수 집계용
  undeliveredReason String?   @map("undelivered_reason") @db.VarChar(50) // NPO/검사/부재/거부 등
  intakePercent     Int?      @map("intake_percent") // 섭취율 0~100
  intakeRecordedBy  String?   @map("intake_recorded_by") @db.Uuid
  intakeRecordedAt  DateTime? @map("intake_recorded_at") @db.Timestamptz()
  leftoverPercent   Int?      @map("leftover_percent") // 잔반율 0~100(식후 관리)
  refusalReason     String?   @map("refusal_reason") @db.VarChar(100) // 거부/잔반 사유
  trayCollectedAt   DateTime? @map("tray_collected_at") @db.Timestamptz() // 트레이 회수 시각
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])

  @@unique([admissionId, date, mealType]) // 일괄생성 멱등
  @@index([admissionId, date])
  @@index([date, status])
  @@map("meal_orders")
}

// ── 직원 식단표 (주간/월간 메뉴) ──
model StaffMealMenu {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  mealType    String   @map("meal_type") @db.VarChar(20) // BREAKFAST, LUNCH, DINNER
  courseType  String   @map("course_type") @db.VarChar(10) // A, B, C, SPECIAL
  menuName    String   @map("menu_name") @db.VarChar(200)
  description String?  @db.Text // 세부 메뉴 (밥+국+반찬)
  price       Int      @default(0)
  calories    Int? // kcal
  allergens   String?  @db.VarChar(200) // 알레르기 유발식품
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isSpecial   Boolean  @default(false) @map("is_special") // 특식 여부
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  creator User @relation("StaffMealMenuCreator", fields: [createdBy], references: [id])

  @@unique([date, mealType, courseType])
  @@index([date])
  @@map("staff_meal_menus")
}

// ── 직원 식수 신청 ──
model StaffMealRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  date        DateTime  @db.Date
  mealType    String    @map("meal_type") @db.VarChar(20)
  courseType  String    @default("A") @map("course_type") @db.VarChar(10)
  status      String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, CONFIRMED, CANCELLED
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation("StaffMealRequests", fields: [userId], references: [id])

  @@unique([userId, date, mealType])
  @@index([date, mealType])
  @@map("staff_meal_requests")
}

// ── 의료장비 ──

enum EquipmentStatus {
  ACTIVE
  UNDER_MAINTENANCE
  BROKEN
  RETIRED
}

/// 환자에게 **사용·삽입된 의료기기** 기록 — 리콜 역추적의 정본.
///
/// 🔴 발단(2026-08-26 실측): 삽입물이 `surgeries.implants`(자유 텍스트)와
/// `SurgeryOpNote.implants`(JSON)에만 남아 있었다. **리콜이 나면 그 로트가 어느 환자에게
/// 들어갔는지 찾을 방법이 없었다.** 자유 텍스트는 검색은 되지만 로트·GTIN 단위로 셀 수 없다.
///
/// 🔴 **바코드 원문을 보존한다**(`rawBarcode`). 파서가 나중에 좋아져도 다시 읽을 수 있어야 한다.
/// 🔴 **체크디지트 검증 결과를 함께 남긴다** — 틀린 GTIN 을 "유효"로 저장하지 않는다.
model DeviceUsage {
  id          String  @id @default(uuid()) @db.Uuid
  patientId   String  @map("patient_id") @db.Uuid
  surgeryId   String? @map("surgery_id") @db.Uuid
  encounterId String? @map("encounter_id") @db.Uuid

  /// GS1 GTIN-14(정규화). 리콜 조회의 축
  gtin             String?   @db.VarChar(14)
  /// 🔴 GTIN 체크디지트 검증 결과 — `null` 은 판정 대상이 아님(GTIN 없음)
  gtinValid        Boolean?  @map("gtin_valid")
  udiDi            String?   @map("udi_di") @db.VarChar(60)
  lotNumber        String?   @map("lot_number") @db.VarChar(40)
  serialNumber     String?   @map("serial_number") @db.VarChar(40)
  /// 유효기간 — `DD=00`(월말)이면 일자는 비운다. 🔴 날짜를 지어내지 않는다
  expiryDate       DateTime? @map("expiry_date") @db.Date
  expiryDayUnknown Boolean   @default(false) @map("expiry_day_unknown")

  deviceName   String  @map("device_name") @db.VarChar(300)
  manufacturer String? @db.VarChar(200)
  /// IMPLANT(체내 잔류) · SINGLE_USE(1회용) · REUSABLE(재사용) · OTHER
  usageType    String  @default("IMPLANT") @map("usage_type") @db.VarChar(20)
  quantity     Int     @default(1)
  /// 🔴 스캔 원문 — 파서를 고쳐도 다시 읽을 수 있어야 한다
  rawBarcode   String? @map("raw_barcode") @db.VarChar(200)
  /// 파서가 해석하지 못한 조각(버리지 않는다)
  unparsed     Json?   @db.JsonB
  note         String? @db.VarChar(500)

  usedAt      DateTime @default(now()) @map("used_at") @db.Timestamptz()
  /**
   * 증빙 파일 — `[{ id, fileName, url, mimeType, sizeBytes, uploadedBy, uploadedAt }]`.
   * 🔴 URL 은 저장 경로다. **응답 시점에 서명**해서 내보낸다(`/uploads` 는 인증이 없다).
   */
  attachments Json?    @db.JsonB
  recordedBy  String   @map("recorded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient  Patient @relation(fields: [patientId], references: [id])
  recorder User    @relation("DeviceUsageRecorder", fields: [recordedBy], references: [id])

  @@index([gtin, lotNumber])
  @@index([patientId, usedAt])
  @@index([serialNumber])
  @@map("device_usages")
}

model Equipment {
  id              String          @id @default(uuid()) @db.Uuid
  assetNumber     String          @unique @map("asset_number") @db.VarChar(50)
  erpAssetCode    String?         @map("erp_asset_code") @db.VarChar(60) // ERP 고정자산 코드 매핑
  name            String          @db.VarChar(300)
  category        String          @db.VarChar(100) // 진단장비, 치료장비, 수술장비, 응급장비, 모니터링
  manufacturer    String?         @db.VarChar(200)
  model           String?         @db.VarChar(200)
  serialNumber    String?         @map("serial_number") @db.VarChar(100)
  /// GS1 GTIN-14(정규화 저장 — 13자리는 앞에 `0`). 🔴 값을 바꾸지 않고 자리만 맞춘다
  gtin            String?         @db.VarChar(14)
  /// UDI-DI(기기식별자) — 발행기관 체계가 GS1 이 아닐 수 있어 GTIN 과 따로 둔다
  udiDi           String?         @map("udi_di") @db.VarChar(60)
  location        String?         @db.VarChar(100)
  purchaseDate    DateTime?       @map("purchase_date") @db.Date
  purchasePrice   Int?            @map("purchase_price") // 구매 금액 (원)
  warrantyExpiry  DateTime?       @map("warranty_expiry") @db.Date
  status          EquipmentStatus @default(ACTIVE)
  nextInspection  DateTime?       @map("next_inspection") @db.Date
  nextCalibration DateTime?       @map("next_calibration") @db.Date // 교정(calibration) 유효기한 — 경과 시 사용 경고
  // 공급업체/A/S 정보
  supplierName    String?         @map("supplier_name") @db.VarChar(200) // 공급업체명
  supplierContact String?         @map("supplier_contact") @db.VarChar(100) // 담당자 연락처
  supplierPhone   String?         @map("supplier_phone") @db.VarChar(50) // 대표 전화
  asContactName   String?         @map("as_contact_name") @db.VarChar(100) // A/S 담당자
  asContactPhone  String?         @map("as_contact_phone") @db.VarChar(50) // A/S 연락처
  notes           String?         @db.Text // 비고
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  maintenanceLogs MaintenanceLog[]
  parts           EquipmentPart[]
  usageLogs       EquipmentUsageLog[]
  inspectionLogs  EquipmentInspectionLog[]

  @@index([status])
  @@index([category])
  @@map("equipment")
}

model MaintenanceLog {
  id           String    @id @default(uuid()) @db.Uuid
  equipmentId  String    @map("equipment_id") @db.Uuid
  type         String    @db.VarChar(50) // INSPECTION, CALIBRATION, REPAIR, FAULT_REPORT, AS_REQUEST
  status       String    @default("COMPLETED") @db.VarChar(30) // REQUESTED, IN_PROGRESS, COMPLETED, CANCELLED
  description  String    @db.Text
  performedBy  String?   @map("performed_by") @db.VarChar(200) // 수행자 (내부 의공팀 or 외부 업체)
  requestedBy  String?   @map("requested_by") @db.VarChar(200) // 요청자
  cost         Int? // 비용 (원)
  vendor       String?   @db.VarChar(200) // 외부 수리/A/S 업체
  partReplaced String?   @map("part_replaced") @db.VarChar(500) // 교체 부품
  resultNotes  String?   @map("result_notes") @db.Text // 처리 결과
  performedAt  DateTime  @map("performed_at") @db.Date
  completedAt  DateTime? @map("completed_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([type])
  @@index([status])
  @@map("maintenance_logs")
}

// ── 장비 부품 재고 ──

model EquipmentPart {
  id            String    @id @default(uuid()) @db.Uuid
  equipmentId   String    @map("equipment_id") @db.Uuid
  partName      String    @map("part_name") @db.VarChar(200)
  partNumber    String?   @map("part_number") @db.VarChar(100) // 부품번호
  currentStock  Int       @default(0) @map("current_stock")
  minStock      Int       @default(1) @map("min_stock") // 안전재고
  unitPrice     Int?      @map("unit_price") // 단가 (원)
  supplier      String?   @db.VarChar(200) // 공급처
  lastOrderedAt DateTime? @map("last_ordered_at") @db.Date
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@map("equipment_parts")
}

// ── 장비 사용일지 ──

model EquipmentUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  equipmentId  String   @map("equipment_id") @db.Uuid
  usedDate     DateTime @map("used_date") @db.Date
  usedBy       String   @map("used_by") @db.VarChar(200) // 사용자
  department   String?  @db.VarChar(100) // 사용 부서
  patientCount Int?     @map("patient_count") // 사용 환자 수
  usageHours   Decimal? @map("usage_hours") @db.Decimal(5, 1) // 사용 시간
  purpose      String?  @db.VarChar(500) // 사용 목적
  condition    String?  @db.VarChar(50) // 사용 후 상태: NORMAL, ISSUE, FAULT
  issueNotes   String?  @map("issue_notes") @db.Text // 이상 소견
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([usedDate])
  @@map("equipment_usage_logs")
}

// ── 장비 점검일지 ──

model EquipmentInspectionLog {
  id                 String    @id @default(uuid()) @db.Uuid
  equipmentId        String    @map("equipment_id") @db.Uuid
  inspectionDate     DateTime  @map("inspection_date") @db.Date
  inspectorName      String    @map("inspector_name") @db.VarChar(200) // 점검자
  inspectionType     String    @map("inspection_type") @db.VarChar(50) // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUAL
  checkItems         Json      @map("check_items") @db.JsonB // [{item, result, notes}]
  overallResult      String    @map("overall_result") @db.VarChar(30) // PASS, FAIL, CONDITIONAL
  findings           String?   @db.Text // 점검 소견
  actionTaken        String?   @map("action_taken") @db.Text // 조치 사항
  nextInspectionDate DateTime? @map("next_inspection_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([inspectionDate])
  @@map("equipment_inspection_logs")
}

// ── Bots 워크플로우 (FR-12) ──

enum BotTriggerType {
  RESOURCE_CREATED
  RESOURCE_UPDATED
  RESOURCE_DELETED
  SCHEDULE
  MANUAL
}

enum BotStatus {
  ACTIVE
  DISABLED
  ERROR
}

model Bot {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique @db.VarChar(200)
  description   String?        @db.Text
  triggerType   BotTriggerType @map("trigger_type")
  triggerConfig Json           @map("trigger_config") @db.JsonB // { resourceType: "Patient", event: "created" }
  action        Json           @db.JsonB // { type: "notification", config: {...} }
  status        BotStatus      @default(ACTIVE)
  lastRunAt     DateTime?      @map("last_run_at") @db.Timestamptz()
  runCount      Int            @default(0) @map("run_count")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy     String         @map("created_by") @db.Uuid

  executions BotExecution[]

  @@index([status])
  @@index([triggerType])
  @@map("bots")
}

model BotExecution {
  id          String   @id @default(uuid()) @db.Uuid
  botId       String   @map("bot_id") @db.Uuid
  triggeredBy String?  @map("triggered_by") @db.VarChar(100) // resourceId or "schedule"
  input       Json?    @db.JsonB
  output      Json?    @db.JsonB
  success     Boolean
  error       String?  @db.Text
  duration    Int? // ms
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  bot Bot @relation(fields: [botId], references: [id])

  @@index([botId])
  @@index([createdAt])
  @@map("bot_executions")
}

// ============================================================
// PACS 연동 (FR-33) — Orthanc DICOM 서버 메타데이터
// ============================================================

model DicomStudy {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  orderId          String?   @map("order_id") @db.Uuid
  orthancStudyId   String    @unique @map("orthanc_study_id") @db.VarChar(100)
  studyInstanceUid String    @unique @map("study_instance_uid") @db.VarChar(200)
  studyDate        DateTime? @map("study_date") @db.Date
  modality         String    @db.VarChar(20) // CT, MR, CR, US, DX
  description      String?   @db.VarChar(500)
  seriesCount      Int       @default(0) @map("series_count")
  instanceCount    Int       @default(0) @map("instance_count")
  bodyPart         String?   @map("body_part") @db.VarChar(100)
  referringDoctor  String?   @map("referring_doctor") @db.VarChar(200)
  reportStatus     String    @default("PENDING") @map("report_status") @db.VarChar(20) // PENDING, REPORTED
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([studyDate])
  @@index([modality])
  @@map("dicom_studies")
}

// ============================================================
// JCI 인증 대응 (FR-34~38)
// ============================================================

model PatientIdentificationCheck {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  checkType     String   @map("check_type") @db.VarChar(20) // ADMISSION, PROCEDURE, MEDICATION, TRANSFUSION, SPECIMEN
  method        String   @db.VarChar(20) // WRISTBAND, VERBAL, BARCODE, TWO_IDENTIFIER
  verifiedItems Json     @map("verified_items") @db.JsonB // {name: true, dob: true, mrn: true}
  verifiedBy    String   @map("verified_by") @db.Uuid
  verifiedAt    DateTime @map("verified_at") @db.Timestamptz()
  result        String   @db.VarChar(10) // PASS, FAIL
  failureReason String?  @map("failure_reason") @db.Text
  encounterId   String?  @map("encounter_id") @db.Uuid
  admissionId   String?  @map("admission_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient  Patient @relation(fields: [patientId], references: [id])
  verifier User    @relation("IdCheckVerifier", fields: [verifiedBy], references: [id])

  @@index([patientId])
  @@index([checkType])
  @@map("patient_identification_checks")
}

model SafetyIncident {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String?  @map("patient_id") @db.Uuid
  // 🔴 2026-10-08 nullable — 익명 보고(결정 safety.anonymousReport · 설정 safety.incident.anonymous) 때만 null
  reporterId   String?  @map("reporter_id") @db.Uuid
  type         String   @db.VarChar(50)
  severity     String   @db.VarChar(20)
  description  String   @db.Text
  location     String?  @db.VarChar(100)
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz()
  actionTaken  String?  @map("action_taken") @db.Text
  status       String   @default("REPORTED") @db.VarChar(20)
  rcaCompleted Boolean  @default(false) @map("rca_completed")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  // ── QI 흐름(2026-10-08) — 병동별 사고율·위해 정도·검토 소요·익명 보고. 전부 NULL 허용(과거 사고는 미기록 — 소급하지 않는다)
  wardId       String?   @map("ward_id") @db.Uuid
  harmLevel    String?   @map("harm_level") @db.VarChar(20) // 척도는 결정 safety.harmLevelScale — 미설정이면 받지 않는다
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz() // REPORTED → INVESTIGATING(첫 검토)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz()
  closedBy     String?   @map("closed_by") @db.Uuid
  anonymous    Boolean   @default(false)
  // 2026-10-09 KOPS 직접 보고 기록 — 송신 채널이 없는 동안 사람이 KOPS 웹에 보고한 **사실**(접수번호·보고 시각·기록자)
  //   🔴 기관 접수를 시스템이 확인하지 않는다 — 사람이 적은 번호다(KONIS konisManualRef 와 같은 규약)
  kopsManualRef String?   @map("kops_manual_ref") @db.VarChar(60)
  kopsManualAt  DateTime? @map("kops_manual_at") @db.Timestamptz()
  kopsManualBy  String?   @map("kops_manual_by") @db.Uuid
  @@index([wardId, occurredAt])

  @@index([type])
  @@index([severity])
  @@map("safety_incidents")
}

// 적신호사건 근본원인분석(P2-G) — SafetyIncident.rcaCompleted 단일 불리언 → 구조화 RCA(JCI QPS.7).
//  incidentId 1:1. FK relation 미사용(수동 조인).
model RcaReport {
  id                  String    @id @default(uuid()) @db.Uuid
  incidentId          String    @unique @map("incident_id") @db.Uuid // SafetyIncident 1:1
  findings            String?   @db.Text // 근본원인
  contributingFactors Json?     @map("contributing_factors") // 기여요인 배열
  actionPlan          Json?     @map("action_plan") // 개선계획 [{action, owner, dueAt}]
  owner               String?   @db.Uuid // RCA 책임자
  dueAt               DateTime? @map("due_at") @db.Timestamptz() // 완료 기한(45일)
  status              String    @default("OPEN") @db.VarChar(20) // OPEN/IN_PROGRESS/COMPLETED/APPROVED
  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, dueAt])
  @@map("rca_reports")
}

// 인증 체크리스트(P3) — 종전 인메모리 배열(재기동 소실·감사 없음) → 영속화. id=자연키('JCI-IPSG-1').
model AccreditationItem {
  id           String    @id @db.VarChar(40)
  standard     String    @db.VarChar(20) // JCI, KoHIAS
  chapter      String?   @db.VarChar(50)
  name         String    @db.VarChar(200)
  status       String    @default("PENDING") @db.VarChar(20) // COMPLIANT/PARTIAL/NON_COMPLIANT
  lastReviewed DateTime? @map("last_reviewed") @db.Date
  evidence     String?   @db.Text
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([standard])
  @@map("accreditation_items")
}

model EarlyWarningScore {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  nurseId              String    @map("nurse_id") @db.Uuid
  // NEWS2 파라미터
  respiratoryRate      Int       @map("respiratory_rate")
  spO2                 Int       @map("sp_o2")
  supplementalO2       Boolean   @default(false) @map("supplemental_o2")
  spO2Scale            Int       @default(1) @map("sp_o2_scale") // 1=일반, 2=COPD
  systolicBp           Int       @map("systolic_bp")
  heartRate            Int       @map("heart_rate")
  consciousness        String    @db.VarChar(15) // ALERT, CONFUSION, VOICE, PAIN, UNRESPONSIVE
  temperature          Decimal   @db.Decimal(4, 1)
  // 계산 결과
  totalScore           Int       @map("total_score")
  riskLevel            String    @map("risk_level") @db.VarChar(15) // LOW, LOW_MEDIUM, MEDIUM, HIGH
  // 개별 점수
  scoreBreakdown       Json      @map("score_breakdown") @db.JsonB // {rr, spo2, o2, bp, hr, temp, consciousness}
  // 대응
  escalationRequired   Boolean   @default(false) @map("escalation_required")
  escalationNotified   Boolean   @default(false) @map("escalation_notified")
  escalationNotifiedAt DateTime? @map("escalation_notified_at") @db.Timestamptz()
  //
  recordedAt           DateTime  @map("recorded_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])
  nurse   User    @relation("EwsNurse", fields: [nurseId], references: [id])

  @@index([patientId, recordedAt])
  @@index([riskLevel])
  @@map("early_warning_scores")
}

model FallRiskAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
