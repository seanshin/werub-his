model PendingMapping {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceTable          String    @map("source_table") @db.VarChar(30)
  sourceId             String    @map("source_id") @db.Uuid
  sourceCode           String    @map("source_code") @db.VarChar(20)
  sourceName           String    @map("source_name") @db.VarChar(500)
  targetSystem         String    @map("target_system") @db.VarChar(20)
  candidates           Json      @db.JsonB
  bestCandidate        String?   @map("best_candidate") @db.VarChar(30)
  bestConfidence       Decimal?  @map("best_confidence") @db.Decimal(3, 2)
  // 관리자 최종 승인
  status               String    @default("PENDING") @db.VarChar(20) // PENDING, CONFIRMED, REJECTED
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNotes          String?   @map("review_notes") @db.Text
  selectedCode         String?   @map("selected_code") @db.VarChar(30)
  mappingId            String?   @map("mapping_id") @db.Uuid
  batchId              String?   @map("batch_id") @db.Uuid
  // 임상 검토 (의료진/간호파트)
  clinicalStatus       String    @default("AWAITING") @map("clinical_status") @db.VarChar(20) // AWAITING, APPROVED, REJECTED, SKIPPED
  clinicalReviewedBy   String?   @map("clinical_reviewed_by") @db.Uuid
  clinicalReviewedAt   DateTime? @map("clinical_reviewed_at") @db.Timestamptz()
  clinicalNotes        String?   @map("clinical_notes") @db.Text
  clinicalReviewerRole String?   @map("clinical_reviewer_role") @db.VarChar(20) // DOCTOR, NURSE, PHARMACIST
  assignedDept         String?   @map("assigned_dept") @db.VarChar(50)
  priority             String    @default("NORMAL") @db.VarChar(10) // HIGH, NORMAL, LOW
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt            DateTime  @default(dbgenerated("NOW() + INTERVAL '30 days'")) @map("expires_at") @db.Timestamptz()

  @@index([status])
  @@index([clinicalStatus])
  @@index([assignedDept])
  @@index([sourceTable, sourceId])
  @@index([batchId])
  @@map("pending_mappings")
}

model MappingBatchJob {
  id                 String    @id @default(uuid()) @db.Uuid
  sourceTable        String    @map("source_table") @db.VarChar(30)
  targetSystem       String    @map("target_system") @db.VarChar(20)
  filter             String    @db.VarChar(50)
  totalCodes         Int       @map("total_codes")
  processedCodes     Int       @default(0) @map("processed_codes")
  confirmedCount     Int       @default(0) @map("confirmed_count")
  pendingCount       Int       @default(0) @map("pending_count")
  // 🔴 2026-08-26 — 종전에는 CONFIRMED·PENDING 이 아닌 것을 전부 `failedCount` 로 셌다.
  //    "이 코드에 이 표준은 해당 사항이 아님"과 "AI 가 죽어서 못 함"이 같은 숫자에 들어가
  //    일괄 매핑 결과가 실제보다 나쁘게 보였다(그리고 무엇을 다시 돌려야 하는지 알 수 없었다).
  notApplicableCount Int       @default(0) @map("not_applicable_count") // 범주상 해당 없음 — 갭이 아니다
  noCandidateCount   Int       @default(0) @map("no_candidate_count") // 물어봤는데 후보 없음
  errorCount         Int       @default(0) @map("error_count") // 수행 못 함(재시도 대상)
  failedCount        Int       @default(0) @map("failed_count") // 신뢰도 미달(LOW_CONFIDENCE)
  status             String    @default("QUEUED") @db.VarChar(20)
  startedAt          DateTime? @map("started_at") @db.Timestamptz()
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  // 🔴 2026-09-15 nullable — 크론 배치는 사람 행위자가 없다(종전엔 UUID 컬럼에 문자열 'SYSTEM_CRON' 을 넣어 저장 자체가 실패할 자리였다).
  //    크론 출처는 `filter: 'CRON_SCHEDULED'` 가 이미 구분한다.
  createdBy          String?   @map("created_by") @db.Uuid
  errorLog           String?   @map("error_log") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("mapping_batch_jobs")
}

model MappingAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  mappingId    String   @map("mapping_id") @db.Uuid
  action       String   @db.VarChar(20)
  previousData Json?    @map("previous_data") @db.JsonB
  newData      Json?    @map("new_data") @db.JsonB
  reason       String?  @db.Text
  performedBy  String?  @map("performed_by") @db.Uuid
  performedAt  DateTime @default(now()) @map("performed_at") @db.Timestamptz()

  @@index([mappingId])
  @@map("mapping_audit_logs")
}

// MRN daily sequence: CREATE SEQUENCE mrn_daily_seq START 1;
// Reset via cron: ALTER SEQUENCE mrn_daily_seq RESTART WITH 1;

// ============================================================
// Phase 2: 진료 워크플로우
// ============================================================

enum EncounterStatus {
  DRAFT
  SIGNED
  AMENDED
}

enum PrescriptionType {
  MEDICATION
  LAB
  IMAGING
  THERAPY
  DIET
  ACTIVITY
  NURSING
}

/// ACTIVE(유효) · CANCELLED(무효 — 발효 전 취소·오입력) · DISCONTINUED(중단 — 그 시각 이후 멈춤, 이미 조제·투약된 사실은 유효)
/// 2026-09-30 오더 중단 설계: 종전엔 투약 중인 약을 멈추는 것도 '취소'라 처방 전체가 처음부터 무효처럼 남았다.
enum PrescriptionStatus {
  ACTIVE
  CANCELLED
  DISCONTINUED
}

enum OrderDepartment {
  PHARMACY
  LAB
  IMAGING
  THERAPY
}

enum OrderStatus {
  ORDERED
  RECEIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BillingStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
  DEFERRED
  REFUNDED
  INSTALLMENT
}

// ── Encounter (진료기록) ──

model Encounter {
  id                    String          @id @default(uuid()) @db.Uuid
  patientId             String          @map("patient_id") @db.Uuid
  doctorId              String          @map("doctor_id") @db.Uuid
  appointmentId         String?         @unique @map("appointment_id") @db.Uuid
  admissionId           String?         @map("admission_id") @db.Uuid
  visitType             String?         @map("visit_type") @db.VarChar(30) // OUTPATIENT, INPATIENT, ER_CONSULT, INPATIENT_CONSULT
  subjective            String?         @db.Text
  objective             String?         @db.Text
  assessment            String?         @db.Text
  plan                  String?         @db.Text
  // ── 구조화 의무기록 필드 ──
  chiefComplaint        String?         @map("chief_complaint") @db.Text
  historyPresentIllness String?         @map("hpi") @db.Text
  pastMedicalHistory    String?         @map("pmh") @db.Text
  familyHistory         String?         @map("family_history") @db.Text
  socialHistory         Json?           @map("social_history")
  reviewOfSystems       Json?           @map("ros")
  physicalExamination   Json?           @map("pe")
  status                EncounterStatus @default(DRAFT)
  signedAt              DateTime?       @map("signed_at") @db.Timestamptz()
  signedBy              String?         @map("signed_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  patient            Patient               @relation(fields: [patientId], references: [id])
  doctor             User                  @relation("DoctorEncounters", fields: [doctorId], references: [id])
  appointment        Appointment?          @relation(fields: [appointmentId], references: [id])
  admission          Admission?            @relation("AdmissionEncounters", fields: [admissionId], references: [id])
  diagnoses          EncounterDiagnosis[]
  prescriptions      Prescription[]
  billing            Billing?
  formSubmissions    FormSubmission[]
  problemLists       ProblemList[]
  consentForms       ConsentForm[]
  telehealthSessions TelehealthSession[]
  consultations      Consultation[]
  checkupVisits      CheckupVisit[]
  attachments        EncounterAttachment[]
  pregnancyStatus    String?               @map("pregnancy_status") @db.VarChar(16) // NONE|PREGNANT|LACTATING|UNKNOWN (DUR 임부금기 라인레벨, ERP 동봉)
  eligibilityCheckId String?               @map("eligibility_check_id") @db.Uuid // 진료시점 자격 스냅샷(copay 권위)
  // ── 앰비언트 스크라이브 프로비넌스(additive·§6.2) ──
  aiScribed          Boolean               @default(false) @map("ai_scribed") // 스크라이브 초안에서 출발
  scribeSessionId    String?               @map("scribe_session_id") @db.Uuid // 초안이 적용된 세션(포인터·관계 미선언)
  aiEditDistance     Int?                  @map("ai_edit_distance") // 초안 대비 서명본 수정량(§11)

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
  @@index([status], map: "idx_encounters_status")
  @@index([patientId, status], map: "idx_encounters_patient_status")
  @@index([patientId, createdAt], map: "idx_encounters_patient_date")
  @@index([doctorId, createdAt], map: "idx_encounters_doctor_date")
  @@map("encounters")
}

// 진료 첨부(타블렛 펜 스케치·도해 등) — 텍스트로 환원 불가한 시각 정보 영속화
model EncounterAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  kind        String   @default("SKETCH") @db.VarChar(16) // SKETCH|IMAGE|FILE
  url         String   @db.Text
  mimeType    String   @map("mime_type") @db.VarChar(64)
  note        String?  @db.Text
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_attachments")
}

// ── 앰비언트 진료 스크라이브(녹음→전사→화자분리→SOAP 초안) ──
// 관계 미선언(scalar FK) — Encounter 관계 블록 무간섭. encounterId 1—N scribe_sessions.

enum ScribeSessionStatus {
  RECORDING
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  DRAFTED
  APPLIED
  FAILED
  DELETED
}

enum ScribeVoiceProfileStatus {
  ACTIVE
  REVOKED
}

model ScribeSession {
  id              String              @id @default(uuid()) @db.Uuid
  encounterId     String              @map("encounter_id") @db.Uuid
  patientId       String              @map("patient_id") @db.Uuid
  doctorId        String              @map("doctor_id") @db.Uuid
  consentId       String?             @map("consent_id") @db.Uuid // RECORDING 동의 참조(P-7)
  status          ScribeSessionStatus @default(RECORDING)
  source          String              @default("RECORDING") @db.VarChar(16) // RECORDING(녹음 사후)|AMBIENT(라이브 대화)
  audioPath       String?             @map("audio_path") @db.Text // storage/scribe/…(원음, 파기 시 null)
  audioDeletedAt  DateTime?           @map("audio_deleted_at") @db.Timestamptz()
  legalHold       Boolean             @default(false) @map("legal_hold") // 보존명령 — 파기 우선(§9)
  transcript      Json? // 화자분리 세그먼트 [{speaker,start,end,text}]·라벨
  sttTier         String?             @map("stt_tier") @db.VarChar(16) // IMAC_BATCH|GPU_CHUNK|MANUAL
  resolverKind    String?             @map("resolver_kind") @db.VarChar(16) // EMBEDDING|HEURISTIC
  jobId           String?             @map("job_id") @db.VarChar(64) // WeRU.B 전사 job
  draftSnapshot   Json?               @map("draft_snapshot") // 생성 SOAP 초안 원문·citations
  aiModel         String?             @map("ai_model") @db.VarChar(64)
  aiPromptVersion String?             @map("ai_prompt_version") @db.VarChar(32)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([encounterId])
  @@index([doctorId])
  @@map("scribe_sessions")
}

// 앰비언트 대화 발화(라이브 전사) — 오디오 미저장·텍스트만 영속. 화자는 추정 라벨(안전 판정 근거 아님)
model VoiceUtterance {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid // ScribeSession(source=AMBIENT)
  seq           Int
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz()
  text          String   @db.Text // STT 확정(final) 원문 — 보존
  editedText    String?  @map("edited_text") @db.Text // 의사 수정본(원문 불변)
  speaker       String   @default("UNKNOWN") @db.VarChar(12) // DOCTOR|PATIENT|UNKNOWN
  speakerSource String   @default("HEURISTIC") @map("speaker_source") @db.VarChar(12) // HEURISTIC|DIARIZE|MANUAL
  confidence    Float?
  droppedSec    Float?   @map("dropped_sec") // 직전 전사 누락(G5 서명 게이트 근거)
  deleted       Boolean  @default(false) // 소프트 삭제(잡담·제3자 마스킹)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([sessionId, seq])
  @@index([sessionId])
  @@map("voice_utterances")
}

model ScribeVoiceProfile {
  id          String                   @id @default(uuid()) @db.Uuid
  doctorId    String                   @unique @map("doctor_id") @db.Uuid // 1인 1프로파일
  embedding   Json? // 음성 임베딩(특징벡터) — 원음 미저장(P-8)
  sampleCount Int                      @default(0) @map("sample_count")
  consentAt   DateTime                 @map("consent_at") @db.Timestamptz() // 생체정보 등록 동의(§4.1(2))
  status      ScribeVoiceProfileStatus @default(ACTIVE)
  revokedAt   DateTime?                @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("scribe_voice_profiles")
}

// ── Concierge Session (AI 환자 컨시어지) ──

model ConciergeSession {
  id            String    @id @default(uuid()) @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  status        String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, CLOSED, EXPIRED
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  closedAt      DateTime? @map("closed_at") @db.Timestamptz()
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz()
  rating        Int? // 만족도 1~5점
  ratingComment String?   @map("rating_comment") @db.VarChar(500)

  patient  Patient            @relation(fields: [patientId], references: [id])
  messages ConciergeMessage[]

  @@index([patientId])
  @@index([status])
  @@map("concierge_sessions")
}

model ConciergeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String   @db.VarChar(10) // patient, agent
  content   String   @db.Text
  intent    String?  @db.VarChar(30) // BOOKING, HISTORY, LAB_RESULT, MEDICATION, BILLING, HOSPITAL_INFO, HEALTH_ADVICE, GENERAL
  richData  Json?    @map("rich_data") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  session ConciergeSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("concierge_messages")
}

// ── Consultation (타과 협진) ──

model Consultation {
  id                 String    @id @default(uuid()) @db.Uuid
  encounterId        String    @map("encounter_id") @db.Uuid
  requestingDoctorId String    @map("requesting_doctor_id") @db.Uuid
  toDepartment       String    @map("to_department") @db.VarChar(50)
  toDoctorId         String?   @map("to_doctor_id") @db.Uuid
  reason             String    @db.Text
  clinicalQuestion   String?   @map("clinical_question") @db.Text
  urgency            String    @default("ROUTINE") @db.VarChar(20) // ROUTINE, URGENT, EMERGENT
  replyDoctorId      String?   @map("reply_doctor_id") @db.Uuid
  replyContent       String?   @map("reply_content") @db.Text
  repliedAt          DateTime? @map("replied_at") @db.Timestamptz()
  recommendations    String?   @db.Text
  status             String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, ACCEPTED, REPLIED, CLOSED
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // 종결 — 누가·언제(2026-10-10 신설 · 그 전에 종결된 행은 null = 모름 · 지어내지 않는다)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz()
  closedById         String?   @map("closed_by") @db.Uuid

  encounter        Encounter @relation(fields: [encounterId], references: [id])
  requestingDoctor User      @relation("ConsultRequester", fields: [requestingDoctorId], references: [id])
  toDoctor         User?     @relation("ConsultToDoctor", fields: [toDoctorId], references: [id])
  replyDoctor      User?     @relation("ConsultReplier", fields: [replyDoctorId], references: [id])
  closedBy         User?     @relation("ConsultCloser", fields: [closedById], references: [id])

  @@index([encounterId])
  @@index([status])
  @@index([toDoctorId, status])
  @@index([toDepartment, status])
  @@map("consultations")
}

// ── Referral Letter (의뢰서/회신서 AI 자동작성) ──

model ReferralLetter {
  id              String    @id @default(uuid()) @db.Uuid
  type            String    @db.VarChar(30) // CONSULTATION_REQUEST, CONSULTATION_REPLY, TRANSFER, LAB_ORDER, CHECKUP_REFERRAL, MEDICAL_OPINION
  consultationId  String?   @map("consultation_id") @db.Uuid
  transferId      String?   @map("transfer_id") @db.Uuid
  encounterId     String?   @map("encounter_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  fromDepartment  String    @map("from_department") @db.VarChar(50)
  fromDoctorId    String    @map("from_doctor_id") @db.Uuid
  toDepartment    String    @map("to_department") @db.VarChar(50)
  toDoctorId      String?   @map("to_doctor_id") @db.Uuid
  urgency         String    @default("ROUTINE") @db.VarChar(20) // ROUTINE, URGENT, EMERGENT
  content         String    @db.Text
  aiDraftContent  String?   @map("ai_draft") @db.Text
  aiModel         String?   @map("ai_model") @db.VarChar(50)
  editedByDoctor  Boolean   @default(false) @map("edited_by_doctor")
  patientSnapshot Json?     @map("patient_snapshot") @db.JsonB
  status          String    @default("DRAFT") @db.VarChar(20) // DRAFT, SIGNED, SENT, RECEIVED, REJECTED, VOIDED, EXPIRED, ARCHIVED
  signedAt        DateTime? @map("signed_at") @db.Timestamptz()
  signedBy        String?   @map("signed_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  pdfUrl          String?   @map("pdf_url") @db.VarChar(500)
  letterNumber    String?   @map("letter_number") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient    Patient @relation(fields: [patientId], references: [id])
  fromDoctor User    @relation("LetterFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor   User?   @relation("LetterToDoctor", fields: [toDoctorId], references: [id])

  @@index([patientId, type])
  @@index([fromDoctorId, status])
  @@index([toDepartment, status])
  @@map("referral_letters")
}

// ── Encounter Diagnosis (진단 연결) ──

model EncounterDiagnosis {
  id              String    @id @default(uuid()) @db.Uuid
  encounterId     String    @map("encounter_id") @db.Uuid
  diagnosisCodeId String    @map("diagnosis_code_id") @db.Uuid
  type            String    @default("PRIMARY") @db.VarChar(20) // PRIMARY, SECONDARY, DIFFERENTIAL
  rank            Int       @default(1)
  certainty       String?   @db.VarChar(20) // CONFIRMED, PROVISIONAL, RULE_OUT
  onsetDate       DateTime? @map("onset_date") @db.Date
  notes           String?   @db.Text

  encounter     Encounter     @relation(fields: [encounterId], references: [id])
  diagnosisCode DiagnosisCode @relation(fields: [diagnosisCodeId], references: [id])

  @@index([encounterId])
  @@index([diagnosisCodeId])
  @@map("encounter_diagnoses")
}

// ── Prescription (처방) ──

model Prescription {
  id                   String             @id @default(uuid()) @db.Uuid
  encounterId          String             @map("encounter_id") @db.Uuid
  type                 PrescriptionType
  medicationCodeId     String?            @map("medication_code_id") @db.Uuid
  procedureCodeId      String?            @map("procedure_code_id") @db.Uuid
  dosage               String?            @db.VarChar(100)
  frequency            String?            @db.VarChar(100)
  duration             Int?
  quantity             Int?
  route                String?            @db.VarChar(50)
  durChecked           Boolean            @default(false) @map("dur_checked")
  durWarnings          Json?              @map("dur_warnings") @db.JsonB
  durOverridden        Boolean            @default(false) @map("dur_overridden")
  durOverrideReason    String?            @map("dur_override_reason") @db.Text // DUR 경고 무시 사유(규제 감사)
  durOverrideBy        String?            @map("dur_override_by") @db.Uuid // 오버라이드 약사
  durOverrideAt        DateTime?          @map("dur_override_at") @db.Timestamptz()
  instructions         String?            @db.Text
  priority             String             @default("ROUTINE") @db.VarChar(20) // STAT, ROUTINE, PRN
  source               String?            @db.VarChar(30) // MANUAL, PRE_ORDER, CP, COPY, FAVORITE
  dispensingType       String             @default("INTERNAL") @map("dispensing_type") @db.VarChar(10) // INTERNAL, EXTERNAL
  rxValidUntil         DateTime?          @map("rx_valid_until") @db.Timestamptz() // 원외 처방전 유효기간
  orderSource          String             @default("WRITTEN") @map("order_source") @db.VarChar(15) // WRITTEN, VERBAL, TELEPHONE
  readBackConfirmedAt  DateTime?          @map("read_back_confirmed_at") @db.Timestamptz()
  readBackConfirmedBy  String?            @map("read_back_confirmed_by") @db.Uuid
  /// 구두·전화 처방의 처방의 사후 확인(서명) — 복창(readBack)은 받은 간호사의 확인이고, 이것은 **낸 의사**의 확인이다(2026-09-30)
  prescriberCosignedAt DateTime?          @map("prescriber_cosigned_at") @db.Timestamptz()
  prescriberCosignedBy String?            @map("prescriber_cosigned_by") @db.Uuid
  status               PrescriptionStatus @default(ACTIVE)
  /// 중단 시각·행위자·사유(DISCONTINUED 일 때만) — 사유는 비어 있으면 안 된다(서버 검증)
  discontinuedAt       DateTime?          @map("discontinued_at") @db.Timestamptz()
  discontinuedBy       String?            @map("discontinued_by") @db.Uuid
  discontinueReason    String?            @map("discontinue_reason") @db.Text
  /// 갱신 원처방(2026-09-30 지속 처방 갱신) — 갱신은 새 처방으로 잇고 원처방은 같은 순간 중단한다(겹치는 이중 투약 방지)
  renewedFromId        String?            @map("renewed_from_id") @db.Uuid
  /// 퇴원약(2026-09-30) — 입원 중 투약이 아니라 퇴원 때 가져갈 약. 투약 예정(MAR)·갱신 대기에 올리지 않는다
  dischargeMed         Boolean            @default(false) @map("discharge_med")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  createdBy            String             @map("created_by") @db.Uuid // 실제 입력자(작성 단말 사용자)
  prescriberId         String?            @map("prescriber_id") @db.Uuid // 책임 처방의(지정) — 위임/대리처방 시 createdBy와 다름. 미지정=createdBy
  diagnosisCodeId      String?            @map("diagnosis_code_id") @db.Uuid // 관련 상병(G2-5·SOAP A↔P 근거)

  encounter      Encounter                  @relation(fields: [encounterId], references: [id])
  diagnosisCode  DiagnosisCode?             @relation("PrescriptionDiagnosis", fields: [diagnosisCodeId], references: [id])
  medicationCode MedicationCode?            @relation(fields: [medicationCodeId], references: [id])
  procedureCode  ProcedureCode?             @relation(fields: [procedureCodeId], references: [id])
  orders         Order[]
  medAdmins      MedicationAdministration[]
  substitutions  GenericSubstitution[]

  @@index([encounterId])
  @@index([status], map: "idx_prescriptions_status")
  @@index([createdAt], map: "idx_prescriptions_created")
  @@index([type, status], map: "idx_prescriptions_type_status")
  @@index([procedureCodeId]) // FK 인덱스(질병통계 groupBy·수가 조인)
  @@index([medicationCodeId]) // FK 인덱스(DUR·약가 조인)
  @@index([renewedFromId], map: "idx_prescriptions_renewed_from")
  @@map("prescriptions")
}

// ── Order (OCS 오더) ──

model Order {
  id              String          @id @default(uuid()) @db.Uuid
  prescriptionId  String          @map("prescription_id") @db.Uuid
  department      OrderDepartment
  status          OrderStatus     @default(ORDERED)
  receivedAt      DateTime?       @map("received_at") @db.Timestamptz()
  receivedById    String?         @map("received_by_id") @db.Uuid // 접수자 (간호사/임상병리사/방사선사)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz()
  startedById     String?         @map("started_by_id") @db.Uuid // 시행 시작자
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz()
  completedById   String?         @map("completed_by_id") @db.Uuid // 완료 처리자
  priority        String          @default("ROUTINE") @db.VarChar(20) // STAT, ROUTINE, PRN, STANDING
  pharmacyType    String          @default("INTERNAL") @map("pharmacy_type") @db.VarChar(10) // INTERNAL, EXTERNAL
  preOrderId      String?         @map("pre_order_id") @db.Uuid
  result          Json?           @db.JsonB
  notes           String?         @db.Text
  acknowledgedBy  String?         @map("acknowledged_by") @db.Uuid
  acknowledgedAt  DateTime?       @map("acknowledged_at") @db.Timestamptz()
  // PACS 워크리스트 등록 결과 — 종전엔 accession 번호를 `notes` 에 덮어써서 수행 메모를 지웠고,
  // 등록 성공/실패를 구분해 남기지 않아 **실패해도 성공 로그가 찍혔다**(관측 불가).
  accessionNumber String?         @map("accession_number") @db.VarChar(64)
  worklistStatus  String?         @map("worklist_status") @db.VarChar(20) // REGISTERED · FAILED · CANCELLED · UNKNOWN(컬럼 도입 이전 건)
  worklistError   String?         @map("worklist_error") @db.Text
  // 취소 스탬프 — 종전엔 취소만 시각·행위자가 없어 "누가 언제 취소했는가"를 재구성할 수 없었다
  // (접수/시행/완료는 스탬프가 있었음). 서명 로그 소급 봉인의 근거이기도 하다.
  cancelledAt     DateTime?       @map("cancelled_at") @db.Timestamptz()
  cancelledById   String?         @map("cancelled_by_id") @db.Uuid
  /// 검체 채취(2026-10-01) — 검사실 **접수와 다른 사건**이다(병동·채혈실에서 채취한 순간). 종전엔 접수 순간을 채취로 찍었다.
  /// 모르면 null(접수 시각으로 채우지 않는다). 검사(LAB) 오더만.
  specimenCollectedAt DateTime? @map("specimen_collected_at") @db.Timestamptz()
  specimenCollectedById String? @map("specimen_collected_by_id") @db.Uuid
  /// 채취를 시스템에 남긴 순간 — 채취 시각과 다르면 나중에 입력한 것이다
  specimenCollectionRecordedAt DateTime? @map("specimen_collection_recorded_at") @db.Timestamptz()
  /// POINT_OF_CARE(채취하며 누름) · ENTERED_LATER(사람이 지난 시각을 입력 — 관측이 아니라 입력값)
  specimenCollectionSource String? @map("specimen_collection_source") @db.VarChar(20)
  specimenCollectionNote String? @map("specimen_collection_note") @db.VarChar(200)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  prescription  Prescription               @relation(fields: [prescriptionId], references: [id])
  canceller     User?                      @relation("OrderCanceller", fields: [cancelledById], references: [id])
  signLogs      OrderSignLog[]
  acknowledger  User?                      @relation("OrderAcknowledger", fields: [acknowledgedBy], references: [id])
  receiver      User?                      @relation("OrderReceiver", fields: [receivedById], references: [id])
  starter       User?                      @relation("OrderStarter", fields: [startedById], references: [id])
  completer     User?                      @relation("OrderCompleter", fields: [completedById], references: [id])
  specimenCollector User?                  @relation("OrderSpecimenCollector", fields: [specimenCollectedById], references: [id])
  dispensing    Dispensing?
  labResult     LabResult?
  imagingResult ImagingResult?
  therapyOrder  TherapyOrder?
  medAdmins     MedicationAdministration[]

  @@index([department, status])
  @@index([prescriptionId])
  @@index([createdAt], map: "idx_orders_created")
  @@index([status, createdAt], map: "idx_orders_status_created")
  @@index([acknowledgedBy, acknowledgedAt])
  @@index([accessionNumber])
  @@map("orders")
}

/// 오더 서명 로그 — CPOE 행위(발행·접수·시행·완료·취소)를 **sign 해시체인 원장에 봉인**하고
/// 그 영수증(entryHash·prevHash·TSA 앵커)을 원내에 보관한다.
///
/// 왜 원내에도 두나: sign 이 내려가도 로그가 유실되면 안 되고(먼저 로컬 저장 → 봉인 시도),
/// 화면 조회가 외부 왕복에 묶이면 안 되며, **봉인 누락을 대조로 찾아내려면** 원내 원장이 있어야 한다.
/// PHI 금지 — 환자·의료진 이름·연락처는 넣지 않는다(식별자와 코드/명칭까지만).
model OrderSignLog {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  prescriptionId String?   @map("prescription_id") @db.Uuid
  patientId      String?   @map("patient_id") @db.Uuid
  encounterId    String?   @map("encounter_id") @db.Uuid
  action         String    @db.VarChar(40) // ORDER_CREATED · ORDER_RECEIVED · ORDER_IN_PROGRESS · ORDER_COMPLETED · ORDER_CANCELLED
  fromStatus     String?   @map("from_status") @db.VarChar(20)
  toStatus       String    @map("to_status") @db.VarChar(20)
  actorId        String?   @map("actor_id") @db.Uuid // 미상(시스템/외부 웹훅)이면 null
  actorRole      String?   @map("actor_role") @db.VarChar(30)
  orderType      String?   @map("order_type") @db.VarChar(20)
  department     String?   @db.VarChar(20)
  priority       String?   @db.VarChar(20)
  summary        String?   @db.Text // 코드·명칭 수준 요약(PHI 아님)
  /// 실시간 배선(EVENT) vs 스탬프에서 복원(RECONCILED) — 커버리지 판정 근거
  origin         String    @default("EVENT") @db.VarChar(20)
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz()
  // ── sign 봉인 영수증 ──
  sealStatus     String    @default("PENDING") @map("seal_status") @db.VarChar(20) // PENDING · SEALED · FAILED · SKIPPED(sign 비활성)
  entryHash      String?   @map("entry_hash") @db.VarChar(64)
  prevHash       String?   @map("prev_hash") @db.VarChar(64)
  authMethod     String?   @map("auth_method") @db.VarChar(20) // SSO(의료진 검증) · API_KEY(시스템 주장)
  anchorHead     String?   @map("anchor_head") @db.VarChar(64)
  anchoredAt     DateTime? @map("anchored_at") @db.Timestamptz()
  sealAttempts   Int       @default(0) @map("seal_attempts")
  sealError      String?   @map("seal_error") @db.Text
  sealedAt       DateTime? @map("sealed_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 같은 전이를 두 번 봉인하지 않는다 — 실시간 배선과 소급 복원이 겹쳐도 1건(멱등)
  @@unique([orderId, action, occurredAt])
  @@index([orderId, occurredAt])
  @@index([sealStatus, createdAt])
  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([patientId, occurredAt])
  @@map("order_sign_logs")
}

// ── Billing (수납) ──

model Billing {
  id                      String        @id @default(uuid()) @db.Uuid
  encounterId             String        @unique @map("encounter_id") @db.Uuid
  patientId               String        @map("patient_id") @db.Uuid
  totalAmount             Int           @map("total_amount")
  insuranceCovered        Int           @map("insurance_covered")
  patientCopay            Int           @map("patient_copay")
  status                  BillingStatus @default(PENDING)
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz()
  paidAmount              Int?          @map("paid_amount")
  // 결제 수단
  paymentMethod           String?       @map("payment_method") @db.VarChar(20)
  cardApprovalNo          String?       @map("card_approval_no") @db.VarChar(30)
  receiptNo               String?       @map("receipt_no") @db.VarChar(30)
  cashReceiptType         String?       @map("cash_receipt_type") @db.VarChar(20)
  cashReceiptNo           String?       @map("cash_receipt_no") @db.VarChar(30)
  // 미수/환불
  deferredReason          String?       @map("deferred_reason") @db.Text
  refundAmount            Int?          @map("refund_amount")
  refundedAt              DateTime?     @map("refunded_at") @db.Timestamptz()
  refundReason            String?       @map("refund_reason") @db.Text
  // 원무과 메모
  cashierNote             String?       @map("cashier_note") @db.Text
  processedBy             String?       @map("processed_by") @db.Uuid
  // 수진자 자격 스냅샷(청구 시점 — 영수증 법정표시·본인부담 구분)
  copayCategory           String?       @map("copay_category") @db.VarChar(24) // NHI|MA_TYPE1|MA_TYPE2|NEAR_POOR|SPECIAL_EXEMPTION|...
  eligibilityStatus       String?       @map("eligibility_status") @db.VarChar(16) // VERIFIED|EXPIRED|NOT_FOUND
  eligibilityCheckId      String?       @map("eligibility_check_id") @db.Uuid
  specialExemption        String?       @map("special_exemption") @db.VarChar(40)
  // 감면(원무 수납 시) — 영수증 납부할금액 = patientCopay - discountAmount
  discountAmount          Int           @default(0) @map("discount_amount")
  discountReason          String?       @map("discount_reason") @db.VarChar(200)
  // 심사결과 반영(청구 심사 후) — 원본 insuranceCovered 보존, 조정액 별도 기록. 삭감액은 병원 부담(환자 미청구)
  reviewedInsuranceAmount Int?          @map("reviewed_insurance_amount") // 심사 후 실제 승인 보험액
  insuranceReducedAmount  Int?          @map("insurance_reduced_amount") // 삭감액(claimed - approved)
  insuranceAdjustedAt     DateTime?     @map("insurance_adjusted_at") @db.Timestamptz()
  copayCapExcess          Int?          @map("copay_cap_excess") // 본인부담상한제 사전급여(상한 초과분·NHIS부담)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  encounter        Encounter         @relation(fields: [encounterId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  items            BillingItem[]
  payments         BillingPayment[]
  claims           Claim[]
  installmentPlans InstallmentPlan[]

  @@index([patientId])
  @@index([status])
  @@index([patientId, status], map: "idx_billings_patient_status")
  @@index([createdAt], map: "idx_billings_created")
  @@index([status, createdAt], map: "idx_billings_status_date")
  @@map("billings")
}

model BillingItem {
  id                   String  @id @default(uuid()) @db.Uuid
  billingId            String  @map("billing_id") @db.Uuid
  codeType             String  @map("code_type") @db.VarChar(20)
  codeId               String  @map("code_id") @db.Uuid
  codeName             String  @map("code_name") @db.VarChar(500)
  quantity             Int
  unitPrice            Int     @map("unit_price")
  amount               Int
  copayRate            Decimal @map("copay_rate") @db.Decimal(5, 4)
  insuranceCategory    String? @map("insurance_category") @db.VarChar(20)
  // COVERED (급여) | NON_COVERED (비급여) | PARTIALLY_COVERED (일부급여)
  fullCopay            Boolean @default(false) @map("full_copay") // 급여 100분의100 본인부담(전액본인부담) — 영수증 급여 일부/전액 분리
  sourcePrescriptionId String? @map("source_prescription_id") @db.Uuid // progressive billing 발생-정산 ref 정합

  billing Billing @relation(fields: [billingId], references: [id])

  @@index([billingId])
  @@index([sourcePrescriptionId])
  @@map("billing_items")
}

// ── Deposit (선납/예치금) ──

model Deposit {
  id            String    @id @default(uuid()) @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  admissionId   String?   @map("admission_id") @db.Uuid
  amount        Int
  balance       Int
  depositType   String    @map("deposit_type") @db.VarChar(20)
  paymentMethod String?   @map("payment_method") @db.VarChar(20)
  depositedAt   DateTime  @default(now()) @map("deposited_at") @db.Timestamptz()
  refundedAt    DateTime? @map("refunded_at") @db.Timestamptz()
  processedBy   String    @map("processed_by") @db.Uuid
  note          String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("deposits")
}

// ── Installment (분할 납부) ──

model InstallmentPlan {
  id           String    @id @default(uuid()) @db.Uuid
  billingId    String    @map("billing_id") @db.Uuid
  totalAmount  Int       @map("total_amount")
  installments Int
  paidCount    Int       @default(0) @map("paid_count")
  nextDueDate  DateTime? @map("next_due_date") @db.Date
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  billing  Billing              @relation(fields: [billingId], references: [id])
  payments InstallmentPayment[]

  @@map("installment_plans")
}

model InstallmentPayment {
  id      String    @id @default(uuid()) @db.Uuid
  planId  String    @map("plan_id") @db.Uuid
  seqNo   Int       @map("seq_no")
  amount  Int
  dueDate DateTime  @map("due_date") @db.Date
  paidAt  DateTime? @map("paid_at") @db.Timestamptz()
  status  String    @default("PENDING") @db.VarChar(20)

  plan InstallmentPlan @relation(fields: [planId], references: [id])

  @@map("installment_payments")
}

// ── Form Engine ──

model FormSchema {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(100)
  version          String   @db.VarChar(20)
  locale           String   @default("ko") @db.VarChar(10)
  schema           Json     @db.JsonB
  category         String   @default("QUESTIONNAIRE") @db.VarChar(30) // QUESTIONNAIRE | SCORING | CONSENT | CUSTOM
  description      String?  @db.VarChar(500)
  estimatedMinutes Int?     @map("estimated_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  /// 문항 판 번호(2026-10-21 임상 규칙 P5 A7) — 문항(schema)이 바뀔 때마다 서버가 올린다 · `version` 은 사람이 적는 표기
  revision         Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String   @map("created_by") @db.Uuid

  submissions         FormSubmission[]
  revisions           FormSchemaRevision[]
  questionnaireTokens QuestionnaireToken[]
  departmentMappings  DepartmentFormMapping[]

  @@index([category])
  @@map("form_schemas")
}

/// 문진 폼 판 원장(2026-10-21 임상 규칙 P5 A7) — 덧붙이기만. 판마다 그때 문항 전체를 보존한다.
/// origin: CREATE(만들 때) · EDIT(문항 수정) · BEFORE_LEDGER(원장 시작 전 내용 — 처음 고칠 때 그 직전 문항을 남긴다 · 언제 만들어졌는지는 모름)
model FormSchemaRevision {
  id           String   @id @default(uuid()) @db.Uuid
  formSchemaId String   @map("form_schema_id") @db.Uuid
  revision     Int
  version      String   @db.VarChar(20)
  schema       Json     @db.JsonB
  origin       String   @db.VarChar(20)
  changedBy    String?  @map("changed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  formSchema FormSchema @relation(fields: [formSchemaId], references: [id])

  @@unique([formSchemaId, revision])
  @@map("form_schema_revisions")
}

model FormSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  formSchemaId String   @map("form_schema_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  encounterId  String?  @map("encounter_id") @db.Uuid
  data         Json     @db.JsonB
  submittedBy  String   @map("submitted_by") @db.Uuid
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz()
  /// 제출 때의 문항 판 번호(2026-10-21 P5 A7) — null = 판 원장 시작 전 제출(어떤 문항으로 받았는지 모름)
  formSchemaRevision Int? @map("form_schema_revision")

  formSchema         FormSchema          @relation(fields: [formSchemaId], references: [id])
  patient            Patient             @relation(fields: [patientId], references: [id])
  encounter          Encounter?          @relation(fields: [encounterId], references: [id])
  questionnaireToken QuestionnaireToken?

  @@index([patientId])
  @@index([formSchemaId])
  @@map("form_submissions")
}

// ============================================================
// Phase 3: 부서 + 청구 + 대시보드
// ============================================================

enum DispensingStatus {
  PENDING
  DISPENSED
  VERIFIED
  ISSUED // 불출(교부) 완료 — 외래: 환자/보호자 수령, 입원: 병동 인계
  CANCELLED
}

enum LabResultStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  COMPLETED // 결과 입력 완료(예비·검증 전)
  VERIFIED // 독립 검증·확정(임상 사용 가능)
}

enum ImagingResultStatus {
  ORDERED
  ACQUIRED
  REPORTED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

// ── 약국 디스펜싱 (FR-05) ──

model Dispensing {
  id                 String           @id @default(uuid()) @db.Uuid
  orderId            String           @unique @map("order_id") @db.Uuid
  patientId          String           @map("patient_id") @db.Uuid
  pharmacistId       String           @map("pharmacist_id") @db.Uuid
  status             DispensingStatus @default(PENDING)
  careType           String           @default("OUTPATIENT") @map("care_type") @db.VarChar(15) // OUTPATIENT, INPATIENT, DISCHARGE
  packagingType      String           @default("STANDARD") @map("packaging_type") @db.VarChar(15) // STANDARD, UNIT_DOSE, BLISTER
  // 분할조제
  splitSeqNo         Int              @default(1) @map("split_seq_no")
  splitOfId          String?          @map("split_of_id") @db.Uuid
  totalPrescribedQty Int?             @map("total_prescribed_qty")
  partialQty         Int?             @map("partial_qty")
  remainingQty       Int?             @map("remaining_qty")
  //
  dispensedAt        DateTime?        @map("dispensed_at") @db.Timestamptz()
  secondCheckBy      String?          @map("second_check_by") @db.Uuid // 고위험약/마약류 독립 2인확인자(≠조제약사, ISMP)
  secondCheckAt      DateTime?        @map("second_check_at") @db.Timestamptz()
  verifiedBy         String?          @map("verified_by") @db.Uuid
  verifiedAt         DateTime?        @map("verified_at") @db.Timestamptz()
  issuedBy           String?          @map("issued_by") @db.Uuid // 불출(교부) 처리자
  issuedAt           DateTime?        @map("issued_at") @db.Timestamptz()
  issuedTo           String?          @map("issued_to") @db.VarChar(100) // 수령 확인 — 외래: 환자/보호자명, 입원: 병동/인수자
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  order      Order                      @relation(fields: [orderId], references: [id])
  patient    Patient                    @relation(fields: [patientId], references: [id])
  pharmacist User                       @relation("PharmacistDispensings", fields: [pharmacistId], references: [id])
  splitOf    Dispensing?                @relation("SplitDispensing", fields: [splitOfId], references: [id])
  splitParts Dispensing[]               @relation("SplitDispensing")
  items      DispensingItem[]
  medAdmins  MedicationAdministration[]
  counsels   DispensingCounsel[]
  atcJobs    AtcDispenseJob[]

  @@index([patientId])
  @@map("dispensings")
}

model DispensingItem {
  id               String    @id @default(uuid()) @db.Uuid
  dispensingId     String    @map("dispensing_id") @db.Uuid
  medicationCodeId String    @map("medication_code_id") @db.Uuid
  prescribedQty    Int       @map("prescribed_qty")
  dispensedQty     Int       @map("dispensed_qty")
  // 바코드 스캔
  scannedBarcode   String?   @map("scanned_barcode") @db.VarChar(100)
  scannedAt        DateTime? @map("scanned_at") @db.Timestamptz()
  barcodeVerified  Boolean   @default(false) @map("barcode_verified")
  // 배치/로트
  batchId          String?   @map("batch_id") @db.Uuid
  lotNumber        String?   @map("lot_number") @db.VarChar(50)

  dispensing     Dispensing       @relation(fields: [dispensingId], references: [id])
  medicationCode MedicationCode   @relation(fields: [medicationCodeId], references: [id])
  batch          MedicationBatch? @relation(fields: [batchId], references: [id])

  @@index([dispensingId])
  @@map("dispensing_items")
}

// ── 약품 배치/로트 관리 ──

model MedicationBatch {
  id               String   @id @default(uuid()) @db.Uuid
  medicationCodeId String   @map("medication_code_id") @db.Uuid
  lotNumber        String   @map("lot_number") @db.VarChar(50)
  expirationDate   DateTime @map("expiration_date") @db.Date
  quantity         Int // 입고 수량
  remainingQty     Int      @map("remaining_qty") // 잔여 수량
  manufacturer     String?  @db.VarChar(200)
  receivedAt       DateTime @map("received_at") @db.Timestamptz()
  storageCondition String   @default("ROOM") @map("storage_condition") @db.VarChar(10) // ROOM, COLD, FROZEN
  isControlled     Boolean  @default(false) @map("is_controlled") // 마약류 여부
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  medicationCode  MedicationCode   @relation(fields: [medicationCodeId], references: [id])
  dispensingItems DispensingItem[]

  @@index([medicationCodeId])
  @@index([expirationDate])
  @@index([lotNumber])
  @@map("medication_batches")
}

// ── 복약지도 ──

model DispensingCounsel {
  id                  String   @id @default(uuid()) @db.Uuid
  dispensingId        String   @map("dispensing_id") @db.Uuid
  pharmacistId        String   @map("pharmacist_id") @db.Uuid
  patientId           String   @map("patient_id") @db.Uuid
  counselType         String   @default("INITIAL") @map("counsel_type") @db.VarChar(15) // INITIAL, REFILL, DISCHARGE
  content             String   @db.Text
  drugInteractions    String?  @map("drug_interactions") @db.Text
  sideEffects         String?  @map("side_effects") @db.Text
  foodInteractions    String?  @map("food_interactions") @db.Text
  storageInstructions String?  @map("storage_instructions") @db.Text
  duration            Int? // 상담 시간(분)
  counseledAt         DateTime @map("counseled_at") @db.Timestamptz()
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  dispensing Dispensing @relation(fields: [dispensingId], references: [id])
  pharmacist User       @relation("CounselPharmacist", fields: [pharmacistId], references: [id])
  patient    Patient    @relation(fields: [patientId], references: [id])

  @@index([dispensingId])
  @@index([patientId])
  @@map("dispensing_counsels")
}

// ── 대체조제 ──

model GenericSubstitution {
  id                         String    @id @default(uuid()) @db.Uuid
  originalPrescriptionId     String    @map("original_prescription_id") @db.Uuid
  substituteMedicationCodeId String    @map("substitute_medication_code_id") @db.Uuid
  reason                     String    @db.Text
  pharmacistId               String    @map("pharmacist_id") @db.Uuid
  requestedAt                DateTime  @map("requested_at") @db.Timestamptz()
  doctorNotified             Boolean   @default(false) @map("doctor_notified")
  doctorApproved             Boolean?  @map("doctor_approved")
  patientConsent             Boolean   @default(false) @map("patient_consent")
  status                     String    @default("REQUESTED") @db.VarChar(15) // REQUESTED, APPROVED, REJECTED
  /// 판정한 사람·시각·사유(2026-09-30) — 종전엔 승인/거부 여부만 남아 누가(책임 처방의인지 관리자 대리인지)·왜를 알 수 없었다.
  /// 이 칸이 생기기 전에 판정된 건은 null 로 둔다(지어내지 않는다).
  decidedById                String?   @map("decided_by_id") @db.Uuid
  decidedAt                  DateTime? @map("decided_at") @db.Timestamptz()
  decisionNote               String?   @map("decision_note") @db.Text
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  originalPrescription Prescription   @relation(fields: [originalPrescriptionId], references: [id])
  substituteMedication MedicationCode @relation("SubstituteMed", fields: [substituteMedicationCodeId], references: [id])
  pharmacist           User           @relation("SubstitutionPharmacist", fields: [pharmacistId], references: [id])

  @@index([originalPrescriptionId])
  @@map("generic_substitutions")
}

// ── 약물이상반응(ADR) 보고 ──

model AdverseReactionReport {
  id                  String    @id @default(uuid()) @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  reporterId          String    @map("reporter_id") @db.Uuid
  reportType          String    @default("INITIAL") @map("report_type") @db.VarChar(15) // INITIAL, FOLLOWUP
  // 의심 약물
  suspectedDrugName   String    @map("suspected_drug_name") @db.VarChar(200)
  suspectedDrugCode   String?   @map("suspected_drug_code") @db.VarChar(30)
  // 이상반응
  reactionDescription String    @map("reaction_description") @db.Text
  onsetDate           DateTime  @map("onset_date") @db.Date
  severity            String    @db.VarChar(10) // MILD, MODERATE, SEVERE, FATAL
  outcome             String    @db.VarChar(15) // RECOVERED, RECOVERING, NOT_RECOVERED, FATAL, UNKNOWN
  // 중대성(seriousness) — KIDS/E2B 중대성 개별 기준(중증도 severity와 별개)
  isSerious           Boolean   @default(false) @map("is_serious")
  seriousDeath        Boolean   @default(false) @map("serious_death")
  seriousLifeThreat   Boolean   @default(false) @map("serious_life_threat")
  seriousHospital     Boolean   @default(false) @map("serious_hospital") // 입원/입원연장
  seriousDisability   Boolean   @default(false) @map("serious_disability") // 영구·중대 장애
  seriousCongenital   Boolean   @default(false) @map("serious_congenital") // 선천이상
  // 인과관계
  causalityAssessment String?   @map("causality_assessment") @db.VarChar(15) // CERTAIN, PROBABLE, POSSIBLE, UNLIKELY
  naranjoScore        Int?      @map("naranjo_score")
  // 보고
  parentReportId      String?   @map("parent_report_id") @db.Uuid // 후속보고→원보고 연결
  kidsReported        Boolean   @default(false) @map("kids_reported")
  kidsReportDate      DateTime? @map("kids_report_date") @db.Date
  kidsReportNumber    String?   @map("kids_report_number") @db.VarChar(30)
  kidsPayload         Json?     @map("kids_payload") // E2B(R3) 스타일 제출 페이로드(스냅샷)
  // 조치
  actionTaken         String?   @map("action_taken") @db.VarChar(15) // WITHDRAWN, REDUCED, UNCHANGED, UNKNOWN
  status              String    @default("DRAFT") @db.VarChar(15) // DRAFT, SUBMITTED, REVIEWED
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient  Patient @relation(fields: [patientId], references: [id])
  reporter User    @relation("AdrReporter", fields: [reporterId], references: [id])

  @@index([patientId])
  @@index([suspectedDrugCode])
  @@index([status])
  @@map("adverse_reaction_reports")
}

// ── 약국 기기 관리 ──

model PharmacyDevice {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(100)
  type             String    @db.VarChar(20) // ATC, COUNTER, PACKAGER, LABEL_PRINTER
  status           String    @default("OFFLINE") @db.VarChar(15) // ONLINE, OFFLINE, ERROR, MAINTENANCE
  connectionType   String    @map("connection_type") @db.VarChar(10) // TCP, SERIAL, USB, API
  connectionConfig Json      @map("connection_config") @db.JsonB
  location         String?   @db.VarChar(100)
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  atcJobs AtcDispenseJob[]

  @@map("pharmacy_devices")
}

model AtcDispenseJob {
  id           String    @id @default(uuid()) @db.Uuid
  dispensingId String    @map("dispensing_id") @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  status       String    @default("QUEUED") @db.VarChar(15) // QUEUED, PROCESSING, COMPLETED, FAILED
  medications  Json      @db.JsonB // [{code, qty, slot}]
  startedAt    DateTime? @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  errorMessage String?   @map("error_message") @db.Text
  retryCount   Int       @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  dispensing Dispensing     @relation(fields: [dispensingId], references: [id])
  device     PharmacyDevice @relation(fields: [deviceId], references: [id])

  @@index([dispensingId])
  @@index([deviceId, status])
  @@map("atc_dispense_jobs")
}

// ── 검사실 (FR-06) ──

model LabResult {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @unique @map("order_id") @db.Uuid
  patientId    String          @map("patient_id") @db.Uuid
  technicianId String          @map("technician_id") @db.Uuid
  status       LabResultStatus @default(PENDING)
  collectedAt  DateTime?       @map("collected_at") @db.Timestamptz()
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz()
  verifiedBy   String?         @map("verified_by") @db.Uuid // 검증·확정한 검사자(입력자와 달라야 함, 독립검증)
  verifiedAt   DateTime?       @map("verified_at") @db.Timestamptz()
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  order       Order                 @relation(fields: [orderId], references: [id])
  patient     Patient               @relation(fields: [patientId], references: [id])
  technician  User                  @relation("TechnicianLabResults", fields: [technicianId], references: [id])
  items       LabResultItem[]
  attachments LabResultAttachment[]
  amendments  LabResultAmendment[]

  @@index([patientId, status], map: "idx_lab_results_patient_status")
  @@index([status, createdAt], map: "idx_lab_results_status_date")
  @@index([completedAt], map: "idx_lab_results_completed")
  @@map("lab_results")
}

// 검사 결과 수정 이력 — 확정/입력 후 정정 시 이전 값 스냅샷 보존(감사·재통보 근거).
model LabResultAmendment {
  id             String   @id @default(uuid()) @db.Uuid
  labResultId    String   @map("lab_result_id") @db.Uuid
  amendedBy      String   @map("amended_by") @db.Uuid
  reason         String   @db.VarChar(500)
  previousStatus String   @map("previous_status") @db.VarChar(20)
  previousItems  Json     @map("previous_items") @db.JsonB // 수정 전 항목 스냅샷
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  labResult LabResult @relation(fields: [labResultId], references: [id])

  @@index([labResultId])
  @@map("lab_result_amendments")
}

model LabResultItem {
  id          String   @id @default(uuid()) @db.Uuid
  labResultId String   @map("lab_result_id") @db.Uuid
  testName    String   @map("test_name") @db.VarChar(200)
  testCode    String?  @map("test_code") @db.VarChar(50) // 원 소스 코드(LIS/장비/내부)
  loincCode   String?  @map("loinc_code") @db.VarChar(20) // 표준 LOINC — LIS 전송분 보존 or 마스터 해소. FHIR Observation.code(http://loinc.org)
  value       String   @db.VarChar(100)
  unit        String   @db.VarChar(50)
  normalMin   Decimal? @map("normal_min") @db.Decimal(10, 3)
  normalMax   Decimal? @map("normal_max") @db.Decimal(10, 3)
  flag        String?  @db.VarChar(10)

  labResult LabResult @relation(fields: [labResultId], references: [id])

  @@index([labResultId], map: "idx_lab_result_items_result")
  @@index([testName], map: "idx_lab_result_items_test")
  @@index([loincCode], map: "idx_lab_result_items_loinc")
  @@map("lab_result_items")
}

/// 만성질환 시계열 관찰값(당뇨·고혈압 등) — Order 불필요, 코드 정규화로 추이 쿼리 최적.
/// code: FBS|PPG|HBA1C|SBP|DBP|WEIGHT|BMI. (patient relation 미선언 — FK 는 manual SQL)
model ChronicObservation {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  code        String   @db.VarChar(20)
  value       Decimal  @db.Decimal(8, 2)
  unit        String   @db.VarChar(10)
  measuredAt  DateTime @map("measured_at") @db.Timestamptz()
  source      String   @default("CLINIC") @db.VarChar(12) // CLINIC|SMBG|CHECKUP|DEVICE|LAB|EWS|NURSING
  // P1 측정 자동 미러링 — 원천 추적(멱등 dedupe) + 급성/만성 맥락 분리
  sourceId    String?  @map("source_id") @db.VarChar(80) // 원천 식별(예: LAB:<labResultItemId>) — 미러 멱등
  context     String   @default("CHRONIC") @db.VarChar(10) // CHRONIC|ACUTE (입원 급성 모니터링은 ACUTE)
  normalMin   Decimal? @map("normal_min") @db.Decimal(8, 2)
  normalMax   Decimal? @map("normal_max") @db.Decimal(8, 2)
  flag        String?  @db.VarChar(2) // N|H|L
  encounterId String?  @map("encounter_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([source, sourceId]) // 미러 멱등(동일 원천 1건). sourceId NULL(수기)은 Postgres 다중 NULL 허용
  @@index([patientId, code, measuredAt])
  @@index([patientId, code, context, measuredAt])
  @@map("chronic_observations")
}

model LabResultAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  labResultId String   @map("lab_result_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(300)
  fileUrl     String   @map("file_url") @db.VarChar(500)
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type") @db.VarChar(100)
  type        String   @db.VarChar(30) // INSTRUMENT_REPORT, EXTERNAL_REPORT, QUALITY_CERT, OTHER
  description String?  @db.Text
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  labResult LabResult @relation(fields: [labResultId], references: [id])
  uploader  User      @relation("LabAttachmentUploader", fields: [uploadedBy], references: [id])

  @@map("lab_result_attachments")
}

model LabInstrument {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  manufacturer    String?   @db.VarChar(200)
  model           String?   @db.VarChar(100)
  serialNumber    String?   @map("serial_number") @db.VarChar(100)
  category        String    @db.VarChar(50) // HEMATOLOGY, CHEMISTRY, IMMUNOLOGY, URINALYSIS, COAGULATION, BLOOD_GAS, SPECIAL
  interfaceType   String    @map("interface_type") @db.VarChar(30) // HL7, FILE_WATCH, PDF_UPLOAD, API, MANUAL
  interfaceConfig Json?     @map("interface_config") @db.JsonB
  location        String?   @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  interfaceResults LabInterfaceResult[]
  worksheets       LabWorksheet[]
  qcRecords        LabQcRecord[]

  @@unique([interfaceType, serialNumber]) // FHIR 가상계측기(serialNumber=FHIR:{clientId}) 중복 생성 경합 방지
  @@map("lab_instruments")
}

model LabInterfaceResult {
  id                 String    @id @default(uuid()) @db.Uuid
  instrumentId       String    @map("instrument_id") @db.Uuid
  rawData            Json      @map("raw_data") @db.JsonB
  parsedItems        Json?     @map("parsed_items") @db.JsonB
  sampleBarcode      String?   @map("sample_barcode") @db.VarChar(50)
  matchedOrderId     String?   @map("matched_order_id") @db.Uuid
  matchedLabResultId String?   @map("matched_lab_result_id") @db.Uuid
  fileName           String?   @map("file_name") @db.VarChar(300)
  status             String    @default("RECEIVED") @db.VarChar(20) // RECEIVED, MATCHED, APPLIED, REJECTED, ERROR
  errorMessage       String?   @map("error_message") @db.Text
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  appliedAt          DateTime? @map("applied_at") @db.Timestamptz()

  instrument LabInstrument @relation(fields: [instrumentId], references: [id])

  @@index([sampleBarcode])
  @@index([status])
  @@map("lab_interface_results")
}

model LabWorksheet {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(200)
  instrumentId String?   @map("instrument_id") @db.Uuid
  category     String    @db.VarChar(50)
