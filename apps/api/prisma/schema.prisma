  sourceTable   String    @map("source_table") @db.VarChar(30)
  sourceId      String    @map("source_id") @db.Uuid
  sourceCode    String    @map("source_code") @db.VarChar(20)
  targetSystem  String    @map("target_system") @db.VarChar(20)
