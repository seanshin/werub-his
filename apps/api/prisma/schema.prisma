  channel    String   @db.VarChar(20) // SMS, PUSH, PORTAL, EMAIL, CALL, VISIT
  direction  String   @db.VarChar(10) // OUTBOUND, INBOUND
  type       String   @db.VarChar(30) // REMINDER, RECALL, CAMPAIGN, MANUAL, SYSTEM
  subject    String?  @db.VarChar(200)
  content    String?  @db.Text
  status     String   @db.VarChar(20) // SENT, DELIVERED, READ, FAILED
  campaignId String?  @map("campaign_id") @db.Uuid
  sentBy     String?  @map("sent_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@index([campaignId])
  @@map("patient_communication_logs")
}

model PatientConsentCrm {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  channel     String    @db.VarChar(20) // SMS, PUSH, PORTAL, EMAIL, ALL
  type        String    @db.VarChar(30) // MARKETING, REMINDER, SURVEY, ANNOUNCEMENT
  consented   Boolean
  consentedAt DateTime? @map("consented_at") @db.Timestamptz()
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz()
  source      String?   @db.VarChar(30) // PORTAL, APP, RECEPTION, PHONE
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, channel, type])
  @@map("patient_consents_crm")
}

model CrmForeignPatientCase {
  id         String @id @default(uuid()) @db.Uuid
  patientId  String @map("patient_id") @db.Uuid
  assignedTo String @map("assigned_to") @db.Uuid

  source     String  @db.VarChar(30) // WEBSITE, AGENCY, REFERRAL, EMBASSY, SNS
  agencyName String? @map("agency_name") @db.VarChar(200)

  arrivalDate     DateTime? @map("arrival_date") @db.Date
  departureDate   DateTime? @map("departure_date") @db.Date
  accommodation   String?   @db.VarChar(200)
  interpreterLang String?   @map("interpreter_lang") @db.VarChar(10) // en, zh, ja, vi, ru

  packageType   String?  @map("package_type") @db.VarChar(30) // CHECKUP_BASIC, CHECKUP_PREMIUM, TREATMENT, SURGERY
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 0)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(12, 0)

  status            String  @default("INQUIRY") @db.VarChar(20) // INQUIRY, QUOTED, CONFIRMED, ARRIVED, IN_TREATMENT, DISCHARGED, FOLLOW_UP, CLOSED
  satisfactionScore Int?    @map("satisfaction_score")
  note              String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient  Patient @relation(fields: [patientId], references: [id])
  assignee User    @relation("CrmForeignCaseAssignee", fields: [assignedTo], references: [id])

  @@index([patientId])
  @@index([assignedTo, status])
  @@map("crm_foreign_patient_cases")
}

model CrmPortalBanner {
  id       String  @id @default(uuid()) @db.Uuid
  type     String  @db.VarChar(20) // MAIN_BANNER, POPUP, INLINE, PUSH_BANNER
  title    String  @db.VarChar(200)
  content  String? @db.Text
  imageUrl String? @map("image_url") @db.VarChar(500)
  linkUrl  String? @map("link_url") @db.VarChar(500)
  linkType String? @map("link_type") @db.VarChar(20) // INTERNAL, EXTERNAL, CHECKUP_RESERVE, SURVEY

  segmentId String? @map("segment_id") @db.Uuid
  targetAll Boolean @default(true) @map("target_all")

  publishFrom  DateTime @map("publish_from") @db.Timestamptz()
  publishUntil DateTime @map("publish_until") @db.Timestamptz()

  showOncePerDay Boolean @default(false) @map("show_once_per_day")
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  impressionCount Int @default(0) @map("impression_count")
  clickCount      Int @default(0) @map("click_count")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  creator User @relation("CrmBannerCreator", fields: [createdBy], references: [id])

  @@index([type, isActive, publishFrom, publishUntil])
  @@map("crm_portal_banners")
}

// ============================================================
// 초진 동의서 (Registration Consent)
// ============================================================

model RegistrationConsent {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  type      String  @db.VarChar(30) // PRIVACY, SENSITIVE, UNIQUE_ID, THIRD_PARTY, TREATMENT, HIE, MARKETING, RESEARCH, EMR_VIEW, TELEHEALTH
  version   String  @default("1.0") @db.VarChar(10)
  agreed    Boolean

  // 서명
  signedAt      DateTime? @map("signed_at") @db.Timestamptz()
  signedBy      String?   @map("signed_by") @db.VarChar(100)
  signatureData String?   @map("signature_data") @db.Text // Base64 서명 이미지
  signMethod    String?   @map("sign_method") @db.VarChar(20) // PAPER, PORTAL, MOBILE, TABLET, HIS(직원 입력 — 환자 서명 증빙 없음)
  /// (2026-10-02) 이 동의가 어떤 증빙에서 왔는가 — 태블릿·휴대폰 서명 묶음 또는 종이 스캔본이 붙은 ConsentForm(REGISTRATION). null = 증빙 연결 없음
  evidenceConsentFormId String? @map("evidence_consent_form_id") @db.Uuid

  // 법정대리인 (미성년자/피후견인)
  guardianName     String? @map("guardian_name") @db.VarChar(100)
  guardianRelation String? @map("guardian_relation") @db.VarChar(20) // PARENT, SPOUSE, CHILD, LEGAL_GUARDIAN

  // 철회
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz()
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)

  // 갱신
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  renewedFromId String?   @map("renewed_from_id") @db.Uuid

  // 추적
  collectedBy String?  @map("collected_by") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, type, version])
  @@index([patientId, type])
  @@map("registration_consents")
}

// ════════════════════════════════════════════════════════════
// 비대면 진료 (Remote Consultation)
// ════════════════════════════════════════════════════════════

model RemoteConsultation {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId  String @map("doctor_id") @db.Uuid

  // 진료 유형
  channel  String @default("TEXT") @db.VarChar(20) // TEXT, VIDEO, RESULT_REVIEW, HYBRID
  category String @default("GENERAL") @db.VarChar(30) // SYMPTOM, MEDICATION, LAB_RESULT, POST_DISCHARGE, FOLLOW_UP, GENERAL
  status   String @default("REQUESTED") @db.VarChar(20) // REQUESTED, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED, REFUNDED
  priority String @default("NORMAL") @db.VarChar(10) // LOW, NORMAL, HIGH, URGENT

  // 환자 요청
  subject         String  @db.VarChar(200)
  chiefComplaint  String? @map("chief_complaint") @db.Text
  symptomDuration String? @map("symptom_duration") @db.VarChar(50)
  attachments     Json?   @db.JsonB

  // 관련 진료 데이터
  priorLabResultId String? @map("prior_lab_result_id") @db.Uuid
  priorImagingId   String? @map("prior_imaging_id") @db.Uuid
  encounterId      String? @map("encounter_id") @db.Uuid

  // 화상 세션 (Jitsi 연동)
  videoRoomId      String?   @map("video_room_id") @db.VarChar(100)
  videoScheduledAt DateTime? @map("video_scheduled_at") @db.Timestamptz()
  videoStartedAt   DateTime? @map("video_started_at") @db.Timestamptz()
  videoEndedAt     DateTime? @map("video_ended_at") @db.Timestamptz()
  videoDurationMin Int?      @map("video_duration_min")
  recordingUrl     String?   @map("recording_url") @db.VarChar(500)
  recordingConsent Boolean   @default(false) @map("recording_consent")
  // 화상 전환 요청 (텍스트 → 화상)
  videoRequestedBy String?   @map("video_requested_by") @db.VarChar(10) // PATIENT, DOCTOR
  videoRequestedAt DateTime? @map("video_requested_at") @db.Timestamptz()

  // 의사 소견
  doctorAssessment String? @map("doctor_assessment") @db.Text
  doctorPlan       String? @map("doctor_plan") @db.Text
  referralNeeded   Boolean @default(false) @map("referral_needed")
  referralReason   String? @map("referral_reason") @db.VarChar(200)

  // 수납
  consultationType String? @map("consultation_type") @db.VarChar(30) // BASIC, LAB_INTERPRET, PHOTO_CONSULT, POST_DISCHARGE, VIDEO_15, VIDEO_30
  feeAmount        Int?    @map("fee_amount")
  billingStatus    String? @map("billing_status") @db.VarChar(20) // PENDING, CONFIRMED, PAID, REFUNDED, WAIVED
  billingId        String? @map("billing_id") @db.Uuid
  paymentMethod    String? @map("payment_method") @db.VarChar(20) // CARD, KAKAOPAY, DEFERRED
  isFreeConsult    Boolean @default(false) @map("is_free_consult")

  // 환자 평가
  patientRating   Int?    @map("patient_rating")
  patientFeedback String? @map("patient_feedback") @db.Text

  // 통계
  messageCount    Int       @default(0) @map("message_count")
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz()
  doctorReadAt    DateTime? @map("doctor_read_at") @db.Timestamptz()
  doctorRepliedAt DateTime? @map("doctor_replied_at") @db.Timestamptz()

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  patient  Patient               @relation("RemoteConsultPatient", fields: [patientId], references: [id])
  doctor   User                  @relation("RemoteConsultDoctor", fields: [doctorId], references: [id])
  messages ConsultationMessage[]

  @@index([patientId, status])
  @@index([doctorId, status, createdAt])
  @@map("remote_consultations")
}

model ConsultationMessage {
  id             String  @id @default(uuid()) @db.Uuid
  consultationId String  @map("consultation_id") @db.Uuid
  sender         String  @db.VarChar(10) // PATIENT, DOCTOR, SYSTEM
  senderId       String? @map("sender_id") @db.Uuid
  content        String  @db.Text
  attachments    Json?   @db.JsonB

  // 의료 콘텐츠 공유
  sharedLabResultId    String? @map("shared_lab_result_id") @db.Uuid
  sharedImagingId      String? @map("shared_imaging_id") @db.Uuid
  sharedPrescriptionId String? @map("shared_prescription_id") @db.Uuid

  // 의료 태그
  isMedicalAdvice Boolean @default(false) @map("is_medical_advice")

  // 읽음 확인
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  consultation RemoteConsultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId, createdAt])
  @@map("consultation_messages")
}

// ============================================================
// 신규입사 온보딩 + 직원 행정 셀프서비스(ESS)
// staff-onboarding-ess.design.md (v1.6) — 신규 10모델
// 인사 SoT는 기존 Staff/StaffCredential/StaffEducation/hr 모듈 재사용,
// 아래는 온보딩 고유 흐름 + 근태/휴가/증명서/QR.
// ============================================================

model OnboardingInvite {
  id                  String    @id @default(uuid()) @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64) // 원문 비저장
  candidateFamilyName String    @map("candidate_family_name") @db.VarChar(50)
  candidateGivenName  String    @map("candidate_given_name") @db.VarChar(50)
  email               String?   @db.VarChar(120) // 이메일 발송 채널(소유 요소). 없으면 placeholder
  phone               String?   @db.VarChar(20) // 연락처(표시용 — SMS OTP 미사용)
  birthDate           DateTime? @map("birth_date") @db.Timestamptz() // 진입 지식 게이트(생년월일 대조)
  jobCategory         String    @map("job_category") @db.VarChar(30)
  department          String?   @db.VarChar(40)
  hireDate            DateTime  @map("hire_date") @db.Timestamptz()
  contractType        String    @map("contract_type") @db.VarChar(20) // FULL_TIME|CONTRACT|COMMISSIONED|PART_TIME
  status              String    @default("INVITED") @db.VarChar(20) // INVITED|VERIFIED|DOC_SUBMITTED|CONTRACT_SIGNED|APPROVED|BOOTED|EXPIRED|REVOKED
  provisionalUserId   String?   @map("provisional_user_id") @db.Uuid // PRE_BOARD 임시계정
  welcomeViewedAt     DateTime? @map("welcome_viewed_at") @db.Timestamptz() // 환영/필수숙지 확인
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz()
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz() // = 생체등록 완료 시점
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz()
  createdById         String    @map("created_by_id") @db.Uuid
  bootedUserId        String?   @map("booted_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  sends     OnboardingSend[]
  documents OnboardingDocument[]
  profile   OnboardingProfile?
  contract  OnboardingContract?

  @@index([status])
  @@index([hireDate])
  @@map("onboarding_invites")
}

model OnboardingSend {
  id       String   @id @default(uuid()) @db.Uuid
  inviteId String   @map("invite_id") @db.Uuid
  channel  String   @db.VarChar(10) // EMAIL | QR_IMAGE | LINK
  sentById String   @map("sent_by_id") @db.Uuid
  meta     Json?
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz()

  invite OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@map("onboarding_sends")
}

model OnboardingDocument {
  id           String   @id @default(uuid()) @db.Uuid
  inviteId     String   @map("invite_id") @db.Uuid
  category     String   @db.VarChar(20) // ID_CARD|BANKBOOK|LICENSE|CAREER|PLEDGE|HEALTH|PHOTO|ETC
  fileKey      String   @map("file_key") @db.VarChar(300) // 암호화 저장 키
  sensitive    Boolean  @default(false)
  status       String   @default("PENDING") @db.VarChar(12) // PENDING|APPROVED|REJECTED
  reviewerId   String?  @map("reviewer_id") @db.Uuid
  rejectReason String?  @map("reject_reason") @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  invite OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId, status])
  @@map("onboarding_documents")
}

model OnboardingProfile {
  id               String    @id @default(uuid()) @db.Uuid
  inviteId         String    @unique @map("invite_id") @db.Uuid
  // 민감 intake 전용 (성명·부서·직급·면허는 Staff/StaffCredential로 이관)
  // 주민번호·급여계좌는 HIS가 구조화 수집 안 함 — 서류(ID_CARD/BANKBOOK)로만 받고 ERP가 서류 보고 입력(§9.5.1 req4)
  gender           String?   @db.VarChar(10) // M|F|OTHER
  nationality      String?   @default("KR") @db.VarChar(40)
  photoKey         String?   @map("photo_key") @db.VarChar(300)
  zipCode          String?   @map("zip_code") @db.VarChar(10)
  addr1            String?   @db.VarChar(200)
  addr2            String?   @db.VarChar(200)
  emgName          String?   @map("emg_name") @db.VarChar(50)
  emgRelation      String?   @map("emg_relation") @db.VarChar(30)
  emgPhone         String?   @map("emg_phone") @db.VarChar(20)
  education        Json? // [{level,school,major,gradYm}]
  career           Json? // [{org,from,to,position}]
  licenses         Json? // [{type,number,issuedAt,issuer}] → 활성화 시 StaffCredential 생성
  military         String?   @db.VarChar(20) // DONE|EXEMPT|NA|UNFINISHED
  dependents       Json?
  sensitiveConsent Boolean   @default(false) @map("sensitive_consent")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  invite OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

model OnboardingContract {
  id                String    @id @default(uuid()) @db.Uuid
  inviteId          String    @unique @map("invite_id") @db.Uuid
  templateId        String    @map("template_id") @db.Uuid // → ConsentTemplate 재사용
  pdfKey            String?   @map("pdf_key") @db.VarChar(300)
  signedAt          DateTime? @map("signed_at") @db.Timestamptz()
  signerHash        String?   @map("signer_hash") @db.VarChar(128)
  signatureImageKey String?   @map("signature_image_key") @db.VarChar(300)
  blockchainTxId    String?   @map("blockchain_tx_id") @db.VarChar(120)

  invite OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@map("onboarding_contracts")
}

model QrSession {
  id           String    @id @default(uuid()) @db.Uuid
  purpose      String    @db.VarChar(16) // LOGIN|CLOCK|ONBOARDING|ATTEND|RECEIPT
  token        String    @unique @db.VarChar(64) // 단기 회전 토큰
  refType      String?   @map("ref_type") @db.VarChar(30)
  refId        String?   @map("ref_id") @db.VarChar(64)
  status       String    @default("OPEN") @db.VarChar(12) // OPEN|SCANNED|CONSUMED|EXPIRED|CANCELLED
  createdById  String?   @map("created_by_id") @db.Uuid
  consumedById String?   @map("consumed_by_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([token])
  @@index([purpose, status])
  @@map("qr_sessions")
}

model AttendanceRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  clinicUserId String?   @map("clinic_user_id") @db.VarChar(100) // 근태 신원(Clinic) — §9.6.1 C-4
  type         String    @db.VarChar(10) // CLOCK_IN | CLOCK_OUT
  method       String    @db.VarChar(10) // QR | BIO | MANUAL | PIN | AUTO (단말보안 §2.4·5.3)
  deviceId     String?   @map("device_id") @db.Uuid
  lat          Float?
  lng          Float?
  correctionOf String?   @map("correction_of") @db.Uuid
  provisional  Boolean   @default(false) // 추정 퇴근(미퇴근 자동마감, 급여 확정 전 보정 대기, §5.3.2)
  autoClosedAt DateTime? @map("auto_closed_at") @db.Timestamptz() // Cron 자동마감 시각
  at           DateTime  @default(now()) @db.Timestamptz()

  @@index([userId, at])
  @@map("attendance_records")
}

model LeaveRequest {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @db.VarChar(12) // ANNUAL|SICK|HALF|OUTING|CORRECTION
  fromDate        DateTime  @map("from_date") @db.Timestamptz()
  toDate          DateTime  @map("to_date") @db.Timestamptz()
  days            Float
  reason          String?   @db.VarChar(300)
  status          String    @default("REQUESTED") @db.VarChar(12) // REQUESTED|APPROVED|REJECTED|WITHDRAWN
  approverId      String?   @map("approver_id") @db.Uuid
  attachmentDocId String?   @map("attachment_doc_id") @db.Uuid // 증빙(StaffDocument — 병가/경조, P2-1)
  eApprovalRef    String?   @map("eapproval_ref") @db.VarChar(80) // EApprovalRelay.refId 연계
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  year    Int
  type    String @db.VarChar(12)
  granted Float
  used    Float  @default(0)

  @@unique([userId, year, type])
  @@map("leave_balances")
}

model EmploymentCertificate {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(12) // EMPLOYMENT | CAREER
  pdfKey     String   @map("pdf_key") @db.VarChar(300)
  verifyCode String   @unique @map("verify_code") @db.VarChar(40) // QR 진위확인
  revoked    Boolean  @default(false)
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz()

  @@index([userId])
  @@map("employment_certificates")
}

// ══════════════════════════════════════════
// 건강검진권(블록체인) — checkup-voucher-blockchain P1 코어
// 설계: docs/02-design/features/checkup-voucher-blockchain.design.md
// 외부참조(programId/visitId/boundPatientId/actorId)는 UUID 컬럼+인덱스(기존 컨벤션·기존모델 미변경)
// ══════════════════════════════════════════

model VoucherPolicy {
  id                        String   @id @default(uuid()) @db.Uuid
  version                   Int
  active                    Boolean  @default(false)
  enabledForms              String[] @map("enabled_forms") // ["PROGRAM","AMOUNT"]
  serialPrefix              String   @default("WGC") @map("serial_prefix")
  validityMonths            Int      @map("validity_months") // 법정 하한 클램프
  refundWindowMonths        Int      @map("refund_window_months")
  balanceRefundRate         Int      @map("balance_refund_rate") // 잔액 환불 비율(%)
  maxCommissionRate         Int      @map("max_commission_rate") // 해외 딜러 수수료율 상한(%)
  domesticMaxCommissionRate Int      @default(15) @map("domestic_max_commission_rate") // 국내 유치업자 수수료율 상한(%) — 더 엄격
  maxHierarchyDepth         Int      @default(2) @map("max_hierarchy_depth")
  prepaymentRequired        Boolean  @default(true) @map("prepayment_required")
  foreignerOnly             Boolean  @default(true) @map("foreigner_only")
  allowedCategories         String[] @map("allowed_categories") // 비급여 프로그램 category 허용
  anchorChainType           String   @default("INTERNAL") @map("anchor_chain_type")
  anchorIntervalMin         Int      @default(60) @map("anchor_interval_min")
  diffPolicy                String   @default("RESIDUAL_VOUCHER") @map("diff_policy") // 금액권 차액: RESIDUAL_VOUCHER|REFUND_DIFF|FORFEIT
  approvedBy                String?  @map("approved_by") @db.Uuid // 4-eyes 승인자(updatedBy와 분리)
  updatedBy                 String?  @map("updated_by") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([version])
  @@index([active])
  @@map("voucher_policies")
}

model VoucherBatch {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  form           String // PROGRAM | AMOUNT
  programId      String?  @map("program_id") @db.Uuid
  faceValue      Int      @map("face_value")
  quantity       Int
  supplyPrice    Int      @map("supply_price")
  policyVersion  Int      @map("policy_version")
  serialRule     Json     @map("serial_rule") @db.JsonB
  merkleRoot     String?  @map("merkle_root") @db.VarChar(64)
  anchorId       String?  @map("anchor_id") @db.Uuid
  status         String   @default("DRAFT") // DRAFT | ISSUED | CLOSED
  issuedBy       String   @map("issued_by") @db.Uuid
  approvedBy     String?  @map("approved_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  vouchers CheckupVoucher[]

  @@index([status])
  @@index([programId])
  @@map("voucher_batches")
}

model CheckupVoucher {
  id                    String    @id @default(uuid()) @db.Uuid
  serial                String    @unique @db.VarChar(40)
  batchId               String    @map("batch_id") @db.Uuid
  form                  String // PROGRAM | AMOUNT
  programId             String?   @map("program_id") @db.Uuid
  faceValue             Int       @map("face_value")
  balance               Int // PROGRAM형=faceValue(소진 0), AMOUNT형=가변
  status                String    @default("ISSUED") // ISSUED|ALLOCATED|SOLD|ACTIVE|REDEEMED|REVOKED|REFUNDED|EXPIRED
  currentOwnerType      String    @default("HOSPITAL") @map("current_owner_type") // HOSPITAL|DISTRIBUTOR|PATIENT
  currentOwnerId        String?   @map("current_owner_id") @db.Uuid
  activationHash        String    @map("activation_hash") @db.VarChar(64) // 활성화코드 해시(검증용)
  activationCodeEnc     String?   @map("activation_code_enc") // 활성화코드 봉투암호화(AES-256-GCM)·딜러 전달용·활성화 후 소각(G1)
  activationFailCount   Int       @default(0) @map("activation_fail_count") // 활성화 무차별대입 실패 카운트(M-2)
  activationLockedUntil DateTime? @map("activation_locked_until") @db.Timestamptz() // 과다 실패 시 일시 잠금
  dealerConfirmedAt     DateTime? @map("dealer_confirmed_at") @db.Timestamptz() // 딜러 수령확인(활성화코드 입력) — null이면 판매 불가(채널분리 승인 게이트)
  boundPatientId        String?   @map("bound_patient_id") @db.Uuid
  genesisHash           String    @map("genesis_hash") @db.VarChar(64)
  headHash              String    @map("head_hash") @db.VarChar(64)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz()
  chainVerifiedAt       DateTime? @map("chain_verified_at") @db.Timestamptz() // 마지막 체인 검증 시각(미검증=null 우선 순회)
  chainValid            Boolean?  @map("chain_valid") // 마지막 검증 결과(false=무결성 위반·사람 조사 대상)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  batch       VoucherBatch        @relation(fields: [batchId], references: [id])
  events      VoucherEvent[]
  redemptions VoucherRedemption[]

  @@index([batchId])
  @@index([status])
  @@index([currentOwnerType, currentOwnerId])
  @@index([expiresAt])
  @@index([boundPatientId])
  @@index([chainVerifiedAt])
  @@map("checkup_vouchers")
}

model VoucherEvent {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @map("voucher_id") @db.Uuid
  serial         String    @db.VarChar(40)
  type           String // ISSUE|ALLOCATE|TRANSFER|ACTIVATE|REDEEM|REVOKE|REFUND|EXPIRE|RESIDUAL
  prevHash       String    @map("prev_hash") @db.VarChar(64)
  hash           String    @db.VarChar(64)
  actorType      String    @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  payload        Json      @db.JsonB
  anchorId       String?   @map("anchor_id") @db.Uuid
  anchorStatus   String    @default("PENDING") @map("anchor_status") // PENDING|ANCHORED|FAILED
  anchorAttempts Int       @default(0) @map("anchor_attempts")
  anchoredAt     DateTime? @map("anchored_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  voucher CheckupVoucher @relation(fields: [voucherId], references: [id])

  @@unique([voucherId, prevHash]) // 같은 head에서 분기 차단(double-spend 체인방어)
  @@index([serial])
  @@index([hash])
  @@index([anchorStatus])
  @@map("voucher_events")
}

model VoucherRedemption {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @map("voucher_id") @db.Uuid
  visitId        String?   @map("visit_id") @db.Uuid // 검진 방문(검진센터 경로) — billingId와 XOR
  billingId      String?   @map("billing_id") @db.Uuid // 수납 결제(원무 수납 경로·A1)
  amountUsed     Int       @map("amount_used")
  actualPrice    Int       @map("actual_price")
  diffBillingRef String?   @map("diff_billing_ref")
  idempotencyKey String    @unique @map("idempotency_key")
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz() // 마지막 역상환 시점 — A2
  reversedAmount Int       @default(0) @map("reversed_amount") // 누적 역상환액(부분환불 비례) — 완전역상환=amountUsed
  reversalReason String?   @map("reversal_reason") @db.VarChar(200)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  voucher CheckupVoucher @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@index([visitId])
  @@index([billingId])
  @@map("voucher_redemptions")
}

model BillingPayment {
  id                  String   @id @default(uuid()) @db.Uuid
  billingId           String   @map("billing_id") @db.Uuid
  method              String   @db.VarChar(20) // CARD|CASH|TRANSFER|DEPOSIT|VOUCHER
  amount              Int // 이 수단으로 결제한 금액(분할라인·복합결제 SoT)
  voucherSerial       String?  @map("voucher_serial") @db.VarChar(40)
  voucherRedemptionId String?  @map("voucher_redemption_id") @db.Uuid
  cardApprovalNo      String?  @map("card_approval_no") @db.VarChar(30)
  // 🔴 카드사·할부개월 — 수납 화면이 select 로 받아 보내고 있었는데 DTO/컬럼이 없어 전역 whitelist 가
  //    지웠다(200 + "수납이 완료되었습니다" + 값 소실). 카드 매출 정산 대사에 필요한 값이라
  //    승인번호만으로는 대사가 되지 않는다.
  cardCompany         String?  @map("card_company") @db.VarChar(30)
  installment         Int? // 0/1 = 일시불
  cashReceiptNo       String?  @map("cash_receipt_no") @db.VarChar(30)
  processedBy         String?  @map("processed_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  billing Billing @relation(fields: [billingId], references: [id])

  @@index([billingId])
  @@map("billing_payments")
}

// ══════════════════════════════════════════
// 건강검진권 P2 유통 — 해외 딜러·선결제 배분·재판매
// ══════════════════════════════════════════

model Distributor {
  id             String    @id @default(uuid()) @db.Uuid
  managementNo   String?   @unique @map("management_no") @db.VarChar(30) // 딜러 관리번호(WGD-YYYY-NNNN) — 사람 식별용
  name           String    @db.VarChar(200)
  parentId       String?   @map("parent_id") @db.Uuid // 계층(총판→대리점)
  tier           String // MASTER | AGENT
  dealerType     String    @default("OVERSEAS") @map("dealer_type") @db.VarChar(12) // DOMESTIC(국내 유치업자) | OVERSEAS(해외 딜러)
  country        String    @db.VarChar(2) // ISO 국가 (DOMESTIC=KR)
  currency       String    @db.VarChar(3) // ISO 통화 (DOMESTIC=KRW)
  licenseNumber  String?   @map("license_number") @db.VarChar(80) // 외국인환자 유치업 등록번호(L3) — DOMESTIC 필수
  contractRef    String?   @map("contract_ref") @db.VarChar(120) // 병원 제휴계약 참조 — OVERSEAS 필수(한국 유치업 등록 면제)
  taxId          String?   @map("tax_id") @db.VarChar(40) // 사업자번호(국내)/TIN(해외) — ERP 원천징수·세금계산서(B2)
  bankInfo       Json?     @map("bank_info") // 송금정보(국내 계좌 / 해외 SWIFT·IBAN) — ERP AP 지급
  licenseExpiry  DateTime? @map("license_expiry") @db.Date // 등록/계약 만료
  commissionRate Int       @map("commission_rate") // 비율 수수료(%) ≤ policy.maxCommissionRate
  status         String    @default("PENDING") // PENDING|ACTIVE|SUSPENDED|TERMINATED
  approvedBy     String?   @map("approved_by") @db.Uuid // 심사 4-eyes
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  accounts    DistributorAccount[]
  allocations VoucherAllocation[]  @relation("AllocTo")
  sales       VoucherSale[]

  @@index([parentId])
  @@index([status])
  @@index([licenseExpiry])
  @@map("voucher_distributors")
}

model DistributorAccount {
  id              String    @id @default(uuid()) @db.Uuid
  distributorId   String    @map("distributor_id") @db.Uuid
  email           String    @unique @db.VarChar(200)
  passwordHash    String    @map("password_hash")
  locale          String    @default("en") @db.VarChar(5)
  mfaEnabled      Boolean   @default(true) @map("mfa_enabled") // 자금 포털 — 기본 강제(W-2)
  mfaSecret       String?   @map("mfa_secret") @db.Text // TOTP 시크릿(field-encryption 봉투암호화). 미등록=null
  mfaEnrolledAt   DateTime? @map("mfa_enrolled_at") @db.Timestamptz() // 등록 완료 시각 — set이면 로그인 TOTP 강제
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz()
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  // 초기설정(이메일 인증코드로 비밀번호 등록) — emailVerifiedAt null이면 로그인 전 초기설정 필요
  setupCodeHash   String?   @map("setup_code_hash") @db.VarChar(120)
  setupCodeExpiry DateTime? @map("setup_code_expiry") @db.Timestamptz()
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id])

  @@index([distributorId])
  @@map("voucher_distributor_accounts")
}

model VoucherAllocation {
  id              String    @id @default(uuid()) @db.Uuid
  idempotencyKey  String    @unique @map("idempotency_key")
  fromType        String    @map("from_type") // HOSPITAL | DISTRIBUTOR
  fromId          String?   @map("from_id") @db.Uuid
  toDistributorId String    @map("to_distributor_id") @db.Uuid
  quantity        Int
  supplyPrice     Int       @map("supply_price") // 공급단가
  paymentRef      String?   @map("payment_ref") @db.VarChar(80)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz()
  status          String    @default("PENDING") // PENDING|PAID|FULFILLED|REVOKED
  // 활성화코드 이메일 발송(채널분리) 감사
  recipientEmail  String?   @map("recipient_email") @db.VarChar(200)
  emailedAt       DateTime? @map("emailed_at") @db.Timestamptz()
  deliveryChannel String?   @map("delivery_channel") @db.VarChar(20) // PENDING|SIMULATION|RESEND|FAILED|BLOCKED — 배달 성공은 RESEND 뿐(isVoucherEmailDelivered)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  toDistributor Distributor @relation("AllocTo", fields: [toDistributorId], references: [id])

  @@index([toDistributorId])
  @@index([status])
  @@map("voucher_allocations")
}

model VoucherSale {
  id               String   @id @default(uuid()) @db.Uuid
  idempotencyKey   String   @unique @map("idempotency_key")
  voucherId        String   @map("voucher_id") @db.Uuid
  distributorId    String   @map("distributor_id") @db.Uuid
  buyerType        String   @map("buyer_type") // PATIENT | DISTRIBUTOR
  buyerId          String?  @map("buyer_id") @db.Uuid
  buyerName        String?  @map("buyer_name") @db.VarChar(120) // 구매자(외국인환자) 이름
  buyerContact     String?  @map("buyer_contact") @db.VarChar(120) // 연락처/이메일
  salePrice        Int      @map("sale_price")
  commissionRate   Int      @map("commission_rate") // 적용 수수료율(스냅샷)
  commissionAmount Int      @map("commission_amount")
  currency         String   @db.VarChar(3)
  paymentRef       String?  @map("payment_ref") @db.VarChar(80)
  soldAt           DateTime @default(now()) @map("sold_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id])

  @@index([distributorId])
  @@index([voucherId])
  @@map("voucher_sales")
}

// ══════════════════════════════════════════
// 건강검진권 P3 정산 — 수수료 정산·환불·자금흐름(billing.line)
// ══════════════════════════════════════════

model VoucherSettlement {
  id                  String    @id @default(uuid()) @db.Uuid
  distributorId       String    @map("distributor_id") @db.Uuid
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime  @map("period_end") @db.Date
  grossSales          Int       @map("gross_sales")
  commissionTotal     Int       @map("commission_total")
  refundClawback      Int       @default(0) @map("refund_clawback")
  netPayable          Int       @map("net_payable") // gross - commission - clawback
  currency            String    @db.VarChar(3)
  fxRate              Float?    @map("fx_rate") // 정산통화→KRW 기준환율 스냅샷(DB-2)
  fxRateSource        String?   @map("fx_rate_source") @db.VarChar(12) // BOK | SIMULATION | BASE(KRW)
  status              String    @default("DRAFT") // DRAFT|CONFIRMED|PAID|PARTIAL
  billingRef          String?   @map("billing_ref") @db.VarChar(80)
  createdBy           String?   @map("created_by") @db.Uuid
  confirmedBy         String?   @map("confirmed_by") @db.Uuid // 4-eyes: 산출자≠확정자(H-2)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz()
  // 지급 회신(B3·DB-4 콜백) — ERP→HIS
  paidAt              DateTime? @map("paid_at") @db.Timestamptz()
  erpVoucherRef       String?   @map("erp_voucher_ref") @db.VarChar(120) // ERP 지급 전표 추적키
  amountPaidKrw       Int?      @map("amount_paid_krw") // 실 지급 원화
  withholdingKrw      Int?      @map("withholding_krw") // 원천징수액(DB-1 확정 후)
  paidCallbackEventId String?   @map("paid_callback_event_id") @db.VarChar(120) // 멱등(마지막 콜백 event_id)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([distributorId, status])
  @@map("voucher_settlements")
}

model VoucherRefund {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @map("voucher_id") @db.Uuid
  serial         String    @db.VarChar(40)
  reason         String    @db.VarChar(200)
  refundAmount   Int       @map("refund_amount") // 소비자 환급액
  clawbackAmount Int       @default(0) @map("clawback_amount") // 딜러 수수료 회수
  saleId         String?   @map("sale_id") @db.Uuid
  distributorId  String?   @map("distributor_id") @db.Uuid // claw-back 대상 딜러(미정산 이월 집계용·H-3)
  status         String    @default("DONE") // DONE
  refundedBy     String?   @map("refunded_by") @db.Uuid
  settledAt      DateTime? @map("settled_at") @db.Timestamptz() // claw-back이 정산에 반영된 시점(null=미정산)
  settlementId   String?   @map("settlement_id") @db.Uuid // 반영된 정산
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([voucherId])
  @@index([serial])
  @@index([distributorId, settledAt])
  @@map("voucher_refunds")
}

// ── 환자여정 프로토콜(오케스트레이션 레이어) — 상태기반 진행·게이트·역할 다음단계 ──
model ProtocolTemplate {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @db.VarChar(40)
  name        String             @db.VarChar(120)
  domain      String             @db.VarChar(16) // SURGERY|OPD|IPD|ER|CHECKUP
  version     Int                @default(1)
  status      String             @default("ACTIVE") @db.VarChar(12) // DRAFT|ACTIVE|RETIRED
  description String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt DateTime?          @map("published_at") @db.Timestamptz()
  publishedBy String?            @map("published_by") @db.Uuid
  steps       ProtocolStep[]
  instances   ProtocolInstance[]

  @@unique([code, version])
  @@index([code, status])
  @@map("protocol_templates")
}

model ProtocolStep {
  id          String           @id @default(uuid()) @db.Uuid
  templateId  String           @map("template_id") @db.Uuid
  key         String           @db.VarChar(40)
  title       String           @db.VarChar(120)
  sortOrder   Int              @map("sort_order")
  phase       String?          @db.VarChar(16)
  ownerRoles  String[]         @map("owner_roles")
  actionType  String           @default("CHECK") @map("action_type") @db.VarChar(12) // CHECK|ORDER|SIGN|MOVE|EDUCATE|VERIFY
  gate        Boolean          @default(false)
  gateRule    String?          @map("gate_rule") @db.VarChar(40) // 명명 술어: preop_ok|signin_ok|timeout_ok|signout_ok
  chartView   String?          @map("chart_view") @db.VarChar(20)
  slaMinutes  Int?             @map("sla_minutes")
  transitions Json? // [{toKey, condition?}]
  template    ProtocolTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
  @@map("protocol_steps")
}

model ProtocolInstance {
  id               String              @id @default(uuid()) @db.Uuid
  templateId       String              @map("template_id") @db.Uuid
  templateVersion  Int                 @map("template_version")
  patientId        String              @map("patient_id") @db.Uuid
  surgeryId        String?             @map("surgery_id") @db.Uuid
  encounterId      String?             @map("encounter_id") @db.Uuid
  admissionId      String?             @map("admission_id") @db.Uuid
  emergencyVisitId String?             @map("emergency_visit_id") @db.Uuid
  currentStepKey   String?             @map("current_step_key") @db.VarChar(40)
  status           String              @default("ACTIVE") @db.VarChar(12) // ACTIVE|BLOCKED|DONE|CANCELLED
  startedAt        DateTime            @default(now()) @map("started_at") @db.Timestamptz()
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz()
  template         ProtocolTemplate    @relation(fields: [templateId], references: [id])
  states           ProtocolStepState[]

  @@index([patientId])
  @@index([surgeryId])
  @@map("protocol_instances")
}

model ProtocolStepState {
  id            String           @id @default(uuid()) @db.Uuid
  instanceId    String           @map("instance_id") @db.Uuid
  stepKey       String           @map("step_key") @db.VarChar(40)
  status        String           @default("PENDING") @db.VarChar(12) // PENDING|IN_PROGRESS|DONE|BLOCKED|SKIPPED
  completedBy   String?          @map("completed_by") @db.Uuid
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz()
  blockedReason String?          @map("blocked_reason") @db.Text
  instance      ProtocolInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, stepKey])
  @@map("protocol_step_states")
}

// ═══════════════ 항암 프로토콜 사이클 엔진 (R4 · 2026-07 전체검토 B-2) ═══════════════

/// 항암 레지멘 정본 — day-based 약물 구성(전처치·수액·G-CSF 포함)
model ChemoRegimen {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(40) // FOLFOX6, AC, CHOP …
  name            String   @db.VarChar(200)
  cycleLengthDays Int      @default(21) @map("cycle_length_days")
  defaultCycles   Int      @default(6) @map("default_cycles")
  diagnosisHint   String?  @map("diagnosis_hint") @db.VarChar(200) // 적응 진단(KCD 프리픽스 등)
  emetogenicity   String?  @db.VarChar(10) // HIGH|MODERATE|LOW|MINIMAL
  status          String   @default("ACTIVE") @db.VarChar(10) // DRAFT|ACTIVE|RETIRED
  notes           String?  @db.VarChar(500)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  drugs   ChemoRegimenDrug[]
  courses ChemoCourse[]

  @@index([status])
  @@map("chemo_regimens")
}

model ChemoRegimenDrug {
  id               String   @id @default(uuid()) @db.Uuid
  regimenId        String   @map("regimen_id") @db.Uuid
  role             String   @default("CHEMO") @db.VarChar(12) // CHEMO|PREMED|HYDRATION|GCSF|SUPPORT
  drugName         String   @map("drug_name") @db.VarChar(200)
  medicationCodeId String?  @map("medication_code_id") @db.Uuid
  dosePerM2        Decimal? @map("dose_per_m2") @db.Decimal(8, 2) // mg/m² — null이면 fixedDose 사용
  fixedDose        Decimal? @map("fixed_dose") @db.Decimal(8, 2) // mg 고정용량
  capMg            Decimal? @map("cap_mg") @db.Decimal(8, 2)
  bandMg           Decimal? @map("band_mg") @db.Decimal(8, 2)
  dayOffsets       Json     @map("day_offsets") // [1] | [1,8] — 사이클 내 D-day(1-base)
  infusionNote     String?  @map("infusion_note") @db.VarChar(200) // 46h 지속주입 등
  sortOrder        Int      @default(0) @map("sort_order")

  regimen ChemoRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)

  @@index([regimenId])
  @@map("chemo_regimen_drugs")
}

/// 환자 항암 치료 코스 — BSA 스냅샷·감량률·치료일정 링크
model ChemoCourse {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  regimenId        String   @map("regimen_id") @db.Uuid
  encounterId      String?  @map("encounter_id") @db.Uuid
  registryId       String?  @map("registry_id") @db.Uuid // CancerRegistry — 완료 시 요약 기록
  status           String   @default("ACTIVE") @db.VarChar(12) // ACTIVE|COMPLETED|STOPPED
  plannedCycles    Int      @map("planned_cycles")
  heightCm         Decimal  @map("height_cm") @db.Decimal(5, 1) // 코스 시작 시점 스냅샷
  weightKg         Decimal  @map("weight_kg") @db.Decimal(5, 1)
  bsa              Decimal  @db.Decimal(4, 2)
  doseReductionPct Int      @default(0) @map("dose_reduction_pct") // 코스 기본 감량률(%)
  startDate        DateTime @map("start_date") @db.Date
  scheduleId       String?  @map("schedule_id") @db.Uuid // PatientTreatmentSchedule 캘린더 링크
  stopReason       String?  @map("stop_reason") @db.VarChar(300)
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient      @relation(fields: [patientId], references: [id])
  regimen ChemoRegimen @relation(fields: [regimenId], references: [id])
  cycles  ChemoCycle[]

  @@index([patientId, status])
  @@map("chemo_courses")
}

model ChemoCycle {
  id                 String    @id @default(uuid()) @db.Uuid
  courseId           String    @map("course_id") @db.Uuid
  cycleNumber        Int       @map("cycle_number")
  plannedDate        DateTime  @map("planned_date") @db.Date
  startedAt          DateTime? @map("started_at") @db.Timestamptz()
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  status             String    @default("PLANNED") @db.VarChar(12) // PLANNED|GATE_HOLD|IN_PROGRESS|COMPLETED|SKIPPED
  doseReductionPct   Int?      @map("dose_reduction_pct") // 사이클 오버라이드(없으면 코스값)
  delayDays          Int       @default(0) @map("delay_days")
  delayReason        String?   @map("delay_reason") @db.VarChar(300)
  gateResult         Json?     @map("gate_result") // {pass, mode, checks:[{name,loinc,value,unit,normalized,min,at}]}
  compoundingOrderId String?   @map("compounding_order_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  course ChemoCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, cycleNumber])
  @@index([status, plannedDate])
  @@map("chemo_cycles")
}

// ═══════════════ 근태 정정·초과근무 결재 (휴가·근태 기획 P1 · 2026-07-17) ═══════════════

/// 근태 정정 신청 — 원본(AttendanceRecord) 불변, 승인 시 correctionOf 신규 레코드
model AttendanceCorrectionRequest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  targetRecordId String?   @map("target_record_id") @db.Uuid // 정정 대상(누락 신청이면 null)
  workDate       DateTime  @map("work_date") @db.Date
  correctedType  String    @map("corrected_type") @db.VarChar(10) // CLOCK_IN | CLOCK_OUT
  correctedAt    DateTime  @map("corrected_at") @db.Timestamptz()
  reason         String    @db.VarChar(300) // 사유 필수(자동마감 소명 포함)
  status         String    @default("REQUESTED") @db.VarChar(12) // REQUESTED|APPROVED|REJECTED|WITHDRAWN
  eApprovalRef   String?   @map("e_approval_ref") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, status])
  @@map("attendance_correction_requests")
}

/// 초과근무 신청 — 승인분만 주간 근로시간 집계 반영
model OvertimeRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  otType       String    @map("ot_type") @db.VarChar(10) // EXTENDED(연장)|NIGHT(야간)|HOLIDAY(휴일)
  startAt      DateTime  @map("start_at") @db.Timestamptz()
  endAt        DateTime  @map("end_at") @db.Timestamptz()
  hours        Decimal   @db.Decimal(4, 1) // 서버 계산(0.5h 반올림)
  isPostFacto  Boolean   @default(false) @map("is_post_facto") // 사후 신청
  reason       String    @db.VarChar(300)
  status       String    @default("REQUESTED") @db.VarChar(12)
  eApprovalRef String?   @map("e_approval_ref") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, workDate])
  @@map("overtime_requests")
}

/// 결재 대결(위임) — 부서장 부재 시 지정 대리인이 수신함·결재 수행 (P2-4)
model ApprovalDelegation {
  id               String    @id @default(uuid()) @db.Uuid
  delegatorStaffId String    @map("delegator_staff_id") @db.Uuid // 위임자(원 결재자)
  delegateStaffId  String    @map("delegate_staff_id") @db.Uuid // 수임자
  fromDate         DateTime  @map("from_date") @db.Date
  toDate           DateTime  @map("to_date") @db.Date
  reason           String    @db.VarChar(300)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([delegateStaffId, fromDate, toDate])
  @@index([delegatorStaffId])
  @@map("approval_delegations")
}

// ── 데이터 품질 스냅샷(추이) — 숫자만 저장(개인정보 0)·일일 크론 06시(기획 data-quality-concierge §2.5+)
model QualityMetricSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  metricKey  String   @map("metric_key") @db.VarChar(60)
  value      Int
  total      Int?
  capturedOn DateTime @map("captured_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([metricKey, capturedOn])
  @@index([metricKey, capturedOn])
  @@map("quality_metric_snapshots")
}

// ============================================================
// VoC (고객의 소리) — 옴니채널 문의/불만/건의/칭찬 통합 (voc-service.plan.md)
// 실시간 대화는 ConsultSession 정본, VocTicket은 비동기 접수 + 상담세션 승격 참조
// ============================================================

model VocTicket {
  id               String  @id @default(uuid()) @db.Uuid
  ticketNo         String  @unique @map("ticket_no") @db.VarChar(20) // VOC-2026-000123
  type             String  @default("QUESTION") @db.VarChar(12) // QUESTION/COMPLAINT/SUGGESTION/COMPLIMENT
  status           String  @default("RECEIVED") @db.VarChar(12) // RECEIVED/TRIAGED/IN_PROGRESS/ANSWERED/ON_HOLD/CLOSED/REOPENED
  severity         String  @default("NORMAL") @db.VarChar(8) // LOW/NORMAL/HIGH/URGENT
  channel          String  @default("WEB") @db.VarChar(10) // WEB/PORTAL/PHONE/KIOSK/CONSULT
  consultSessionId String? @map("consult_session_id") @db.Uuid // 상담실 세션 승격 시 참조(중복저장 금지)

  // 신청자
  patientId        String? @map("patient_id") @db.Uuid
  identityVerified Boolean @default(false) @map("identity_verified")
  submitterName    String? @map("submitter_name") @db.VarChar(100)
  contactPhone     String? @map("contact_phone") @db.VarChar(30)
  contactEmail     String? @map("contact_email") @db.VarChar(120)
  replyChannel     String  @default("PORTAL") @db.VarChar(10) // PORTAL/EMAIL/SMS

  // 내용
  title      String  @db.VarChar(300)
  department String? @db.VarChar(60)
  category   String? @db.VarChar(40)

  // 배정·SLA
  assigneeId      String?   @map("assignee_id") @db.Uuid
  dueAt           DateTime? @map("due_at") @db.Timestamptz()
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz()
  closedAt        DateTime? @map("closed_at") @db.Timestamptz()
  reopenCount     Int       @default(0) @map("reopen_count")

  // 만족도·개선연계
  ratingScore  Int?    @map("rating_score")
  actionItemId String? @map("action_item_id") @db.Uuid

  consentAt DateTime? @map("consent_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  patient     Patient?        @relation(fields: [patientId], references: [id])
  messages    VocMessage[]
  attachments VocAttachment[]

  @@index([status, dueAt])
  @@index([patientId])
  @@index([type, createdAt])
  @@index([assigneeId])
  @@map("voc_tickets")
}

model VocMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorType String   @map("author_type") @db.VarChar(10) // PATIENT/STAFF/AI/SYSTEM
  authorId   String?  @map("author_id") @db.Uuid
  authorName String?  @map("author_name") @db.VarChar(100)
  body       String   @db.Text
  internal   Boolean  @default(false) // 내부 메모(환자 비노출)
  aiDraft    Boolean  @default(false) @map("ai_draft")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  ticket VocTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("voc_messages")
}

model VocAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  url        String   @db.VarChar(500) // 저장 경로(/uploads/voc/..)
  fileName   String   @map("file_name") @db.VarChar(255)
  uploadedBy String   @map("uploaded_by") @db.VarChar(10) // PATIENT/STAFF
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  ticket VocTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("voc_attachments")
}

// ============================================================
// Go-Live / Cutover 관제 — 운영 전환 항목 통합 레지스트리 (go-live-cutover-command.plan.md)
// A~D는 어댑터가 config/DB 직접조회로 status 파생(모듈 순환 회피), E~G는 수동 관리
// ============================================================

model GoLiveItem {
  id         String    @id @default(uuid()) @db.Uuid
  area       String    @db.VarChar(4) // A~G
  key        String    @unique @db.VarChar(60) // 'security.terminal2'
  title      String    @db.VarChar(300)
  type       String    @db.VarChar(12) // CONFIG_GATE/APPROVAL/EXTERNAL/MANUAL/HARDWARE
  owner      String?   @db.VarChar(60)
  status     String    @default("NOT_READY") @db.VarChar(12) // NOT_READY/IN_PROGRESS/READY/DONE/BLOCKED (수동항목만·자동은 파생)
  blocker    String?   @db.Text
  drillDown  String?   @db.VarChar(200)
  sourceKey  String?   @db.VarChar(80) // 어댑터 연동 키(config·gate·track)·null=수동
  targetMode String?   @db.VarChar(8) // A영역: 준비 판정 목표 모드
  isBlocking Boolean   @default(true) @map("is_blocking")
  targetDate DateTime? @map("target_date") @db.Date
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  approvals GoLiveApproval[]

  @@index([area, status])
  @@map("go_live_items")
}

model GoLiveApproval {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  action    String   @db.VarChar(12) // APPROVE/REVOKE/EXECUTE/ROLLBACK
  actorId   String   @map("actor_id") @db.Uuid
  actorName String   @map("actor_name") @db.VarChar(100)
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  item GoLiveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("go_live_approvals")
}

model GoLiveSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  capturedOn    DateTime @unique @map("captured_on") @db.Date // 일 1건
  readinessPct  Int      @map("readiness_pct")
  blockingReady Int      @map("blocking_ready")
  blockingTotal Int      @map("blocking_total")
  overdueCount  Int      @default(0) @map("overdue_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("go_live_snapshots")
}

// ── VoiceEMR (음성 구동 EMR) ─────────────────────────────
enum VoiceSessionStatus {
  ACTIVE
  CLOSED
  ABORTED
}

enum VoiceMode {
  READ
  DICTATE
  COMMAND
}

enum VoicePhraseType {
  ALIAS
  HABIT
  VOCAB
  MACRO
}

/// 음성 세션 — 진료 단위(발화 세션 X-Session-Id는 비영속·클라 UUID)
model VoiceCommandSession {
  id             String             @id @default(uuid()) @db.Uuid
  /// 진료 단위 세션 — 수술 단위 세션(surgeryId)이면 null(2026-10-05)
  encounterId    String?            @map("encounter_id") @db.Uuid
  /// 수술 단위 세션(수술방 차트 구술) — 수술팀만 연다
  surgeryId      String?            @map("surgery_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  doctorId       String             @map("doctor_id") @db.Uuid
  mode           VoiceMode          @default(READ)
  status         VoiceSessionStatus @default(ACTIVE)
  consentId      String?            @map("consent_id") @db.Uuid
  audioRetention String             @default("none") @map("audio_retention") @db.VarChar(16)
  startedAt      DateTime           @default(now()) @map("started_at") @db.Timestamptz()
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz()
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  logs           VoiceCommandLog[]

  @@index([encounterId])
  @@index([surgeryId])
  @@index([doctorId])
  @@map("voice_command_sessions")
}

/// 명령/입력 감사 — 명령 실행·오더 초안은 audit 대상
model VoiceCommandLog {
  id              String              @id @default(uuid()) @db.Uuid
  sessionId       String              @map("session_id") @db.Uuid
  session         VoiceCommandSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  utteranceSid    String?             @map("utterance_sid") @db.VarChar(64)
  transcript      String?             @db.Text
  intent          String?             @db.VarChar(24)
  sub             String?             @db.VarChar(24)
  slots           Json?
  nbest           Json?
  phraseId        String?             @map("phrase_id") @db.Uuid
  resultKind      String?             @map("result_kind") @db.VarChar(24)
  resultRef       String?             @map("result_ref") @db.VarChar(64)
  confirmedByUser Boolean             @default(false) @map("confirmed_by_user")
  droppedS        Float?              @map("dropped_s")
  confidence      Float?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sessionId])
  @@map("voice_command_logs")
}

/// 개인 설정
model VoiceUserProfile {
  userId                String    @id @map("user_id") @db.Uuid
  defaultMode           VoiceMode @default(READ) @map("default_mode")
  pttEnabled            Boolean   @default(true) @map("ptt_enabled")
  speakerGateEnabled    Boolean   @default(false) @map("speaker_gate_enabled")
  language              String    @default("ko") @db.VarChar(8)
  // ── 화자 음성 등록(생체인식·성문) ──
  // 생체정보=민감정보(개인정보보호법 §23) → 별도 동의 필수. 미동의=마이크 분리로 사용(fail-open).
  biometricConsentAt    DateTime? @map("biometric_consent_at") @db.Timestamptz()
  biometricConsentVer   String?   @map("biometric_consent_ver") @db.VarChar(16)
  voiceprintStatus      String    @default("none") @map("voiceprint_status") @db.VarChar(16) // none|pending|enrolled|revoked
  voiceprintSampleCount Int       @default(0) @map("voiceprint_sample_count")
  voiceprintRef         String?   @map("voiceprint_ref") @db.VarChar(128) // WeRU.B speaker id
  voiceprintEnrolledAt  DateTime? @map("voiceprint_enrolled_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("voice_user_profiles")
}

/// 개인 맞춤 문구(문구·습관·어휘·매크로)
model VoiceCustomPhrase {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  type      VoicePhraseType
  pattern   String          @db.VarChar(200)
  action    Json
  enabled   Boolean         @default(true)
  priority  Int             @default(100)
  hitCount  Int             @default(0) @map("hit_count")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([userId, type, pattern], map: "uq_voice_phrase")
  @@index([userId, type, enabled])
  @@map("voice_custom_phrases")
}

// ── 직원 노출 사고 · 약사 임상활동 (2026-08-18 · 이연 회수 T1) ──────────────────
//
// 🔴 관계 필드를 선언하지 않는다(ChronicObservation 선례) — Patient/User 모델에 역참조를 더하면
//    동시 작업이 서로를 덮어쓴다. FK 는 manual SQL 로 건다. 이름은 서비스에서 조회해 붙인다.

/// 직원 니들스틱·체액 노출 사고. 🔴 SafetyIncident(환자안전 정본) 재사용 금지 —
/// 재사용하면 환자안전 지표·경영 대시보드가 직원 사고로 오염된다(P12).
model StaffExposureIncident {
  id              String    @id @default(uuid()) @db.Uuid
  staffId         String    @map("staff_id") @db.Uuid
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz()
  exposureType    String    @map("exposure_type") @db.VarChar(30) // NEEDLESTICK|SHARPS|SPLASH_MUCOSA|SKIN_CONTACT|OTHER
  bodyPart        String?   @map("body_part") @db.VarChar(50)
  deviceType      String?   @map("device_type") @db.VarChar(60)
  place           String?   @db.VarChar(60)
  sourcePatientId String?   @map("source_patient_id") @db.Uuid
  /// 원환자 감염상태 — 모르면 null(음성으로 단정하지 않는다)
  sourceHbv       Boolean?  @map("source_hbv")
  sourceHcv       Boolean?  @map("source_hcv")
  sourceHiv       Boolean?  @map("source_hiv")
  ppeUsed         String?   @map("ppe_used") @db.VarChar(100)
  immediateAction String?   @map("immediate_action") @db.Text
  prophylaxis     String?   @db.Text // 예방조치(PEP 등)
  followUpStatus  String    @default("OPEN") @map("follow_up_status") @db.VarChar(20) // OPEN|IN_FOLLOW_UP|CLOSED
  followUpNotes   String?   @map("follow_up_notes") @db.Text
  reportedBy      String    @map("reported_by") @db.Uuid
  reportedAt      DateTime  @default(now()) @map("reported_at") @db.Timestamptz()
  closedAt        DateTime? @map("closed_at") @db.Timestamptz()

  @@index([staffId, occurredAt])
  @@index([followUpStatus])
  @@map("staff_exposure_incidents")
}

/// 약사 처방 중재(용량·상호작용·중복 등) — 종전 인메모리 배열(재시작마다 소실)
model PharmacistIntervention {
  id             String    @id @default(uuid()) @db.Uuid
  pharmacistId   String    @map("pharmacist_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  prescriptionId String?   @map("prescription_id") @db.Uuid
  drugText       String?   @map("drug_text") @db.VarChar(200) // 중재 대상 약물 표기(처방 삭제 후에도 남는 기록)
  type           String    @db.VarChar(20) // DOSE|INTERACTION|DUPLICATE|ROUTE|OTHER
  reason         String    @db.Text
  suggestion     String    @db.Text
  status         String    @default("PENDING") @db.VarChar(20) // PENDING|ACCEPTED|REJECTED
  doctorResponse String?   @map("doctor_response") @db.Text
  respondedBy    String?   @map("responded_by") @db.Uuid
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([patientId, createdAt])
  @@index([status])
  @@map("pharmacist_interventions")
}

/// 치료적 약물 농도 감시(TDM)
model TdmRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  drugName             String    @map("drug_name") @db.VarChar(120)
  indication           String?   @db.VarChar(200)
  targetRangeMin       Decimal?  @map("target_range_min") @db.Decimal(8, 2)
  targetRangeMax       Decimal?  @map("target_range_max") @db.Decimal(8, 2)
  targetUnit           String?   @map("target_unit") @db.VarChar(20)
  status               String    @default("REQUESTED") @db.VarChar(20) // REQUESTED|SAMPLED|RESULTED|REVIEWED
  /// 실측 농도 — 없으면 null(추정치를 넣지 않는다)
  resultLevel          Decimal?  @map("result_level") @db.Decimal(8, 2)
  resultInterpretation String?   @map("result_interpretation") @db.Text
  doseRecommendation   String?   @map("dose_recommendation") @db.Text
  requestedBy          String    @map("requested_by") @db.Uuid
  requestedAt          DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  sampledAt            DateTime? @map("sampled_at") @db.Timestamptz()
  resultedAt           DateTime? @map("resulted_at") @db.Timestamptz()
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz()

  @@index([patientId, requestedAt])
  @@index([status])
  @@map("tdm_requests")
}

// ══════════════════════════════════════════════════════════════════════════
// 상시 감시자 (HIS Sentinel) — 기획 his-sentinel-monitoring.plan.md
//
// 🔴 감시자는 **별도 프로세스**(pm2 `sentinel`)로 돈다. API 안에 있으면 대상이 죽을 때
//    함께 죽고, 전 테이블 조인 스윕이 1GB 상한 API 의 메모리를 밀면 그것이 곧 진료 중단이다.
// 🔴 감시자는 **임상 데이터를 고치지 않는다.** 읽고, 자기 원장에만 쓴다.
// ══════════════════════════════════════════════════════════════════════════

/// 스윕 1회 = 1행. 🔴 **감시자 자신의 생존과 부분 실패가 여기 남는다** —
/// 화면은 이 행이 없거나 오래됐으면 "0건"이 아니라 "미판정"을 그려야 한다.
model SentinelRun {
  id         String    @id @default(uuid()) @db.Uuid
  /// DATA | FLOW | CONTRACT | PIPE
  axis       String    @db.VarChar(16)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()
  /// 전 항목이 평가됐는가. 부분 실패면 false 이고 failed > 0 이다
  ok         Boolean   @default(false)
  /// 🔴 시도/성공/실패를 따로 센다 — 실패를 성공으로 세면 추이 전체를 못 믿는다
  attempted  Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  /// 실패 사유(있으면). 없음이 아니라 사유를 남긴다
  error      String?   @db.Text
  durationMs Int?      @map("duration_ms")

  @@index([axis, startedAt])
  @@map("sentinel_runs")
}

/// 실시간 축 — **값싼 지표의 1분 시계열**.
///
/// 🔴 딥 스윕(67불변식 전테이블 조인)은 1분마다 돌릴 수 없다. 그래서 층을 나눈다 —
///    인덱스를 타는 값싼 카운트만 1분마다 재서 여기 쌓고, 그 **자기 이력** 대비 급변을 본다.
///    (실측 2026-09-03: 후보 쿼리 전부 1~12ms)
/// 🔴 급변 판정에도 baseline 이 필요하다. 부족하면 판정하지 않고 "축적 중"이라 말한다 —
///    표본 없이 임계를 만들면 이 축이 거짓 경보 공장이 된다(축 B 에서 겪은 것과 같다).
model SentinelPulse {
  id     BigInt   @id @default(autoincrement())
  /// 'queue.active' 같은 지표 키(등록부 정본)
  metric String   @db.VarChar(60)
  value  Float
  at     DateTime @default(now()) @db.Timestamptz()

  @@index([metric, at])
  @@map("sentinel_pulses")
}

/// 요청 경로 안에서만 보이는 계약 어긋남 — **API 가 판단하지 않고 적기만** 한다.
///
/// 🔴 같은 드리프트는 **한 줄**로 접는다(로그 홍수가 아니라 줄어드는 목록).
///    규모는 `hitCount` 가 말한다 — 하루 수천 줄을 원장으로 옮기면 문제도 함께 옮겨간다.
/// 🔴 판정은 감시자가 한다. 여기 있는 것은 관측 사실뿐이다.
model SentinelRuntimeSignal {
  id          String   @id @default(uuid()) @db.Uuid
  /// KEY_MISSING(생산자에 그 키가 없다) | NULL_FOLDED(산출 불가를 0으로 접었다)
  kind        String   @db.VarChar(24)
  /// 값을 내는 쪽 — 'bed-board.getBoard'
  producer    String   @db.VarChar(120)
  /// 값을 읽는 쪽 — 'command-center.buildKpi'
  consumer    String   @db.VarChar(120)
  /// 읽은 키와 실제 키 목록 등, 사람이 바로 고칠 수 있는 만큼
  detail      String   @db.Text
  hitCount    Int      @default(1) @map("hit_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz()

  @@unique([kind, producer, consumer])
  @@index([lastSeenAt])
  @@map("sentinel_runtime_signals")
}

/// API 프로세스만 알 수 있는 것을 감시자에게 넘기는 자리.
///
/// 🔴 크론 객체는 API 메모리에 있어 별도 프로세스가 볼 수 없다. 그렇다고 감시자에게
///    관리자 토큰을 쥐여 주면 자격 관리 문제가 새로 생긴다 —
///    **API 가 판단하지 않고 원장에 적기만** 하고, 감시자가 그것을 읽는다(기획 §2.1).
/// 🔴 덤으로 **API 생존**이 관측 가능해진다: 이 행이 낡으면 API 가 멈춘 것이다.
model SentinelProbe {
  /// 'cron' | 'publicSite'
  key        String   @id @db.VarChar(40)
  payload    Json
  capturedAt DateTime @map("captured_at") @db.Timestamptz()

  @@map("sentinel_probes")
}

/// 발견 1건 = 1행(항목당 한 줄로 접는다 — 로그 홍수가 아니라 줄어드는 목록).
model SentinelFinding {
  id            String    @id @default(uuid()) @db.Uuid
  /// DATA | FLOW | CONTRACT | PIPE
  axis          String    @db.VarChar(16)
  /// 'integrity.09' 처럼 축 안에서 유일한 키
  checkKey      String    @map("check_key") @db.VarChar(80)
  /// RED | AMBER | INFO — 🔴 INFO 는 0 이 목표가 아닌 관측 항목이다(경보하지 않는다)
  severity      String    @db.VarChar(8)
  label         String    @db.Text
  /// 이번 스윕의 건수
  value         Int
  /// 직전 스윕의 건수(추이). null = 처음 본 항목
  prevValue     Int?      @map("prev_value")
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz()
  /// 0 이 된 시각. 행을 지우지 않는다 — 지우면 추이가 사라진다
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz()
  /// 어디서 고치는가. 🔴 모르면 null — 경로를 지어내지 않는다
  drillDown     String?   @map("drill_down") @db.VarChar(200)
  /// 🔴 **관측하지 못했다**(프로브 실패·경로 없음 등). true 면 value 를 믿지 않는다 —
  /// "위반 0건"과 "확인 못 함"은 다른 사실이고, 화면은 이 둘을 다르게 그린다.
  unobservable  Boolean   @default(false)
  /// 왜 이 값인지 한 줄(관측 불가면 그 사유)
  detail        String?   @db.Text
  /// 🔴 **신규 발생만 알린다.** 스윕이 이 행을 처음 만들었거나, 해결됐다가 재발했을 때만 true.
  ///    기존 항목을 매 스윕 다시 알리면 알림이 소음이 되고, 소음은 진짜 경보를 죽인다.
  notifyPending Boolean   @default(false) @map("notify_pending")
  /// 실제로 보낸 시각. null = 아직 안 보냄(설정이 꺼져 있거나 범위 밖)
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz()

  @@unique([axis, checkKey])
  @@index([axis, severity, resolvedAt])
  @@map("sentinel_findings")
}

/// 발견 항목에 대한 **사람 판정** 원장 — append-only(재판정은 새 행·최신이 화면 표시).
///
/// 🔴 판정은 발견을 없애지 않는다(기록 ≠ 적용). 스윕은 계속 세고, `resolvedAt` 은
///    스윕만 만든다. 판정은 그 숫자에 대한 해석(시드 아티팩트/실결함/보존)의 기록이다.
/// 🔴 `valueAtJudgment` 가 이 원장의 핵심이다 — 판정 이후 값이 늘면 화면은 이 판정을
///    "판정됨"으로 그리지 않고 "판정 이후 증가(재판정 필요)"로 되돌린다.
///    옛 판정이 새 위반을 조용히 덮으면 그것이 곧 거짓 안심이다.
/// 어휘 정본: packages/shared/src/sentinel-judgment.ts
model SentinelJudgment {
  id              String   @id @default(uuid()) @db.Uuid
  /// DATA | FLOW | CONTRACT | PIPE
  axis            String   @db.VarChar(16)
  checkKey        String   @map("check_key") @db.VarChar(80)
  /// SEED_ARTIFACT | FIXED_RESIDUAL | REAL_DEFECT | UNDETERMINED (shared 정본)
  verdict         String   @db.VarChar(20)
  /// 판정 시점의 발견 건수 — 서버가 발견 행에서 직접 스냅샷한다(클라이언트 값 불신)
  valueAtJudgment Int      @map("value_at_judgment")
  /// 🔴 근거 필수 — 근거 없는 판정은 받지 않는다(실측·문서 참조를 적는다)
  basis           String   @db.Text
  /// SCREEN(화면 기록) | DOC(기획서 판정 1·2차 이관 — judgedBy 없음)
  source          String   @default("SCREEN") @db.VarChar(10)
  /// DOC 이관분은 null — 판정자를 지어내지 않는다
  judgedBy        String?  @map("judged_by") @db.Uuid
  judgedAt        DateTime @default(now()) @map("judged_at") @db.Timestamptz()

  @@index([axis, checkKey, judgedAt])
  @@map("sentinel_judgments")
}

// ═══════════════════════════════════════════════════════════════════════════
// AI 판단 거버넌스 — 제안(review-pending)을 일급 개념으로
// 정본 기획서: docs/01-plan/features/ai-judgment-governance.plan.md §2.1·§2.2
//
// 🔴 여기 들어오는 것은 **제안이지 정본이 아니다.** 정본 반영은 각 도메인 정본 서비스가
//    하고(현행 A 유지), 이 테이블은 "AI 가 무엇을 냈고 사람이 무엇을 했는가"만 증명한다.
// 🔴 기존 정본 모델에는 아무 컬럼도 추가하지 않았다(관계 필드 없음 · uuid 컬럼만).
//    정본 쪽 `aiProposalId` 역참조는 사람 결정 `ai.draftProvenanceSchema` 뒤 P3 의 몫이다.
// ═══════════════════════════════════════════════════════════════════════════

/// 제안 상태기계. EXPIRED(결정 없이 시간 경과)와 REJECTED(사람이 안 쓰기로 함)는 **다른 사실**이다 —
/// 섞으면 거부율이 부풀려진다. 어휘 정본: packages/shared/src/ai-proposal.ts
enum AiProposalStatus {
  GENERATED
  PRESENTED
  ACCEPTED
  EDITED
  REJECTED
  EXPIRED
  SUPERSEDED
}

/// 출처 3상태(기존 `ai-verify.ts` 어휘와 같은 값) — UNAVAILABLE 을 빈 초안으로 바꾸지 않는다.
enum AiProposalSource {
  AI
  FALLBACK
  UNAVAILABLE
}

/// AI 제안 1건 — **불변**. 본문 수정은 update 가 아니라 SUPERSEDED + 새 버전이다
/// (선례: CheckupExplainerContent). 가드: test/architecture/ai-proposal-immutability.spec.ts
model AiProposal {
  id                String           @id @default(uuid()) @db.Uuid
  /// SOAP_DRAFT | NURSING_DRAFT | … — 값 정본은 shared `AI_PROPOSAL_KINDS`(DTO 가 @IsIn).
  /// enum 이 아닌 이유: 도메인 갈래가 붙을 때마다 스키마 마이그레이션을 강제하지 않으려는 것.
  kind              String           @db.VarChar(40)
  /// 정본 리소스 종류(Encounter·NursingNote·MdtCase …)
  targetType        String           @map("target_type") @db.VarChar(40)
  /// 정본 행 id. 🔴 UUID 가 아닌 정본(코드 키 등)이면 ZERO_UUID + targetKey — **추정하지 않는다**
  targetId          String           @map("target_id") @db.Uuid
  /// UUID 가 아닌 정본 키(ZERO_UUID 일 때만 의미 있음)
  targetKey         String?          @map("target_key") @db.VarChar(120)
  /// 환자 귀속(있으면). 관계 필드를 두지 않는다 — 정본 테이블을 건드리지 않기 위해서다
  patientId         String?          @map("patient_id") @db.Uuid
  /// 🔴 **상류가 돌려준 모델 태그만** 적는다. 요청한 태그와 다를 수 있고, 응답이 안 알려주면 null
  modelRef          String?          @map("model_ref") @db.VarChar(64)
  /// 릴리즈 레지스트리 참조(알면). 관계 없이 uuid 컬럼만 — 소비는 서비스가 조인한다
  modelReleaseId    String?          @map("model_release_id") @db.Uuid
  promptVersion     String?          @map("prompt_version") @db.VarChar(64)
  /// 제안 생성 시점 입력의 sha256 — 승인 시 재계산이 다르면 **경고하되 막지 않는다**
  inputSnapshotHash String?          @map("input_snapshot_hash") @db.VarChar(64)
  /// 본문 sha256(평문 기준) — 본문이 암호화돼 있어도 동일성 비교가 가능하게
  contentHash       String           @map("content_hash") @db.VarChar(64)
  /// 초안 본문(필드 암호화 · common/crypto/field-encryption.ts). 보존정책 대상
  contentEnc        String?          @map("content_enc") @db.Text
  /// 🔴 **모델이 자기보고한 값만.** 안 주면 null — 화면이 0.7 같은 값을 지어내지 않는다
  confidence        Decimal?         @db.Decimal(4, 3)
  source            AiProposalSource
  /// FALLBACK/UNAVAILABLE 사유(AUTH·TIMEOUT·VERIFY_FAILED …) — 모르면 null
  reasonCode        String?          @map("reason_code") @db.VarChar(40)
  status            AiProposalStatus @default(GENERATED)
  version           Int              @default(1)
  /// 이 제안이 대체한 이전 제안
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  /// 🔴 화면이 실제로 렌더한 시점에만 채운다. null = 사람이 본 적 없다(생성됨 ≠ 노출됨)
  presentedAt       DateTime?        @map("presented_at") @db.Timestamptz()
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz()
  decidedBy         String?          @map("decided_by") @db.Uuid
  /// 거부 사유 — 선택이다(필수로 강제하면 아무 값이나 골라 거짓 데이터가 된다)
  rejectReason      String?          @map("reject_reason") @db.VarChar(200)
  /// 초안↔최종본 편집거리(levenshteinCapped · 캡 1500자라 하한일 수 있음). 최종 본문은 저장하지 않는다
  editDistance      Int?             @map("edit_distance")
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz()

  transitions AiProposalTransition[]

  @@index([patientId, createdAt])
  @@index([targetType, targetId])
  @@index([kind, status, createdAt])
  @@index([modelRef, createdAt])
  @@map("ai_proposals")
}

/// 상태 전이 원장 — **append-only**(서비스에 update/delete 없음).
/// 🔴 여기가 비면 "언제 보여줬고 누가 결정했는가"를 재구성할 수 없다. 행을 고치지 않는다.
model AiProposalTransition {
  id            String            @id @default(uuid()) @db.Uuid
  proposalId    String            @map("proposal_id") @db.Uuid
  /// 최초 생성 전이는 null(이전 상태가 없다)
  fromStatus    AiProposalStatus? @map("from_status")
  toStatus      AiProposalStatus  @map("to_status")
  actorId       String?           @map("actor_id") @db.Uuid
  at            DateTime          @default(now()) @db.Timestamptz()
  /// 사유 — 시스템 코드(NOT_PRESENTED·EXPIRED_DUE …) 또는 사람이 적은 자유 사유
  reason        String?           @db.VarChar(200)
  editDistance  Int?              @map("edit_distance")
  /// 어느 화면·클라이언트에서 일어났는가(FE 가 보고) — 모르면 null
  clientContext String?           @map("client_context") @db.VarChar(80)

  proposal AiProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([proposalId, at])
  @@map("ai_proposal_transitions")
}

/// 모델 릴리즈 레지스트리 — "언제부터 어떤 모델이 임상에 쓰였는가"의 정본.
/// 🔴 자동 업데이트가 없다는 것은 문서가 아니라 이 표 + AiCallLog 의 기간별 분포로 증명한다.
model AiModelRelease {
  id          String    @id @default(uuid()) @db.Uuid
  /// WeRU.B 등
  provider    String    @db.VarChar(40)
  /// qwen2.5:14b 같은 상류 태그 — 지어내지 않고 상류가 말한 값
  modelTag    String    @map("model_tag") @db.VarChar(64)
  /// 이미지/가중치 digest(알면)
  digest      String?   @db.VarChar(80)
  deployedAt  DateTime  @map("deployed_at") @db.Timestamptz()
  /// 폐기 시각. null = 현역
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz()
  approvedBy  String?   @map("approved_by") @db.Uuid
  /// 결정 등록부 키(policy.aiModel.revalidation 등) — 승인 근거가 없으면 null(있는 척하지 않는다)
  approvalRef String?   @map("approval_ref") @db.VarChar(80)
  notes       String?   @db.Text

  @@unique([provider, modelTag, deployedAt])
  @@map("ai_model_releases")
}

/// AI 호출 계측 — 🔴 **PHI 를 담지 않는다**(프롬프트·응답 본문·환자 식별자 없음).
/// 담기는 것은 "무엇을 어떤 모델로 불렀고 얼마나 걸렸으며 어떻게 끝났는가"뿐이다.
model AiCallLog {
  id             String            @id @default(uuid()) @db.Uuid
  /// 스킬 이름(soap-draft·lab-interpret …)
  skill          String            @db.VarChar(80)
  /// 호출 주체(모듈·클라이언트)
  client         String            @db.VarChar(60)
  /// 우리가 요청한 태그
  requestedModel String?           @map("requested_model") @db.VarChar(64)
  /// 🔴 **상류가 보고한 태그.** requestedModel 과 다를 수 있다 — 다르면 그것이 사실이다
  modelRef       String?           @map("model_ref") @db.VarChar(64)
  latencyMs      Int?              @map("latency_ms")
  httpStatus     Int?              @map("http_status")
  source         AiProposalSource?
  reasonCode     String?           @map("reason_code") @db.VarChar(40)
  /// 검증 실패 상세(PHI 없는 요약)
  verifyFailed   Json?             @map("verify_failed")
  /// 이 호출이 만든 제안(있으면)
  proposalId     String?           @map("proposal_id") @db.Uuid
  /// 응답 바이트 수(본문 아님)
  bytes          Int?
  /// 호출 당시 운영 모드 — 🔴 빌드 상한이라 실효 모드(런타임 토글)와 다를 수 있다
  mode           String?           @db.VarChar(16)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt])
  @@index([modelRef, createdAt])
  @@index([skill, createdAt])
  @@map("ai_call_logs")
}

/// 언어팩 사람 검수 — **검수 오버레이 원장** (정본 `docs/01-plan/features/i18n-human-review.plan.md` §2.1).
///
/// 🔴 **정본은 코드다**(`packages/shared/src/i18n/messages/*.ts`). 이 표는 코드에 들어 있는
///    AI 초안 위에 **사람이 검수한 결과**를 얹는 오버레이이고, 내보내기(export)로 코드에 반영·커밋되면
///    `MERGED` 로 넘어가 역할이 끝난다. DB 를 정본으로 만들면 다음 배포가 조용히 되돌린다(P12).
/// 🔴 카탈로그 원문(한국어 키)은 **여기에 복제하지 않는다** — 코드 초안값은 조회 시 shared 에서 읽는다.
///    `baseValue` 만 예외다: "제안 당시의 코드 값"이라 코드가 바뀐 것을 화면이 말할 수 있게 하는 스냅샷이다.
enum TranslationOverrideStatus {
  /// 검수자가 저장했다. 🔴 **화면에 반영되지 않는다**(기록 ≠ 적용)
  PROPOSED
  /// 승인 — 런타임 오버레이로 나간다
  APPROVED
  /// 반려. 🔴 "번역하지 않고 원문+티로 둔다"는 **정답인 선택**이기도 하다(안전 키 · KTAS 선례)
  REJECTED
  /// 코드 카탈로그에 반영·커밋됐다(사람이 표시 — 자동 커밋 없음)
  MERGED
}

model TranslationOverride {
  id         String                    @id @default(uuid()) @db.Uuid
  /// 언어 코드(en·ja·zh·ru·vi·kk·mn·th…). ko 는 대상이 아니다 — 원문이 곧 키다
  locale     String                    @db.VarChar(16)
  /// 카탈로그 키 = 한국어 원문(문맥 키는 `원문@문맥`). 실측 최장 137자 → 500 으로 둔다
  /// (Text 로 두면 `@@unique([locale, key])` btree 가 긴 값에서 터진다)
  key        String                    @db.VarChar(500)
  /// 카탈로그 영역명(nav·status·chart… — `AREA_CATALOGS` 에서 파생해 기록)
  area       String                    @db.VarChar(40)
  /// 검수자가 확정한 값
  draftValue String                    @map("draft_value") @db.Text
  /// 🔴 제안 시점의 **코드 값** 스냅샷. 코드가 그 뒤 바뀌면 화면이 "원본이 바뀌었다"를 말한다.
  ///    코드에 아직 번역이 없던 자리는 null(빈 문자열과 다른 사실이다)
  baseValue  String?                   @map("base_value") @db.Text
  status     TranslationOverrideStatus @default(PROPOSED)
  /// 사유·근거. 반려는 특히 여기가 본문이다(왜 번역하지 않는가)
  note       String?                   @db.Text
  proposedBy String?                   @map("proposed_by") @db.Uuid
  proposedAt DateTime                  @default(now()) @map("proposed_at") @db.Timestamptz()
  reviewedBy String?                   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?                 @map("reviewed_at") @db.Timestamptz()
  /// 코드로 내보내 커밋된 시점(사람이 표시)
  mergedAt   DateTime?                 @map("merged_at") @db.Timestamptz()
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  transitions TranslationOverrideTransition[]

  /// 한 키에 한 제안 — 재수정은 같은 행을 갱신하고 이력은 전이 원장에 남는다
  @@unique([locale, key])
  @@index([locale, status])
  @@index([area, locale])
  @@index([status, proposedAt])
  @@map("translation_overrides")
}

/// 검수 전이 원장(append-only) — 누가 언제 무엇을 왜 바꿨는가.
/// 🔴 어휘는 `AiProposalTransition` 과 같은 모양을 따른다(초안 → 사람 판정 → 이력).
model TranslationOverrideTransition {
  id         String                     @id @default(uuid()) @db.Uuid
  overrideId String                     @map("override_id") @db.Uuid
  /// 최초 생성 전이는 null(이전 상태가 없다)
  fromStatus TranslationOverrideStatus? @map("from_status")
  toStatus   TranslationOverrideStatus  @map("to_status")
  actorId    String?                    @map("actor_id") @db.Uuid
  at         DateTime                   @default(now()) @db.Timestamptz()
  /// 사람이 적은 사유(반려 근거 등). 필수로 강제하지 않는다 — 강제하면 아무 값이나 골라 거짓이 된다
  reason     String?                    @db.VarChar(500)

  override TranslationOverride @relation(fields: [overrideId], references: [id], onDelete: Restrict)

  @@index([overrideId, at])
  @@map("translation_override_transitions")
}

// ── 통합 상황판 지표 이력(2026-10-02 · 상황판 디자인 F 추세선) ──
// 🔴 이력 없이 추세선을 그리면 값을 지어낸다 — 서버가 5분마다 상황판과 **같은 집계**(getSummary · 전 섹션)를 한 행으로 남긴다.
//    한 칸(bucketAt = 5분 내림)에 한 행 — 같은 칸 중복 기록은 유일 제약으로 막는다(인스턴스·재시작 무관).
//    섹션 조회가 실패한 지표는 0 이 아니라 null(values 에 null) · 실패 섹션 이름은 failedSections.
//    보존: 30일(같은 크론이 지난 행을 지운다 — 파생 지표라 원장이 아니다).
model CommandCenterKpiSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  bucketAt       DateTime @unique @map("bucket_at") @db.Timestamptz()
  takenAt        DateTime @map("taken_at") @db.Timestamptz()
  /// { 지표키: number | null } — 키 정본은 command-center-trend.ts `TREND_METRICS`
  values         Json
  /// 조회 실패한 섹션 이름 배열(빈 배열 = 전 섹션 성공)
  failedSections Json     @map("failed_sections")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("command_center_kpi_snapshots")
}

/// 서명본 보존(2026-10-03) — 서명된 진료기록·퇴원요약을 정정(SIGNED→AMENDED)하는 순간 **직전 서명본**을 남긴다.
/// 🔴 종전 정정은 서명본을 제자리에서 덮어썼다(정정 전 내용·원래 서명 시각·서명자 소실 · 감사 로그엔 바뀐 필드 이름만).
/// 한 행 = 대체된 서명본 한 판. 현재 판은 원 기록 자체다. 무엇이 정정됐는지(changedFields)는 정정 요청이 건드린 항목.
model SignedRecordVersion {
  id            String    @id @default(uuid()) @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  recordType    String    @map("record_type") @db.VarChar(30) // ENCOUNTER | DISCHARGE_SUMMARY
  recordId      String    @map("record_id") @db.Uuid
  /// 그 판의 서명 시각·서명자 — 원 기록에 있던 값 그대로(모르면 null)
  signedAt      DateTime? @map("signed_at") @db.Timestamptz()
  signedBy      String?   @map("signed_by") @db.Uuid
  /// 그 판의 내용(서명 당시 그대로)
  content       Json      @db.JsonB
  /// 정정이 시작된 시각·정정한 사람 — 이 판이 대체된 순간
  supersededAt  DateTime  @default(now()) @map("superseded_at") @db.Timestamptz()
  supersededBy  String?   @map("superseded_by") @db.Uuid
  changedFields Json      @default("[]") @map("changed_fields") @db.JsonB
  /// 정정 사유(2026-10-03 · 선택 입력 — 강제하면 아무 값이나 넣고 넘어간다) · 없으면 null
  reason        String?   @db.VarChar(500)

  @@index([patientId, supersededAt])
  @@index([recordType, recordId])
  @@map("signed_record_versions")
}

/// 수술 중 기록 원장(2026-10-05 · 수술방 차트) — 활력·약물·수액·혈액·배출·사건·메모를 **덧붙이기만** 한다.
/// 🔴 종전 마취 기록은 활력·약물을 JSON 한 칸으로 통째로 덮어써 두 사람이 동시에 적으면 앞 사람 기록이 사라졌고, 입력 화면도 없었다.
/// 고치지 않는다 — 틀린 줄은 무효(void · 사유 필수) 후 다시 적는다(누가·언제 적었는지가 남는다).
/// 발생 시각 출처: RECORDED(입력 순간) · USER_CLAIMED(직원이 넣은 과거 시각)
model IntraopEvent {
  id               String    @id @default(uuid()) @db.Uuid
  surgeryId        String    @map("surgery_id") @db.Uuid
  kind             String    @db.VarChar(16)
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz()
  occurredAtSource String    @map("occurred_at_source") @db.VarChar(16)
  payload          Json      @db.JsonB
  recordedById     String    @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime  @default(now()) @map("recorded_at") @db.Timestamptz()
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz()
  voidedById       String?   @map("voided_by_id") @db.Uuid
  voidReason       String?   @map("void_reason") @db.Text

  @@index([surgeryId, occurredAt])
  @@map("intraop_events")
}

/// 수술방 차트 개인 배치(2026-10-05) — 사람 × 기기 구성(태블릿·모니터 n대) × 수술방 역할마다 어떤 패널을 어디에 둘지.
/// 정본 어휘·기본 배치·정규화는 shared `or-chart.ts`(모르는 패널은 버리고 저장한다).
model OrChartLayout {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  deviceProfile String   @map("device_profile") @db.VarChar(16)
  orRole        String   @map("or_role") @db.VarChar(16)
  layout        Json     @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, deviceProfile, orRole])
  @@map("or_chart_layouts")
}

/// 질 개선 활동(PDCA · 2026-10-07) — CPOE 질 지표 신호에서 시작해 계획→실행→효과 확인→표준화→종결.
/// 기준선(baseline)은 시작할 때 **서버가 원장에서 센 값**을 박는다(화면이 보낸 수를 쓰지 않는다).
/// 상태 어휘·전이는 shared `cpoe-quality.ts` `QI_ACTION_TRANSITIONS` 하나. 경과는 `QiImprovementEvent`(덧붙이기만).
model QiImprovementAction {
  id                  String    @id @default(uuid()) @db.Uuid
  // CPOE 지표 키(shared CPOE_QI_KEYS) — 일반 지표 활동이면 null 이고 indicatorId 가 있다(2026-10-08)
  indicatorKey        String?   @map("indicator_key") @db.VarChar(40)
  indicatorId         String?   @map("indicator_id") @db.Uuid
  // 기준선 출처 — SUPPLIER(서버 재집계) · MANUAL(공급원 없는 지표 — 사람이 넣은 분자·분모)
  baselineSource      String    @default("SUPPLIER") @map("baseline_source") @db.VarChar(12)
  title               String    @db.VarChar(200)
  problem             String    @db.Text
  rootCause           String?   @map("root_cause") @db.Text
  plan                String    @db.Text
  ownerId             String?   @map("owner_id") @db.Uuid
  dueDate             DateTime? @map("due_date") @db.Date
  status              String    @default("PLAN") @db.VarChar(16)
  /// 시작 신호(관리도 달 등) — 없으면 null(지어내지 않는다)
  triggerPeriod       String?   @map("trigger_period") @db.VarChar(20)
  baselineFrom        DateTime  @map("baseline_from") @db.Timestamptz()
  baselineTo          DateTime  @map("baseline_to") @db.Timestamptz()
  baselineNumerator   Int       @map("baseline_numerator")
  baselineDenominator Int       @map("baseline_denominator")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  closedAt            DateTime? @map("closed_at") @db.Timestamptz()

  events QiImprovementEvent[]

  @@index([indicatorKey, status])
  @@map("qi_improvement_actions")
}

/// 개선 활동 경과 — 생성·상태 전이·메모·효과 확인(그 기간을 서버가 다시 센 분자·분모). 고치지 않고 덧붙인다.
model QiImprovementEvent {
  id               String    @id @default(uuid()) @db.Uuid
  actionId         String    @map("action_id") @db.Uuid
  kind             String    @db.VarChar(16)
  fromStatus       String?   @map("from_status") @db.VarChar(16)
  toStatus         String?   @map("to_status") @db.VarChar(16)
  note             String?   @db.Text
  checkFrom        DateTime? @map("check_from") @db.Timestamptz()
  checkTo          DateTime? @map("check_to") @db.Timestamptz()
  checkNumerator   Int?      @map("check_numerator")
  checkDenominator Int?      @map("check_denominator")
  actorId          String    @map("actor_id") @db.Uuid
  at               DateTime  @default(now()) @db.Timestamptz()

  action QiImprovementAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, at])
  @@map("qi_improvement_events")
}
/// 일일 재원일수 스냅샷(QI 흐름 2026-10-08) — 사고율 분모(결정 qi.autoMeasure.denominator = PATIENT_DAYS).
/// 그날 자정 재원 중이던 입원 수를 병동별로. 병동을 알 수 없으면 wardKey ''. 재계산 가능(같은 날·병동은 덮어쓴다).
model PatientDaySnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  wardKey     String   @default("") @map("ward_key") @db.VarChar(60)
  patientDays Int      @map("patient_days")
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  @@unique([date, wardKey])
  @@index([date])
  @@map("patient_day_snapshots")
}

/// 기구일수 월 입력(QI 흐름 2026-10-08) — CLABSI·CAUTI·VAP 분모. 결정 qi.deviceDays.source = MANUAL 일 때만 받는다.
model DeviceDayEntry {
  id         String   @id @default(uuid()) @db.Uuid
  period     String   @db.VarChar(7) // YYYY-MM
  wardKey    String   @default("") @map("ward_key") @db.VarChar(60)
  deviceType String   @map("device_type") @db.VarChar(20) // CENTRAL_LINE · URINARY_CATHETER · VENTILATOR
  days       Int
  enteredBy  String   @map("entered_by") @db.Uuid
  enteredAt  DateTime @default(now()) @map("entered_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([period, wardKey, deviceType])
  @@map("device_day_entries")
}

/// 기구 삽입·제거 원장(QI 흐름 2026-10-09 · 결정 qi.deviceDays.source = DEVICE_LEDGER 의 원천)
/// 중심정맥관·유치도뇨관·인공호흡기 — 자정 시점에 꽂혀 있는 기구 수가 그날의 기구일수다.
/// 🔴 지우지 않는다 — 잘못 넣은 행은 무효(사유) · 제거는 한 번(제거 시각 ≥ 삽입 시각 · 미래 불가)
model DeviceLine {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  admissionId String?   @map("admission_id") @db.Uuid
  deviceType  String    @map("device_type") @db.VarChar(20) // CENTRAL_LINE · URINARY_CATHETER · VENTILATOR
  site        String?   @db.VarChar(80)
  insertedAt  DateTime  @map("inserted_at") @db.Timestamptz()
  insertedBy  String    @map("inserted_by") @db.Uuid // 기록자
  removedAt   DateTime? @map("removed_at") @db.Timestamptz()
  removedBy   String?   @map("removed_by") @db.Uuid
  note        String?   @db.Text
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy    String?   @map("voided_by") @db.Uuid
  voidReason  String?   @map("void_reason") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([patientId, removedAt])
  @@index([admissionId])
  @@index([deviceType, insertedAt])
  @@map("device_lines")
}

/// 경보 승인 원장(2026-10-09) — 경보 등록부(`alert-registry.ts`)의 tier·대상·억제 창을 **사람이 승인한 기록**.
/// 승인 당시 값을 snapshot 으로 남긴다 — 코드가 바뀌면 "승인 후 변경됨(재승인 필요)"으로 되돌아간다.
/// 🔴 승인자의 직책·권한은 시스템이 검증하지 못한다 — 근거(위원회 의결 번호·문서)를 반드시 받는다 · 철회는 사유와 함께(지우지 않음)
model AlertApproval {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @db.VarChar(60)
  snapshot     Json
  basis        String    @db.Text
  approvedBy   String    @map("approved_by") @db.Uuid
  approvedAt   DateTime  @default(now()) @map("approved_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason") @db.Text

  @@index([code, approvedAt])
  @@map("alert_approvals")
}

/// 진단별 입원 시 존재(POA) 원장(2026-10-09) — 입원 기간 진료 진단(EncounterDiagnosis) 코드마다 하나.
/// 결정 safety.poaFlag 가 필수(safety.poa.required)로 정하면 퇴원요약 서명 전에 모든 진단에 값이 있어야 한다.
/// 🔴 PSI 산출은 이것만으로 열리지 않는다 — 지표별 코드셋·제외 기준(외부 원문)이 선행한다.
model DiagnosisPoa {
  id            String   @id @default(uuid()) @db.Uuid
  admissionId   String   @map("admission_id") @db.Uuid
  diagnosisCode String   @map("diagnosis_code") @db.VarChar(20)
  poa           String   @db.VarChar(2) // Y(입원 시 있음) · N(입원 후 발생) · U(기록으로 판단 불가)
  recordedBy    String   @map("recorded_by") @db.Uuid
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  @@unique([admissionId, diagnosisCode])
  @@map("diagnosis_poa")
}

/// QI 보고서 스냅샷(QI 흐름 2026-10-08) — 즉석 JSON 이 아니라 **보존·재현 가능한 판**으로.
/// 읽은 측정 행 id 를 함께 남긴다. 위원회 안건에 첨부되면 SUBMITTED.
model QiReportSnapshot {
  id             String    @id @default(uuid()) @db.Uuid
  period         String    @db.VarChar(7)
  title          String    @db.VarChar(200)
  body           Json      @db.JsonB
  measurementIds Json      @map("measurement_ids") @db.JsonB
  status         String    @default("DRAFT") @db.VarChar(12) // DRAFT · SUBMITTED · WITHDRAWN
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz()
  agendaId       String?   @map("agenda_id") @db.Uuid
  sha256         String?   @db.VarChar(64)

  @@index([period, createdAt])
  @@map("qi_report_snapshots")
}

/// 인증 기준(QI 흐름 2026-10-08) — 체계(결정 accreditation.framework)가 정해진 뒤 담당자가 **원문을 보고** 입력한다.
/// 🔴 조문·점수표를 코드·시드에 박지 않는다.
model AccreditationStandard {
  id                String                    @id @default(uuid()) @db.Uuid
  framework         String                    @db.VarChar(10) // KOIHA · JCI
  chapter           String                    @db.VarChar(120)
  code              String                    @db.VarChar(40)
  title             String                    @db.VarChar(300)
  measurableElement String?                   @map("measurable_element") @db.Text
  indicatorIds      Json?                     @map("indicator_ids") @db.JsonB // 연결된 질 지표 id 배열
  sourceRef         String?                   @map("source_ref") @db.VarChar(300) // 원문 출처(문서명·판·쪽)
  isActive          Boolean                   @default(true) @map("is_active")
  createdBy         String                    @map("created_by") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  assessments       AccreditationAssessment[]

  @@unique([framework, code])
  @@map("accreditation_standards")
}

/// 인증 자체 평가(QI 흐름 2026-10-08) — **덧붙이기만**(종전 AccreditationItem 은 갱신이 이전 판단을 지웠다).
/// 자가 판단(assessedBy)과 확인(verifiedBy)을 가른다 — 확인 전엔 "자가 평가"로만 말한다.
model AccreditationAssessment {
  id           String                @id @default(uuid()) @db.Uuid
  standardId   String                @map("standard_id") @db.Uuid
  cycle        String                @db.VarChar(20) // 평가 주기 표식(예: 2026-H2)
  judgment     String                @db.VarChar(12) // MET · PARTIAL · NOT_MET · NA
  evidenceText String?               @map("evidence_text") @db.Text
  attachments  Json?                 @db.JsonB // [{name,url}]
  ownerId      String?               @map("owner_id") @db.Uuid
  dueDate      DateTime?             @map("due_date") @db.Date
  assessedBy   String                @map("assessed_by") @db.Uuid
  assessedAt   DateTime              @default(now()) @map("assessed_at") @db.Timestamptz()
  verifiedBy   String?               @map("verified_by") @db.Uuid
  verifiedAt   DateTime?             @map("verified_at") @db.Timestamptz()
  standard     AccreditationStandard @relation(fields: [standardId], references: [id])

  @@index([standardId, cycle, assessedAt])
  @@map("accreditation_assessments")
}

