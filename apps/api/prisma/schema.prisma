// 생산 배치(끼니·식이유형별 생산량·조리지시서) — 급양과 조리
model ProductionBatch {
  id          String    @id @default(uuid()) @db.Uuid
  date        DateTime  @db.Date
  mealType    String    @map("meal_type") @db.VarChar(20) // BREAKFAST/LUNCH/DINNER/SNACK
  dietType    String    @map("diet_type") @db.VarChar(100)
  plannedQty  Int       @default(0) @map("planned_qty") // 산출 생산량(식수)
  producedQty Int?      @map("produced_qty") // 실제 생산량
  allergyNote String?   @map("allergy_note") @db.Text // 알레르기 대체 특이 요약
  cookStartAt DateTime? @map("cook_start_at") @db.Timestamptz()
  cookEndAt   DateTime? @map("cook_end_at") @db.Timestamptz()
  status      String    @default("PLANNED") @db.VarChar(20) // PLANNED, COOKING, DONE
  cookedBy    String?   @map("cooked_by") @db.Uuid
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([date, mealType, dietType])
  @@index([date, status])
  @@map("production_batches")
}

// 검식(관능·검수) — 조리 완료 배치 품질 확인
model MealInspection {
  id                String   @id @default(uuid()) @db.Uuid
  productionBatchId String   @map("production_batch_id") @db.Uuid
  pass              Boolean  @default(true) // 적합 여부
  taste             Int? // 관능 1~5(맛)
  temperature       Int? // 1~5(온도 적정)
  portion           Int? // 1~5(양)
  hygiene           Int? // 1~5(위생)
  notes             String?  @db.Text
  inspectedBy       String   @map("inspected_by") @db.Uuid
  inspectedAt       DateTime @default(now()) @map("inspected_at") @db.Timestamptz()

  @@index([productionBatchId])
  @@map("meal_inspections")
}

// HACCP CCP 기록 — 중요관리점 온도·시간 측정(가열≥75℃·냉장≤5℃·온장≥57℃)
model HaccpCheck {
  id                String   @id @default(uuid()) @db.Uuid
  productionBatchId String?  @map("production_batch_id") @db.Uuid
  date              DateTime @db.Date
  mealType          String?  @map("meal_type") @db.VarChar(20)
  ccpType           String   @map("ccp_type") @db.VarChar(20) // HEATING(가열중심온도), COLD(냉장보관), HOT(온장보관), TIME(배식시간)
  value             Float? // 측정값(℃ 또는 분)
  withinLimit       Boolean  @default(true) @map("within_limit") // 기준 적합
  correctiveAction  String?  @map("corrective_action") @db.Text // 이탈 시 시정조치
  checkedBy         String   @map("checked_by") @db.Uuid
  checkedAt         DateTime @default(now()) @map("checked_at") @db.Timestamptz()

  @@index([productionBatchId])
  @@index([date])
  @@map("haccp_checks")
}

// 배식 확인(5-Rights) — 오배식 방지 감사 기록
model MealDeliveryCheck {
  id              String   @id @default(uuid()) @db.Uuid
