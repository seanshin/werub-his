  signInExpectedBloodLoss  Boolean?  @map("sign_in_expected_blood_loss") // WHO: 예상 출혈량 >500ml
  signInDifficultAirway    Boolean?  @map("sign_in_difficult_airway") // WHO: 기도관리 위험
  signInCompletedBy        String?   @map("sign_in_completed_by") @db.Uuid
  signInCompletedAt        DateTime? @map("sign_in_completed_at") @db.Timestamptz()
  timeOutTeamIntro         Boolean?  @map("time_out_team_intro")
  timeOutPatientName       Boolean?  @map("time_out_patient_name")
  timeOutProcedure         Boolean?  @map("time_out_procedure")
  timeOutSite              Boolean?  @map("time_out_site")
  timeOutAntibiotics       Boolean?  @map("time_out_antibiotics")
  timeOutCriticalEvents    Boolean?  @map("time_out_critical_events") // WHO: 예상 주요 사건
  timeOutImagingDisplayed  Boolean?  @map("time_out_imaging_displayed") // WHO: 필수 영상 게시
  timeOutCompletedBy       String?   @map("time_out_completed_by") @db.Uuid
  timeOutCompletedAt       DateTime? @map("time_out_completed_at") @db.Timestamptz()
  signOutProcedureRecorded Boolean?  @map("sign_out_procedure_recorded")
