generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST // 원무·접수 — 인적정보/보험/수납 실무(임상 기록 권한 없음)
  PHARMACIST
  LAB_TECH
  NUTRITION // 급양·영양 — 급식/식단/영양 기능 한정(임상 기록·처방·오더 권한 없음)
  ADMIN_STAFF // 행정직(총무·시설·자재) — 재고/장비/행정 한정(임상·환자 임상데이터 권한 없음)
  MEDICAL_RECORDS // 의무기록사(HIM) — 기록 발급/검색·동의·감사 조회 한정(임상 작성·처방·오더 권한 없음)
  CHECKUP // 건강검진센터 원무·행정 — 검진 접수/예약/계약/통계 한정(본원 임상·처방·오더·시스템관리 권한 없음)
  CRM_MANAGER
  CRM_STAFF
  EXECUTIVE // 경영진 — 읽기 전용 관제(강마스킹)
  READ
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum InsuranceType {
  NHI // 국민건강보험
  MEDICAID // 의료급여
  INDUSTRIAL // 산재
  AUTO // 자동차보험
  SELF_PAY // 자비
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  INITIAL // 초진
  FOLLOW_UP // 재진
  URGENT // 응급
  ROUTINE // 정기
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
}

// ============================================================
// Users (사용자)
// ============================================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  familyName        String    @map("family_name") @db.VarChar(100)
  givenName         String    @map("given_name") @db.VarChar(100)
  role              UserRole  @default(NURSE)
  department        String?   @db.VarChar(50) // 진료과 (내과, 외과, 정형외과 등)
  specialty         String?   @db.VarChar(100) // 세부 전문과 (순환기, 호흡기 등)
  profession        String?   @db.VarChar(40) // 직종(shared CLINICAL_PROFESSIONS) — 역할이 접근을, 직종이 오더 입력 범위를 정한다(의료기사는 LAB_TECH 공유·직종으로 갈림). 역할과 안 맞으면 무시
  signatureImage    String?   @map("signature_image") @db.Text // 직원 서명 이미지(base64 PNG/SVG)
  isActive          Boolean   @default(true) @map("is_active")
  accountStage      String    @default("ACTIVE") @map("account_stage") @db.VarChar(12) // ACTIVE | PRE_BOARD(온보딩 임시계정 — 생체등록만, staff 접근 차단)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz()
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz()
  signCertSerial    String?   @map("sign_cert_serial") @db.VarChar(64) // 외부 서명서비스 의료진 인증서 일련번호(P0 additive)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  appointmentsAsDoctor     Appointment[]                 @relation("DoctorAppointments")
  createdPatients          Patient[]                     @relation("PatientCreatedBy")
  updatedPatients          Patient[]                     @relation("PatientUpdatedBy")
  patientHistories         PatientHistory[]              @relation("HistoryChangedBy")
  auditLogs                AuditLog[]
  createdAppointments      Appointment[]                 @relation("AppointmentCreatedBy")
  cancelledAppointments    Appointment[]                 @relation("AppointmentCancelledBy")
  encounters               Encounter[]                   @relation("DoctorEncounters")
  dispensings              Dispensing[]                  @relation("PharmacistDispensings")
  labResults               LabResult[]                   @relation("TechnicianLabResults")
  guardianApprovals        PatientGuardian[]             @relation("GuardianApprover")
  labAttachments           LabResultAttachment[]         @relation("LabAttachmentUploader")
  labWorksheets            LabWorksheet[]                @relation("WorksheetTechnician")
  labSendOuts              LabSendOut[]                  @relation("SendOutRequester")
  cellQcTests              CellQcTest[]                  @relation("CellQcTester")
  cellDocUploads           CellBatchDocument[]           @relation("CellDocUploader")
  genomicOrders            GenomicTest[]                 @relation("GenomicOrderer")
  genomicReports           GenomicReport[]               @relation("GenomicReporter")
  labQcRecords             LabQcRecord[]                 @relation("QcPerformer")
  dietOrders               DietOrder[]                   @relation("DietOrderer")
  nutritionCounsels        NutritionCounsel[]            @relation("NutritionCounselor")
  anesthesiaRecords        AnesthesiaRecord[]            @relation("Anesthetist")
  preAnesthesiaEvaluations PreAnesthesiaEvaluation[]     @relation("PreAnesthesiaEvaluator")
  pacuRecords              PacuRecord[]                  @relation("PacuNurse")
  crossmatchRequests       BloodCrossmatch[]             @relation("CrossmatchRequester")
  transfusionOrders        TransfusionOrder[]            @relation("TransfusionOrderer")
  admissionsAsDoctor       Admission[]                   @relation("AdmittingDoctor")
  admissionsAsAttending    Admission[]                   @relation("AttendingDoctor")
  progressNotes            ProgressNote[]                @relation("ProgressNoteDoctor")
  certificates             Certificate[]                 @relation("CertificateIssuer")
  surgeriesAsSurgeon       Surgery[]                     @relation("SurgeonSurgeries")
  problemsAdded            ProblemList[]                 @relation("ProblemAddedBy")
  allergiesRecorded        Allergy[]                     @relation("AllergyRecorder")
  allergyAssessments       AllergyAssessment[]           @relation("AllergyAssessor")
  isolationsOrdered        IsolationPrecaution[]         @relation("IsolationOrderedBy")
  psychAdmissionsRecorded  PsychiatricAdmission[]        @relation("PsychAdmissionRecorder")
  dischargeSummaries       DischargeSummary[]            @relation("DischargeSummaryDoctor")
  consentsAsDoctor         ConsentForm[]                 @relation("ConsentDoctor")
  nursingAssessments       NursingAssessment[]           @relation("NursingAssessmentNurse")
  nursingDiagnoses         NursingDiagnosis[]            @relation("NursingDiagnosisNurse")
  nursingNotes             NursingNote[]                 @relation("NursingNoteNurse")
  intakeOutputs            IntakeOutput[]                @relation("IntakeOutputNurse")
  medAdminsAsNurse         MedicationAdministration[]    @relation("MedAdminNurse")
  medAdminsAsVerifier      MedicationAdministration[]    @relation("MedAdminVerifier")
  clinicSchedules          ClinicSchedule[]              @relation("DoctorClinicSchedules")
  clinicClosures           ClinicClosure[]               @relation("DoctorClosures")
  substituteClosures       ClinicClosure[]               @relation("SubstituteClosures")
  waitingQueues            WaitingQueue[]                @relation("DoctorWaitingQueue")
  encounterTemplates       EncounterTemplate[]           @relation("EncounterTemplateCreator")
  textMacros               TextMacro[]                   @relation("UserTextMacros")
  recordCopiesIssued       MedicalRecordCopy[]           @relation("RecordCopyIssuer")
  clinicSyncLogs           ClinicSyncLog[]               @relation("SyncLogExecutor")
  btgAccesses              BreakTheGlassAccess[]         @relation("BtgAccessUser")
  btgReviews               BreakTheGlassAccess[]         @relation("BtgAccessReviewer")
  vipDesignations          VipPatient[]                  @relation("VipDesignator")
  orderSets                OrderSet[]                    @relation("OrderSetCreator")
  favoriteOrders           FavoriteOrder[]               @relation("UserFavoriteOrders")
  preOrders                PreOrder[]                    @relation("PreOrderDoctor")
  doctorCodeLists          DoctorCodeList[]              @relation("DoctorCodeLists")
  prescriptionSets         DoctorPrescriptionSet[]       @relation("DoctorPrescriptionSets")
  chargeOfCare             ChargeOfCare[]                @relation("ChargeOfCareDoctor")
  journeyDelayAcks         JourneyDelayAck[]
  deviceUsagesRecorded     DeviceUsage[]                 @relation("DeviceUsageRecorder")
  referenceDatasets        ReferenceDataset[]            @relation("ReferenceDatasetImporter")
  handoffsFrom             ClinicalHandoff[]             @relation("HandoffFrom")
  handoffsTo               ClinicalHandoff[]             @relation("HandoffTo")
  rounds                   Round[]                       @relation("RoundDoctor")
  questionnaireReviews     QuestionnaireToken[]          @relation("QuestionnaireReviewer")
  rehabAssessments         RehabAssessment[]             @relation("RehabAssessor")
  rehabPlans               RehabPlan[]                   @relation("RehabPlanPrescriber")
  rehabSessions            RehabSession[]                @relation("RehabTherapist")
  radiationPlans           RadiationPlan[]               @relation("RadiationPlanPrescriber")
  radiationApprovals       RadiationPlan[]               @relation("RadiationPlanApprover")
  radiationFractions       RadiationFraction[]           @relation("RadiationTherapist")
  radiationToxicities      RadiationToxicity[]           @relation("RadiationToxicityAssessor")
  dialysisOrders           DialysisOrder[]               @relation("DialysisOrderPrescriber")
  dialysisSessions         DialysisSession[]             @relation("DialysisNurse")
  dentalCharts             DentalChart[]                 @relation("DentalChartChartedBy")
  dentalPlans              DentalTreatmentPlan[]         @relation("DentalPlanPlannedBy")
  dentalRecords            DentalTreatmentRecord[]       @relation("DentalRecordTreatedBy")
  eyeExams                 EyeExam[]                     @relation("EyeExamExaminer")
  eyeSurgeries             EyeSurgery[]                  @relation("EyeSurgeryOperator")
  skinLesions              SkinLesion[]                  @relation("SkinLesionRecorder")
  skinTreatments           SkinTreatment[]               @relation("SkinTreatmentTreatedBy")
  entExams                 EntExam[]                     @relation("EntExamExaminer")
  eyePrescriptions         EyePrescription[]             @relation("EyePrescriptionPrescriber")
  urologyProcedures        UrologyProcedure[]            @relation("UrologyProcedurePerformer")
  hearingAids              HearingAid[]                  @relation("HearingAidPrescriber")
  dentalLabOrders          DentalLabOrder[]              @relation("DentalLabOrderOrderer")
  sleepStudies             SleepStudy[]                  @relation("SleepStudyInterpreter")
  dentalRecalls            DentalRecall[]                @relation("DentalRecallCreator")
  doctorMessages           PatientMessage[]              @relation("DoctorMessages")
  orthoExams               OrthoExam[]                   @relation("OrthoExamExaminer")
  obgynExams               ObGynExam[]                   @relation("ObGynExamExaminer")
  pediatricGrowths         PediatricGrowth[]             @relation("PediatricGrowthMeasurer")
  pediatricImmunizations   PediatricImmunization[]       @relation("PediatricImmunizationGiver")
  devAssessments           DevelopmentalAssessment[]     @relation("DevAssessmentAssessor")
  psychExams               PsychExam[]                   @relation("PsychExamExaminer")
  neuroExams               NeuroExam[]                   @relation("NeuroExamExaminer")
  urologyExams             UrologyExam[]                 @relation("UrologyExamExaminer")
  plasticExams             PlasticExam[]                 @relation("PlasticExamExaminer")
  internalMedicineExams    InternalMedicineExam[]        @relation("InternalMedicineExamExaminer")
  surgeryOpNotes           SurgeryOpNote[]               @relation("SurgeryOpNoteCreator")
  burnAssessments          BurnAssessment[]              @relation("BurnAssessmentAssessor")
  careTeamsAsDoctor        CareTeam[]                    @relation("CareTeamDoctor")
  careTeamsAsNurse         CareTeam[]                    @relation("CareTeamNurse")
  universalNursingNotes    UniversalNursingNote[]        @relation("UniversalNursingNoteNurse")
  blockchainCerts          BlockchainCertificate[]       @relation("UserBlockchainCerts")
  docSignatures            DocumentSignature[]           @relation("UserDocSignatures")
  specimenCollections      PathologySpecimen[]           @relation("SpecimenCollector")
  pathologyReports         PathologyReport[]             @relation("PathologyReporter")
  pathologySigns           PathologyReport[]             @relation("PathologySigner")
  hiraClaimDocs            HiraClaimDocument[]           @relation("HiraClaimCreator")
  controlledLogs           ControlledSubstanceLog[]      @relation("ControlledPrescriber")
  csIncidentsReported      ControlledSubstanceIncident[] @relation("CsIncidentReporter")
  notifications            Notification[]
  dispensingCounsels       DispensingCounsel[]           @relation("CounselPharmacist")
  genericSubstitutions     GenericSubstitution[]         @relation("SubstitutionPharmacist")
  adrReports               AdverseReactionReport[]       @relation("AdrReporter")
  nurseAssignments         NursePatientAssignment[]      @relation("NurseAssignments")
  ewsRecords               EarlyWarningScore[]           @relation("EwsNurse")
  idChecks                 PatientIdentificationCheck[]  @relation("IdCheckVerifier")
  hospiceRegistrations     HospiceRegistration[]         @relation("HospiceRegistrar")
  hospiceAssessments       HospiceSymptomAssessment[]    @relation("HospiceAssessor")
  hospiceConferences       HospiceCareConference[]       @relation("HospiceConferenceFacilitator")
  transplantSurgeries      TransplantRecord[]            @relation("TransplantSurgeon")
  telehealthSessions       TelehealthSession[]           @relation("TelehealthDoctor")
  checkupSummaries         CheckupSummary[]              @relation("CheckupReviewer")
  checkupInterpretations   CheckupInterpretation[]       @relation("CheckupInterpreter")
  checkupStationOps        CheckupStationLog[]           @relation("CheckupStationOperator")
  therapyOrders            TherapyOrder[]                @relation("TherapyTherapist")
  staffMealMenusCreated    StaffMealMenu[]               @relation("StaffMealMenuCreator")
  staffMealRequests        StaffMealRequest[]            @relation("StaffMealRequests")
  hospitalInfoCreated      HospitalInfoContent[]         @relation("HospitalInfoCreator")
  hospitalInfoUpdated      HospitalInfoContent[]         @relation("HospitalInfoUpdater")
  hospitalInfoAudits       HospitalInfoAudit[]           @relation("HospitalInfoAuditor")
  doctorProfile            DoctorProfile?                @relation("DoctorProfileUser")
  flowSheetEntries         FlowSheetEntry[]              @relation("FlowSheetNurse")
  nursingChecklists        NursingChecklist[]            @relation("ChecklistNurse")
  consultRequests          Consultation[]                @relation("ConsultRequester")
  consultToDoctor          Consultation[]                @relation("ConsultToDoctor")
  consultReplies           Consultation[]                @relation("ConsultReplier")
  consultsClosed           Consultation[]                @relation("ConsultCloser")
  advanceDirectivesRevoked AdvanceDirective[]            @relation("AdvanceDirectiveRevoker")
  lettersFrom              ReferralLetter[]              @relation("LetterFromDoctor")
  lettersTo                ReferralLetter[]              @relation("LetterToDoctor")
  acknowledgedOrders       Order[]                       @relation("OrderAcknowledger")
  receivedOrders           Order[]                       @relation("OrderReceiver")
  startedOrders            Order[]                       @relation("OrderStarter")
  completedOrders          Order[]                       @relation("OrderCompleter")
  specimenCollectedOrders  Order[]                       @relation("OrderSpecimenCollector")
  cancelledOrders          Order[]                       @relation("OrderCanceller")
  homepagePopups           HomepagePopup[]               @relation("PopupCreator")
  mediaFiles               MediaFile[]                   @relation("MediaUploader")
  dashboardConfig          UserDashboardConfig?
  crmCampaignsCreated      CrmCampaign[]                 @relation("CrmCampaignCreator")
  crmForeignCasesAssigned  CrmForeignPatientCase[]       @relation("CrmForeignCaseAssignee")
  crmBannersCreated        CrmPortalBanner[]             @relation("CrmBannerCreator")
  remoteConsultations      RemoteConsultation[]          @relation("RemoteConsultDoctor")
  webauthnCredentials      WebAuthnCredential[]          @relation("UserWebAuthnCredentials")
  staffDevices             StaffDevice[]                 @relation("UserStaffDevices")
  appKeys                  AppInstallationKey[]          @relation("UserAppKeys")
  sentStaffCalls           StaffCall[]                   @relation("StaffCallSender")
  staffCallAcks            StaffCallAck[]                @relation("StaffCallAcker")
  emergencyAccesses        AuthEmergencyAccess[]         @relation("EmergencyAccessUser")
  accountRecoveries        AccountRecovery[]             @relation("AccountRecoveryUser")
  dedicatedTerminals       TerminalRegistry[]            @relation("TerminalDedicated")
  committeeMemberships     CommitteeMember[]             @relation("CommitteeMemberUser")
  staffConsent             StaffConsent?                 @relation("StaffConsentUser")

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserDashboardConfig {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  config    Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_dashboard_configs")
}

// 관리자 관리 — 역할/부서별 기본 대시보드 템플릿
model DashboardTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String   @db.VarChar(20) // ROLE / DEPARTMENT
  scopeRef  String   @map("scope_ref") @db.VarChar(50) // role 또는 부서명
  config    Json     @db.JsonB
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([scope, scopeRef])
  @@map("dashboard_templates")
}

// 상담실 — 환자포털 실시간 채팅 상담(AI 1차 + 직원, 다국어)
model ConsultSession {
  id               String           @id @default(uuid()) @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  status           String           @default("OPEN") @db.VarChar(12) // OPEN/WAITING/ACTIVE/CLOSED
  locale           String           @default("ko") @db.VarChar(10) // 환자 선택 언어
  category         String?          @db.VarChar(20) // GENERAL/INTERNATIONAL/CHECKUP/BILLING (라우팅 키)
  teamId           String?          @map("team_id") @db.Uuid // 귀속 팀(라우팅 결과)
  aiMode           String           @default("AUTO") @map("ai_mode") @db.VarChar(8) // AUTO/OFF (P3: SUGGEST)
  assigneeId       String?          @map("assignee_id") @db.Uuid // 담당 직원
  priority         String           @default("NORMAL") @db.VarChar(8) // NORMAL/HIGH/URGENT (SLA 에스컬레이션)
  escalationLevel  Int              @default(0) @map("escalation_level") // 0/1/2 (SLA 전용)
  escalatedAt      DateTime?        @map("escalated_at") // SLA 에스컬레이션 시각
  escalatedToId    String?          @map("escalated_to_id") @db.Uuid // 팀장 에스컬레이션 대상(P2)
  leadEscalatedAt  DateTime?        @map("lead_escalated_at") // 팀장 에스컬레이션 시각(SLA와 분리)
  escalationReason String?          @map("escalation_reason") @db.VarChar(300)
  firstResponseAt  DateTime?        @map("first_response_at") // 첫 직원응답(평균응답 지표)
  jitsiRoom        String?          @map("jitsi_room") @db.VarChar(60) // 1:1 화상 룸
  videoStartedAt   DateTime?        @map("video_started_at")
  rating           Int? // 종료 후 만족도 1~5
  ratingComment    String?          @map("rating_comment") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  messages         ConsultMessage[]

  @@index([patientId])
  @@index([status])
  @@index([teamId])
  @@map("consult_sessions")
}

model ConsultMessage {
  id            String         @id @default(uuid()) @db.Uuid
  sessionId     String         @map("session_id") @db.Uuid
  session       ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender        String         @db.VarChar(10) // PATIENT/AI/STAFF/LEAD
  senderId      String?        @map("sender_id") @db.Uuid // 발신 직원(다중 구분·환자 미반환)
  visibility    String         @default("PATIENT") @db.VarChar(10) // PATIENT/INTERNAL(직원전용 노트)
  content       String         @db.Text // 표시용(발신자/수신자 언어)
  contentKo     String?        @map("content_ko") @db.Text // 직원용 한국어(번역/원문)
  attachmentUrl String?        @map("attachment_url") @db.VarChar(500) // 이미지/파일
  lang          String?        @db.VarChar(10)
  readAt        DateTime?      @map("read_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("consult_messages")
}

// 상담 팀(다팀 운영) — 카테고리/언어별 큐, 기본 AI모드
model ConsultTeam {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(40)
  description   String?        @db.VarChar(200)
  categories    Json? // ["GENERAL","INTERNATIONAL","CHECKUP","BILLING"]
  locales       Json? // ["ko","en","zh"]
  defaultAiMode String         @default("AUTO") @map("default_ai_mode") @db.VarChar(8)
  isDefault     Boolean        @default(false) @map("is_default") // 미매칭 세션 수용 기본팀
  active        Boolean        @default(true)
  agents        ConsultAgent[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("consult_teams")
}

// 상담 프로필(직원 위에 부여) — 역할/상태/소속팀
model ConsultAgent {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  teamId        String?      @map("team_id") @db.Uuid
  team          ConsultTeam? @relation(fields: [teamId], references: [id])
  role          String       @db.VarChar(8) // AGENT/LEAD/ADMIN
  status        String       @default("OFFLINE") @db.VarChar(8) // ONLINE/AWAY/BUSY/OFFLINE
  skills        Json? // {langs:[],categories:[]}
  maxConcurrent Int          @default(5) @map("max_concurrent")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([teamId])
  @@map("consult_agents")
}

// 상담 빠른답변 템플릿(직원 입력 보조) — 2026-09-14 기획 portal-chat-consultation FR-12
// 🔴 환자에게 자동 전송하지 않는다(직원이 답변 칸에 넣고 직접 전송). 시드 문구 없음(빈 목록으로 시작 — 임상 판단·수치를 지어내지 않는다).
// teamId null = 전체 팀 공용(ADMIN 만 작성), 그 외 = 그 팀 전용(해당 팀 LEAD·ADMIN 작성). 삭제 대신 비활성(active=false).
model ConsultReplyTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  title     String   @db.VarChar(80)
  body      String   @db.Text
  active    Boolean  @default(true)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([teamId, active])
  @@map("consult_reply_templates")
}

// 자동 번역 캐시 (공유 번역 엔진 — 포털·홈페이지·상담실)
model Translation {
  id         String   @id @default(uuid()) @db.Uuid
  hash       String   @unique // sha256(source|target|text)
  sourceLang String   @map("source_lang") @db.VarChar(10)
  targetLang String   @map("target_lang") @db.VarChar(10)
  sourceText String   @map("source_text") @db.Text
  translated String   @db.Text
  engine     String   @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetLang])
  @@map("translations")
}

// 비급여 진료비용 항목 — 의료법 §45 / 복지부 고시 서식 고지용
model NonCoveredItem {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @db.VarChar(30) // 항목 코드(HIRA 비급여 코드 등)
  name            String   @db.VarChar(200) // 항목 명칭
  category        String   @db.VarChar(20) // ROOM/PROCEDURE/EXAM/THERAPY/MATERIAL/CERTIFICATE/OTHER
  price           Int // 비용(원)
  description     String?  @db.VarChar(500) // 특이사항
  requiresConsent Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("non_covered_items")
}

// ============================================================
// Patients (환자) — bi-temporal
// ============================================================

model Patient {
  id     String  @id @default(uuid()) @db.Uuid
  mrn    String  @unique @db.VarChar(50)
  fhirId String? @unique @map("fhir_id") @db.VarChar(100)

  // Demographics (ADR-002: familyName/givenName)
  familyName  String   @map("family_name") @db.VarChar(100)
  givenName   String   @map("given_name") @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      Gender

  // 한국형 보험 정보 (ADR-003)
  insuranceType   InsuranceType @default(NHI) @map("insurance_type")
  insuranceNumber String?       @map("insurance_number") @db.VarChar(255) // AES-256 encrypted
  incomeDecile    Int?          @map("income_decile") // 건강보험료 기준 소득분위 1~10(본인부담상한제) — NHIS 자격조회 소스

  // Contact
  phone           String? @db.VarChar(20)
  phoneNormalized String? @map("phone_normalized") @db.VarChar(20) // 🔴 A1: 정규화 전화(정확 매칭·중복탐지용·표시는 phone 원문)
  email           String? @db.VarChar(255)
  address         Json?   @db.JsonB

  // 본인인증 CI (NICE/PASS)
  ci String? @unique @db.VarChar(200) // AES-256-GCM encrypted CI값

  // Extended Demographics
  nationalId        String? @map("national_id") @db.VarChar(200) // AES-256-GCM encrypted
  nationalIdType    String? @map("national_id_type") @db.VarChar(20) // RESIDENT, FOREIGNER, PASSPORT
  nationalIdHash    String? @map("national_id_hash") @db.VarChar(64) // HMAC-SHA256 블라인드 인덱스(복호화 없이 검색/중복확인)
  photoUrl          String? @map("photo_url") @db.VarChar(500)
  nationality       String? @default("KR") @db.VarChar(50)
  preferredLanguage String? @default("ko") @map("preferred_language") @db.VarChar(10)

  // v3.0 해외/외부 환자
  passportNumber          String?   @map("passport_number") @db.VarChar(200) // AES-256-GCM 암호화(원시 키)
  passportNumberHash      String?   @map("passport_number_hash") @db.VarChar(64) // HMAC 블라인드 인덱스(정확 일치 조회/중복확인)
  alienRegistrationNo     String?   @map("alien_registration_no") @db.VarChar(200) // AES-256-GCM 암호화(원시 키)
  alienRegistrationNoHash String?   @map("alien_registration_no_hash") @db.VarChar(64) // HMAC 블라인드 인덱스
  nameEn                  String?   @map("name_en") @db.VarChar(200) // 영문 성명
  koreanName              String?   @map("korean_name") @db.VarChar(100) // 한글 호칭 이름(외국인 — 원어 표기 타이핑/호출 곤란 해소, 예: "스미스 존")
  passportExpiry          DateTime? @map("passport_expiry") @db.Date // 여권 만료일 — 체류/여행자보험 유효성 확인
  visaType                String?   @map("visa_type") @db.VarChar(20) // 체류자격(B-2 관광·C-3 단기·E-7 취업·F-6 결혼 등)
  patientSource           String?   @map("patient_source") @db.VarChar(20) // DOMESTIC, FOREIGN_RESIDENT, FOREIGN_TOURIST, OVERSEAS_KOREAN, REMOTE_INTERNATIONAL, TRANSFER_IN, EMERGENCY_UNKNOWN
  sourceOrgId             String?   @map("source_org_id") @db.Uuid // 전원 출처 기관
  externalPatientId       String?   @map("external_patient_id") @db.VarChar(100)
  travelInsurance         Json?     @map("travel_insurance") @db.JsonB // {company, policyNo, contactNo}
  embassyContact          String?   @map("embassy_contact") @db.VarChar(200)
  interpreterNeeded       Boolean   @default(false) @map("interpreter_needed")
  depositRequired         Boolean   @default(false) @map("deposit_required")
  isActive                Boolean   @default(true) @map("is_active") // 보관(soft) — 외국인 등록 목록 관리용(전체 환자 검색은 미필터)
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz()
  attachments             Json?     @db.JsonB // 환자 서류 첨부 [{url,fileName,mimeType,size,uploadedBy,uploadedAt}] — 여권 사본·보험증권 등
  maritalStatus           String?   @map("marital_status") @db.VarChar(20) // SINGLE, MARRIED, DIVORCED, WIDOWED, UNKNOWN
  occupation              String?   @db.VarChar(100)
  smokingStatus           String?   @map("smoking_status") @db.VarChar(12) // 흡연상태(사회력): CURRENT|FORMER|NEVER|UNKNOWN — FHIR LOINC 72166-2, CVD 위험엔진 입력
  religion                String?   @db.VarChar(50)
  deathDate               DateTime? @map("death_date") @db.Timestamptz()
  deathCause              String?   @map("death_cause") @db.VarChar(500)
  isDeceased              Boolean   @default(false) @map("is_deceased")
  // 🔴 사망진단서 입력이 저장되지 않던 것(2026-08-26). DTO 는 받고 응답에도 실었는데
  //    update 는 위 3필드만 써서 **사망장소·사망종류·사인 (나)(다)(라)가 사라졌다.**
  //    사망진단서는 법정 서식이라 원문이 남아야 한다.
  deathLocation           String?   @map("death_location") @db.VarChar(20) // HOSPITAL|ER|OR|ICU|OTHER
  deathType               String?   @map("death_type") @db.VarChar(20) // NATURAL|EXTERNAL|OTHER
  deathCauseChain         Json?     @map("death_cause_chain") @db.JsonB // {a,b,c,d} — (가)직접사인→(라)
  deathConfirmedBy        String?   @map("death_confirmed_by") @db.Uuid
  deathConfirmedAt        DateTime? @map("death_confirmed_at") @db.Timestamptz()
  memo                    String?   @db.Text
  tags                    String[]  @default([])
  mergedIntoId            String?   @map("merged_into_id") @db.Uuid

  // CRM
  crmScore         Int?      @default(0) @map("crm_score")
  lastContactAt    DateTime? @map("last_contact_at") @db.Timestamptz()
  churnRisk        String?   @map("churn_risk") @db.VarChar(10) // LOW, MEDIUM, HIGH
  rfmSegment       String?   @map("rfm_segment") @db.VarChar(20) // CHAMPION, LOYAL, AT_RISK, LOST...
  preferredChannel String?   @map("preferred_channel") @db.VarChar(20) // SMS, PUSH, KAKAO

  // Medical
  bloodType String? @map("blood_type") @db.VarChar(5)
  allergies Json    @default("[]") @db.JsonB

  // Bi-temporal (EtherCIS pattern)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz()
  validTo   DateTime? @map("valid_to") @db.Timestamptz()

  // 외부 서명서비스(sign) 환자 인증서 일련번호 — additive(P0)
  signCertSerial String? @map("sign_cert_serial") @db.VarChar(64)

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  // Relations
  creator                       User                           @relation("PatientCreatedBy", fields: [createdBy], references: [id])
  updater                       User                           @relation("PatientUpdatedBy", fields: [updatedBy], references: [id])
  contacts                      PatientContact[]
  mergedInto                    Patient?                       @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom                    Patient[]                      @relation("PatientMerge")
  appointments                  Appointment[]
  appointmentWaitlists          AppointmentWaitlist[]
  histories                     PatientHistory[]
  encounters                    Encounter[]
  billings                      Billing[]
  formSubmissions               FormSubmission[]
  dispensings                   Dispensing[]
  labResults                    LabResult[]
  labSendOuts                   LabSendOut[]
  cellTherapyBatches            CellTherapyBatch[]
  genomicTests                  GenomicTest[]
