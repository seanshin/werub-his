  doctorId    String   @map("doctor_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  category    String?  @db.VarChar(50)
  items       Json     @db.JsonB // [{codeId, codeType, name, dosage, frequency, duration, route}]
  useCount    Int      @default(0) @map("use_count")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  doctor User @relation("DoctorPrescriptionSets", fields: [doctorId], references: [id])

  @@index([doctorId])
  @@map("doctor_prescription_sets")
}

/// 원내 처방집(포뮬러리) — 병원 위원회가 승인한 사용 가능 코드(영역별)
model FormularyItem {
  id        String    @id @default(uuid()) @db.Uuid
  domain    String    @db.VarChar(20) // MEDICATION|LAB|IMAGING|THERAPY|DIET|ACTIVITY|NURSING
  codeType  String    @map("code_type") @db.VarChar(30) // MEDICATION_CODE|PROCEDURE_CODE|NURSING_CODE|PRESET
  codeId    String?   @map("code_id") @db.Uuid // 마스터 FK(프리셋은 null)
  presetKey String?   @map("preset_key") @db.VarChar(40) // 치료/활동 프리셋 키
  status    String    @default("ACTIVE") @db.VarChar(20) // ACTIVE|SUSPENDED|REMOVED
  note      String?   @db.Text // 위원회 결정 메모(제한 조건 등)
  committee String?   @db.VarChar(60) // 결정 위원회
  decidedAt DateTime? @map("decided_at") @db.Timestamptz()
  decidedBy String?   @map("decided_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([domain, codeType, codeId, presetKey])
  @@index([domain, status])
  @@index([codeId])
  @@map("formulary_items")
}

/// 포뮬러리 체크리스트 — AI가 관련 코드를 카테고리로 정리한 큐레이션 목록(검토→체크→일괄 등재)
model FormularyList {
  id          String   @id @default(uuid()) @db.Uuid
  domain      String   @db.VarChar(20)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  /// [{ category, items: [{ codeId, code, label }] }]
  items       Json     @db.JsonB
  aiGenerated Boolean  @default(false) @map("ai_generated")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([domain])
  @@map("formulary_lists")
}

/// 코드 등재 요청 — 처방집 밖 코드의 사용 요청(위원회 심의)
model FormularyRequest {
  id          String    @id @default(uuid()) @db.Uuid
  domain      String    @db.VarChar(20)
  codeType    String    @map("code_type") @db.VarChar(30)
  codeId      String?   @map("code_id") @db.Uuid
  codeLabel   String?   @map("code_label") @db.VarChar(300) // 표시용(코드·명)
  freeText    String?   @map("free_text") @db.VarChar(300) // 마스터에도 없는 신규
  reason      String    @db.Text // 임상 사유(필수)
  urgency     String    @default("ROUTINE") @db.VarChar(10) // ROUTINE|URGENT
  requestedBy String    @map("requested_by") @db.Uuid
  department  String?   @db.VarChar(100)
  status      String    @default("PENDING") @db.VarChar(20) // PENDING|APPROVED|REJECTED|WITHDRAWN
  decision    String?   @db.Text
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status, domain])
  @@index([requestedBy])
  @@map("formulary_requests")
}

model DepartmentCodeCatalog {
