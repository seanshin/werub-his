  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  program EducationProgram @relation(fields: [programId], references: [id])

  @@index([staffId])
  @@index([expiresAt])
  @@map("education_completions")
}

// ============================================================
// EMR Enhancement: 의무기록 강화
// ============================================================

enum ProblemStatus {
  ACTIVE
  CHRONIC
  RESOLVED
  INACTIVE
}

enum ProblemSeverity {
  MILD
  MODERATE
  SEVERE
}

// ── EMR-04: 문제목록 (Problem List) ──

model ProblemList {
  id               String          @id @default(uuid()) @db.Uuid
  patientId        String          @map("patient_id") @db.Uuid
  diagnosisCodeId  String          @map("diagnosis_code_id") @db.Uuid
  description      String          @db.VarChar(500)
  status           ProblemStatus   @default(ACTIVE)
  severity         ProblemSeverity @default(MODERATE)
  onsetDate        DateTime?       @map("onset_date") @db.Date
  resolvedDate     DateTime?       @map("resolved_date") @db.Date
  addedBy          String          @map("added_by") @db.Uuid
  addedEncounterId String?         @map("added_encounter_id") @db.Uuid
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  patient       Patient       @relation(fields: [patientId], references: [id])
  diagnosisCode DiagnosisCode @relation(fields: [diagnosisCodeId], references: [id])
  addedByUser   User          @relation("ProblemAddedBy", fields: [addedBy], references: [id])
  encounter     Encounter?    @relation(fields: [addedEncounterId], references: [id])

  @@index([patientId, status])
  @@index([patientId])
  @@map("problem_lists")
}

// ── EMR-05: 알레르기/ADR ──

enum AllergyType {
  DRUG
  FOOD
  ENVIRONMENTAL
  LATEX
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyVerification {
  CONFIRMED
  UNCONFIRMED
  REFUTED
  ENTERED_IN_ERROR
}

model Allergy {
  id                 String              @id @default(uuid()) @db.Uuid
  patientId          String              @map("patient_id") @db.Uuid
  type               AllergyType
  allergen           String              @db.VarChar(300)
  allergenCode       String?             @map("allergen_code") @db.VarChar(50)
  reaction           String              @db.VarChar(500)
  severity           AllergySeverity
  onsetDate          DateTime?           @map("onset_date") @db.Date
  verificationStatus AllergyVerification @default(UNCONFIRMED) @map("verification_status")
  reportedBy         String              @map("reported_by") @db.VarChar(100)
  recordedBy         String              @map("recorded_by") @db.Uuid
  notes              String?             @db.Text
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  patient  Patient @relation("PatientAllergies", fields: [patientId], references: [id])
  recorder User    @relation("AllergyRecorder", fields: [recordedBy], references: [id])

  @@index([patientId, isActive])
  @@index([allergenCode])
  @@map("allergies")
}

// 알레르기 문진 이력(NKA 안전) — 레코드 부재("미문진")와 "무알레르기 확인"을 구별.
// 현재 상태 도출: 활성 Allergy>0 → HAS / 없으면 최신 문진 result / 문진 없으면 NOT_ASSESSED.
enum AllergyAssessmentResult {
  NO_KNOWN_ALLERGIES // 무알레르기 확인(문진 결과 없음)
  HAS_ALLERGIES // 알레르기 있음(상세는 Allergy)
  UNABLE_TO_ASSESS // 문진 불가(의식저하·의사소통 곤란 등)
}

model AllergyAssessment {
  id          String                  @id @default(uuid()) @db.Uuid
  patientId   String                  @map("patient_id") @db.Uuid
  result      AllergyAssessmentResult
  encounterId String?                 @map("encounter_id") @db.Uuid
  note        String?                 @db.Text
  assessedBy  String                  @map("assessed_by") @db.Uuid
  assessedAt  DateTime                @default(now()) @map("assessed_at") @db.Timestamptz()
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz()

  patient  Patient @relation("PatientAllergyAssessments", fields: [patientId], references: [id])
  assessor User    @relation("AllergyAssessor", fields: [assessedBy], references: [id])

  @@index([patientId, assessedAt])
  @@map("allergy_assessments")
}

// 감염 격리 주의(일급 오더·영속) — 종전 인메모리 배열(재시작 소실) 대체. 환자단위 격리상태를 보드/배너로 노출.
enum IsolationPrecautionType {
  STANDARD // 표준주의
  CONTACT // 접촉주의
  DROPLET // 비말주의
  AIRBORNE // 공기주의(음압)
  PROTECTIVE // 역격리(면역저하 보호)
  STRICT // 엄격격리
}

enum IsolationPrecautionStatus {
  ACTIVE
  DISCONTINUED
}

/// 격리 프로토콜 정본(2026-08-04 P0-a④) — 종전 infection-control.service 하드코딩(PPE·기간·면회)의 테이블화.
/// 감염관리위 개정 표면. 미등재 타입은 코드 기본값 폴백(fail-safe).
model IsolationProtocol {
  id                     String   @id @default(uuid()) @db.Uuid
  isolationType          String   @unique @map("isolation_type") @db.VarChar(20) // STANDARD·DROPLET·AIRBORNE·CONTACT·STRICT·PROTECTIVE
  standardDurationDays   Int      @map("standard_duration_days")
  requiredPPE            Json     @map("required_ppe")
  environmentalMeasures  Json     @map("environmental_measures")
  visitationPolicy       String   @map("visitation_policy") @db.VarChar(100)
  staffEducationRequired Boolean  @map("staff_education_required")
  isActive               Boolean  @default(true) @map("is_active")
  source                 String?  @db.VarChar(40) // SEED | 위원회 의결번호(GOV-YYYY-NNN)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("isolation_protocols")
}

model IsolationPrecaution {
  id                String                    @id @default(uuid()) @db.Uuid
  patientId         String                    @map("patient_id") @db.Uuid
  admissionId       String?                   @map("admission_id") @db.Uuid
  type              IsolationPrecautionType
  status            IsolationPrecautionStatus @default(ACTIVE)
  reason            String                    @db.VarChar(500)
  organism          String?                   @db.VarChar(200) // 원인균(MDRO 등)
  roomNumber        String?                   @map("room_number") @db.VarChar(30)
  startDate         DateTime                  @default(now()) @map("start_date") @db.Timestamptz()
  expectedEndDate   DateTime?                 @map("expected_end_date") @db.Date
  endDate           DateTime?                 @map("end_date") @db.Timestamptz()
  orderedBy         String                    @map("ordered_by") @db.Uuid
  discontinuedBy    String?                   @map("discontinued_by") @db.Uuid
  discontinueReason String?                   @map("discontinue_reason") @db.VarChar(500)
  notes             String?                   @db.Text
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  patient       Patient @relation("PatientIsolations", fields: [patientId], references: [id])
  orderedByUser User    @relation("IsolationOrderedBy", fields: [orderedBy], references: [id])

  @@index([patientId, status])
  @@index([status])
  @@map("isolation_precautions")
}

// 검사 기준치 마스터 — 종전 LabTestCode 문자열(성별만) 대체. 성별·연령대·검체별 구조화 범위 + 위급값으로 자동 판정.
enum RefRangeSex {
  ANY
  MALE
  FEMALE
}

model ReferenceRange {
  id           String      @id @default(uuid()) @db.Uuid
  testCode     String?     @map("test_code") @db.VarChar(50) // LabTestCode.code(원내)
  loincCode    String?     @map("loinc_code") @db.VarChar(20) // 표준 LOINC(선택)
  testName     String?     @map("test_name") @db.VarChar(200) // 표시용
  sex          RefRangeSex @default(ANY)
  ageMinYears  Int?        @map("age_min_years") // 포함 하한(세)
  ageMaxYears  Int?        @map("age_max_years") // 미포함 상한(세) → [min, max)
  ageMinMonths Int?        @map("age_min_months") // 영아 정밀 연령대 하한(개월·포함)
  ageMaxMonths Int?        @map("age_max_months") // 영아 정밀 연령대 상한(개월·미포함)
  specimen     String?     @db.VarChar(50)
  low          Decimal?    @db.Decimal(12, 3)
  high         Decimal?    @db.Decimal(12, 3)
  criticalLow  Decimal?    @map("critical_low") @db.Decimal(12, 3)
  criticalHigh Decimal?    @map("critical_high") @db.Decimal(12, 3)
  unit         String?     @db.VarChar(20)
  textNormal   String?     @map("text_normal") @db.VarChar(100) // 정성검사 정상값(예: Negative)
  source       String?     @db.VarChar(50) // 출처(seed/KDCA/manufacturer 등)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([testCode, sex])
  @@index([loincCode])
  @@map("reference_ranges")
}

// ── EMR-02: 퇴원요약 ──

enum DischargeSummaryStatus {
  DRAFT
  SIGNED
  AMENDED
}

model DischargeSummary {
  id                   String                 @id @default(uuid()) @db.Uuid
  admissionId          String                 @unique @map("admission_id") @db.Uuid
  doctorId             String                 @map("doctor_id") @db.Uuid
  admitDate            DateTime               @map("admit_date") @db.Date
  dischargeDate        DateTime               @map("discharge_date") @db.Date
  admitDiagnosis       String                 @map("admit_diagnosis") @db.Text
  dischargeDiagnosis   String                 @map("discharge_diagnosis") @db.Text
  diagnosisCodes       Json                   @map("diagnosis_codes") @db.JsonB
  hospitalCourse       String                 @map("hospital_course") @db.Text
  procedures           String?                @db.Text
  significantFindings  String?                @map("significant_findings") @db.Text
  conditionAtDischarge String                 @map("condition_at_discharge") @db.VarChar(200)
  dischargeMedications Json                   @map("discharge_medications") @db.JsonB
  followUpPlan         String                 @map("follow_up_plan") @db.Text
  followUpDate         DateTime?              @map("follow_up_date") @db.Date
  dietaryInstructions  String?                @map("dietary_instructions") @db.Text
  activityRestrictions String?                @map("activity_restrictions") @db.Text
  patientEducation     String?                @map("patient_education") @db.Text
  status               DischargeSummaryStatus @default(DRAFT)
  signedAt             DateTime?              @map("signed_at") @db.Timestamptz()
  signedBy             String?                @map("signed_by") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  doctor    User      @relation("DischargeSummaryDoctor", fields: [doctorId], references: [id])

  @@map("discharge_summaries")
}

// ── EMR-01: 간호기록 ──

enum NursingDiagnosisStatus {
  ACTIVE
  RESOLVED
}

enum NursingNoteType {
  FOCUS
  NARRATIVE
  DAR
  SOAP
  DARE
  SBAR
}

enum ShiftType {
  DAY
  EVENING
  NIGHT
}

enum IntakeType {
  ORAL
  IV
  OTHER
}

enum OutputType {
  URINE
  DRAIN
  EMESIS
  OTHER
}

enum MedAdminStatus {
  SCHEDULED
  ADMINISTERED
  HELD
  REFUSED
  MISSED
}

model NursingAssessment {
  id                   String   @id @default(uuid()) @db.Uuid
  admissionId          String   @map("admission_id") @db.Uuid
  nurseId              String   @map("nurse_id") @db.Uuid
  consciousness        String   @db.VarChar(20)
  mobility             String   @db.VarChar(50)
  painScore            Int      @map("pain_score")
  painLocation         String?  @map("pain_location") @db.VarChar(100)
  nutritionStatus      String   @map("nutrition_status") @db.VarChar(50)
  skinIntegrity        String   @map("skin_integrity") @db.VarChar(50)
  fallRiskAssessmentId String?  @map("fall_risk_assessment_id") @db.Uuid
  bradenScore          Int?     @map("braden_score")
  allergyConfirmed     Boolean  @default(false) @map("allergy_confirmed")
  additionalData       Json?    @map("additional_data") @db.JsonB
  assessedAt           DateTime @map("assessed_at") @db.Timestamptz()
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  admission          Admission           @relation(fields: [admissionId], references: [id])
  nurse              User                @relation("NursingAssessmentNurse", fields: [nurseId], references: [id])
  fallRiskAssessment FallRiskAssessment? @relation(fields: [fallRiskAssessmentId], references: [id])
  diagnoses          NursingDiagnosis[]

  @@index([admissionId])
  @@map("nursing_assessments")
}

model NursingDiagnosis {
  id                      String                 @id @default(uuid()) @db.Uuid
  assessmentId            String                 @map("assessment_id") @db.Uuid
  nurseId                 String                 @map("nurse_id") @db.Uuid
  nandaCode               String                 @map("nanda_code") @db.VarChar(20)
  nandaName               String                 @map("nanda_name") @db.VarChar(300)
  relatedFactors          String?                @map("related_factors") @db.Text
  definingCharacteristics String?                @map("defining_characteristics") @db.Text
  expectedOutcome         String                 @map("expected_outcome") @db.Text
  status                  NursingDiagnosisStatus @default(ACTIVE)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  assessment    NursingAssessment     @relation(fields: [assessmentId], references: [id])
  nurse         User                  @relation("NursingDiagnosisNurse", fields: [nurseId], references: [id])
  interventions NursingIntervention[] // NIC(다)
  outcomes      NursingOutcome[] // NOC(다)

  @@index([assessmentId])
  @@map("nursing_diagnoses")
}

model NursingNote {
  id               String          @id @default(uuid()) @db.Uuid
  admissionId      String          @map("admission_id") @db.Uuid
  nurseId          String          @map("nurse_id") @db.Uuid
  noteType         NursingNoteType @map("note_type")
  // DAR/FOCUS 공통
  focus            String?         @db.VarChar(200)
  data             String?         @db.Text // DAR-D, DARE-D
  action           String?         @db.Text // DAR-A, DARE-A
  response         String?         @db.Text // DAR-R, DARE-R
  content          String?         @db.Text // NARRATIVE 본문
  // SOAP 간호기록
  subjective       String?         @db.Text // S: 환자 주관적 호소
  objective        String?         @db.Text // O: 객관적 관찰/측정
  assessment       String?         @db.Text // A: 간호 판단
  plan             String?         @db.Text // P: 간호 계획
  // DARE 추가
  education        String?         @db.Text // E: 환자 교육
  // 메타
  shiftType        ShiftType       @map("shift_type")
  priority         String?         @db.VarChar(10) // NORMAL, URGENT, CRITICAL
  photoUrls        Json?           @map("photo_urls") @db.JsonB // 상처 사진 등
  recordedAt       DateTime        @map("recorded_at") @db.Timestamptz()
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  // 무결성(가): 간호기록은 작성=서명(append-only). DRAFT 작성 후 sign 가능, 정정은 AMENDED.
  status           String          @default("SIGNED") @db.VarChar(12) // DRAFT|SIGNED|AMENDED
  signedAt         DateTime?       @map("signed_at") @db.Timestamptz()
  signedBy         String?         @map("signed_by") @db.Uuid
  // AI 보조 프로비넌스(간호기록 AI 보조 기획 P0) — AI는 저자 아님(보조). 책임=signedBy 간호사 불변.
  aiAssisted       Boolean         @default(false) @map("ai_assisted") // AI 초안에서 출발했는지
  aiModel          String?         @map("ai_model") @db.VarChar(80) // 사용 모델/버전
  aiPromptVersion  String?         @map("ai_prompt_version") @db.VarChar(40) // 프롬프트 템플릿 버전(재현성)
  aiSourceSnapshot Json?           @map("ai_source_snapshot") @db.JsonB // 초안 근거(집계 데이터 ref·값)+초안 원문
  aiEditDistance   Int?            @map("ai_edit_distance") // 간호사 수정량(서명 시 계산·과신 모니터)
  // 의사 공동서명(co-sign) — 간호기록 전자결재 확약(P1). NONE 기본(상신 전), 상신 시 PENDING, 확약 COSIGNED/REJECTED
  cosignStatus     String?         @map("cosign_status") @db.VarChar(12)
  cosignedBy       String?         @map("cosigned_by") @db.Uuid
  cosignedAt       DateTime?       @map("cosigned_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  nurse     User      @relation("NursingNoteNurse", fields: [nurseId], references: [id])

  @@index([admissionId, recordedAt])
  @@index([noteType])
  @@map("nursing_notes")
}

// 간호중재(NIC·다) — 간호진단의 계획·중재. ADPIE의 Planning/Intervention.
model NursingIntervention {
  id                 String           @id @default(uuid()) @db.Uuid
  nursingDiagnosisId String           @map("nursing_diagnosis_id") @db.Uuid
  nicCode            String?          @map("nic_code") @db.VarChar(20) // NIC 분류코드(선택)
  name               String           @db.VarChar(300) // 간호중재명
  detail             String?          @db.Text
  frequency          String?          @db.VarChar(100) // 시행 빈도
  status             String           @default("PLANNED") @db.VarChar(15) // PLANNED|ACTIVE|COMPLETED|DISCONTINUED
  /// 🔴 이행 추적 — 종전에는 `status` 만 있어 **계획만 있고 이행이 없었다**.
  /// "COMPLETED" 로 바꾼 사람과 시각을 알 수 없어, 중재를 실제로 했는지 원장이 답하지 못했다
  /// (낙상 예방 중재는 그 자체가 안전 지표의 분자다).
  /// 🔴 상태만 바꾸고 수행 기록을 남기지 않는 경로를 만들지 않는다 — 서비스가 함께 적는다.
  performedBy        String?          @map("performed_by") @db.Uuid
  performedAt        DateTime?        @map("performed_at") @db.Timestamptz()
  performedNote      String?          @map("performed_note") @db.Text
  createdBy          String           @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  diagnosis          NursingDiagnosis @relation(fields: [nursingDiagnosisId], references: [id])

  @@index([nursingDiagnosisId])
  @@map("nursing_interventions")
}

// 간호결과(NOC·다) — 간호진단의 기대결과·평가. ADPIE의 Outcome/Evaluation.
model NursingOutcome {
  id                 String           @id @default(uuid()) @db.Uuid
  nursingDiagnosisId String           @map("nursing_diagnosis_id") @db.Uuid
  nocCode            String?          @map("noc_code") @db.VarChar(20) // NOC 분류코드(선택)
  name               String           @db.VarChar(300) // 기대결과명
  baselineScore      Int?             @map("baseline_score") // 1-5 Likert(초기)
  targetScore        Int?             @map("target_score") // 목표
  currentScore       Int?             @map("current_score") // 현재(평가)
  status             String           @default("NOT_MET") @db.VarChar(15) // NOT_MET|PARTIALLY_MET|MET
  evaluatedAt        DateTime?        @map("evaluated_at") @db.Timestamptz()
  evaluatedBy        String?          @map("evaluated_by") @db.Uuid
  createdBy          String           @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  diagnosis          NursingDiagnosis @relation(fields: [nursingDiagnosisId], references: [id])

  @@index([nursingDiagnosisId])
  @@map("nursing_outcomes")
}

model IntakeOutput {
  id           String      @id @default(uuid()) @db.Uuid
  admissionId  String      @map("admission_id") @db.Uuid
  nurseId      String      @map("nurse_id") @db.Uuid
  recordedAt   DateTime    @map("recorded_at") @db.Timestamptz()
  intakeType   IntakeType? @map("intake_type")
  intakeAmount Int?        @map("intake_amount")
  intakeDetail String?     @map("intake_detail") @db.VarChar(200)
  outputType   OutputType? @map("output_type")
  outputAmount Int?        @map("output_amount")
  outputDetail String?     @map("output_detail") @db.VarChar(200)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  admission Admission @relation(fields: [admissionId], references: [id])
  nurse     User      @relation("IntakeOutputNurse", fields: [nurseId], references: [id])

  @@index([admissionId, recordedAt])
  @@map("intake_outputs")
}

model MedicationAdministration {
  id                 String         @id @default(uuid()) @db.Uuid
  prescriptionId     String         @map("prescription_id") @db.Uuid
  orderId            String?        @map("order_id") @db.Uuid
  dispensingId       String?        @map("dispensing_id") @db.Uuid
  compoundingOrderId String?        @map("compounding_order_id") @db.Uuid // 무균조제 불출 연결(주사·TPN·항암)
  // BCMA bedside 스캔(2026-07 R2-3) — 투약 시점 환자 손목밴드(MRN)·약품 바코드 원본 보존
  patientBandScan    String?        @map("patient_band_scan") @db.VarChar(40)
  medScan            String?        @map("med_scan") @db.VarChar(60)
  bcmaScanAt         DateTime?      @map("bcma_scan_at") @db.Timestamptz()
  nurseId            String?        @map("nurse_id") @db.Uuid
  patientId          String         @map("patient_id") @db.Uuid
  scheduledAt        DateTime       @map("scheduled_at") @db.Timestamptz()
  administeredAt     DateTime?      @map("administered_at") @db.Timestamptz()
  status             MedAdminStatus @default(SCHEDULED)
  holdReason         String?        @map("hold_reason") @db.VarChar(500)
  route              String         @db.VarChar(20)
  dose               String         @db.VarChar(100)
  verifiedBy         String?        @map("verified_by") @db.Uuid
  notes              String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  prescription     Prescription      @relation(fields: [prescriptionId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  dispensing       Dispensing?       @relation(fields: [dispensingId], references: [id])
  compoundingOrder CompoundingOrder? @relation(fields: [compoundingOrderId], references: [id])
  nurse            User?             @relation("MedAdminNurse", fields: [nurseId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  verifier         User?             @relation("MedAdminVerifier", fields: [verifiedBy], references: [id])

  @@index([patientId, scheduledAt])
  @@index([prescriptionId])
  @@map("medication_administrations")
}

