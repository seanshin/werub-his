# hospital.example.org 홈페이지 운영 환경변수 (AWS)
# 실제 시크릿/도메인은 배포 플랫폼(App Runner/ECS/Amplify) 환경변수로 주입.

# [BUILD 시점 고정] /api·/media 프록시 대상. next.config rewrites destination 에 박힘.
#  → 런타임 env 로 안 바뀌므로 반드시 빌드(ARG/build env)로 주입. 환경별 이미지.
HOMEPAGE_API_ORIGIN=https://his.example.org

# [런타임] SSR(publicFetch) 서버→HIS API 직접 호출 URL. (서버-서버, CORS 불요)
INTERNAL_API_URL=https://his.example.org

# 브라우저 노출용. 빈 값 유지 → 클라이언트는 상대경로(/api·/media) 호출
#  → rewrites 가 HOMEPAGE_API_ORIGIN 으로 서버측 프록시(same-origin·CORS 불요).
NEXT_PUBLIC_API_URL=

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
