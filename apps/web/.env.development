# 개발 전용 환경변수 — `next dev`(NODE_ENV=development) 에서만 로드된다.
#
# 🔴 운영 빌드(`next build`)는 이 파일을 읽지 않는다(NODE_ENV=production 이면 Next 는
#    `.env.production` / `.env.local` / `.env` 만 로드한다). 따라서 여기 켠 값이
#    운영 번들로 새지 않는다 — 그 사실은 가드가 산출물을 직접 뒤져 확인한다
#    (`test/ui/no-test-accounts-in-prod.spec.ts`).

# 운영 모드(빌드 상한) — DEV / REHEARSAL / REAL. 정본 `packages/shared/src/his-mode.ts`.
# 🔴 이 변수가 없으면 REAL 로 접혀 시드 로그인 패널이 **개발기에서도 사라진다**.
#    2026-08-24 WEB-SEC-01(운영 노출 봉합) 이후 게이트 변수를 어디에도 정의하지 않아
#    실제로 그 상태였다(2026-08-25 사람 신고) — 이 파일이 그 자리다.
# 배포 서버(리허설)는 `./infra/scripts/deploy.sh --mode rehearsal` 로 켠다.
NEXT_PUBLIC_HIS_MODE=DEV

# 검진권 해외딜러 포털(`/distributor`) 테스트 계정 — 값은 JSON 으로만 주입한다
# (`102e5fed` 에서 소스 하드코딩을 제거했고, 그 뒤 이 변수를 어디에도 정의하지 않아 개발기에서도 사라졌다).
# 🔴 아래 5종·비밀번호는 그 커밋의 diff 에서 그대로 회수한 값이다(지어내지 않았다).
NEXT_PUBLIC_DEALER_TEST_ACCOUNTS=[{"kind":"해외","label":"데모 해외딜러 (Demo)","email":"dealer@hospital.example.org","password":"CHANGE_ME","meta":"US/USD"},{"kind":"국내","label":"국내유치업 A","email":"domestic1@hospital.example.org","password":"CHANGE_ME","meta":"KR/KRW · 12%"},{"kind":"국내","label":"국내유치업 B","email":"domestic2@hospital.example.org","password":"CHANGE_ME","meta":"KR/KRW · 15%"},{"kind":"해외","label":"Overseas Dealer A","email":"overseas1@hospital.example.org","password":"CHANGE_ME","meta":"US/USD · 25%"},{"kind":"해외","label":"Overseas Dealer B","email":"overseas2@hospital.example.org","password":"CHANGE_ME","meta":"CN/CNY · 20%"}]
