# ============================================================================
# Hospital RUN — Production Environment Variables (컨테이너 설치 경로)
# ============================================================================
# 이 파일을 .env.production 으로 복사 후 실제 값을 입력하세요.
# 절대 이 파일을 git에 커밋하지 마세요!
#
# 🔴 이 파일은 **두 가지로 쓰인다**:
#    ① compose 치환(`${DB_PASSWORD}` 등) — `docker compose --env-file .env.production …`
#    ② api·sentinel 컨테이너의 `env_file` — 코드가 읽는 키가 여기 있어야 컨테이너 안에서 보인다
#    그래서 **루트 `.env.example` 의 [필수]·[판매본 필수] 키를 여기로 함께 옮겨 채운다.**
#    아래 목록은 compose 가 직접 쓰는 것만이며, 전체 키는 `.env.example` 과
#    `docs/05-reference/customer-install-guide.md` §3 이 정본이다.
#
# 🔴 REAL(판매본)은 아래가 비면 **부팅을 거부한다** — 반드시 채운다:
#    PDF_SERVICE_TOKEN · PDF_RENDER_SECRET · DOC_DOWNLOAD_SECRET · AI_PROVENANCE_SECRET
#    (비면 저장소에 공개된 개발용 고정 문자열로 떨어지는 자리다)

# ── Mode ──
# DEV / REHEARSAL / REAL — 🔴 비우면 REAL 로 판정된다(모르면 안전측). 판매본 운영은 REAL.
HIS_MODE=REAL

# ── Database ──
# 🔴 서비스 이름은 `his-postgres` 로 고유화돼 있다(같은 호스트의 형제 시스템과 충돌 방지)
DB_NAME=hospitalrun
DB_USER=hospital
DB_PASSWORD=CHANGE_ME_strong_password_32chars

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Auth (최소 32자 랜덤 문자열) ──
# 생성: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_auth_secret_min_32_chars
AUTH_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32

# ── Encryption (AES-256: 64자 hex) ──
# 생성: openssl rand -hex 32
# 🔴 all-zeros 플레이스홀더를 그대로 쓰면 암호화가 무의미하다(go-live 가 NOT_READY 로 잡는다)
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_for_aes256

# ── Public URL ──
PUBLIC_URL=https://his.example.kr

# ── 웹 빌드 인자 ──
# 🔴 **빈 문자열이 정본**이다 — 브라우저가 상대경로를 쓴다(CLAUDE.md Deployment Rules).
#    값을 넣으면 그 주소가 빌드에 박히고, 바꾸려면 재빌드해야 한다.
NEXT_PUBLIC_API_URL=

# ── 공개 사이트 최신성 확인 (선택) ──
# 🔴 API 는 10분마다 이 주소로 **외부 요청**을 보낸다(공개 사이트가 낡은 빌드를 서비스하는지 확인).
#    비워 두면 코드 기본값(`https://hospital.example.org` — 다른 기관의 도메인)으로 나간다.
#    격리 네트워크 설치 기관은 자기 주소를 넣거나, 외부 차단 방화벽에 이 사실을 반영한다.
#    🔴 확인 자체를 끄는 설정은 **아직 없다**(갈래 E 회신 R25 — 코드 변경 필요).
HOMEPAGE_PUBLIC_URL=

# ── DB 백업 폴더 (go-live `security.dbBackup` 판정 대상) ──
# 🔴 컨테이너 안 경로다. 호스트의 `infra/docker/backups` 가 여기에 마운트된다.
#    비우면 코드 기본값(특정 서버의 홈 아래)으로 떨어져 새 설치본은 늘 "판정 불가(ENOENT)" 였다.
DB_BACKUP_DIR=/backups

# ── nginx 설정 선택 ──
# 기본값 = HIS 단독(`./nginx/prod-his-only.conf`). PACS(OpenPACS)를 함께 설치하면 `./nginx/prod.conf`.
# NGINX_CONF=./nginx/prod.conf

# ── 첫 관리자 (최초 1회 bootstrap 프로파일에서만 사용) ──
# 🔴 여기에 적어 두지 말고 **그 한 번의 명령에만** 환경변수로 넘기는 것을 권한다(파일에 남는다).
#    비밀번호 12자 이상 · 이미 사용자가 있으면 스크립트가 거부한다.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FAMILY_NAME=
# ADMIN_GIVEN_NAME=

# ── SSL Certificate Paths (nginx volume mount) ──
# infra/docker/nginx/ssl/ 에 아래 파일을 배치:
#   fullchain.pem  (인증서 + 중간인증서)
#   privkey.pem    (개인키)
